def OQ7.Theorem51Statement : OQ7.PhysicalParameters → Prop :=
fun p =>
  (∀ᶠ (L : ℝ) in Filter.atTop, (OQ7.exactTargetClass p L).Nonempty) ∧
    (∀ (L : ℝ), ∀ layers ∈ OQ7.exactTargetClass p L, OQ7.stackAsymmetry p.k layers < OQ7.ScalarEnvelope.D0 p.T p.a) ∧
      Filter.Tendsto (fun L => (p.k * L) ^ 2 * (OQ7.ScalarEnvelope.D0 p.T p.a - OQ7.optimalAsymmetry p L)) Filter.atTop
        (nhds (OQ7.asymptoticCoefficient p))
