OQ7Prescribed.apertureMeanSlopeDeriv_continuous : ∀ (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w → ∀ (x : ℂ), Continuous (OQ7Prescribed.apertureMeanSlopeDeriv w x)
OQ7Prescribed.apertureMeanSlopeDeriv_norm_le : ∀ (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w →
    HasCompactSupport w →
      ∀ (x : ℂ) (r C : ℝ),
        0 ≤ r → (∀ (y : ℂ), ‖iteratedFDeriv ℝ 4 w y‖ ≤ C) → ‖OQ7Prescribed.apertureMeanSlopeDeriv w x r‖ ≤ C * r / 3
OQ7Prescribed.apertureOscillation_add : ∀ (k a b : ℝ),
  OQ7Prescribed.apertureOscillation k (a + b) =
    OQ7Prescribed.apertureOscillation k a * OQ7Prescribed.apertureOscillation k b
OQ7Prescribed.apertureOscillation_boundary_phase : ∀ (k L z : ℝ),
  OQ7Prescribed.apertureOscillation k (L - z) * OQ7Prescribed.apertureOscillation (-k) L =
    OQ7Prescribed.apertureOscillation (-k) z
OQ7Prescribed.apertureOscillation_continuous : ∀ (k : ℝ), Continuous (OQ7Prescribed.apertureOscillation k)
OQ7Prescribed.apertureOscillation_error_bound : ∀ (k a b : ℝ),
  0 < k →
    a ≤ b →
      ∀ (u du ddu : ℝ → ℂ),
        ContinuousOn u (Set.uIcc a b) →
          ContinuousOn du (Set.uIcc a b) →
            (∀ t ∈ Set.Ioo (min a b) (max a b), HasDerivAt u (du t) t) →
              (∀ t ∈ Set.Ioo (min a b) (max a b), HasDerivAt du (ddu t) t) →
                IntervalIntegrable ddu MeasureTheory.volume a b →
                  u b = 0 →
                    du b = 0 →
                      ∀ (M : ℝ),
                        (∀ t ∈ Set.Ioc a b, ‖ddu t‖ ≤ M) →
                          ‖(∫ (t : ℝ) in a..b, u t * OQ7Prescribed.apertureOscillation k t) +
                                (Complex.I * ↑k)⁻¹ * u a * OQ7Prescribed.apertureOscillation k a‖ ≤
                            (‖du a‖ + M * (b - a)) / k ^ 2
OQ7Prescribed.apertureOscillation_hasDerivAt : ∀ (k t : ℝ),
  HasDerivAt (OQ7Prescribed.apertureOscillation k) (Complex.I * ↑k * OQ7Prescribed.apertureOscillation k t) t
OQ7Prescribed.apertureOscillation_ibp : ∀ (k a b : ℝ) (u du : ℝ → ℂ),
  ContinuousOn u (Set.uIcc a b) →
    (∀ t ∈ Set.Ioo (min a b) (max a b), HasDerivAt u (du t) t) →
      IntervalIntegrable du MeasureTheory.volume a b →
        Complex.I * ↑k * ∫ (t : ℝ) in a..b, u t * OQ7Prescribed.apertureOscillation k t =
          u b * OQ7Prescribed.apertureOscillation k b - u a * OQ7Prescribed.apertureOscillation k a -
            ∫ (t : ℝ) in a..b, du t * OQ7Prescribed.apertureOscillation k t
OQ7Prescribed.apertureOscillation_norm : ∀ (k t : ℝ), ‖OQ7Prescribed.apertureOscillation k t‖ = 1
OQ7Prescribed.apertureOscillation_opposite_mul : ∀ (k z : ℝ),
  OQ7Prescribed.apertureOscillation k z * OQ7Prescribed.apertureOscillation (-k) z = 1
OQ7Prescribed.apertureOscillation_sub : ∀ (k z t : ℝ),
  OQ7Prescribed.apertureOscillation k (z - t) =
    OQ7Prescribed.apertureOscillation k z * OQ7Prescribed.apertureOscillation (-k) t
OQ7Prescribed.apertureOscillation_two_ibp : ∀ (k a b : ℝ),
  k ≠ 0 →
    ∀ (u du ddu : ℝ → ℂ),
      ContinuousOn u (Set.uIcc a b) →
        ContinuousOn du (Set.uIcc a b) →
          (∀ t ∈ Set.Ioo (min a b) (max a b), HasDerivAt u (du t) t) →
            (∀ t ∈ Set.Ioo (min a b) (max a b), HasDerivAt du (ddu t) t) →
              IntervalIntegrable ddu MeasureTheory.volume a b →
                u b = 0 →
                  du b = 0 →
                    (Complex.I * ↑k) ^ 2 *
                        ((∫ (t : ℝ) in a..b, u t * OQ7Prescribed.apertureOscillation k t) +
                          (Complex.I * ↑k)⁻¹ * u a * OQ7Prescribed.apertureOscillation k a) =
                      du a * OQ7Prescribed.apertureOscillation k a +
                        ∫ (t : ℝ) in a..b, ddu t * OQ7Prescribed.apertureOscillation k t
