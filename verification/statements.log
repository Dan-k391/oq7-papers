OQ7Prescribed.directedFlux_incident_reflected : ∀ (r : ℂ), OQ7.directedFlux (1 + r) (1 - r) = 1 - Complex.normSq r
OQ7Prescribed.directedFlux_transmitted : ∀ (t : ℂ), OQ7.directedFlux t t = Complex.normSq t
@OQ7Prescribed.displaced_distance_phase_error : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℝ H] (x y : H),
  0 < ‖x‖ →
    2 * ‖y‖ ≤ ‖x‖ → 0 ≤ ‖x - y‖ - ‖x‖ + inner ℝ (‖x‖⁻¹ • x) y ∧ ‖x - y‖ - ‖x‖ + inner ℝ (‖x‖⁻¹ • x) y ≤ ‖y‖ ^ 2 / ‖x‖
OQ7Prescribed.displaced_dyadic_farField_error : ∀ (k R : ℝ),
  0 ≤ R →
    ∀ (x y : OQ7Prescribed.Position),
      2 * R + 2 ≤ ‖x‖ →
        ‖y‖ ≤ R →
          ∀ (v : OQ7Prescribed.Vector),
            ‖(↑‖x‖ * Complex.exp (-Complex.I * ↑(k * ‖x‖))) • (OQ7Prescribed.classicalDyadic k (x - y)) v -
                  (↑(k ^ 2 / (4 * Real.pi)) *
                      Complex.exp (-Complex.I * ↑(k * inner ℝ (OQ7Prescribed.radialDirection x) y))) •
                    OQ7Prescribed.transverseProjection (OQ7Prescribed.radialDirection x) v‖ ≤
              OQ7Prescribed.farFieldKernelConstant k R / ‖x‖ * ‖v‖
@OQ7Prescribed.displaced_inverse_amplitude_error : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [InnerProductSpace ℝ H] (x y : H), 0 < ‖x‖ → 2 * ‖y‖ ≤ ‖x‖ → |‖x‖ / ‖x - y‖ - 1| ≤ 2 * ‖y‖ / ‖x‖
OQ7Prescribed.displaced_kernel_radiation_norm_le : ∀ (k R : ℝ),
  0 ≤ R →
    ∀ (x y : OQ7Prescribed.Position),
      2 * R + 2 ≤ ‖x‖ →
        ‖y‖ ≤ R →
          ∀ (v : OQ7Prescribed.Vector),
            ‖OQ7Prescribed.cross (OQ7Prescribed.kernelMagnetic k (x - y) v)
                    (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)) -
                  (OQ7Prescribed.classicalDyadic k (x - y)) v‖ ≤
              OQ7Prescribed.radiationKernelConstant k R / ‖x‖ ^ 2 * ‖v‖
OQ7Prescribed.displaced_kernelMagnetic_norm_decay : ∀ (k R : ℝ),
  0 ≤ R →
    ∀ (x y : OQ7Prescribed.Position),
      2 * R + 2 ≤ ‖x‖ →
        ‖y‖ ≤ R →
          ∀ (v : OQ7Prescribed.Vector),
            ‖OQ7Prescribed.kernelMagnetic k (x - y) v‖ ≤ OQ7Prescribed.magneticDecayConstant k / ‖x‖ * ‖v‖
OQ7Prescribed.distributionCurl_add : ∀ (U V : OQ7Prescribed.CartesianDistribution),
  OQ7Prescribed.distributionCurl (U + V) = OQ7Prescribed.distributionCurl U + OQ7Prescribed.distributionCurl V
OQ7Prescribed.distributionCurl_complex_smul : ∀ (a : ℂ) (U : OQ7Prescribed.CartesianDistribution),
  OQ7Prescribed.distributionCurl (a • U) = a • OQ7Prescribed.distributionCurl U
OQ7Prescribed.distributionCurl_eq_implies_hasWeakCurl : ∀ (F G : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    MeasureTheory.LocallyIntegrable G MeasureTheory.volume →
      OQ7Prescribed.distributionCurl (OQ7Prescribed.fieldComponentDistribution F) =
          OQ7Prescribed.fieldComponentDistribution G →
        OQ7Prescribed.HasWeakCurl F G
OQ7Prescribed.distributionCurl_gradient : ∀ (T : OQ7Prescribed.ScalarDistribution),
  (OQ7Prescribed.distributionCurl fun i => (OQ7Prescribed.distributionPartial i) T) = 0
OQ7Prescribed.distributionCurl_real_smul : ∀ (a : ℝ) (U : OQ7Prescribed.CartesianDistribution),
  OQ7Prescribed.distributionCurl (a • U) = a • OQ7Prescribed.distributionCurl U
OQ7Prescribed.distributionCurlCurl : ∀ (U : OQ7Prescribed.CartesianDistribution) (i : Fin 3),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.distributionCurl U) i =
    (OQ7Prescribed.distributionPartial i) (OQ7Prescribed.distributionDivergence U) -
      OQ7Prescribed.distributionLaplacian (U i)
OQ7Prescribed.distributionPartial_commute : ∀ (T : OQ7Prescribed.ScalarDistribution) (i j : Fin 3),
  (OQ7Prescribed.distributionPartial i) ((OQ7Prescribed.distributionPartial j) T) =
    (OQ7Prescribed.distributionPartial j) ((OQ7Prescribed.distributionPartial i) T)
OQ7Prescribed.distributionPartial_complex_smul : ∀ (a : ℂ) (T : OQ7Prescribed.ScalarDistribution) (i : Fin 3),
  (OQ7Prescribed.distributionPartial i) (a • T) = a • (OQ7Prescribed.distributionPartial i) T
OQ7Prescribed.domain_compact_closure : ∀ (B : OQ7Prescribed.TwoLayerBody), IsCompact (closure B.domain)
OQ7Prescribed.domain_subset_closedBall : ∀ (B : OQ7Prescribed.TwoLayerBody),
  B.domain ⊆ Metric.closedBall 0 (B.aperture + B.absorberThickness + B.plateThickness)
OQ7Prescribed.dyadicGreenDistribution_apply : ∀ (k : ℝ) (i j : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.dyadicGreenDistribution k i j) φ =
    (if i = j then k ^ 2 • ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingGreen k x else 0) +
      ∫ (x : OQ7Prescribed.Position),
        ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x • OQ7Prescribed.outgoingGreen k x
OQ7Prescribed.dyadicGreenDistribution_apply_of_zero : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  φ 0 = 0 →
    ∀ (i j : Fin 3),
      (OQ7Prescribed.dyadicGreenDistribution k i j) φ =
        ∫ (x : OQ7Prescribed.Position), ↑(φ x) * ((OQ7Prescribed.classicalDyadic k x) (OQ7Prescribed.basisC j)).ofLp i
OQ7Prescribed.dyadicGreenDistribution_eq_static_add_remainder : ∀ (k : ℝ) (i j : Fin 3),
  OQ7Prescribed.dyadicGreenDistribution k i j =
    OQ7Prescribed.greenHessian 0 i j +
      Distribution.ofFun ⊤ (fun x => ((OQ7Prescribed.dyadicRemainder k x) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume ⊤
OQ7Prescribed.dyadicRemainder_cancel : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  OQ7Prescribed.dyadicRemainder k x =
    (↑(k ^ 2) * Complex.exp (Complex.I * ↑k * ↑‖x‖) / (↑(4 * Real.pi) * ↑‖x‖) +
          (Complex.exp (Complex.I * ↑k * ↑‖x‖) * (Complex.I * ↑k * ↑‖x‖ - 1) + 1) / (↑(4 * Real.pi) * ↑‖x‖ ^ 3)) •
        ContinuousLinearMap.id ℂ OQ7Prescribed.Vector +
      ((Complex.exp (Complex.I * ↑k * ↑‖x‖) * ((Complex.I * ↑k * ↑‖x‖) ^ 2 - 3 * (Complex.I * ↑k * ↑‖x‖) + 3) - 3) /
          (↑(4 * Real.pi) * ↑‖x‖ ^ 5)) •
        ((InnerProductSpace.rankOne ℂ) (OQ7Prescribed.complexify x)) (OQ7Prescribed.complexify x)
OQ7Prescribed.dyadicRemainder_current_entry_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
