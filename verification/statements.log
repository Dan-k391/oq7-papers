      ‖-OQ7Prescribed.normalizedIncidentDrive k B σ -
          (OQ7Prescribed.activeMaterialOperator k B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β) q‖
OQ7Prescribed.normalizedExtinction_compact_lower_bound : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) (s : Set ℝ),
  IsCompact s → ∃ c, 0 < c ∧ ∀ θ ∈ s, c ≤ OQ7Prescribed.normalizedExtinction k hk B σ θ α β hα hβ
OQ7Prescribed.normalizedExtinction_continuous : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
