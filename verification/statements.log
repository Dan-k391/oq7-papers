                    (∀ (x : OQ7Prescribed.Position), ‖φ x‖ ≤ T) →
                      ∀ (i : Fin 3),
                        ‖∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x‖ ≤
                          8 * M * C * T * MeasureTheory.volume.real (Metric.ball 0 1) * ε
OQ7Prescribed.shrinkingCutoffPoleError_tendsto : ∀ (F : OQ7Prescribed.Position → ℝ),
  (∃ R, 0 < R ∧ ∃ C, 0 ≤ C ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C / ‖x‖) →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
      Filter.Tendsto (fun ε => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)
OQ7Prescribed.sine_ne_zero_dense : Dense {θ | Real.sin θ ≠ 0}
@OQ7Prescribed.slabAbsorberAmplitude_loss_angle_continuous : ∀ {X : Type u_1} [inst : TopologicalSpace X] (k : ℝ),
  0 < k →
    ∀ (A : OQ7.HomogeneousLayer),
      1 ≤ A.p →
        0 ≤ A.q →
          0 ≤ A.width →
            ∀ (p d : ℝ),
              1 ≤ p →
                0 ≤ d →
                  ∀ (q : X → OQ7Prescribed.NonnegativeSlabLoss) (θ : X → ℝ),
                    Continuous q →
                      Continuous θ →
                        ∀ (σ : OQ7Prescribed.Direction),
                          Continuous fun x =>
                            OQ7Prescribed.slabAbsorberAmplitude k A (OQ7Prescribed.dielectricSlab p (↑(q x)) d) (θ x) σ
OQ7Prescribed.slabAmplitudes_feedback : ∀ (k : ℝ) (A W : OQ7.HomogeneousLayer) (θ : ℝ),
  OQ7Prescribed.slabFeedback k A W θ ≠ 0 →
    ∀ (σ : OQ7Prescribed.Direction),
      OQ7Prescribed.slabAbsorberAmplitude k A W θ σ =
          ↑(Real.cos θ) *
            (OQ7Prescribed.dielectricSlabReflection k W.p W.q W.width * OQ7Prescribed.slabPlateLeftAmplitude k A W θ σ +
              (OQ7Prescribed.dielectricSlabTransmission k W.p W.q W.width -
                  OQ7Prescribed.apertureOscillation k W.width) *
                OQ7Prescribed.slabPlateRightAmplitude k A W σ) ∧
        OQ7Prescribed.slabPlateLeftAmplitude k A W θ σ =
          OQ7Prescribed.slabLeftAuxiliaryIncident k A σ +
            ↑(Real.cos θ) * OQ7Prescribed.dielectricSlabReflection k A.p A.q A.width *
              OQ7Prescribed.slabAbsorberAmplitude k A W θ σ
OQ7Prescribed.slabApertureDifference_coe : ∀ (k : ℝ) (hk : 0 < k) (w : ℂ → ℂ)
  (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume) (A M r L : ℝ) (hAM : 0 ≤ A + M) (hM : 0 ≤ M) (hL : 0 ≤ L),
  r + L ≤ A + M →
    ∀ (hA : tsupport w ⊆ Metric.closedBall 0 A) (u v : ℂ) (q : ↥(OQ7Prescribed.HeightSupportedL2 M)),
      ↑↑((OQ7Prescribed.slabApertureDifference k hk w hw A M r L hAM hM hL hA u v) q) =ᵐ[MeasureTheory.volume]
        (OQ7Prescribed.slabObservationRegion r L).indicator fun x =>
          OQ7Prescribed.axisCoupling (OQ7Prescribed.slabPosition v 0)
              (OQ7Prescribed.electricVolumeField k (OQ7Prescribed.slabLiftPolarization w hw A M hAM hA u q) x) -
            OQ7Prescribed.planarSlabTransverse k w (↑↑↑q) (OQ7Prescribed.slabHorizontalCoordinate x) (x.ofLp 2) u v
OQ7Prescribed.slabApertureDifference_smooth_coe : ∀ (k : ℝ) (hk : 0 < k) (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w)
  (hwc : HasCompactSupport w) (A M r L : ℝ) (hAM : 0 ≤ A + M) (hM : 0 ≤ M) (hL : 0 ≤ L),
  r + L ≤ A + M →
    ∀ (hA : tsupport w ⊆ Metric.closedBall 0 A) (u v : ℂ) (f : ℝ → ℂ) (hf : ContDiff ℝ (↑⊤) f)
      (hc : HasCompactSupport f) (hs : tsupport f ⊆ Metric.closedBall 0 M) (p : OQ7Prescribed.CompactPolarization),
      (p.current = fun x =>
          OQ7Prescribed.slabSeparatedFunction w f x • OQ7Prescribed.complexify (OQ7Prescribed.slabPosition u 0)) →
        ↑↑((OQ7Prescribed.slabApertureDifference k hk w ⋯ A M r L hAM hM hL hA u v)
                (OQ7Prescribed.heightSmoothElement M f hf hc hs)) =ᵐ[MeasureTheory.volume]
          (OQ7Prescribed.slabObservationRegion r L).indicator fun x =>
            OQ7Prescribed.axisCoupling (OQ7Prescribed.slabPosition v 0) (OQ7Prescribed.electricVolumeField k p x) -
              OQ7Prescribed.planarSlabTransverse k w f (OQ7Prescribed.slabHorizontalCoordinate x) (x.ofLp 2) u v
OQ7Prescribed.slabApertureDifference_smooth_norm_sq : ∀ (k : ℝ) (hk : 0 < k) (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w)
  (hwc : HasCompactSupport w) (A M r L : ℝ) (hAM : 0 ≤ A + M) (hM : 0 ≤ M) (hL : 0 ≤ L),
  r + L ≤ A + M →
    ∀ (hA : tsupport w ⊆ Metric.closedBall 0 A) (u v : ℂ) (f : ℝ → ℂ) (hf : ContDiff ℝ (↑⊤) f)
      (hc : HasCompactSupport f) (hs : tsupport f ⊆ Metric.closedBall 0 M) (p : OQ7Prescribed.CompactPolarization),
      (p.current = fun x =>
          OQ7Prescribed.slabSeparatedFunction w f x • OQ7Prescribed.complexify (OQ7Prescribed.slabPosition u 0)) →
        ‖(OQ7Prescribed.slabApertureDifference k hk w ⋯ A M r L hAM hM hL hA u v)
                (OQ7Prescribed.heightSmoothElement M f hf hc hs)‖ ^
            2 =
          ∫ (y : ℂ × ℝ) in OQ7Prescribed.slabProductRegion r L,
            ‖OQ7Prescribed.slabPhysicalProjectionError k p w f u v y‖ ^ 2
OQ7Prescribed.slabAuxiliaryIncident_phase : ∀ (k : ℝ) (A W : OQ7.HomogeneousLayer) (σ : OQ7Prescribed.Direction)
  (z : ℝ),
  OQ7Prescribed.slabLeftAuxiliaryIncident k A σ * OQ7Prescribed.apertureOscillation k (z - A.width) +
      OQ7Prescribed.slabPlateRightAmplitude k A W σ * OQ7Prescribed.apertureOscillation k (A.width + W.width - z) =
    OQ7Prescribed.planarIncidentPhase k σ z
OQ7Prescribed.slabAxisLift_coe : ∀ (w : ℂ → ℂ) (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume) (u : ℂ)
  (q : ↥OQ7Prescribed.HeightL2),
  ↑↑((OQ7Prescribed.slabAxisLift w hw u) q) =ᵐ[MeasureTheory.volume] fun x =>
    OQ7Prescribed.slabSeparatedFunction w (↑↑q) x • OQ7Prescribed.complexify (OQ7Prescribed.slabPosition u 0)
OQ7Prescribed.slabAxisLift_norm_le : ∀ (w : ℂ → ℂ) (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume) (u : ℂ)
  (q : ↥OQ7Prescribed.HeightL2),
  ‖(OQ7Prescribed.slabAxisLift w hw u) q‖ ≤
    ‖OQ7Prescribed.axisEmbedding (OQ7Prescribed.slabPosition u 0)‖ * ‖MeasureTheory.MemLp.toLp w hw‖ * ‖q‖
OQ7Prescribed.slabCoordinateEquiv_apply : ∀ (p : ℂ × ℝ),
  OQ7Prescribed.slabCoordinateEquiv p = OQ7Prescribed.slabPosition p.1 p.2
OQ7Prescribed.slabCoordinateEquiv_measurePreserving : MeasureTheory.MeasurePreserving
  (⇑OQ7Prescribed.slabCoordinateEquiv) MeasureTheory.volume MeasureTheory.volume
OQ7Prescribed.slabCoordinateEquiv_symm_apply : ∀ (x : OQ7Prescribed.Position),
  OQ7Prescribed.slabCoordinateEquiv.symm x = (OQ7Prescribed.slabHorizontalCoordinate x, x.ofLp 2)
OQ7Prescribed.slabCoupledAbsorber_constitutive : ∀ (k : ℝ) (A W : OQ7.HomogeneousLayer) (θ : ℝ)
  (σ : OQ7Prescribed.Direction) (hpA : 1 ≤ A.p) (z : ℝ),
  (OQ7Prescribed.slabCoupledAbsorber k A W θ σ hpA).current z =
    (OQ7.relativePermittivity A - 1) * (OQ7Prescribed.slabCoupledAbsorber k A W θ σ hpA).electric z
OQ7Prescribed.slabCoupledAbsorber_electric_eq_green : ∀ (k : ℝ),
  0 < k →
    ∀ (A W : OQ7.HomogeneousLayer) (θ : ℝ) (σ : OQ7Prescribed.Direction) (hpA : 1 ≤ A.p) (hpW : 1 ≤ W.p),
      0 ≤ A.q →
        0 ≤ W.q →
          ∀ (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
            ∀ z ∈ Set.Icc 0 A.width,
              (OQ7Prescribed.slabCoupledAbsorber k A W θ σ hpA).electric z =
                k ^ 2 •
                    OQ7Prescribed.scalarPlanarPotential k
                      (↑↑↑(OQ7Prescribed.planarLayerL2Current k 0 A.width (A.width + W.width) ⋯ hdA ⋯
                              (OQ7Prescribed.slabCoupledAbsorber k A W θ σ hpA)))
                      z +
                  ↑(Real.cos θ) *
                    k ^ 2 •
                      OQ7Prescribed.scalarPlanarPotential k
                        (↑↑↑(OQ7Prescribed.planarLayerL2Current k A.width (A.width + W.width) (A.width + W.width) hdA ⋯
                                ⋯ (OQ7Prescribed.slabCoupledPlate k A W θ σ hpW)))
                        z
OQ7Prescribed.slabCoupledAbsorber_Green_exterior_right : ∀ (k : ℝ),
  0 < k →
    ∀ (A W : OQ7.HomogeneousLayer) (θ : ℝ) (σ : OQ7Prescribed.Direction) (hpA : 1 ≤ A.p),
      0 ≤ A.q →
        ∀ (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width) (z : ℝ),
          A.width ≤ z →
            k ^ 2 •
                OQ7Prescribed.scalarPlanarPotential k
                  (↑↑↑(OQ7Prescribed.planarLayerL2Current k 0 A.width (A.width + W.width) ⋯ hdA ⋯
                          (OQ7Prescribed.slabCoupledAbsorber k A W θ σ hpA)))
                  z =
              OQ7Prescribed.slabAbsorberAmplitude k A W θ σ * OQ7Prescribed.dielectricSlabReflection k A.p A.q A.width *
                OQ7Prescribed.apertureOscillation k (z - A.width)
OQ7Prescribed.slabCoupledAbsorber_Green_interior : ∀ (k : ℝ),
  0 < k →
    ∀ (A W : OQ7.HomogeneousLayer) (θ : ℝ) (σ : OQ7Prescribed.Direction) (hpA : 1 ≤ A.p),
      0 ≤ A.q →
        ∀ (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
          ∀ z ∈ Set.Icc 0 A.width,
            k ^ 2 •
                OQ7Prescribed.scalarPlanarPotential k
                  (↑↑↑(OQ7Prescribed.planarLayerL2Current k 0 A.width (A.width + W.width) ⋯ hdA ⋯
                          (OQ7Prescribed.slabCoupledAbsorber k A W θ σ hpA)))
                  z =
              (OQ7Prescribed.slabCoupledAbsorber k A W θ σ hpA).electric z -
                OQ7Prescribed.slabAbsorberAmplitude k A W θ σ * OQ7Prescribed.apertureOscillation k (A.width - z)
