def OQ7Prescribed.Theorem11Statement : Prop :=
∀ (k P Q target : ℝ),
  0 < k →
    1 < P →
      0 < Q →
        0 < target →
          ∀ (ε : ℝ),
            0 < ε →
              ε < 1 →
                ∃ B,
                  B.admissible P Q ∧
                    ∃ sp sm,
                      OQ7Prescribed.extinction k B OQ7Prescribed.Direction.plus sp.electric = target ∧
                        OQ7Prescribed.extinction k B OQ7Prescribed.Direction.minus sm.electric = target ∧
                          1 - ε < OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric ∧
                            OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric < 1
'OQ7Prescribed.Theorem11Statement' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.activeInjection_coe : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.activeInjection B u v) q) =ᵐ[MeasureTheory.volume] fun x =>
    if x.ofLp 2 < B.absorberThickness then ↑↑↑q x • OQ7Prescribed.complexify u else ↑↑↑q x • OQ7Prescribed.complexify v
OQ7Prescribed.activeInjection_inner : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)) (p : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  inner ℂ ((OQ7Prescribed.activeInjection B u v) q) p = inner ℂ q ((OQ7Prescribed.activeProjection B u v) p)
OQ7Prescribed.activeInjection_norm : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position),
  ‖u‖ ^ 2 = 1 →
    ‖v‖ ^ 2 = 1 → ∀ (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)), ‖(OQ7Prescribed.activeInjection B u v) q‖ = ‖q‖
OQ7Prescribed.activeInverseMaterial_coe : ∀ (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.activeInverseMaterial B α β) q) =ᵐ[MeasureTheory.volume] fun x =>
    if x.ofLp 2 < B.absorberThickness then α⁻¹ * ↑↑↑q x else β⁻¹ * ↑↑↑q x
OQ7Prescribed.activeInverseMaterial_loss_integral : ∀ (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  -(inner ℂ q ((OQ7Prescribed.activeInverseMaterial B α β) q)).im =
    ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.activeLossWeight B α β x * ‖↑↑↑q x‖ ^ 2
OQ7Prescribed.activeInverseMaterial_negative_imaginary_bound : ∀ (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  OQ7Prescribed.activeMaterialCoercivity α β * ‖q‖ ^ 2 ≤ -(inner ℂ q ((OQ7Prescribed.activeInverseMaterial B α β) q)).im
OQ7Prescribed.activeMaterialCoercivity_pos : ∀ (α β : ℂ),
  0 < α.im → 0 < β.im → 0 < OQ7Prescribed.activeMaterialCoercivity α β
OQ7Prescribed.activeMaterialEquiv_apply : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (u v : OQ7Prescribed.Position) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  (OQ7Prescribed.activeMaterialEquiv k hk B u v α β hα hβ) q = (OQ7Prescribed.activeMaterialOperator k B u v α β) q
OQ7Prescribed.activeMaterialEquiv_inverse_norm_le : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (u v : OQ7Prescribed.Position) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  ‖↑(OQ7Prescribed.activeMaterialEquiv k hk B u v α β hα hβ).symm‖ ≤
    1 / min (α.im / Complex.normSq α) (β.im / Complex.normSq β)
OQ7Prescribed.activeMaterialOperator_imaginary_coercive : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position) (α β : ℂ)
      (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
      OQ7Prescribed.activeMaterialCoercivity α β * ‖q‖ ^ 2 ≤
        (inner ℂ q ((OQ7Prescribed.activeMaterialOperator k B u v α β) q)).im
OQ7Prescribed.activePhysicalAbsorption_work : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (u v : OQ7Prescribed.Position) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.absorption k (OQ7Prescribed.rankOneBody B u v α β)
      (OQ7Prescribed.volumeTotalElectric k σ
        (OQ7Prescribed.bodyCurrentPolarization B
          ((OQ7Prescribed.activeInjection B u v) (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ)))) =
    k *
      -(inner ℂ (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ)
            ((OQ7Prescribed.activeInverseMaterial B α β)
              (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ))).im
OQ7Prescribed.activePhysicalExtinction_work : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (u v : OQ7Prescribed.Position) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.extinction k (OQ7Prescribed.rankOneBody B u v α β) σ
      (OQ7Prescribed.volumeTotalElectric k σ
        (OQ7Prescribed.bodyCurrentPolarization B
          ((OQ7Prescribed.activeInjection B u v) (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ)))) =
    k *
      (inner ℂ ((OQ7Prescribed.activeProjection B u v) (OQ7Prescribed.bodyIncidentCurrent k B σ))
          (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ)).im
OQ7Prescribed.activePhysicalSolution_equation : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (u v : OQ7Prescribed.Position) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  (OQ7Prescribed.activeMaterialOperator k B u v α β) (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ) =
    -(OQ7Prescribed.activeProjection B u v) (OQ7Prescribed.bodyIncidentCurrent k B σ)
OQ7Prescribed.activePhysicalSolution_physicalVolumeEquation : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (u v : OQ7Prescribed.Position) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.MaterialVolumeEquation k (OQ7Prescribed.rankOneBody B u v α β) σ
    (OQ7Prescribed.bodyCurrentPolarization B
      ((OQ7Prescribed.activeInjection B u v) (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ)))
OQ7Prescribed.activePhysicalSolution_projected_total : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (u v : OQ7Prescribed.Position) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  (OQ7Prescribed.activeProjection B u v)
      (OQ7Prescribed.bodyIncidentCurrent k B σ +
        (OQ7Prescribed.bodyOutgoingOperator k B)
          ((OQ7Prescribed.activeInjection B u v) (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ))) =
    (OQ7Prescribed.activeInverseMaterial B α β) (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ)
OQ7Prescribed.activePhysicalSolution_sine_factorization : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.activePhysicalSolution k hk B σ (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β hα hβ =
    ↑(Real.sin θ) • OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ
OQ7Prescribed.activeProjectedIncident_sine_factorization : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ),
  (OQ7Prescribed.activeProjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
      (OQ7Prescribed.bodyIncidentCurrent k B σ) =
    ↑(Real.sin θ) • OQ7Prescribed.normalizedIncidentDrive k B σ
OQ7Prescribed.activeProjectedOutgoing_im_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position) (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
      0 ≤
        (inner ℂ q
            ((OQ7Prescribed.activeProjection B u v)
              ((OQ7Prescribed.bodyOutgoingOperator k B) ((OQ7Prescribed.activeInjection B u v) q)))).im
OQ7Prescribed.activeProjection_coe : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position)
  (p : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.activeProjection B u v) p) =ᵐ[MeasureTheory.volume] fun x =>
    if x.ofLp 2 < B.absorberThickness then OQ7Prescribed.axisCoupling u (↑↑↑p x)
    else OQ7Prescribed.axisCoupling v (↑↑↑p x)
OQ7Prescribed.activeProjection_injection : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position),
  ‖u‖ ^ 2 = 1 →
    ‖v‖ ^ 2 = 1 →
      ∀ (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
        (OQ7Prescribed.activeProjection B u v) ((OQ7Prescribed.activeInjection B u v) q) = q
OQ7Prescribed.activeProjection_inner : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)) (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  inner ℂ f ((OQ7Prescribed.activeInjection B u v) q) = inner ℂ ((OQ7Prescribed.activeProjection B u v) f) q
OQ7Prescribed.activeScalarLoss_pos : ∀ (α : ℂ), 0 < α.im → 0 < OQ7Prescribed.activeScalarLoss α
OQ7Prescribed.admissible_susceptibility_bounded_inverse : ∀ (P Q : ℝ) (T : OQ7Prescribed.Tensor),
  OQ7Prescribed.MaterialAdmissible P Q T →
    ∃ c,
      0 < c ∧
        ∃ e,
          (∀ (v : OQ7Prescribed.Vector), e v = (OQ7Prescribed.tensorMap (T - 1)) v) ∧
            ‖↑e.symm‖ ≤ 1 / c ∧
              ∀ (v : OQ7Prescribed.Vector),
                c / (‖OQ7Prescribed.tensorMap (T - 1)‖ + 1) ^ 2 * ‖v‖ ^ 2 ≤ -(inner ℂ v (e.symm v)).im
OQ7Prescribed.admissible_susceptibility_imaginary_coercive : ∀ (P Q : ℝ) (T : OQ7Prescribed.Tensor),
  OQ7Prescribed.MaterialAdmissible P Q T →
    ∃ c, 0 < c ∧ ∀ (v : OQ7Prescribed.Vector), c * ‖v‖ ^ 2 ≤ (inner ℂ v ((OQ7Prescribed.tensorMap (T - 1)) v)).im
OQ7Prescribed.axisCoupling_bound : ∀ (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  ‖u‖ ^ 2 = 1 → Complex.normSq (OQ7Prescribed.axisCoupling u v) ≤ OQ7Prescribed.squareNorm v
OQ7Prescribed.axisCoupling_eq_inner : ∀ (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.axisCoupling u v = inner ℂ (OQ7Prescribed.complexify u) v
OQ7Prescribed.axisEmbedding_adjoint_apply : ∀ (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (ContinuousLinearMap.adjoint (OQ7Prescribed.axisEmbedding u)) v = OQ7Prescribed.axisCoupling u v
OQ7Prescribed.axisEmbedding_adjoint_embedding : ∀ (u : OQ7Prescribed.Position),
  ‖u‖ ^ 2 = 1 →
    ∀ (z : ℂ), (ContinuousLinearMap.adjoint (OQ7Prescribed.axisEmbedding u)) ((OQ7Prescribed.axisEmbedding u) z) = z
OQ7Prescribed.axisEmbedding_apply : ∀ (u : OQ7Prescribed.Position) (z : ℂ),
  (OQ7Prescribed.axisEmbedding u) z = z • OQ7Prescribed.complexify u
OQ7Prescribed.bilinear_add_left : ∀ (u v w : OQ7Prescribed.Vector),
  OQ7Prescribed.bilinear (u + v) w = OQ7Prescribed.bilinear u w + OQ7Prescribed.bilinear v w
OQ7Prescribed.bilinear_add_right : ∀ (u v w : OQ7Prescribed.Vector),
  OQ7Prescribed.bilinear u (v + w) = OQ7Prescribed.bilinear u v + OQ7Prescribed.bilinear u w
OQ7Prescribed.bilinear_complex_smul_right : ∀ (u v : OQ7Prescribed.Vector) (z : ℂ),
  OQ7Prescribed.bilinear u (z • v) = z * OQ7Prescribed.bilinear u v
OQ7Prescribed.bilinear_complexify_eq_inner : ∀ (x : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.bilinear (OQ7Prescribed.complexify x) v = inner ℂ (OQ7Prescribed.complexify x) v
OQ7Prescribed.bilinear_complexify_self : ∀ (x : OQ7Prescribed.Position),
  OQ7Prescribed.bilinear (OQ7Prescribed.complexify x) (OQ7Prescribed.complexify x) = ↑(‖x‖ ^ 2)
OQ7Prescribed.bilinear_cross_conjugate : ∀ (H E : OQ7Prescribed.Vector) (v : OQ7Prescribed.Position),
