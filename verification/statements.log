      (OQ7Prescribed.normalizedExtinction k hk B σ θ α β hα hβ -
        OQ7Prescribed.normalizedAbsorption k hk B σ θ α β hα hβ)
OQ7Prescribed.physicalScatteringState_exists : ∀ (k : ℝ),
  0 < k →
    ∀ (P Q : ℝ) (B : OQ7Prescribed.TwoLayerBody),
      B.admissible P Q → ∀ (σ : OQ7Prescribed.Direction), Nonempty (OQ7Prescribed.ScatteringState k B σ)
OQ7Prescribed.physicalSlab_uniform_L2_aperture_residual : ∀ (k : ℝ) (hk : 0 < k) (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w)
  (hwc : HasCompactSupport w) (A X L : ℝ) (hA0 : 0 ≤ A) (hX : 0 ≤ X) (hL : 0 ≤ L)
  (hA : tsupport w ⊆ Metric.closedBall 0 A),
  ∃ K,
    0 < K ∧
      ∀ (R : ℝ) (hR : 1 ≤ R) (u v : ℂ),
        ‖u‖ ≤ 1 →
          ‖v‖ ≤ 1 →
            ∀ (q : ↥(OQ7Prescribed.HeightSupportedL2 L)),
              ‖(OQ7Prescribed.scaledSlabApertureDifference k hk w hw hwc A X L hA0 hX hL hA R hR u v)
                    (OQ7Prescribed.heightSupportEnlargement L q)‖ ≤
                K * ‖q‖
OQ7Prescribed.physicalSourceFields_first_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.electricVolumeField k p)) =
    (Complex.I * ↑k) • OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.magneticVolumeField k p)
OQ7Prescribed.physicalSourceFields_first_weakCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.electricVolumeField k p) fun x =>
    (Complex.I * ↑k) • OQ7Prescribed.magneticVolumeField k p x
OQ7Prescribed.physicalSourceFields_second_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.magneticVolumeField k p)) =
    (-Complex.I * ↑k) •
      (OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.electricVolumeField k p) +
        OQ7Prescribed.polarizationCurrentComponentDistribution p)
OQ7Prescribed.physicalSourceFields_second_weakCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.magneticVolumeField k p) fun x =>
    (-Complex.I * ↑k) • (OQ7Prescribed.electricVolumeField k p x + p.current x)
OQ7Prescribed.physicalVolume_absorption_le_extinction : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
      OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.bodyCurrentPolarization B f) →
        OQ7Prescribed.absorption k B
            (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) ≤
          OQ7Prescribed.extinction k B σ
            (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f))
OQ7Prescribed.physicalVolume_energy_balance : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.bodyCurrentPolarization B f) →
    OQ7Prescribed.extinction k B σ (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) =
      OQ7Prescribed.absorption k B (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) +
        OQ7Prescribed.scattering k B (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f))
OQ7Prescribed.physicalVolume_extinction_reciprocity : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody),
      Matrix.transpose B.absorberPermittivity = B.absorberPermittivity →
        Matrix.transpose B.platePermittivity = B.platePermittivity →
          ∀ (p q : OQ7Prescribed.CompactPolarization),
            OQ7Prescribed.MaterialVolumeEquation k B OQ7Prescribed.Direction.plus p →
              OQ7Prescribed.MaterialVolumeEquation k B OQ7Prescribed.Direction.minus q →
                OQ7Prescribed.extinction k B OQ7Prescribed.Direction.plus
                    (OQ7Prescribed.volumeTotalElectric k OQ7Prescribed.Direction.plus p) =
                  OQ7Prescribed.extinction k B OQ7Prescribed.Direction.minus
                    (OQ7Prescribed.volumeTotalElectric k OQ7Prescribed.Direction.minus q)
OQ7Prescribed.physicalVolume_Haar_energy_balance : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.bodyCurrentPolarization B f) →
    OQ7Prescribed.extinction k B σ (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) =
      OQ7Prescribed.absorption k B (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) +
        ∫ (n : ↑OQ7Prescribed.UnitSphere),
          ‖OQ7Prescribed.currentFarField k B
                (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) ↑n‖ ^
            2 ∂OQ7Prescribed.sphereArea
OQ7Prescribed.physicalVolume_scattering_eq_Haar : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.bodyCurrentPolarization B f) →
    OQ7Prescribed.scattering k B (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) =
      ∫ (n : ↑OQ7Prescribed.UnitSphere),
        ‖OQ7Prescribed.currentFarField k B
              (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) ↑n‖ ^
          2 ∂OQ7Prescribed.sphereArea
OQ7Prescribed.physicalVolume_scattering_nonneg : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.bodyCurrentPolarization B f) →
    0 ≤ OQ7Prescribed.scattering k B (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f))
OQ7Prescribed.physicalVolume_work_balance : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.bodyCurrentPolarization B f) →
    OQ7Prescribed.extinction k B σ (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) =
      OQ7Prescribed.absorption k B (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) +
        k * (inner ℂ f ((OQ7Prescribed.bodyOutgoingOperator k B) f)).im
OQ7Prescribed.planarActiveAxisMaps_norm_le : ∀ (L h θ : ℝ) (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  ‖(OQ7Prescribed.planarLayerAxisMap L h 1 (Real.cos θ)) q‖ ≤ ‖q‖ ∧
    ‖(OQ7Prescribed.planarLayerAxisMap L h 0 (Real.sin θ)) q‖ ≤ ‖q‖
OQ7Prescribed.planarActiveAxisMaps_vector_current : ∀ (L h θ : ℝ) (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  ∀ᵐ (z : ℝ),
    ↑↑↑((OQ7Prescribed.planarLayerAxisMap L h 1 (Real.cos θ)) q) z • OQ7Prescribed.basisC 0 +
        ↑↑↑((OQ7Prescribed.planarLayerAxisMap L h 0 (Real.sin θ)) q) z • OQ7Prescribed.basisC 1 =
      ↑↑↑q z • OQ7Prescribed.complexify (if z < h then OQ7Prescribed.basisR 0 else OQ7Prescribed.rotatedAxis θ)
OQ7Prescribed.planarActiveMaterialEquiv_inverse_norm_le : ∀ (k : ℝ) (hk : 0 < k) (L : ℝ) (hL : 0 ≤ L) (h θ : ℝ)
  (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  ‖↑(OQ7Prescribed.planarActiveMaterialEquiv k hk L hL h θ α β hα hβ).symm‖ ≤
    1 / min (α.im / Complex.normSq α) (β.im / Complex.normSq β)
OQ7Prescribed.planarActiveMaterialOperator_imaginary_coercive : ∀ (k : ℝ) (hk : 0 < k) (L : ℝ) (hL : 0 ≤ L) (h θ : ℝ)
  (α β : ℂ) (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  OQ7Prescribed.activeMaterialCoercivity α β * ‖q‖ ^ 2 ≤
    (inner ℂ q ((OQ7Prescribed.planarActiveMaterialOperator k hk L hL h θ α β) q)).im
OQ7Prescribed.planarActiveOutgoing_coe : ∀ (k : ℝ) (hk : 0 < k) (L : ℝ) (hL : 0 ≤ L) (h θ : ℝ)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  ↑↑↑((OQ7Prescribed.planarActiveOutgoing k hk L hL h θ) q) =ᵐ[MeasureTheory.volume]
    (Set.Icc 0 L).indicator fun z =>
      if z < h then
        k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑((OQ7Prescribed.planarLayerAxisMap L h 1 (Real.cos θ)) q)) z
      else
        k ^ 2 •
          (↑(Real.cos θ) *
              OQ7Prescribed.scalarPlanarPotential k (↑↑↑((OQ7Prescribed.planarLayerAxisMap L h 1 (Real.cos θ)) q)) z +
            ↑(Real.sin θ) *
              OQ7Prescribed.scalarPlanarPotential k (↑↑↑((OQ7Prescribed.planarLayerAxisMap L h 0 (Real.sin θ)) q)) z)
OQ7Prescribed.planarActiveOutgoing_im_nonneg : ∀ (k : ℝ) (hk : 0 < k) (L : ℝ) (hL : 0 ≤ L) (h θ : ℝ)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)), 0 ≤ (inner ℂ q ((OQ7Prescribed.planarActiveOutgoing k hk L hL h θ) q)).im
OQ7Prescribed.planarActiveOutgoing_rotation_continuous : ∀ (k : ℝ) (hk : 0 < k) (L : ℝ) (hL : 0 ≤ L) (h : ℝ),
  Continuous fun θ => OQ7Prescribed.planarActiveOutgoing k hk L hL h θ
OQ7Prescribed.planarActiveOutgoing_two_layer_current_coe : ∀ (k : ℝ) (hk : 0 < k) (h L : ℝ) (hh : 0 ≤ h) (hL : h ≤ L)
  (θ : ℝ) (F : OQ7Prescribed.PlanarLayerField k 0 h) (G : OQ7Prescribed.PlanarLayerField k h L),
  ↑↑↑((OQ7Prescribed.planarActiveOutgoing k hk L ⋯ h θ)
            (OQ7Prescribed.planarLayerL2Current k 0 h L ⋯ hh hL F +
              OQ7Prescribed.planarLayerL2Current k h L L hh hL ⋯ G)) =ᵐ[MeasureTheory.volume]
    (Set.Icc 0 L).indicator fun z =>
      if z < h then
        k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑(OQ7Prescribed.planarLayerL2Current k 0 h L ⋯ hh hL F)) z +
          ↑(Real.cos θ) *
            k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑(OQ7Prescribed.planarLayerL2Current k h L L hh hL ⋯ G)) z
      else
        ↑(Real.cos θ) *
            k ^ 2 •
              OQ7Prescribed.scalarPlanarPotential k (↑↑↑(OQ7Prescribed.planarLayerL2Current k 0 h L ⋯ hh hL F)) z +
          k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑(OQ7Prescribed.planarLayerL2Current k h L L hh hL ⋯ G)) z
OQ7Prescribed.planarActiveOutgoing_two_layer_current_eq : ∀ (k : ℝ) (hk : 0 < k) (h L : ℝ) (hh : 0 ≤ h) (hL : h ≤ L)
  (θ : ℝ) (F : OQ7Prescribed.PlanarLayerField k 0 h) (G : OQ7Prescribed.PlanarLayerField k h L),
  (OQ7Prescribed.planarActiveOutgoing k hk L ⋯ h θ)
      (OQ7Prescribed.planarLayerL2Current k 0 h L ⋯ hh hL F + OQ7Prescribed.planarLayerL2Current k h L L hh hL ⋯ G) =
    (OQ7Prescribed.planarLayerAxisMap L h 1 (Real.cos θ))
        ((OQ7Prescribed.planarScalarOutgoing k hk L ⋯) (OQ7Prescribed.planarLayerL2Current k 0 h L ⋯ hh hL F)) +
      (OQ7Prescribed.planarLayerAxisMap L h (Real.cos θ) 1)
        ((OQ7Prescribed.planarScalarOutgoing k hk L ⋯) (OQ7Prescribed.planarLayerL2Current k h L L hh hL ⋯ G))
OQ7Prescribed.planarGreen_indicator_integrable : ∀ (k a b z : ℝ) (q : ℝ → ℂ),
  ContinuousOn q (Set.Icc a b) →
    MeasureTheory.Integrable (fun t => OQ7Prescribed.planarScalarGreen k (z - t) * (Set.Ioc a b).indicator q t)
      MeasureTheory.volume
OQ7Prescribed.planarGreen_integral_indicator : ∀ (k a b z : ℝ),
  a ≤ b →
    ∀ (q : ℝ → ℂ),
      ∫ (t : ℝ), OQ7Prescribed.planarScalarGreen k (z - t) * (Set.Ioc a b).indicator q t =
        ∫ (t : ℝ) in a..b, OQ7Prescribed.planarScalarGreen k (z - t) * q t
OQ7Prescribed.planarGreen_interval_exterior_left_representation : ∀ (k a b z : ℝ),
  k ≠ 0 →
    a ≤ b →
      z ≤ a →
        ∀ (E H q : ℝ → ℂ),
          ContinuousOn E (Set.Icc a b) →
            ContinuousOn H (Set.Icc a b) →
              ContinuousOn q (Set.Icc a b) →
                (∀ t ∈ Set.Ioo a b, HasDerivAt E (Complex.I * ↑k * H t) t) →
                  (∀ t ∈ Set.Ioo a b, HasDerivAt H (Complex.I * ↑k * (E t + q t)) t) →
                    ↑k ^ 2 * ∫ (t : ℝ) in a..b, OQ7Prescribed.planarScalarGreen k (z - t) * q t =
                      1 / 2 * OQ7Prescribed.apertureOscillation k (b - z) * (H b - E b) -
                        1 / 2 * OQ7Prescribed.apertureOscillation k (a - z) * (H a - E a)
OQ7Prescribed.planarGreen_interval_exterior_right_representation : ∀ (k a b z : ℝ),
  k ≠ 0 →
    a ≤ b →
      b ≤ z →
        ∀ (E H q : ℝ → ℂ),
          ContinuousOn E (Set.Icc a b) →
            ContinuousOn H (Set.Icc a b) →
              ContinuousOn q (Set.Icc a b) →
                (∀ t ∈ Set.Ioo a b, HasDerivAt E (Complex.I * ↑k * H t) t) →
                  (∀ t ∈ Set.Ioo a b, HasDerivAt H (Complex.I * ↑k * (E t + q t)) t) →
                    ↑k ^ 2 * ∫ (t : ℝ) in a..b, OQ7Prescribed.planarScalarGreen k (z - t) * q t =
                      1 / 2 * OQ7Prescribed.apertureOscillation k (z - b) * (H b + E b) -
                        1 / 2 * OQ7Prescribed.apertureOscillation k (z - a) * (H a + E a)
OQ7Prescribed.planarGreen_interval_interior_representation : ∀ (k a b z : ℝ),
  k ≠ 0 →
    a ≤ z →
      z ≤ b →
        ∀ (E H q : ℝ → ℂ),
          ContinuousOn E (Set.Icc a b) →
            ContinuousOn H (Set.Icc a b) →
              ContinuousOn q (Set.Icc a b) →
                (∀ t ∈ Set.Ioo a b, HasDerivAt E (Complex.I * ↑k * H t) t) →
                  (∀ t ∈ Set.Ioo a b, HasDerivAt H (Complex.I * ↑k * (E t + q t)) t) →
                    ↑k ^ 2 * ∫ (t : ℝ) in a..b, OQ7Prescribed.planarScalarGreen k (z - t) * q t =
                      E z - 1 / 2 * OQ7Prescribed.apertureOscillation k (z - a) * (H a + E a) +
                        1 / 2 * OQ7Prescribed.apertureOscillation k (b - z) * (H b - E b)
OQ7Prescribed.planarGreen_interval_left : ∀ (k a b z : ℝ),
  a ≤ b →
    b ≤ z →
      ∀ (q : ℝ → ℂ),
        ∫ (t : ℝ) in a..b, OQ7Prescribed.planarScalarGreen k (z - t) * q t =
          Complex.I / (2 * ↑k) * OQ7Prescribed.apertureOscillation k z *
            ∫ (t : ℝ) in a..b, OQ7Prescribed.apertureOscillation (-k) t * q t
OQ7Prescribed.planarGreen_interval_right : ∀ (k a b z : ℝ),
  a ≤ b →
    z ≤ a →
      ∀ (q : ℝ → ℂ),
        ∫ (t : ℝ) in a..b, OQ7Prescribed.planarScalarGreen k (z - t) * q t =
          Complex.I / (2 * ↑k) * OQ7Prescribed.apertureOscillation (-k) z *
            ∫ (t : ℝ) in a..b, OQ7Prescribed.apertureOscillation k t * q t
OQ7Prescribed.planarGreen_interval_split : ∀ (k a b z : ℝ),
  a ≤ z →
    z ≤ b →
      ∀ (q : ℝ → ℂ),
        ContinuousOn q (Set.Icc a b) →
          ∫ (t : ℝ) in a..b, OQ7Prescribed.planarScalarGreen k (z - t) * q t =
            Complex.I / (2 * ↑k) *
              ((OQ7Prescribed.apertureOscillation k z *
                  ∫ (t : ℝ) in a..z, OQ7Prescribed.apertureOscillation (-k) t * q t) +
                OQ7Prescribed.apertureOscillation (-k) z *
                  ∫ (t : ℝ) in z..b, OQ7Prescribed.apertureOscillation k t * q t)
OQ7Prescribed.planarHeightEmbedding_norm : ∀ (L : ℝ) (hL : 0 ≤ L) (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  ‖(OQ7Prescribed.planarHeightEmbedding L hL) q‖ = ‖q‖
OQ7Prescribed.planarHeightMap_coe : ∀ (k : ℝ) (hk : 0 < k) (M L : ℝ) (hM : 0 ≤ M) (hL : 0 ≤ L)
  (q : ↥(OQ7Prescribed.HeightSupportedL2 M)),
  ↑↑((OQ7Prescribed.planarHeightMap k hk M L hM hL) q) =ᵐ[MeasureTheory.volume]
    (Set.Icc 0 L).indicator (OQ7Prescribed.scalarPlanarPotential k ↑↑↑q)
OQ7Prescribed.planarHeightRaw_coe : ∀ (k : ℝ) (hk : 0 < k) (M L : ℝ) (q : ↥(OQ7Prescribed.HeightSupportedL2 M)),
  ↑↑(OQ7Prescribed.planarHeightRaw k hk M L q) =ᵐ[MeasureTheory.volume]
    (Set.Icc 0 L).indicator (OQ7Prescribed.scalarPlanarPotential k ↑↑↑q)
OQ7Prescribed.planarHeightRaw_norm_le : ∀ (k : ℝ) (hk : 0 < k) (M L : ℝ),
  0 ≤ M →
    0 ≤ L →
      ∀ (q : ↥(OQ7Prescribed.HeightSupportedL2 M)),
        ‖OQ7Prescribed.planarHeightRaw k hk M L q‖ ≤ √L * (1 / (2 * k)) * √(2 * M) * ‖q‖
OQ7Prescribed.planarIncidentPhase_memLp : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (L : ℝ),
  MeasureTheory.MemLp ((Set.Icc 0 L).indicator (OQ7Prescribed.planarIncidentPhase k σ)) 2 MeasureTheory.volume
OQ7Prescribed.planarIncidentPhase_minus : ∀ (k z : ℝ),
  OQ7Prescribed.planarIncidentPhase k OQ7Prescribed.Direction.minus z = OQ7Prescribed.apertureOscillation (-k) z
OQ7Prescribed.planarIncidentPhase_norm : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (z : ℝ),
  ‖OQ7Prescribed.planarIncidentPhase k σ z‖ = 1
OQ7Prescribed.planarIncidentPhase_physical : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : ℂ) (z : ℝ),
  OQ7Prescribed.planarIncidentPhase k σ z = OQ7Prescribed.planePhase k σ (OQ7Prescribed.slabPosition x z)
OQ7Prescribed.planarIncidentPhase_plus : ∀ (k z : ℝ),
  OQ7Prescribed.planarIncidentPhase k OQ7Prescribed.Direction.plus z = OQ7Prescribed.apertureOscillation k z
OQ7Prescribed.planarIncidentPhase_plus_star : ∀ (k z : ℝ),
  (starRingEnd ℂ) (OQ7Prescribed.planarIncidentPhase k OQ7Prescribed.Direction.plus z) =
    OQ7Prescribed.apertureOscillation (-k) z
OQ7Prescribed.planarIncidentProfile_coe : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (L : ℝ),
  ↑↑↑(OQ7Prescribed.planarIncidentProfile k σ L) =ᵐ[MeasureTheory.volume]
    (Set.Icc 0 L).indicator (OQ7Prescribed.planarIncidentPhase k σ)
OQ7Prescribed.planarInverseMaterial_coe : ∀ (L h : ℝ) (α β : ℂ) (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  ↑↑↑((OQ7Prescribed.planarInverseMaterial L h α β) q) =ᵐ[MeasureTheory.volume] fun z =>
    if z < h then α⁻¹ * ↑↑↑q z else β⁻¹ * ↑↑↑q z
OQ7Prescribed.planarInverseMaterial_negative_imaginary_bound : ∀ (L h : ℝ) (α β : ℂ)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  OQ7Prescribed.activeMaterialCoercivity α β * ‖q‖ ^ 2 ≤
    -(inner ℂ q ((OQ7Prescribed.planarInverseMaterial L h α β) q)).im
OQ7Prescribed.planarLayerAxisMap_adjoint : ∀ (L h a b : ℝ),
  ContinuousLinearMap.adjoint (OQ7Prescribed.planarLayerAxisMap L h a b) = OQ7Prescribed.planarLayerAxisMap L h a b
OQ7Prescribed.planarLayerAxisMap_coe : ∀ (L h a b : ℝ) (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  ↑↑↑((OQ7Prescribed.planarLayerAxisMap L h a b) q) =ᵐ[MeasureTheory.volume] fun z =>
    if z < h then ↑a * ↑↑↑q z else ↑b * ↑↑↑q z
OQ7Prescribed.planarLayerAxisMap_cos_sin_combination : ∀ (L h θ : ℝ) (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  (OQ7Prescribed.planarLayerAxisMap L h (Real.cos θ) 1) q =
    ↑(Real.cos θ) • (OQ7Prescribed.planarLayerAxisMap L h 1 (Real.cos θ)) q +
      ↑(Real.sin θ) • (OQ7Prescribed.planarLayerAxisMap L h 0 (Real.sin θ)) q
OQ7Prescribed.planarLayerAxisMap_first_current : ∀ (k h L : ℝ) (hh : 0 ≤ h) (hL : h ≤ L)
  (F : OQ7Prescribed.PlanarLayerField k 0 h) (a b : ℝ),
  (OQ7Prescribed.planarLayerAxisMap L h a b) (OQ7Prescribed.planarLayerL2Current k 0 h L ⋯ hh hL F) =
    ↑a • OQ7Prescribed.planarLayerL2Current k 0 h L ⋯ hh hL F
OQ7Prescribed.planarLayerAxisMap_norm_le : ∀ (L h a b : ℝ),
  |a| ≤ 1 → |b| ≤ 1 → ∀ (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)), ‖(OQ7Prescribed.planarLayerAxisMap L h a b) q‖ ≤ ‖q‖
OQ7Prescribed.planarLayerAxisMap_parameter_continuous : ∀ (L h : ℝ),
  Continuous fun p => OQ7Prescribed.planarLayerAxisMap L h p.1 p.2
OQ7Prescribed.planarLayerAxisMap_second_current : ∀ (k h L : ℝ) (hh : 0 ≤ h) (hL : h ≤ L)
  (F : OQ7Prescribed.PlanarLayerField k h L) (a b : ℝ),
  (OQ7Prescribed.planarLayerAxisMap L h a b) (OQ7Prescribed.planarLayerL2Current k h L L hh hL ⋯ F) =
    ↑b • OQ7Prescribed.planarLayerL2Current k h L L hh hL ⋯ F
OQ7Prescribed.planarLayerL2Current_add : ∀ (k a b L : ℝ) (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ L)
  (F G : OQ7Prescribed.PlanarLayerField k a b),
  OQ7Prescribed.planarLayerL2Current k a b L ha hab hb (F.add G) =
    OQ7Prescribed.planarLayerL2Current k a b L ha hab hb F + OQ7Prescribed.planarLayerL2Current k a b L ha hab hb G
OQ7Prescribed.planarLayerL2Current_coe : ∀ (k a b L : ℝ) (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ L)
  (F : OQ7Prescribed.PlanarLayerField k a b),
  ↑↑↑(OQ7Prescribed.planarLayerL2Current k a b L ha hab hb F) =ᵐ[MeasureTheory.volume] (Set.Ioc a b).indicator F.current
OQ7Prescribed.planarLayerL2Current_const_mul : ∀ (k a b L : ℝ) (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ L)
  (F : OQ7Prescribed.PlanarLayerField k a b) (c : ℂ),
  OQ7Prescribed.planarLayerL2Current k a b L ha hab hb (OQ7Prescribed.PlanarLayerField.const_mul c F) =
    c • OQ7Prescribed.planarLayerL2Current k a b L ha hab hb F
OQ7Prescribed.planarNormalizedAbsorption_continuous : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction) (L : ℝ)
  (hL : 0 ≤ L) (h : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  Continuous fun θ => OQ7Prescribed.planarNormalizedAbsorption k hk σ L hL h θ α β hα hβ
OQ7Prescribed.planarNormalizedAbsorption_eq_slabIntegral : ∀ (k : ℝ) (hk : 0 < k) (A W : OQ7.HomogeneousLayer) (θ : ℝ)
  (σ : OQ7Prescribed.Direction) (hpA : 1 ≤ A.p) (hpW : 1 ≤ W.p) (hqA : 0 < A.q) (hqW : 0 < W.q) (hdA : 0 ≤ A.width)
  (hdW : 0 ≤ W.width),
  OQ7Prescribed.planarNormalizedAbsorption k hk σ (A.width + W.width) ⋯ A.width θ (OQ7.relativePermittivity A - 1)
      (OQ7.relativePermittivity W - 1) ⋯ ⋯ =
    OQ7Prescribed.slabIntegralAbsorption k A W θ σ hpA hpW
OQ7Prescribed.planarNormalizedAbsorption_le_extinction : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction) (L : ℝ)
  (hL : 0 ≤ L) (h θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.planarNormalizedAbsorption k hk σ L hL h θ α β hα hβ ≤
    OQ7Prescribed.planarNormalizedExtinction k hk σ L hL h θ α β hα hβ
OQ7Prescribed.planarNormalizedAbsorption_pos : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction) (L : ℝ) (hL : 0 ≤ L)
  (h θ : ℝ),
  0 ≤ h →
    h < L →
      ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
        0 < OQ7Prescribed.planarNormalizedAbsorption k hk σ L hL h θ α β hα hβ
OQ7Prescribed.planarNormalizedAsymmetry_continuous : ∀ (k : ℝ) (hk : 0 < k) (L : ℝ) (hL : 0 ≤ L) (h : ℝ),
  0 ≤ h →
    h < L →
      ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
        Continuous fun θ => OQ7Prescribed.planarNormalizedAsymmetry k hk L hL h θ α β hα hβ
OQ7Prescribed.planarNormalizedAsymmetry_eq_slabFormula : ∀ (k : ℝ) (hk : 0 < k) (A W : OQ7.HomogeneousLayer) (θ : ℝ)
  (hpA : 1 ≤ A.p) (hpW : 1 ≤ W.p) (hqA : 0 < A.q) (hqW : 0 < W.q) (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
  OQ7Prescribed.planarNormalizedAsymmetry k hk (A.width + W.width) ⋯ A.width θ (OQ7.relativePermittivity A - 1)
      (OQ7.relativePermittivity W - 1) ⋯ ⋯ =
    OQ7Prescribed.slabFormulaAsymmetry k A W θ hpA hpW
OQ7Prescribed.planarNormalizedAsymmetry_lt_one : ∀ (k : ℝ) (hk : 0 < k) (h d : ℝ) (hh : 0 < h) (hd : 0 < d) (θ : ℝ)
  (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im), OQ7Prescribed.planarNormalizedAsymmetry k hk (h + d) ⋯ h θ α β hα hβ < 1
OQ7Prescribed.planarNormalizedDrive_coe : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (L h : ℝ),
  ↑↑↑(OQ7Prescribed.planarNormalizedDrive k σ L h) =ᵐ[MeasureTheory.volume]
    (Set.Icc 0 L).indicator fun z => if z < h then 0 else OQ7Prescribed.planarIncidentPhase k σ z
OQ7Prescribed.planarNormalizedDrive_ne_zero : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (L h : ℝ),
  0 ≤ h → h < L → OQ7Prescribed.planarNormalizedDrive k σ L h ≠ 0
OQ7Prescribed.planarNormalizedDrive_norm : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (L h : ℝ),
  0 ≤ h → h ≤ L → ‖OQ7Prescribed.planarNormalizedDrive k σ L h‖ = √(L - h)
OQ7Prescribed.planarNormalizedDrive_norm_sq : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (L h : ℝ),
  0 ≤ h → h ≤ L → ‖OQ7Prescribed.planarNormalizedDrive k σ L h‖ ^ 2 = L - h
OQ7Prescribed.planarNormalizedExtinction_compact_lower_bound : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction)
  (L : ℝ) (hL : 0 ≤ L) (h : ℝ),
  0 ≤ h →
    h < L →
      ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) (s : Set ℝ),
        IsCompact s → ∃ c, 0 < c ∧ ∀ θ ∈ s, c ≤ OQ7Prescribed.planarNormalizedExtinction k hk σ L hL h θ α β hα hβ
OQ7Prescribed.planarNormalizedExtinction_continuous : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction) (L : ℝ)
  (hL : 0 ≤ L) (h : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  Continuous fun θ => OQ7Prescribed.planarNormalizedExtinction k hk σ L hL h θ α β hα hβ
OQ7Prescribed.planarNormalizedExtinction_plus_eq_slabFormula : ∀ (k : ℝ) (hk : 0 < k) (A W : OQ7.HomogeneousLayer)
  (θ : ℝ),
  1 ≤ A.p →
    1 ≤ W.p →
      ∀ (hqA : 0 < A.q) (hqW : 0 < W.q) (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
        OQ7Prescribed.planarNormalizedExtinction k hk OQ7Prescribed.Direction.plus (A.width + W.width) ⋯ A.width θ
            (OQ7.relativePermittivity A - 1) (OQ7.relativePermittivity W - 1) ⋯ ⋯ =
          OQ7Prescribed.slabFormulaExtinction k A W θ
OQ7Prescribed.planarNormalizedExtinction_pos : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction) (L : ℝ) (hL : 0 ≤ L)
  (h θ : ℝ),
  0 ≤ h →
    h < L →
      ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
        0 < OQ7Prescribed.planarNormalizedExtinction k hk σ L hL h θ α β hα hβ
OQ7Prescribed.planarNormalizedExtinction_reciprocity : ∀ (k : ℝ) (hk : 0 < k) (h d : ℝ) (hh : 0 < h) (hd : 0 < d)
  (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.planarNormalizedExtinction k hk OQ7Prescribed.Direction.plus (h + d) ⋯ h θ α β hα hβ =
    OQ7Prescribed.planarNormalizedExtinction k hk OQ7Prescribed.Direction.minus (h + d) ⋯ h θ α β hα hβ
OQ7Prescribed.planarNormalizedExtinction_work_balance : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction) (L : ℝ)
  (hL : 0 ≤ L) (h θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.planarNormalizedExtinction k hk σ L hL h θ α β hα hβ =
    OQ7Prescribed.planarNormalizedAbsorption k hk σ L hL h θ α β hα hβ +
      k *
        (inner ℂ (OQ7Prescribed.planarNormalizedResponse k hk σ L hL h θ α β hα hβ)
            ((OQ7Prescribed.planarActiveOutgoing k hk L hL h θ)
              (OQ7Prescribed.planarNormalizedResponse k hk σ L hL h θ α β hα hβ))).im
OQ7Prescribed.planarNormalizedResponse_continuous : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction) (L : ℝ)
  (hL : 0 ≤ L) (h : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  Continuous fun θ => OQ7Prescribed.planarNormalizedResponse k hk σ L hL h θ α β hα hβ
OQ7Prescribed.planarNormalizedResponse_equation : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction) (L : ℝ)
  (hL : 0 ≤ L) (h θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  (OQ7Prescribed.planarActiveMaterialOperator k hk L hL h θ α β)
      (OQ7Prescribed.planarNormalizedResponse k hk σ L hL h θ α β hα hβ) =
    -OQ7Prescribed.planarNormalizedDrive k σ L h
OQ7Prescribed.planarNormalizedResponse_ne_zero : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction) (L : ℝ)
  (hL : 0 ≤ L) (h θ : ℝ),
  0 ≤ h →
    h < L →
      ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im), OQ7Prescribed.planarNormalizedResponse k hk σ L hL h θ α β hα hβ ≠ 0
OQ7Prescribed.planarNormalizedResponse_norm_le : ∀ (k : ℝ) (hk : 0 < k) (σ : OQ7Prescribed.Direction) (L : ℝ)
  (hL : 0 ≤ L) (h θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  ‖OQ7Prescribed.planarNormalizedResponse k hk σ L hL h θ α β hα hβ‖ ≤
    1 / min (α.im / Complex.normSq α) (β.im / Complex.normSq β) * ‖OQ7Prescribed.planarNormalizedDrive k σ L h‖
OQ7Prescribed.planarRealKernel_even : ∀ (k s : ℝ),
  OQ7Prescribed.planarRealKernel k (-s) = OQ7Prescribed.planarRealKernel k s
OQ7Prescribed.planarScalarGreen_continuous : ∀ (k : ℝ), Continuous (OQ7Prescribed.planarScalarGreen k)
OQ7Prescribed.planarScalarGreen_norm : ∀ (k s : ℝ), 0 < k → ‖OQ7Prescribed.planarScalarGreen k s‖ = 1 / (2 * k)
OQ7Prescribed.planarScalarGreen_physical_split : ∀ (k s : ℝ),
  k ≠ 0 →
    k ^ 2 • OQ7Prescribed.planarScalarGreen k s =
      ↑(OQ7Prescribed.planarRealKernel k s) + Complex.I * ↑(k / 2 * Real.cos (k * s))
OQ7Prescribed.planarScalarOutgoing_coe : ∀ (k : ℝ) (hk : 0 < k) (L : ℝ) (hL : 0 ≤ L)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  ↑↑↑((OQ7Prescribed.planarScalarOutgoing k hk L hL) q) =ᵐ[MeasureTheory.volume]
    (Set.Icc 0 L).indicator fun z => k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑q) z
OQ7Prescribed.planarScalarOutgoing_im_nonneg : ∀ (k : ℝ) (hk : 0 < k) (L : ℝ) (hL : 0 ≤ L)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)), 0 ≤ (inner ℂ q ((OQ7Prescribed.planarScalarOutgoing k hk L hL) q)).im
OQ7Prescribed.planarScalarOutgoing_twoLayer_representation : ∀ (k : ℝ) (hk : 0 < k) (h L : ℝ) (hh : 0 ≤ h) (hL : h ≤ L)
  (A : OQ7Prescribed.PlanarLayerField k 0 h) (W : OQ7Prescribed.PlanarLayerField k h L),
  A.electric h = W.electric h →
    A.magnetic h = W.magnetic h →
      ↑↑↑((OQ7Prescribed.planarScalarOutgoing k hk L ⋯)
                (OQ7Prescribed.planarTwoLayerL2Current k h L hh hL A W)) =ᵐ[MeasureTheory.volume]
        (Set.Icc 0 L).indicator fun z =>
          (if z ≤ h then A.electric z else W.electric z) -
              1 / 2 * OQ7Prescribed.apertureOscillation k z * (A.magnetic 0 + A.electric 0) +
            1 / 2 * OQ7Prescribed.apertureOscillation k (L - z) * (W.magnetic L - W.electric L)
OQ7Prescribed.planarScalarOutgoing_work : ∀ (k : ℝ) (hk : 0 < k) (L : ℝ) (hL : 0 ≤ L)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)),
  inner ℂ q ((OQ7Prescribed.planarScalarOutgoing k hk L hL) q) =
    OQ7Prescribed.kernelQuadratic (fun p => k ^ 2 • OQ7Prescribed.planarScalarGreen k (p.1 - p.2)) ↑↑↑q
OQ7Prescribed.planarSlabTransverse_congr_height_ae : ∀ (k : ℝ) (w : ℂ → ℂ) (q f : ℝ → ℂ),
  q =ᵐ[MeasureTheory.volume] f →
    ∀ (x : ℂ) (z : ℝ) (u v : ℂ),
      OQ7Prescribed.planarSlabTransverse k w q x z u v = OQ7Prescribed.planarSlabTransverse k w f x z u v
OQ7Prescribed.planarSlabTransverse_continuous_product : ∀ (k : ℝ) (w : ℂ → ℂ) (q : ℝ → ℂ),
  Continuous w →
    ContDiff ℝ (↑⊤) q →
      HasCompactSupport q → ∀ (u v : ℂ), Continuous fun y => OQ7Prescribed.planarSlabTransverse k w q y.1 y.2 u v
OQ7Prescribed.planarSlabTransverse_factorization : ∀ (k : ℝ) (w : ℂ → ℂ) (q : ℝ → ℂ) (x u v : ℂ) (z : ℝ),
  OQ7Prescribed.planarSlabTransverse k w q x z u v =
    (k ^ 2 * inner ℝ u v) • (w x * OQ7Prescribed.scalarPlanarPotential k q z)
OQ7Prescribed.planarSlabTransverse_integrable : ∀ (k : ℝ),
  0 < k →
    ∀ (w : ℂ → ℂ) (q : ℝ → ℂ),
      Continuous q →
        HasCompactSupport q →
          ∀ (x u v : ℂ) (z : ℝ),
            MeasureTheory.Integrable
              (fun t => (k ^ 2 * inner ℝ u v) • (OQ7Prescribed.planarScalarGreen k (z - t) * w x) * q t)
              MeasureTheory.volume
OQ7Prescribed.planarTwoLayer_incoming_equation : ∀ (k h L z : ℝ),
  k ≠ 0 →
    ∀ (hh : 0 ≤ h) (hL : h ≤ L),
      z ∈ Set.Icc 0 L →
        ∀ (A : OQ7Prescribed.PlanarLayerField k 0 h) (W : OQ7Prescribed.PlanarLayerField k h L),
          A.electric h = W.electric h →
            A.magnetic h = W.magnetic h →
              ∀ (l r : ℂ),
                A.magnetic 0 + A.electric 0 = 2 * l →
                  W.magnetic L - W.electric L = -2 * r * OQ7Prescribed.apertureOscillation (-k) L →
                    (if z ≤ h then A.electric z else W.electric z) =
                      l * OQ7Prescribed.apertureOscillation k z + r * OQ7Prescribed.apertureOscillation (-k) z +
                        k ^ 2 •
                          OQ7Prescribed.scalarPlanarPotential k
                            (↑↑↑(OQ7Prescribed.planarTwoLayerL2Current k h L hh hL A W)) z
OQ7Prescribed.planarTwoLayer_minus_incident_equation : ∀ (k h L z : ℝ),
  k ≠ 0 →
    ∀ (hh : 0 ≤ h) (hL : h ≤ L),
      z ∈ Set.Icc 0 L →
        ∀ (A : OQ7Prescribed.PlanarLayerField k 0 h) (W : OQ7Prescribed.PlanarLayerField k h L),
          A.electric h = W.electric h →
            A.magnetic h = W.magnetic h →
              A.magnetic 0 + A.electric 0 = 0 →
                W.magnetic L - W.electric L = -2 * OQ7Prescribed.apertureOscillation (-k) L →
                  (if z ≤ h then A.electric z else W.electric z) =
                    OQ7Prescribed.planarIncidentPhase k OQ7Prescribed.Direction.minus z +
                      k ^ 2 •
                        OQ7Prescribed.scalarPlanarPotential k
                          (↑↑↑(OQ7Prescribed.planarTwoLayerL2Current k h L hh hL A W)) z
OQ7Prescribed.planarTwoLayer_plus_incident_equation : ∀ (k h L z : ℝ),
  k ≠ 0 →
    ∀ (hh : 0 ≤ h) (hL : h ≤ L),
      z ∈ Set.Icc 0 L →
        ∀ (A : OQ7Prescribed.PlanarLayerField k 0 h) (W : OQ7Prescribed.PlanarLayerField k h L),
          A.electric h = W.electric h →
            A.magnetic h = W.magnetic h →
              A.magnetic 0 + A.electric 0 = 2 →
                W.magnetic L - W.electric L = 0 →
                  (if z ≤ h then A.electric z else W.electric z) =
                    OQ7Prescribed.planarIncidentPhase k OQ7Prescribed.Direction.plus z +
                      k ^ 2 •
                        OQ7Prescribed.scalarPlanarPotential k
                          (↑↑↑(OQ7Prescribed.planarTwoLayerL2Current k h L hh hL A W)) z
OQ7Prescribed.planarTwoLayerCurrent_memLp : ∀ (h L : ℝ) (qA qW : ℝ → ℂ),
  ContinuousOn qA (Set.Icc 0 h) →
    ContinuousOn qW (Set.Icc h L) →
      MeasureTheory.MemLp (OQ7Prescribed.planarTwoLayerCurrent h L qA qW) 2 MeasureTheory.volume
OQ7Prescribed.planarTwoLayerGreen_integral : ∀ (k h L z : ℝ),
  0 ≤ h →
    h ≤ L →
      ∀ (qA qW : ℝ → ℂ),
        ContinuousOn qA (Set.Icc 0 h) →
          ContinuousOn qW (Set.Icc h L) →
            ∫ (t : ℝ), OQ7Prescribed.planarScalarGreen k (z - t) * OQ7Prescribed.planarTwoLayerCurrent h L qA qW t =
              (∫ (t : ℝ) in 0..h, OQ7Prescribed.planarScalarGreen k (z - t) * qA t) +
                ∫ (t : ℝ) in h..L, OQ7Prescribed.planarScalarGreen k (z - t) * qW t
OQ7Prescribed.planarTwoLayerGreen_interior_representation : ∀ (k h L z : ℝ),
  k ≠ 0 →
    0 ≤ h →
      h ≤ L →
        z ∈ Set.Icc 0 L →
          ∀ (A : OQ7Prescribed.PlanarLayerField k 0 h) (W : OQ7Prescribed.PlanarLayerField k h L),
            A.electric h = W.electric h →
              A.magnetic h = W.magnetic h →
                ↑k ^ 2 *
                    ∫ (t : ℝ),
                      OQ7Prescribed.planarScalarGreen k (z - t) *
                        OQ7Prescribed.planarTwoLayerCurrent h L A.current W.current t =
                  (if z ≤ h then A.electric z else W.electric z) -
                      1 / 2 * OQ7Prescribed.apertureOscillation k z * (A.magnetic 0 + A.electric 0) +
                    1 / 2 * OQ7Prescribed.apertureOscillation k (L - z) * (W.magnetic L - W.electric L)
OQ7Prescribed.planarTwoLayerL2Current_coe : ∀ (k h L : ℝ) (hh : 0 ≤ h) (hL : h ≤ L)
  (A : OQ7Prescribed.PlanarLayerField k 0 h) (W : OQ7Prescribed.PlanarLayerField k h L),
  ↑↑↑(OQ7Prescribed.planarTwoLayerL2Current k h L hh hL A W) =ᵐ[MeasureTheory.volume]
    OQ7Prescribed.planarTwoLayerCurrent h L A.current W.current
OQ7Prescribed.planarWaveMomentMinus_hasDerivAt : ∀ (k t : ℝ) (E H q : ℝ → ℂ),
  HasDerivAt E (Complex.I * ↑k * H t) t →
    HasDerivAt H (Complex.I * ↑k * (E t + q t)) t →
      HasDerivAt (fun z => OQ7Prescribed.apertureOscillation k z * (H z - E z))
        (Complex.I * ↑k * (OQ7Prescribed.apertureOscillation k t * q t)) t
OQ7Prescribed.planarWaveMomentPlus_hasDerivAt : ∀ (k t : ℝ) (E H q : ℝ → ℂ),
  HasDerivAt E (Complex.I * ↑k * H t) t →
    HasDerivAt H (Complex.I * ↑k * (E t + q t)) t →
      HasDerivAt (fun z => OQ7Prescribed.apertureOscillation (-k) z * (H z + E z))
        (Complex.I * ↑k * (OQ7Prescribed.apertureOscillation (-k) t * q t)) t
OQ7Prescribed.planarWaveMoments_boundary : ∀ (k a b : ℝ),
  a ≤ b →
    ∀ (E H q : ℝ → ℂ),
      ContinuousOn E (Set.Icc a b) →
        ContinuousOn H (Set.Icc a b) →
          ContinuousOn q (Set.Icc a b) →
            (∀ t ∈ Set.Ioo a b, HasDerivAt E (Complex.I * ↑k * H t) t) →
              (∀ t ∈ Set.Ioo a b, HasDerivAt H (Complex.I * ↑k * (E t + q t)) t) →
                Complex.I * ↑k * ∫ (t : ℝ) in a..b, OQ7Prescribed.apertureOscillation (-k) t * q t =
                    OQ7Prescribed.apertureOscillation (-k) b * (H b + E b) -
                      OQ7Prescribed.apertureOscillation (-k) a * (H a + E a) ∧
                  Complex.I * ↑k * ∫ (t : ℝ) in a..b, OQ7Prescribed.apertureOscillation k t * q t =
                    OQ7Prescribed.apertureOscillation k b * (H b - E b) -
                      OQ7Prescribed.apertureOscillation k a * (H a - E a)
OQ7Prescribed.planePhase_contDiff : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  ContDiff ℝ (↑⊤) (OQ7Prescribed.planePhase k σ)
OQ7Prescribed.planePhase_hasFDerivAt : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  HasFDerivAt (OQ7Prescribed.planePhase k σ)
    ((Complex.I * ↑(σ.sign * k) * OQ7Prescribed.planePhase k σ x) • Complex.ofRealCLM ∘SL PiLp.proj 2 (fun x => ℝ) 2) x
OQ7Prescribed.planePhase_norm : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.planePhase k σ x‖ = 1
OQ7Prescribed.plateDesign_phases : ∀ (k : ℝ),
  k ≠ 0 →
    ∀ (j : ℕ),
      1 ≤ j →
        k * OQ7Prescribed.plateDesignThickness k j = ↑j * (2 * Real.pi) - Real.pi ∧
          k * OQ7Prescribed.plateDesignIndex j * OQ7Prescribed.plateDesignThickness k j = ↑j * (2 * Real.pi)
OQ7Prescribed.plateDesignIndex_gt_one : ∀ (j : ℕ), 1 ≤ j → 1 < OQ7Prescribed.plateDesignIndex j
OQ7Prescribed.plateDesignPermittivity_pos_susceptibility : ∀ (j : ℕ),
  1 ≤ j → 0 < OQ7Prescribed.plateDesignPermittivity j - 1
OQ7Prescribed.plateDesignThickness_pos : ∀ (k : ℝ),
  0 < k → ∀ (j : ℕ), 1 ≤ j → 0 < OQ7Prescribed.plateDesignThickness k j
OQ7Prescribed.polarization_zero_outside : ∀ (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field),
  ∀ x ∉ B.domain, OQ7Prescribed.polarization B E x = 0
OQ7Prescribed.polarizationCurrentComponentDistribution_apply : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.polarizationCurrentComponentDistribution p i) φ =
    ∫ (x : OQ7Prescribed.Position), φ x • (p.current x).ofLp i
OQ7Prescribed.polarizationCurrentComponentDistribution_eq_vectorL2 : ∀ (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  OQ7Prescribed.polarizationCurrentComponentDistribution p i =
    OQ7Prescribed.vectorL2ComponentDistribution (MeasureTheory.MemLp.toLp p.current ⋯) i
OQ7Prescribed.pole_point_complex_test_ibp : ∀ (F D : OQ7Prescribed.Position → ℂ) (i : Fin 3),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 F x) →
    (∀ (x : OQ7Prescribed.Position), x ≠ 0 → HasLineDerivAt ℝ F (D x) x (OQ7Prescribed.basisR i)) →
      MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
        MeasureTheory.LocallyIntegrable D MeasureTheory.volume →
          (∃ R, 0 < R ∧ ∃ M, 0 ≤ M ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ M / ‖x‖) →
            ∀ (φ : OQ7Prescribed.ScalarTest),
              ∫ (x : OQ7Prescribed.Position), ((OQ7Prescribed.testPartial i) φ) x • F x =
                -∫ (x : OQ7Prescribed.Position), φ x • D x
OQ7Prescribed.pole_point_test_ibp : ∀ (F D : OQ7Prescribed.Position → ℝ) (i : Fin 3),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 F x) →
    (∀ (x : OQ7Prescribed.Position), x ≠ 0 → HasLineDerivAt ℝ F (D x) x (OQ7Prescribed.basisR i)) →
      MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
        MeasureTheory.LocallyIntegrable D MeasureTheory.volume →
          (∃ R, 0 < R ∧ ∃ M, 0 ≤ M ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ M / ‖x‖) →
            ∀ (φ : OQ7Prescribed.ScalarTest),
              ∫ (x : OQ7Prescribed.Position), F x * ((OQ7Prescribed.testPartial i) φ) x =
                -∫ (x : OQ7Prescribed.Position), D x * φ x
OQ7Prescribed.position_ae_ne_zero : ∀ᵐ (ξ : OQ7Prescribed.Position), ξ ≠ 0
OQ7Prescribed.position_sum_basis : ∀ (a : OQ7Prescribed.Position), ∑ j, a.ofLp j • OQ7Prescribed.basisR j = a
OQ7Prescribed.position_zero_volume : MeasureTheory.volume {0} = 0
OQ7Prescribed.potentialBound_lt_top : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ),
  OQ7Prescribed.potentialBound k p S < ⊤
OQ7Prescribed.potentialComponent_eq_fieldComponent : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.potentialComponentDistribution k p =
    OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.outgoingPotential k p)
OQ7Prescribed.potentialComponent_first_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j i : Fin 3),
  (OQ7Prescribed.distributionPartial j) (OQ7Prescribed.potentialComponentDistribution k p i) =
    OQ7Prescribed.gradientPotentialComponentDistribution k p j i
OQ7Prescribed.potentialComponent_helmholtz_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialComponentDistribution k p i) (OQ7Prescribed.testLaplacian φ) +
      k ^ 2 • (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    -∫ (x : OQ7Prescribed.Position), φ x • (p.current x).ofLp i
OQ7Prescribed.potentialComponent_helmholtz_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.distributionLaplacian (OQ7Prescribed.potentialComponentDistribution k p i) +
      k ^ 2 • OQ7Prescribed.potentialComponentDistribution k p i =
    -OQ7Prescribed.polarizationCurrentComponentDistribution p i
OQ7Prescribed.potentialComponent_helmholtz_L2_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  OQ7Prescribed.distributionLaplacian (OQ7Prescribed.potentialComponentDistribution k p i) +
      k ^ 2 • OQ7Prescribed.potentialComponentDistribution k p i =
    -OQ7Prescribed.vectorL2ComponentDistribution (MeasureTheory.MemLp.toLp p.current ⋯) i
OQ7Prescribed.potentialComponentDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    (∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingPotential k p x).ofLp i
OQ7Prescribed.potentialComponentDistribution_apply_integral : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    ∫ (x : OQ7Prescribed.Position), ↑(φ x) * (OQ7Prescribed.outgoingPotential k p x).ofLp i
OQ7Prescribed.potentialComponentDistribution_correlation_re_im : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.currentCorrelationRealTest Complex.reCLM p φ i) +
      Complex.I *
        (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.currentCorrelationRealTest Complex.imCLM p φ i)
OQ7Prescribed.potentialComponentDistribution_dynamic_hessian_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (l i j : Fin 3),
  (OQ7Prescribed.potentialComponentDistribution k p l)
      ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) =
    (OQ7Prescribed.potentialComponentDistribution 0 p l)
        ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) +
      ∫ (z : OQ7Prescribed.Position),
        OQ7Prescribed.newtonCurrentCorrelation p φ l z * OQ7Prescribed.dynamicHessianRemainder k i j z
OQ7Prescribed.potentialComponentDistribution_newton_pairing : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.potentialComponentDistribution 0 p i) φ =
    ∫ (z : OQ7Prescribed.Position), OQ7Prescribed.outgoingGreen 0 z * OQ7Prescribed.newtonCurrentCorrelation p φ i z
OQ7Prescribed.potentialComponentDistribution_newtonTempered : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3),
  (OQ7Prescribed.potentialComponentDistribution 0 p j) φ =
    OQ7Prescribed.newtonTempered (OQ7Prescribed.newtonCurrentCorrelationSchwartz p φ j)
OQ7Prescribed.potentialComponentDistribution_outgoing_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    ∫ (z : OQ7Prescribed.Position), OQ7Prescribed.outgoingGreen k z * OQ7Prescribed.newtonCurrentCorrelation p φ i z
OQ7Prescribed.potentialComponentDistribution_zero_apply_integral : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialComponentDistribution 0 p i) φ =
    ∫ (x : OQ7Prescribed.Position), ↑(φ x) * (OQ7Prescribed.outgoingPotential 0 p x).ofLp i
OQ7Prescribed.potentialCurlField_locallySquareIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.potentialCurlField k p)
OQ7Prescribed.potentialDistribution_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.potentialDistribution k (p.add q) =
    OQ7Prescribed.potentialDistribution k p + OQ7Prescribed.potentialDistribution k q
OQ7Prescribed.potentialDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialDistribution k p) φ =
    ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingPotential k p x
OQ7Prescribed.power_difference_triangle : ∀ (x a X A t : ℝ), |x - a - t * (X - A)| ≤ |x - t * X| + |a - t * A|
OQ7Prescribed.poynting_flux_lower_bound : ∀ (E H : OQ7Prescribed.Vector) (n : OQ7Prescribed.Position),
  ‖n‖ = 1 →
    -(‖H‖ * ‖OQ7Prescribed.cross H (OQ7Prescribed.complexify n) - E‖) ≤
      (OQ7Prescribed.pairing E (OQ7Prescribed.cross H (OQ7Prescribed.complexify n))).re
OQ7Prescribed.purePhase_norm_sub_le : ∀ (a b : ℝ),
  ‖Complex.exp (Complex.I * ↑a) - Complex.exp (Complex.I * ↑b)‖ ≤ |a - b|
OQ7Prescribed.quadratic_layer : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.quadratic (OQ7Prescribed.layerPermittivity a b ν u) v =
    (1 + Complex.I * ↑ν) * ↑(OQ7Prescribed.squareNorm v) +
      (↑a + Complex.I * ↑b) * ↑(Complex.normSq (OQ7Prescribed.axisCoupling u v))
OQ7Prescribed.quadratic_layer_im : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (OQ7Prescribed.quadratic (OQ7Prescribed.layerPermittivity a b ν u) v).im =
    ν * OQ7Prescribed.squareNorm v + b * Complex.normSq (OQ7Prescribed.axisCoupling u v)
OQ7Prescribed.quadratic_layer_re : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (OQ7Prescribed.quadratic (OQ7Prescribed.layerPermittivity a b ν u) v).re =
    OQ7Prescribed.squareNorm v + a * Complex.normSq (OQ7Prescribed.axisCoupling u v)
OQ7Prescribed.radial_lineDeriv : ∀ (F : ℝ → ℂ) (F₁ : ℂ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    HasDerivAt F F₁ ‖x‖ → ∀ (j : Fin 3), lineDeriv ℝ (fun y => F ‖y‖) x (OQ7Prescribed.basisR j) = (x.ofLp j / ‖x‖) • F₁
OQ7Prescribed.radial_second_lineDeriv : ∀ (F F₁ F₂ : ℝ → ℂ),
  (∀ (r : ℝ), 0 < r → HasDerivAt F (F₁ r) r) →
    (∀ (r : ℝ), 0 < r → HasDerivAt F₁ (F₂ r) r) →
      ∀ (x : OQ7Prescribed.Position),
        x ≠ 0 →
          ∀ (i j : Fin 3),
            lineDeriv ℝ (fun y => lineDeriv ℝ (fun z => F ‖z‖) y (OQ7Prescribed.basisR j)) x (OQ7Prescribed.basisR i) =
              (x.ofLp i * x.ofLp j / ‖x‖ ^ 2) • F₂ ‖x‖ +
                ((if i = j then 1 else 0) / ‖x‖ - x.ofLp i * x.ofLp j / ‖x‖ ^ 3) • F₁ ‖x‖
OQ7Prescribed.radialDirection_norm : ∀ (x : OQ7Prescribed.Position), x ≠ 0 → ‖OQ7Prescribed.radialDirection x‖ = 1
OQ7Prescribed.radialDirection_positive_smul : ∀ (s : ℝ),
  0 < s → ∀ (n : ↑OQ7Prescribed.UnitSphere), OQ7Prescribed.radialDirection (s • ↑n) = ↑n
OQ7Prescribed.radialDirection_sub_norm_le : ∀ (x y : OQ7Prescribed.Position),
  ‖y‖ < ‖x‖ → ‖OQ7Prescribed.radialDirection (x - y) - OQ7Prescribed.radialDirection x‖ ≤ 2 * ‖y‖ / (‖x‖ - ‖y‖)
OQ7Prescribed.radialDirection_sub_norm_le_distance : ∀ (x y : OQ7Prescribed.Position),
  ‖y‖ < ‖x‖ → ‖OQ7Prescribed.radialDirection (x - y) - OQ7Prescribed.radialDirection x‖ ≤ 2 * ‖y‖ / ‖x - y‖
OQ7Prescribed.radialHessian_trace : ∀ (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (A B : ℂ),
      ∑ i, ((x.ofLp i * x.ofLp i / ‖x‖ ^ 2) • A + (1 / ‖x‖ - x.ofLp i * x.ofLp i / ‖x‖ ^ 3) • B) = A + (2 / ‖x‖) • B
@OQ7Prescribed.radialNorm_hasFDerivAt : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  (x : E), x ≠ 0 → HasFDerivAt (fun y => ‖y‖) (‖x‖⁻¹ • (innerSL ℝ) x) x
OQ7Prescribed.rankOne_complexify_continuous : Continuous fun x =>
  ((InnerProductSpace.rankOne ℂ) (OQ7Prescribed.complexify x)) (OQ7Prescribed.complexify x)
OQ7Prescribed.rankOne_transpose : ∀ (u : OQ7Prescribed.Position),
  Matrix.transpose (OQ7Prescribed.rankOne u) = OQ7Prescribed.rankOne u
OQ7Prescribed.rankOneBody_polarization : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position) (α β : ℂ)
  (E : OQ7Prescribed.Field),
  OQ7Prescribed.polarization (OQ7Prescribed.rankOneBody B u v α β) E =
    B.domain.indicator fun x =>
      if x.ofLp 2 < B.absorberThickness then (α * OQ7Prescribed.axisCoupling u (E x)) • OQ7Prescribed.complexify u
      else (β * OQ7Prescribed.axisCoupling v (E x)) • OQ7Prescribed.complexify v
OQ7Prescribed.rankOneElectricUnit_val : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody) (θ : ℝ) (α β : ℂ)
  (hα : 0 < α.im) (hβ : 0 < β.im),
  ↑(OQ7Prescribed.rankOneElectricUnit k hk B θ α β hα hβ) = OQ7Prescribed.physicalElectricOperator k B 0 θ α β
OQ7Prescribed.rankOnePhysical_extinction_reciprocity : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (u v : OQ7Prescribed.Position) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.extinction k (OQ7Prescribed.rankOneBody B u v α β) OQ7Prescribed.Direction.plus
      (OQ7Prescribed.volumeTotalElectric k OQ7Prescribed.Direction.plus
        (OQ7Prescribed.bodyCurrentPolarization B
          ((OQ7Prescribed.activeInjection B u v)
            (OQ7Prescribed.activePhysicalSolution k hk B OQ7Prescribed.Direction.plus u v α β hα hβ)))) =
    OQ7Prescribed.extinction k (OQ7Prescribed.rankOneBody B u v α β) OQ7Prescribed.Direction.minus
      (OQ7Prescribed.volumeTotalElectric k OQ7Prescribed.Direction.minus
        (OQ7Prescribed.bodyCurrentPolarization B
          ((OQ7Prescribed.activeInjection B u v)
            (OQ7Prescribed.activePhysicalSolution k hk B OQ7Prescribed.Direction.minus u v α β hα hβ))))
OQ7Prescribed.rankOnePhysicalScatteringState_exists : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction) (u v : OQ7Prescribed.Position) (α β : ℂ),
      0 < α.im → 0 < β.im → Nonempty (OQ7Prescribed.ScatteringState k (OQ7Prescribed.rankOneBody B u v α β) σ)
OQ7Prescribed.rankOneRotationExtinction_continuous : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  Continuous fun θ => OQ7Prescribed.rankOneRotationExtinction k hk B σ θ α β hα hβ
OQ7Prescribed.rankOneRotationExtinction_factorization : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.rankOneRotationExtinction k hk B σ θ α β hα hβ =
    Real.sin θ ^ 2 * OQ7Prescribed.normalizedExtinction k hk B σ θ α β hα hβ
OQ7Prescribed.real_inner_basis : ∀ (x : OQ7Prescribed.Position) (j : Fin 3),
  inner ℝ x (OQ7Prescribed.basisR j) = x.ofLp j
OQ7Prescribed.real_inner_norm_square_error : ∀ (u v f : OQ7Prescribed.Vector),
  |(inner ℂ u v).re - ‖f‖ ^ 2| ≤ ‖u‖ * ‖v - u‖ + (‖u‖ + ‖f‖) * ‖u - f‖
OQ7Prescribed.realCLM_basis_expansion : ∀ (L : OQ7Prescribed.Position →L[ℝ] ℂ) (a : OQ7Prescribed.Position),
  L a = ∑ j, ↑(a.ofLp j) * L (OQ7Prescribed.basisR j)
OQ7Prescribed.realDot_eq_inner : ∀ (n y : OQ7Prescribed.Position), OQ7Prescribed.realDot n y = inner ℝ n y
OQ7Prescribed.reciprocalMaterialVolume_incident_work : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody),
      Matrix.transpose B.absorberPermittivity = B.absorberPermittivity →
        Matrix.transpose B.platePermittivity = B.platePermittivity →
          ∀ (p q : OQ7Prescribed.CompactPolarization),
            OQ7Prescribed.MaterialVolumeEquation k B OQ7Prescribed.Direction.plus p →
              OQ7Prescribed.MaterialVolumeEquation k B OQ7Prescribed.Direction.minus q →
                ∫ (x : OQ7Prescribed.Position),
                    OQ7Prescribed.bilinear (p.current x)
                      (OQ7Prescribed.incidentElectric k OQ7Prescribed.Direction.minus x) =
                  ∫ (x : OQ7Prescribed.Position),
                    OQ7Prescribed.bilinear (q.current x)
                      (OQ7Prescribed.incidentElectric k OQ7Prescribed.Direction.plus x)
OQ7Prescribed.reflectedCurrentComponent_fourier_neg : ∀ (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (ξ : OQ7Prescribed.Position),
  FourierTransform.fourier (OQ7Prescribed.reflectedCurrentComponent p j) (-ξ) =
    (FourierTransform.fourier p.current ξ).ofLp j
OQ7Prescribed.reflectedCurrentComponent_hasCompactSupport : ∀ (p : OQ7Prescribed.CompactPolarization) (j : Fin 3),
  HasCompactSupport (OQ7Prescribed.reflectedCurrentComponent p j)
OQ7Prescribed.reflectedCurrentComponent_integrable : ∀ (p : OQ7Prescribed.CompactPolarization) (j : Fin 3),
  MeasureTheory.Integrable (OQ7Prescribed.reflectedCurrentComponent p j) MeasureTheory.volume
OQ7Prescribed.relativePermittivity_susceptibility_im : ∀ (A : OQ7.HomogeneousLayer),
  (OQ7.relativePermittivity A - 1).im = A.q
OQ7Prescribed.relativePermittivity_susceptibility_ne_zero : ∀ (A : OQ7.HomogeneousLayer),
  0 < A.q → OQ7.relativePermittivity A - 1 ≠ 0
OQ7Prescribed.remainder_current_correlation_inner : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (z : OQ7Prescribed.Position),
  ∫ (y : OQ7Prescribed.Position), ↑(φ (z + y)) • (OQ7Prescribed.dyadicRemainder k z) (p.current y) =
    (OQ7Prescribed.dyadicRemainder k z) (OQ7Prescribed.currentTestCorrelationVector p φ z)
OQ7Prescribed.remainder_current_correlation_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  MeasureTheory.Integrable (fun q => ↑(φ (q.1 + q.2)) • (OQ7Prescribed.dyadicRemainder k q.1) (p.current q.2))
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.remainder_current_correlation_pairing_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  MeasureTheory.Integrable
    (fun z => (OQ7Prescribed.dyadicRemainder k z) (OQ7Prescribed.currentTestCorrelationVector p φ z))
    MeasureTheory.volume
OQ7Prescribed.remainder_current_pairing_integrand_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (S : ℝ),
  (∀ (x : OQ7Prescribed.Position), φ x ≠ 0 → ‖x‖ ≤ S) →
    ∀ (x y : OQ7Prescribed.Position),
      ↑(φ x) • (OQ7Prescribed.dyadicRemainder k (x - y)) (p.current y) =
        ↑(φ x) • (OQ7Prescribed.cutoffDyadicRemainder k (S + p.radius) (x - y)) (p.current y)
OQ7Prescribed.remainder_current_test_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  MeasureTheory.Integrable (fun q => ↑(φ q.1) • (OQ7Prescribed.dyadicRemainder k (q.1 - q.2)) (p.current q.2))
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.remainderPotential_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.remainderPotential k (p.add q) =
    OQ7Prescribed.remainderPotential k p + OQ7Prescribed.remainderPotential k q
OQ7Prescribed.remainderPotential_aestronglyMeasurable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.AEStronglyMeasurable (OQ7Prescribed.remainderPotential k p) MeasureTheory.volume
OQ7Prescribed.remainderPotential_congr_current : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  p.current =ᵐ[MeasureTheory.volume] q.current →
    OQ7Prescribed.remainderPotential k p = OQ7Prescribed.remainderPotential k q
OQ7Prescribed.remainderPotential_eLpNorm_le : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (K : Set OQ7Prescribed.Position),
  MeasurableSet K →
    ∀ (S : ℝ),
      (∀ x ∈ K, ‖x‖ ≤ S) →
        MeasureTheory.eLpNorm (OQ7Prescribed.remainderPotential k p) 2 (MeasureTheory.volume.restrict K) ≤
          OQ7Prescribed.remainderPotentialBound k p S * MeasureTheory.volume K ^ (1 / 2)
OQ7Prescribed.remainderPotential_enorm_le : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x : OQ7Prescribed.Position),
  ‖x‖ ≤ S → ‖OQ7Prescribed.remainderPotential k p x‖ₑ ≤ OQ7Prescribed.remainderPotentialBound k p S
OQ7Prescribed.remainderPotential_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  MeasureTheory.Integrable (fun y => (OQ7Prescribed.dyadicRemainder k (x - y)) (p.current y)) MeasureTheory.volume
OQ7Prescribed.remainderPotential_integrand_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x y : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    (OQ7Prescribed.dyadicRemainder k (x - y)) (p.current y) =
      (OQ7Prescribed.cutoffDyadicRemainder k (S + p.radius) (x - y)) (p.current y)
OQ7Prescribed.remainderPotential_locallyIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.remainderPotential k p) MeasureTheory.volume
OQ7Prescribed.remainderPotential_memLp_on_compact : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (K : Set OQ7Prescribed.Position),
  IsCompact K → MeasureTheory.MemLp (OQ7Prescribed.remainderPotential k p) 2 (MeasureTheory.volume.restrict K)
OQ7Prescribed.remainderPotential_smul : ∀ (k : ℝ) (z : ℂ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.remainderPotential k (OQ7Prescribed.CompactPolarization.scale z p) =
    z • OQ7Prescribed.remainderPotential k p
OQ7Prescribed.remainderPotential_test_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  MeasureTheory.Integrable (fun x => ↑(φ x) • OQ7Prescribed.remainderPotential k p x) MeasureTheory.volume
OQ7Prescribed.remainderPotential_test_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  ∫ (x : OQ7Prescribed.Position), ↑(φ x) • OQ7Prescribed.remainderPotential k p x =
    ∫ (z : OQ7Prescribed.Position),
      (OQ7Prescribed.dyadicRemainder k z) (OQ7Prescribed.currentTestCorrelationVector p φ z)
OQ7Prescribed.remainderPotentialBound_lt_top : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ),
  OQ7Prescribed.remainderPotentialBound k p S < ⊤
OQ7Prescribed.remainderPotentialComponentDistribution_dynamic_pairing : ∀ (k : ℝ)
  (p : OQ7Prescribed.CompactPolarization) (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.remainderPotentialComponentDistribution k p i) φ =
    k ^ 2 • (OQ7Prescribed.potentialComponentDistribution k p i) φ +
      ∑ j,
        ∫ (z : OQ7Prescribed.Position),
          OQ7Prescribed.newtonCurrentCorrelation p φ j z * OQ7Prescribed.dynamicHessianRemainder k i j z
OQ7Prescribed.remainderPotentialComponentDistribution_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.remainderPotentialComponentDistribution k p i) φ =
    (∫ (z : OQ7Prescribed.Position),
          (OQ7Prescribed.dyadicRemainder k z) (OQ7Prescribed.currentTestCorrelationVector p φ z)).ofLp
      i
OQ7Prescribed.remainderPotentialComponentDistribution_pairing_sum : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.remainderPotentialComponentDistribution k p i) φ =
    ∑ j,
      ∫ (z : OQ7Prescribed.Position),
        OQ7Prescribed.newtonCurrentCorrelation p φ j z *
          ((OQ7Prescribed.dyadicRemainder k z) (OQ7Prescribed.basisC j)).ofLp i
OQ7Prescribed.remainderPotentialDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.remainderPotentialDistribution k p) φ =
    ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.remainderPotential k p x
OQ7Prescribed.remainderPotentialDistribution_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.remainderPotentialDistribution k p) φ =
    ∫ (z : OQ7Prescribed.Position),
      (OQ7Prescribed.dyadicRemainder k z) (OQ7Prescribed.currentTestCorrelationVector p φ z)
OQ7Prescribed.removable_point_complex_test_ibp : ∀ (F D : OQ7Prescribed.Position → ℂ) (i : Fin 3),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 F x) →
    (∀ (x : OQ7Prescribed.Position), x ≠ 0 → HasLineDerivAt ℝ F (D x) x (OQ7Prescribed.basisR i)) →
      MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
        MeasureTheory.LocallyIntegrable D MeasureTheory.volume →
          (∃ R, 0 < R ∧ ∃ M, 0 ≤ M ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ M) →
            ∀ (φ : OQ7Prescribed.ScalarTest),
              ∫ (x : OQ7Prescribed.Position), ((OQ7Prescribed.testPartial i) φ) x • F x =
                -∫ (x : OQ7Prescribed.Position), φ x • D x
OQ7Prescribed.removable_point_test_ibp : ∀ (F D : OQ7Prescribed.Position → ℝ) (i : Fin 3),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 F x) →
    (∀ (x : OQ7Prescribed.Position), x ≠ 0 → HasLineDerivAt ℝ F (D x) x (OQ7Prescribed.basisR i)) →
      MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
        MeasureTheory.LocallyIntegrable D MeasureTheory.volume →
          (∃ R, 0 < R ∧ ∃ M, 0 ≤ M ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ M) →
            ∀ (φ : OQ7Prescribed.ScalarTest),
              ∫ (x : OQ7Prescribed.Position), F x * ((OQ7Prescribed.testPartial i) φ) x =
                -∫ (x : OQ7Prescribed.Position), D x * φ x
OQ7Prescribed.rotatedAxis_continuous : Continuous OQ7Prescribed.rotatedAxis
OQ7Prescribed.rotatedAxis_unit : ∀ (θ : ℝ), ‖OQ7Prescribed.rotatedAxis θ‖ ^ 2 = 1
OQ7Prescribed.scalarAxisPolarization_current : ∀ (f : OQ7Prescribed.Position → ℂ) (hf : Continuous f)
  (hc : HasCompactSupport f) (a : OQ7Prescribed.Position),
  (OQ7Prescribed.scalarAxisPolarization f hf hc a).current = fun x => f x • OQ7Prescribed.complexify a
OQ7Prescribed.scalarConstitutive_negative_imaginary : ∀ (α z : ℂ),
  α ≠ 0 → -(inner ℂ (α * z) (α⁻¹ * (α * z))).im = α.im * Complex.normSq z
OQ7Prescribed.scalarInverse_negative_imaginary : ∀ (α z : ℂ),
  -(inner ℂ z (α⁻¹ • z)).im = OQ7Prescribed.activeScalarLoss α * ‖z‖ ^ 2
OQ7Prescribed.scalarOutgoingPotential_contDiff : ∀ (k : ℝ) (f : OQ7Prescribed.Position → ℂ),
  ContDiff ℝ (↑⊤) f → HasCompactSupport f → ContDiff ℝ (↑⊤) (OQ7Prescribed.scalarOutgoingPotential k f)
OQ7Prescribed.scalarOutgoingPotential_convolution : ∀ (k : ℝ) (f : OQ7Prescribed.Position → ℂ),
  OQ7Prescribed.scalarOutgoingPotential k f =
    MeasureTheory.convolution (OQ7Prescribed.outgoingGreen k) f (ContinuousLinearMap.mul ℝ ℂ) MeasureTheory.volume
OQ7Prescribed.scalarOutgoingPotential_integrable : ∀ (k : ℝ) (f : OQ7Prescribed.Position → ℂ),
  Continuous f →
    HasCompactSupport f →
      ∀ (x : OQ7Prescribed.Position),
        MeasureTheory.Integrable (fun y => OQ7Prescribed.outgoingGreen k (x - y) * f y) MeasureTheory.volume
OQ7Prescribed.scalarOutgoingPotential_partial : ∀ (k : ℝ) (f : OQ7Prescribed.Position → ℂ),
  ContDiff ℝ (↑⊤) f →
    HasCompactSupport f →
      ∀ (x a : OQ7Prescribed.Position),
        (fderiv ℝ (OQ7Prescribed.scalarOutgoingPotential k f) x) a =
          OQ7Prescribed.scalarOutgoingPotential k (fun y => (fderiv ℝ f y) a) x
OQ7Prescribed.scalarOutgoingPotential_slab_horizontal_partial : ∀ (k : ℝ) (w : ℂ → ℂ) (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ContDiff ℝ (↑⊤) q →
      HasCompactSupport w →
        HasCompactSupport q →
          ∀ (x : OQ7Prescribed.Position) (v : ℂ),
            (fderiv ℝ (OQ7Prescribed.scalarOutgoingPotential k (OQ7Prescribed.slabSeparatedFunction w q)) x)
                (OQ7Prescribed.slabPosition v 0) =
              OQ7Prescribed.scalarOutgoingPotential k
                (OQ7Prescribed.slabSeparatedFunction (OQ7Prescribed.apertureWindowPartial w v) q) x
OQ7Prescribed.scalarOutgoingPotential_slab_product_integrable : ∀ (k : ℝ) (w : ℂ → ℂ) (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ContDiff ℝ (↑⊤) q →
      HasCompactSupport w →
        HasCompactSupport q →
          ∀ (x : ℂ) (z : ℝ),
            MeasureTheory.Integrable (fun p => OQ7Prescribed.slabGreen k (z - p.2) (x - p.1) * w p.1 * q p.2)
              MeasureTheory.volume
OQ7Prescribed.scalarOutgoingPotential_slab_second_horizontal_partial : ∀ (k : ℝ) (w : ℂ → ℂ) (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ContDiff ℝ (↑⊤) q →
      HasCompactSupport w →
        HasCompactSupport q →
          ∀ (x : OQ7Prescribed.Position) (u v : ℂ),
            (fderiv ℝ
                  (fun y =>
                    (fderiv ℝ (OQ7Prescribed.scalarOutgoingPotential k (OQ7Prescribed.slabSeparatedFunction w q)) y)
                      (OQ7Prescribed.slabPosition u 0))
                  x)
                (OQ7Prescribed.slabPosition v 0) =
              OQ7Prescribed.scalarOutgoingPotential k
                (OQ7Prescribed.slabSeparatedFunction (OQ7Prescribed.apertureWindowSecond w u v) q) x
OQ7Prescribed.scalarOutgoingPotential_slab_separation : ∀ (k : ℝ) (w : ℂ → ℂ) (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ContDiff ℝ (↑⊤) q →
      HasCompactSupport w →
        HasCompactSupport q →
          ∀ (x : ℂ) (z : ℝ),
            OQ7Prescribed.scalarOutgoingPotential k (OQ7Prescribed.slabSeparatedFunction w q)
                (OQ7Prescribed.slabPosition x z) =
              ∫ (t : ℝ), OQ7Prescribed.horizontalSlabPotential k (z - t) w x * q t
OQ7Prescribed.scalarOutgoingSlabTransverse_centered_uniform_error : ∀ (k : ℝ),
  0 < k →
    ∀ (w : ℂ → ℂ),
      ContDiff ℝ (↑⊤) w →
        HasCompactSupport w →
          ∀ (A X L : ℝ),
            0 ≤ A →
              0 ≤ X →
                0 ≤ L →
                  tsupport w ⊆ Metric.closedBall 0 A →
                    ∃ C,
                      0 < C ∧
                        ∀ (q : ℝ → ℂ),
                          ContDiff ℝ (↑⊤) q →
                            HasCompactSupport q →
                              tsupport q ⊆ Metric.closedBall 0 L →
                                ∀ (R z : ℝ) (x u v : ℂ),
                                  1 ≤ R →
                                    |z| ≤ L →
                                      ‖x‖ ≤ X * R →
                                        ‖u‖ ≤ 1 →
                                          ‖v‖ ≤ 1 →
                                            ‖OQ7Prescribed.scalarOutgoingSlabTransverse k
                                                    (OQ7Prescribed.scaledApertureWindow w R) q x z u v -
                                                  OQ7Prescribed.planarSlabTransverse k
                                                    (OQ7Prescribed.scaledApertureWindow w R) q x z u v‖ ≤
                                              C / R * ∫ (t : ℝ), ‖q t‖
OQ7Prescribed.scalarOutgoingSlabTransverse_height_integrable : ∀ (k : ℝ) (w : ℂ → ℂ) (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ContDiff ℝ (↑⊤) q →
      HasCompactSupport w →
        HasCompactSupport q →
          ∀ (x u v : ℂ) (z : ℝ),
            MeasureTheory.Integrable (fun t => OQ7Prescribed.horizontalSlabTransverseKernel k (z - t) w x u v * q t)
              MeasureTheory.volume
OQ7Prescribed.scalarOutgoingSlabTransverse_separation : ∀ (k : ℝ) (w : ℂ → ℂ) (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ContDiff ℝ (↑⊤) q →
      HasCompactSupport w →
        HasCompactSupport q →
          ∀ (x u v : ℂ) (z : ℝ),
            OQ7Prescribed.scalarOutgoingSlabTransverse k w q x z u v =
              ∫ (t : ℝ), OQ7Prescribed.horizontalSlabTransverseKernel k (z - t) w x u v * q t
OQ7Prescribed.scalarOutgoingSlabTransverse_uniform_aperture_error : ∀ (k : ℝ),
  0 < k →
    ∀ (w : ℂ → ℂ),
      ContDiff ℝ (↑⊤) w →
        HasCompactSupport w →
          ∀ (A X L : ℝ),
            0 ≤ A →
              0 ≤ X →
                0 ≤ L →
                  tsupport w ⊆ Metric.closedBall 0 A →
                    ∃ C,
                      0 < C ∧
                        ∀ (q : ℝ → ℂ),
                          ContDiff ℝ (↑⊤) q →
                            HasCompactSupport q →
                              tsupport q ⊆ Set.Icc 0 L →
                                ∀ (R z : ℝ) (x u v : ℂ),
                                  1 ≤ R →
                                    z ∈ Set.Icc 0 L →
                                      ‖x‖ ≤ X * R →
                                        ‖u‖ ≤ 1 →
                                          ‖v‖ ≤ 1 →
                                            ‖OQ7Prescribed.scalarOutgoingSlabTransverse k
                                                    (OQ7Prescribed.scaledApertureWindow w R) q x z u v -
                                                  OQ7Prescribed.planarSlabTransverse k
                                                    (OQ7Prescribed.scaledApertureWindow w R) q x z u v‖ ≤
                                              C / R * ∫ (t : ℝ), ‖q t‖
@OQ7Prescribed.scalarPiecewiseL2_coe : ∀ {α : Type u_1} [inst : MeasurableSpace α] (μ : MeasureTheory.Measure α)
  (s : Set α) (hs : MeasurableSet s) (a b : ℂ) (f : ↥(MeasureTheory.Lp ℂ 2 μ)),
  ↑↑((OQ7Prescribed.scalarPiecewiseL2 μ s hs a b) f) =ᵐ[μ] fun x => if x ∈ s then a * ↑↑f x else b * ↑↑f x
@OQ7Prescribed.scalarPiecewiseL2_norm_le : ∀ {α : Type u_1} [inst : MeasurableSpace α] (μ : MeasureTheory.Measure α)
  (s : Set α) (hs : MeasurableSet s) (a b : ℂ),
  ‖a‖ ≤ 1 → ‖b‖ ≤ 1 → ∀ (f : ↥(MeasureTheory.Lp ℂ 2 μ)), ‖(OQ7Prescribed.scalarPiecewiseL2 μ s hs a b) f‖ ≤ ‖f‖
OQ7Prescribed.scalarPlanarPotential_add : ∀ (k : ℝ),
  0 < k →
    ∀ (q r : ℝ → ℂ),
      MeasureTheory.Integrable q MeasureTheory.volume →
        MeasureTheory.Integrable r MeasureTheory.volume →
          (OQ7Prescribed.scalarPlanarPotential k fun t => q t + r t) = fun z =>
            OQ7Prescribed.scalarPlanarPotential k q z + OQ7Prescribed.scalarPlanarPotential k r z
OQ7Prescribed.scalarPlanarPotential_congr_ae : ∀ (k : ℝ) (q r : ℝ → ℂ),
  q =ᵐ[MeasureTheory.volume] r → OQ7Prescribed.scalarPlanarPotential k q = OQ7Prescribed.scalarPlanarPotential k r
OQ7Prescribed.scalarPlanarPotential_contDiff : ∀ (k : ℝ) (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) q → HasCompactSupport q → ContDiff ℝ (↑⊤) (OQ7Prescribed.scalarPlanarPotential k q)
OQ7Prescribed.scalarPlanarPotential_continuous_integrable : ∀ (k : ℝ),
  0 < k →
    ∀ (q : ℝ → ℂ),
      MeasureTheory.Integrable q MeasureTheory.volume → Continuous (OQ7Prescribed.scalarPlanarPotential k q)
OQ7Prescribed.scalarPlanarPotential_convolution : ∀ (k : ℝ) (q : ℝ → ℂ),
  OQ7Prescribed.scalarPlanarPotential k q =
    MeasureTheory.convolution q (OQ7Prescribed.planarScalarGreen k) (ContinuousLinearMap.mul ℝ ℂ) MeasureTheory.volume
OQ7Prescribed.scalarPlanarPotential_height_memLp : ∀ (k : ℝ),
  0 < k →
    ∀ (q : ℝ → ℂ),
      MeasureTheory.Integrable q MeasureTheory.volume →
        ∀ (L : ℝ),
          MeasureTheory.MemLp ((Set.Icc 0 L).indicator (OQ7Prescribed.scalarPlanarPotential k q)) 2 MeasureTheory.volume
OQ7Prescribed.scalarPlanarPotential_height_norm_bound : ∀ (k : ℝ) (hk : 0 < k) (q : ℝ → ℂ)
  (hq : MeasureTheory.Integrable q MeasureTheory.volume) (L : ℝ),
  0 ≤ L →
    ‖MeasureTheory.MemLp.toLp ((Set.Icc 0 L).indicator (OQ7Prescribed.scalarPlanarPotential k q)) ⋯‖ ≤
      √L * (1 / (2 * k)) * ∫ (t : ℝ), ‖q t‖
OQ7Prescribed.scalarPlanarPotential_integrand_integrable : ∀ (k : ℝ),
  0 < k →
    ∀ (q : ℝ → ℂ),
      MeasureTheory.Integrable q MeasureTheory.volume →
        ∀ (z : ℝ),
          MeasureTheory.Integrable (fun t => OQ7Prescribed.planarScalarGreen k (z - t) * q t) MeasureTheory.volume
OQ7Prescribed.scalarPlanarPotential_layer_current : ∀ (k a b L : ℝ) (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ L)
  (F : OQ7Prescribed.PlanarLayerField k a b) (z : ℝ),
  OQ7Prescribed.scalarPlanarPotential k (↑↑↑(OQ7Prescribed.planarLayerL2Current k a b L ha hab hb F)) z =
    ∫ (t : ℝ) in a..b, OQ7Prescribed.planarScalarGreen k (z - t) * F.current t
OQ7Prescribed.scalarPlanarPotential_layer_exterior_left : ∀ (k a b L : ℝ),
  k ≠ 0 →
    ∀ (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ L) (F : OQ7Prescribed.PlanarLayerField k a b),
      ∀ z ≤ a,
        k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑(OQ7Prescribed.planarLayerL2Current k a b L ha hab hb F)) z =
          1 / 2 * OQ7Prescribed.apertureOscillation k (b - z) * (F.magnetic b - F.electric b) -
            1 / 2 * OQ7Prescribed.apertureOscillation k (a - z) * (F.magnetic a - F.electric a)
OQ7Prescribed.scalarPlanarPotential_layer_exterior_right : ∀ (k a b L : ℝ),
  k ≠ 0 →
    ∀ (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ L) (F : OQ7Prescribed.PlanarLayerField k a b) (z : ℝ),
      b ≤ z →
        k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑(OQ7Prescribed.planarLayerL2Current k a b L ha hab hb F)) z =
          1 / 2 * OQ7Prescribed.apertureOscillation k (z - b) * (F.magnetic b + F.electric b) -
            1 / 2 * OQ7Prescribed.apertureOscillation k (z - a) * (F.magnetic a + F.electric a)
OQ7Prescribed.scalarPlanarPotential_layer_interior : ∀ (k a b L : ℝ),
  k ≠ 0 →
    ∀ (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ L) (F : OQ7Prescribed.PlanarLayerField k a b),
      ∀ z ∈ Set.Icc a b,
        k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑(OQ7Prescribed.planarLayerL2Current k a b L ha hab hb F)) z =
          F.electric z - 1 / 2 * OQ7Prescribed.apertureOscillation k (z - a) * (F.magnetic a + F.electric a) +
            1 / 2 * OQ7Prescribed.apertureOscillation k (b - z) * (F.magnetic b - F.electric b)
OQ7Prescribed.scalarPlanarPotential_norm_bound : ∀ (k : ℝ),
  0 < k →
    ∀ (q : ℝ → ℂ),
      MeasureTheory.Integrable q MeasureTheory.volume →
        ∀ (z : ℝ), ‖OQ7Prescribed.scalarPlanarPotential k q z‖ ≤ 1 / (2 * k) * ∫ (t : ℝ), ‖q t‖
OQ7Prescribed.scalarPlanarPotential_smul : ∀ (k : ℝ) (q : ℝ → ℂ) (a : ℂ),
  (OQ7Prescribed.scalarPlanarPotential k fun t => a * q t) = fun z => a * OQ7Prescribed.scalarPlanarPotential k q z
OQ7Prescribed.scalarPlanarPotential_supported_add : ∀ (k : ℝ),
  0 < k →
    ∀ (L : ℝ),
      0 ≤ L →
        ∀ (q r : ↥(OQ7Prescribed.PlanarCurrentL2 L)) (z : ℝ),
          k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑(q + r)) z =
            k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑q) z +
              k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑r) z
OQ7Prescribed.scalarPlanarPotential_supported_smul : ∀ (k L : ℝ) (q : ↥(OQ7Prescribed.PlanarCurrentL2 L)) (c : ℂ)
  (z : ℝ),
  k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑(c • q)) z =
    c * k ^ 2 • OQ7Prescribed.scalarPlanarPotential k (↑↑↑q) z
OQ7Prescribed.scalarPlanarPotential_twoLayer_representation : ∀ (k h L z : ℝ),
  k ≠ 0 →
    ∀ (hh : 0 ≤ h) (hL : h ≤ L),
      z ∈ Set.Icc 0 L →
        ∀ (A : OQ7Prescribed.PlanarLayerField k 0 h) (W : OQ7Prescribed.PlanarLayerField k h L),
          A.electric h = W.electric h →
            A.magnetic h = W.magnetic h →
              k ^ 2 •
                  OQ7Prescribed.scalarPlanarPotential k (↑↑↑(OQ7Prescribed.planarTwoLayerL2Current k h L hh hL A W)) z =
                (if z ≤ h then A.electric z else W.electric z) -
                    1 / 2 * OQ7Prescribed.apertureOscillation k z * (A.magnetic 0 + A.electric 0) +
                  1 / 2 * OQ7Prescribed.apertureOscillation k (L - z) * (W.magnetic L - W.electric L)
OQ7Prescribed.scalarTest_global_lipschitz : ∀ (φ : OQ7Prescribed.ScalarTest), ∃ L, LipschitzWith L ⇑φ
OQ7Prescribed.scalarTest_support_radius : ∀ (φ : OQ7Prescribed.ScalarTest),
  ∃ S, 0 < S ∧ ∀ (x : OQ7Prescribed.Position), φ x ≠ 0 → ‖x‖ ≤ S
OQ7Prescribed.scalarTestSchwartz_apply : ∀ (φ : OQ7Prescribed.ScalarTest) (x : OQ7Prescribed.Position),
  (OQ7Prescribed.scalarTestSchwartz φ) x = ↑(φ x)
OQ7Prescribed.scalarTestSchwartz_fderiv_basis : ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3)
  (x : OQ7Prescribed.Position),
  (fderiv ℝ (⇑(OQ7Prescribed.scalarTestSchwartz φ)) x) (OQ7Prescribed.basisR i) = ↑(((OQ7Prescribed.testPartial i) φ) x)
OQ7Prescribed.scalarTestSchwartz_hasCompactSupport : ∀ (φ : OQ7Prescribed.ScalarTest),
  HasCompactSupport ⇑(OQ7Prescribed.scalarTestSchwartz φ)
OQ7Prescribed.scalarTestSchwartz_partial : ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  LineDeriv.lineDerivOp (OQ7Prescribed.basisR i) (OQ7Prescribed.scalarTestSchwartz φ) =
    OQ7Prescribed.scalarTestSchwartz ((OQ7Prescribed.testPartial i) φ)
OQ7Prescribed.scalarVectorConvolution_ae_integrable : ∀ (K : OQ7Prescribed.Position → ℂ) (f : OQ7Prescribed.Field),
  MeasureTheory.Integrable K MeasureTheory.volume →
    MeasureTheory.Integrable f MeasureTheory.volume →
      ∀ᵐ (x : OQ7Prescribed.Position), MeasureTheory.Integrable (fun y => K y • f (x - y)) MeasureTheory.volume
OQ7Prescribed.scalarVectorConvolution_memLp_two : ∀ (K : OQ7Prescribed.Position → ℂ) (f : OQ7Prescribed.Field),
  MeasureTheory.Integrable K MeasureTheory.volume →
    MeasureTheory.Integrable f MeasureTheory.volume →
      MeasureTheory.MemLp f 2 MeasureTheory.volume →
        MeasureTheory.MemLp (OQ7Prescribed.scalarVectorConvolution K f) 2 MeasureTheory.volume ∧
          ∫ (x : OQ7Prescribed.Position), ‖OQ7Prescribed.scalarVectorConvolution K f x‖ ^ 2 ≤
            (∫ (y : OQ7Prescribed.Position), ‖K y‖) ^ 2 * ∫ (x : OQ7Prescribed.Position), ‖f x‖ ^ 2
OQ7Prescribed.scaled_pairing_real : ∀ (a : ℂ) (E C : OQ7Prescribed.Vector),
  (OQ7Prescribed.pairing (a • E) (a • C)).re = ‖a‖ ^ 2 * (OQ7Prescribed.pairing E C).re
OQ7Prescribed.scaledApertureWindow_contDiff : ∀ (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w → ∀ (R : ℝ), ContDiff ℝ (↑⊤) (OQ7Prescribed.scaledApertureWindow w R)
OQ7Prescribed.scaledApertureWindow_hasCompactSupport : ∀ (w : ℂ → ℂ),
  HasCompactSupport w → ∀ (R : ℝ), R ≠ 0 → HasCompactSupport (OQ7Prescribed.scaledApertureWindow w R)
OQ7Prescribed.scaledApertureWindow_integral_norm_sq : ∀ (w : ℂ → ℂ) (R : ℝ),
  0 < R → ∫ (x : ℂ), ‖OQ7Prescribed.scaledApertureWindow w R x‖ ^ 2 = R ^ 2 * ∫ (x : ℂ), ‖w x‖ ^ 2
OQ7Prescribed.scaledApertureWindow_iteratedFDeriv : ∀ (n : ℕ) (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ∀ (R : ℝ) (x : ℂ),
      iteratedFDeriv ℝ n (OQ7Prescribed.scaledApertureWindow w R) x = R⁻¹ ^ n • iteratedFDeriv ℝ n w (R⁻¹ • x)
OQ7Prescribed.scaledApertureWindow_jetBound : ∀ (n : ℕ) (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ∀ (R C : ℝ),
      0 < R →
        (∀ (y : ℂ), ‖iteratedFDeriv ℝ n w y‖ ≤ C) →
          ∀ (x : ℂ), ‖iteratedFDeriv ℝ n (OQ7Prescribed.scaledApertureWindow w R) x‖ ≤ C / R ^ n
OQ7Prescribed.scaledApertureWindow_L2_norm : ∀ (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w) (hc : HasCompactSupport w) (R : ℝ)
  (hR : 0 < R),
  ‖MeasureTheory.MemLp.toLp (OQ7Prescribed.scaledApertureWindow w R) ⋯‖ = R * ‖MeasureTheory.MemLp.toLp w ⋯‖
OQ7Prescribed.scaledApertureWindow_second_jetBound : ∀ (n : ℕ) (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ∀ (R C : ℝ),
      0 < R →
        (∀ (y : ℂ), ‖iteratedFDeriv ℝ (n + 2) w y‖ ≤ C) →
          ∀ (u v : ℂ),
            ‖u‖ ≤ 1 →
              ‖v‖ ≤ 1 →
                ∀ (x : ℂ),
                  ‖iteratedFDeriv ℝ n (OQ7Prescribed.apertureWindowSecond (OQ7Prescribed.scaledApertureWindow w R) u v)
                        x‖ ≤
                    C / R ^ (n + 2)
