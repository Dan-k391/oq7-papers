  ∃ S, 0 < S ∧ ∀ (x : OQ7Prescribed.Position), φ x ≠ 0 → ‖x‖ ≤ S
OQ7Prescribed.scalarTestSchwartz_apply : ∀ (φ : OQ7Prescribed.ScalarTest) (x : OQ7Prescribed.Position),
  (OQ7Prescribed.scalarTestSchwartz φ) x = ↑(φ x)
OQ7Prescribed.scalarTestSchwartz_fderiv_basis : ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3)
  (x : OQ7Prescribed.Position),
  (fderiv ℝ (⇑(OQ7Prescribed.scalarTestSchwartz φ)) x) (OQ7Prescribed.basisR i) = ↑(((OQ7Prescribed.testPartial i) φ) x)
OQ7Prescribed.scalarTestSchwartz_hasCompactSupport : ∀ (φ : OQ7Prescribed.ScalarTest),
  HasCompactSupport ⇑(OQ7Prescribed.scalarTestSchwartz φ)
OQ7Prescribed.scalarTestSchwartz_partial : ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  LineDeriv.lineDerivOp (OQ7Prescribed.basisR i) (OQ7Prescribed.scalarTestSchwartz φ) =
    OQ7Prescribed.scalarTestSchwartz ((OQ7Prescribed.testPartial i) φ)
OQ7Prescribed.scalarVectorConvolution_ae_integrable : ∀ (K : OQ7Prescribed.Position → ℂ) (f : OQ7Prescribed.Field),
  MeasureTheory.Integrable K MeasureTheory.volume →
    MeasureTheory.Integrable f MeasureTheory.volume →
      ∀ᵐ (x : OQ7Prescribed.Position), MeasureTheory.Integrable (fun y => K y • f (x - y)) MeasureTheory.volume
OQ7Prescribed.scalarVectorConvolution_memLp_two : ∀ (K : OQ7Prescribed.Position → ℂ) (f : OQ7Prescribed.Field),
  MeasureTheory.Integrable K MeasureTheory.volume →
    MeasureTheory.Integrable f MeasureTheory.volume →
      MeasureTheory.MemLp f 2 MeasureTheory.volume →
        MeasureTheory.MemLp (OQ7Prescribed.scalarVectorConvolution K f) 2 MeasureTheory.volume ∧
          ∫ (x : OQ7Prescribed.Position), ‖OQ7Prescribed.scalarVectorConvolution K f x‖ ^ 2 ≤
            (∫ (y : OQ7Prescribed.Position), ‖K y‖) ^ 2 * ∫ (x : OQ7Prescribed.Position), ‖f x‖ ^ 2
@OQ7Prescribed.setRestrictionCLM_inner : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [inst_3 : CompleteSpace E]
  (μ : MeasureTheory.Measure α) (s : Set α) (hs : MeasurableSet s) (f : ↥(OQ7Prescribed.SetSupportedL2 μ s))
  (g : ↥(MeasureTheory.Lp E 2 μ)), inner ℂ ↑f ↑((OQ7Prescribed.setRestrictionCLM μ s hs) g) = inner ℂ (↑f) g
@OQ7Prescribed.setRestrictionCLM_norm_le : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [inst_3 : CompleteSpace E]
  (μ : MeasureTheory.Measure α) (s : Set α) (hs : MeasurableSet s), ‖OQ7Prescribed.setRestrictionCLM μ s hs‖ ≤ 1
@OQ7Prescribed.setSupportedL2_isClosed : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α)
  (s : Set α), MeasurableSet s → IsClosed ↑(OQ7Prescribed.setSupportedL2 μ s)
OQ7Prescribed.shrinking_cutoff_integral_tendsto : ∀ (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable f MeasureTheory.volume →
    Filter.Tendsto (fun ε => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoff ε ε x * f x)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds (∫ (x : OQ7Prescribed.Position), f x))
OQ7Prescribed.shrinking_cutoff_tendsto : ∀ (x : OQ7Prescribed.Position),
  x ≠ 0 → Filter.Tendsto (fun ε => OQ7Prescribed.exteriorCutoff ε ε x) (nhdsWithin 0 (Set.Ioi 0)) (nhds 1)
OQ7Prescribed.shrinkingCutoffError_integrable : ∀ (ε : ℝ),
  0 < ε →
    ∀ (F : OQ7Prescribed.Position → ℝ),
      (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContinuousAt F x) →
        ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
          MeasureTheory.Integrable (fun x => OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
            MeasureTheory.volume
OQ7Prescribed.shrinkingCutoffError_integrable_and_tendsto : ∀ (F : OQ7Prescribed.Position → ℝ),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContinuousAt F x) →
    (∃ R, 0 < R ∧ ∃ C, 0 ≤ C ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C) →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
        (∀ (ε : ℝ),
            0 < ε →
              MeasureTheory.Integrable (fun x => OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
                MeasureTheory.volume) ∧
          Filter.Tendsto
            (fun ε => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
            (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)
OQ7Prescribed.shrinkingCutoffError_norm_le : ∀ (ε R M C T : ℝ),
  0 < ε →
    2 * ε ≤ R →
      0 ≤ M →
        0 ≤ C →
          0 ≤ T →
            (∀ (s : ℝ), ‖OQ7Prescribed.transitionDerivative s‖ ≤ M) →
              ∀ (F : OQ7Prescribed.Position → ℝ),
                (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C) →
                  ∀ (φ : OQ7Prescribed.ScalarTest),
                    (∀ (x : OQ7Prescribed.Position), ‖φ x‖ ≤ T) →
                      ∀ (i : Fin 3),
                        ‖∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x‖ ≤
                          8 * M * C * T * MeasureTheory.volume.real (Metric.ball 0 1) * ε ^ 2
OQ7Prescribed.shrinkingCutoffError_tendsto : ∀ (F : OQ7Prescribed.Position → ℝ),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContinuousAt F x) →
    (∃ R, 0 < R ∧ ∃ C, 0 ≤ C ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C) →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
        Filter.Tendsto
          (fun ε => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
          (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)
OQ7Prescribed.shrinkingCutoffError_tendsto_of_bound : ∀ (F : OQ7Prescribed.Position → ℝ),
  (∃ R, 0 < R ∧ ∃ C, 0 ≤ C ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C) →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
      Filter.Tendsto (fun ε => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)
OQ7Prescribed.shrinkingCutoffPartial_support : ∀ (ε : ℝ),
  0 < ε → ∀ (i : Fin 3), Function.support (OQ7Prescribed.exteriorCutoffPartial ε ε i) ⊆ Metric.closedBall 0 (2 * ε)
OQ7Prescribed.shrinkingCutoffPoleError_norm_le : ∀ (ε R M C T : ℝ),
  0 < ε →
    2 * ε ≤ R →
      0 ≤ M →
        0 ≤ C →
          0 ≤ T →
            (∀ (s : ℝ), ‖OQ7Prescribed.transitionDerivative s‖ ≤ M) →
              ∀ (F : OQ7Prescribed.Position → ℝ),
                (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C / ‖x‖) →
                  ∀ (φ : OQ7Prescribed.ScalarTest),
                    (∀ (x : OQ7Prescribed.Position), ‖φ x‖ ≤ T) →
                      ∀ (i : Fin 3),
                        ‖∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x‖ ≤
                          8 * M * C * T * MeasureTheory.volume.real (Metric.ball 0 1) * ε
OQ7Prescribed.shrinkingCutoffPoleError_tendsto : ∀ (F : OQ7Prescribed.Position → ℝ),
  (∃ R, 0 < R ∧ ∃ C, 0 ≤ C ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C / ‖x‖) →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
      Filter.Tendsto (fun ε => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)
OQ7Prescribed.smooth_cutoff_flux_integrable : ∀ (k : ℝ) (E H : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) E →
    ContDiff ℝ (↑⊤) H →
      (OQ7Prescribed.curl E = fun x => (Complex.I * ↑k) • H x) →
        ∀ (ψ : OQ7Prescribed.Position → ℝ),
          ContDiff ℝ (↑⊤) ψ →
            HasCompactSupport ψ →
              MeasureTheory.Integrable
                (fun x =>
                  (OQ7Prescribed.pairing (E x)
                      (OQ7Prescribed.cross (H x) (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)))).re)
                MeasureTheory.volume
OQ7Prescribed.smooth_source_cutoff_energy : ∀ (k : ℝ) (E H p : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) E →
    ContDiff ℝ (↑⊤) H →
      Continuous p →
        (OQ7Prescribed.curl E = fun x => (Complex.I * ↑k) • H x) →
          (OQ7Prescribed.curl H = fun x => (-Complex.I * ↑k) • (E x + p x)) →
            ∀ (ψ : OQ7Prescribed.Position → ℝ),
              ContDiff ℝ (↑⊤) ψ →
                HasCompactSupport ψ →
                  k * (∫ (x : OQ7Prescribed.Position), ↑(ψ x) * OQ7Prescribed.pairing (p x) (E x)).im =
                    -∫ (x : OQ7Prescribed.Position),
                        (OQ7Prescribed.pairing (E x)
                            (OQ7Prescribed.cross (H x)
                              (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)))).re
OQ7Prescribed.smoothElectricSource_contDiff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current → ContDiff ℝ (↑⊤) (OQ7Prescribed.smoothElectricSource k p)
OQ7Prescribed.smoothElectricSource_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.curl (OQ7Prescribed.smoothElectricSource k p) = fun x =>
      (Complex.I * ↑k) • OQ7Prescribed.smoothMagneticSource k p x
OQ7Prescribed.smoothElectricSource_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.smoothElectricSource k p) =
      OQ7Prescribed.outgoingVolumeDistribution k p
OQ7Prescribed.smoothElectricSource_eq_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.smoothElectricSource k p =ᵐ[MeasureTheory.volume] OQ7Prescribed.electricVolumeField k p
OQ7Prescribed.smoothField_component_partial : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F →
    ∀ (i j : Fin 3),
      (OQ7Prescribed.distributionPartial j) (OQ7Prescribed.fieldComponentDistribution F i) =
        Distribution.ofFun ⊤ (fun x => ((fderiv ℝ F x) (OQ7Prescribed.basisR j)).ofLp i) MeasureTheory.volume ⊤
OQ7Prescribed.smoothField_curl_contDiff : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F → ContDiff ℝ (↑⊤) (OQ7Prescribed.curl F)
OQ7Prescribed.smoothField_curl_continuous : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F → Continuous (OQ7Prescribed.curl F)
OQ7Prescribed.smoothField_distributionCurl : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F →
    OQ7Prescribed.distributionCurl (OQ7Prescribed.fieldComponentDistribution F) =
      OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.curl F)
OQ7Prescribed.smoothField_hasWeakCurl : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F → OQ7Prescribed.HasWeakCurl F (OQ7Prescribed.curl F)
OQ7Prescribed.smoothField_partial_contDiff : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F → ∀ (j : Fin 3), ContDiff ℝ ↑⊤ fun x => (fderiv ℝ F x) (OQ7Prescribed.basisR j)
OQ7Prescribed.smoothMagneticSource_contDiff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current → ContDiff ℝ (↑⊤) (OQ7Prescribed.smoothMagneticSource k p)
OQ7Prescribed.smoothMagneticSource_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.curl (OQ7Prescribed.smoothMagneticSource k p) = fun x =>
      (-Complex.I * ↑k) • (OQ7Prescribed.smoothElectricSource k p x + p.current x)
OQ7Prescribed.smoothMagneticSource_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.smoothMagneticSource k p) =
      OQ7Prescribed.outgoingMagneticDistribution k p
OQ7Prescribed.smoothMagneticSource_eq_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.smoothMagneticSource k p =ᵐ[MeasureTheory.volume] OQ7Prescribed.magneticVolumeField k p
OQ7Prescribed.smoothPhysicalSource_cutoff_energy : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (ψ : OQ7Prescribed.Position → ℝ),
      ContDiff ℝ (↑⊤) ψ →
        HasCompactSupport ψ →
          k *
              (∫ (x : OQ7Prescribed.Position),
                  ↑(ψ x) * OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.smoothElectricSource k p x)).im =
            -∫ (x : OQ7Prescribed.Position),
                (OQ7Prescribed.pairing (OQ7Prescribed.smoothElectricSource k p x)
                    (OQ7Prescribed.cross (OQ7Prescribed.smoothMagneticSource k p x)
                      (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)))).re
OQ7Prescribed.smoothPhysicalSource_flux_lower_bound_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ᵐ (x : OQ7Prescribed.Position),
      2 * p.radius + 2 ≤ ‖x‖ →
        -((OQ7Prescribed.magneticDecayConstant k / ‖x‖ * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖) *
              (OQ7Prescribed.radiationKernelConstant k p.radius / ‖x‖ ^ 2 *
                ∫ (y : OQ7Prescribed.Position), ‖p.current y‖)) ≤
          (OQ7Prescribed.pairing (OQ7Prescribed.smoothElectricSource k p x)
              (OQ7Prescribed.cross (OQ7Prescribed.smoothMagneticSource k p x)
                (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re
OQ7Prescribed.smoothPhysicalSource_radial_energy : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (r : ℝ),
      0 < r →
        p.radius ≤ r →
          k *
              (∫ (x : OQ7Prescribed.Position),
                  OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.smoothElectricSource k p x)).im =
            ∫ (x : OQ7Prescribed.Position),
              OQ7Prescribed.sourceEnergyWeight r x *
                (OQ7Prescribed.pairing (OQ7Prescribed.smoothElectricSource k p x)
                    (OQ7Prescribed.cross (OQ7Prescribed.smoothMagneticSource k p x)
                      (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re
OQ7Prescribed.smoothPhysicalSource_radial_flux_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (r : ℝ),
      0 < r →
        MeasureTheory.Integrable
          (fun x =>
            OQ7Prescribed.sourceEnergyWeight r x *
              (OQ7Prescribed.pairing (OQ7Prescribed.smoothElectricSource k p x)
                  (OQ7Prescribed.cross (OQ7Prescribed.smoothMagneticSource k p x)
                    (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re)
          MeasureTheory.volume
OQ7Prescribed.smoothPhysicalSource_work_lower_bound : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (M : ℝ),
      0 ≤ M →
        (∀ (s : ℝ), OQ7Prescribed.transitionDerivative s ≤ M) →
          ∀ (r : ℝ),
            0 < r →
              2 * p.radius + 2 ≤ r →
                -(32 * Real.pi / 3 * OQ7Prescribed.sourceEnergyErrorConstant k p M / r) ≤
                  k *
                    (∫ (x : OQ7Prescribed.Position),
                        OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.smoothElectricSource k p x)).im
OQ7Prescribed.smoothPhysicalSource_work_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (p : OQ7Prescribed.CompactPolarization),
      ContDiff ℝ (↑⊤) p.current →
        0 ≤
          (∫ (x : OQ7Prescribed.Position),
              OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.smoothElectricSource k p x)).im
OQ7Prescribed.smoothScalar_distributionPartial : ∀ (f : OQ7Prescribed.Position → ℂ),
  ContDiff ℝ (↑⊤) f →
    ∀ (j : Fin 3),
      (OQ7Prescribed.distributionPartial j) (Distribution.ofFun ⊤ f MeasureTheory.volume ⊤) =
        Distribution.ofFun ⊤ (fun x => (fderiv ℝ f x) (OQ7Prescribed.basisR j)) MeasureTheory.volume ⊤
OQ7Prescribed.sourceEnergyCutoff_contDiff : ∀ (r : ℝ), 0 < r → ContDiff ℝ (↑⊤) (OQ7Prescribed.sourceEnergyCutoff r)
OQ7Prescribed.sourceEnergyCutoff_current_work : ∀ (p : OQ7Prescribed.CompactPolarization) (E : OQ7Prescribed.Field)
  (r : ℝ),
  0 < r →
    p.radius ≤ r →
      (fun x => ↑(OQ7Prescribed.sourceEnergyCutoff r x) * OQ7Prescribed.pairing (p.current x) (E x)) = fun x =>
        OQ7Prescribed.pairing (p.current x) (E x)
OQ7Prescribed.sourceEnergyCutoff_gradient : ∀ (r : ℝ),
  0 < r →
    ∀ (x : OQ7Prescribed.Position),
      OQ7Prescribed.scalarGradient (OQ7Prescribed.sourceEnergyCutoff r) x =
        -OQ7Prescribed.sourceEnergyWeight r x • OQ7Prescribed.radialDirection x
OQ7Prescribed.sourceEnergyCutoff_hasCompactSupport : ∀ (r : ℝ),
  0 < r → HasCompactSupport (OQ7Prescribed.sourceEnergyCutoff r)
OQ7Prescribed.sourceEnergyErrorConstant_nonneg : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (M : ℝ),
  0 ≤ M → 0 ≤ OQ7Prescribed.sourceEnergyErrorConstant k p M
OQ7Prescribed.sourceEnergyWeight_continuous : ∀ (r : ℝ), Continuous (OQ7Prescribed.sourceEnergyWeight r)
OQ7Prescribed.sourceEnergyWeight_hasCompactSupport : ∀ (r : ℝ),
  0 < r → HasCompactSupport (OQ7Prescribed.sourceEnergyWeight r)
OQ7Prescribed.sourceEnergyWeight_le : ∀ (r M : ℝ),
  0 < r →
    (∀ (s : ℝ), OQ7Prescribed.transitionDerivative s ≤ M) →
      ∀ (x : OQ7Prescribed.Position), OQ7Prescribed.sourceEnergyWeight r x ≤ M / r
OQ7Prescribed.sourceEnergyWeight_nonneg : ∀ (r : ℝ),
  0 < r → ∀ (x : OQ7Prescribed.Position), 0 ≤ OQ7Prescribed.sourceEnergyWeight r x
OQ7Prescribed.sourceEnergyWeight_zero_inner : ∀ (r : ℝ),
  0 < r → ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ r → OQ7Prescribed.sourceEnergyWeight r x = 0
OQ7Prescribed.sourceEnergyWeight_zero_outer : ∀ (r : ℝ),
  0 < r → ∀ (x : OQ7Prescribed.Position), 2 * r ≤ ‖x‖ → OQ7Prescribed.sourceEnergyWeight r x = 0
OQ7Prescribed.sphere_coordinate_cross_zero : ∀ (i j : Fin 3),
  i ≠ j → ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i * (↑n).ofLp j ∂OQ7Prescribed.sphereArea = 0
OQ7Prescribed.sphere_coordinate_mul_integrable : ∀ (i j : Fin 3),
  MeasureTheory.Integrable (fun n => (↑n).ofLp i * (↑n).ofLp j) OQ7Prescribed.sphereArea
OQ7Prescribed.sphere_coordinate_sq_equal : ∀ (i j : Fin 3),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i ^ 2 ∂OQ7Prescribed.sphereArea =
    ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp j ^ 2 ∂OQ7Prescribed.sphereArea
OQ7Prescribed.sphere_coordinate_sq_integral : ∀ (i : Fin 3),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i ^ 2 ∂OQ7Prescribed.sphereArea = 4 * Real.pi / 3
OQ7Prescribed.sphere_integral_orthogonal : ∀ (e : OQ7Prescribed.Position ≃ₗᵢ[ℝ] OQ7Prescribed.Position)
  (f : ↑OQ7Prescribed.UnitSphere → ℝ),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), f ((OQ7Prescribed.orthogonalSphere e) n) ∂OQ7Prescribed.sphereArea =
    ∫ (n : ↑OQ7Prescribed.UnitSphere), f n ∂OQ7Prescribed.sphereArea
OQ7Prescribed.sphere_newton_angular_cancellation : ∀ (i j : Fin 3),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), 3 * (↑n).ofLp i * (↑n).ofLp j - if i = j then 1 else 0 ∂OQ7Prescribed.sphereArea =
    0
OQ7Prescribed.sphere_second_moment : ∀ (i j : Fin 3),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i * (↑n).ofLp j ∂OQ7Prescribed.sphereArea =
    if i = j then 4 * Real.pi / 3 else 0
OQ7Prescribed.sphere_test_derivative_continuous : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  Continuous fun r =>
    ∫ (n : ↑OQ7Prescribed.UnitSphere),
      (↑n).ofLp j * ((OQ7Prescribed.testPartial i) φ) (r • ↑n) ∂OQ7Prescribed.sphereArea
OQ7Prescribed.sphere_test_moment_continuous : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  Continuous fun r =>
    ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i * (↑n).ofLp j * φ (r • ↑n) ∂OQ7Prescribed.sphereArea
OQ7Prescribed.sphere_test_moment_zero : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i * (↑n).ofLp j * φ (0 • ↑n) ∂OQ7Prescribed.sphereArea =
    (if i = j then 4 * Real.pi / 3 else 0) * φ 0
OQ7Prescribed.sphereArea_real_univ : OQ7Prescribed.sphereArea.real Set.univ = 4 * Real.pi
OQ7Prescribed.sphereDirection_unit : ∀ (θ φ : ℝ), ‖OQ7Prescribed.sphereDirection θ φ‖ ^ 2 = 1
OQ7Prescribed.squareNorm_eq_norm_sq : ∀ (v : OQ7Prescribed.Vector), OQ7Prescribed.squareNorm v = ‖v‖ ^ 2
OQ7Prescribed.squareNorm_nonneg : ∀ (v : OQ7Prescribed.Vector), 0 ≤ OQ7Prescribed.squareNorm v
@OQ7Prescribed.squareNorm_pos : ∀ {v : OQ7Prescribed.Vector}, v ≠ 0 → 0 < OQ7Prescribed.squareNorm v
OQ7Prescribed.staticFourierOperator_apply_norm_le : ∀ (f : ↥OQ7Prescribed.VectorL2),
  ‖OQ7Prescribed.staticFourierOperator f‖ ≤ ‖f‖
OQ7Prescribed.staticFourierOperator_component_distribution_apply : ∀ (f : ↥OQ7Prescribed.VectorL2) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.vectorL2ComponentDistribution (OQ7Prescribed.staticFourierOperator f) i) φ =
    ∑ j,
      ∫ (ξ : OQ7Prescribed.Position),
        (FourierTransformInv.fourierInv (OQ7Prescribed.scalarTestSchwartz φ)) ξ *
            OQ7Prescribed.newtonHessianFrequency i j ξ *
          (↑↑(FourierTransform.fourier f) ξ).ofLp j
OQ7Prescribed.staticFourierOperator_distribution_apply : ∀ (f : ↥OQ7Prescribed.VectorL2) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.vectorL2Distribution (OQ7Prescribed.staticFourierOperator f)) φ =
    ∫ (ξ : OQ7Prescribed.Position),
      (FourierTransformInv.fourierInv (OQ7Prescribed.scalarTestSchwartz φ)) ξ •
        (OQ7Prescribed.staticSymbol ξ) (↑↑(FourierTransform.fourier f) ξ)
OQ7Prescribed.staticFourierOperator_entry_pairing_integrable : ∀ (f : ↥OQ7Prescribed.VectorL2)
  (φ : SchwartzMap OQ7Prescribed.Position ℂ) (i j : Fin 3),
  MeasureTheory.Integrable (fun ξ => φ ξ * OQ7Prescribed.newtonHessianFrequency i j ξ * (↑↑f ξ).ofLp j)
    MeasureTheory.volume
OQ7Prescribed.staticFourierOperator_norm_le : ‖OQ7Prescribed.staticFourierOperator‖ ≤ 1
OQ7Prescribed.staticFourierOperator_pairing_integrable : ∀ (f : ↥OQ7Prescribed.VectorL2)
  (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun ξ => φ ξ • (OQ7Prescribed.staticSymbol ξ) (↑↑f ξ)) MeasureTheory.volume
OQ7Prescribed.staticFourierOperator_quadratic_im : ∀ (f : ↥OQ7Prescribed.VectorL2),
  (inner ℂ f (OQ7Prescribed.staticFourierOperator f)).im = 0
OQ7Prescribed.staticFourierOperator_tempered_apply : ∀ (f : ↥OQ7Prescribed.VectorL2)
  (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  (MeasureTheory.Lp.toTemperedDistribution (OQ7Prescribed.staticFourierOperator f)) φ =
    ∫ (ξ : OQ7Prescribed.Position),
      (FourierTransformInv.fourierInv φ) ξ • (OQ7Prescribed.staticSymbol ξ) (↑↑(FourierTransform.fourier f) ξ)
OQ7Prescribed.staticMultiplierCLM_norm_le : ‖OQ7Prescribed.staticMultiplierCLM‖ ≤ 1
OQ7Prescribed.staticMultiplierLp_add : ∀ (f g : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.staticMultiplierLp (f + g) = OQ7Prescribed.staticMultiplierLp f + OQ7Prescribed.staticMultiplierLp g
OQ7Prescribed.staticMultiplierLp_coe : ∀ (f : ↥OQ7Prescribed.VectorL2),
  ↑↑(OQ7Prescribed.staticMultiplierLp f) =ᵐ[MeasureTheory.volume] fun ξ => (OQ7Prescribed.staticSymbol ξ) (↑↑f ξ)
OQ7Prescribed.staticMultiplierLp_norm_le : ∀ (f : ↥OQ7Prescribed.VectorL2), ‖OQ7Prescribed.staticMultiplierLp f‖ ≤ ‖f‖
OQ7Prescribed.staticMultiplierLp_quadratic_im : ∀ (f : ↥OQ7Prescribed.VectorL2),
  (inner ℂ f (OQ7Prescribed.staticMultiplierLp f)).im = 0
OQ7Prescribed.staticMultiplierLp_smul : ∀ (z : ℂ) (f : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.staticMultiplierLp (z • f) = z • OQ7Prescribed.staticMultiplierLp f
OQ7Prescribed.staticMultiplierWithOriginLp_eq : ∀ (A : OQ7Prescribed.Vector →L[ℂ] OQ7Prescribed.Vector)
  (f : ↥OQ7Prescribed.VectorL2), OQ7Prescribed.staticMultiplierWithOriginLp A f = OQ7Prescribed.staticMultiplierLp f
OQ7Prescribed.staticSymbol_apply : ∀ (ξ : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (OQ7Prescribed.staticSymbol ξ) v = -↑(‖ξ‖ ^ 2)⁻¹ • OQ7Prescribed.tensorApply (OQ7Prescribed.rankOne ξ) v
OQ7Prescribed.staticSymbol_apply_norm_le : ∀ (ξ : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  ‖(OQ7Prescribed.staticSymbol ξ) v‖ ≤ ‖v‖
OQ7Prescribed.staticSymbol_coordinate : ∀ (ξ : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector) (i : Fin 3),
  ((OQ7Prescribed.staticSymbol ξ) v).ofLp i = ∑ j, ↑(-(ξ.ofLp i * ξ.ofLp j) / ‖ξ‖ ^ 2) * v.ofLp j
OQ7Prescribed.staticSymbol_memLp : ∀ (f : ↥OQ7Prescribed.VectorL2),
  MeasureTheory.MemLp (fun ξ => (OQ7Prescribed.staticSymbol ξ) (↑↑f ξ)) 2 MeasureTheory.volume
OQ7Prescribed.staticSymbol_norm_le : ∀ (ξ : OQ7Prescribed.Position), ‖OQ7Prescribed.staticSymbol ξ‖ ≤ 1
OQ7Prescribed.staticSymbol_quadratic : ∀ (ξ : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  inner ℂ v ((OQ7Prescribed.staticSymbol ξ) v) = -↑(‖ξ‖ ^ 2)⁻¹ * ↑(Complex.normSq (OQ7Prescribed.axisCoupling ξ v))
OQ7Prescribed.staticSymbol_quadratic_im : ∀ (ξ : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (inner ℂ v ((OQ7Prescribed.staticSymbol ξ) v)).im = 0
OQ7Prescribed.staticSymbol_zero : OQ7Prescribed.staticSymbol 0 = 0
OQ7Prescribed.staticSymbol_zero_apply : ∀ (v : OQ7Prescribed.Vector), (OQ7Prescribed.staticSymbol 0) v = 0
OQ7Prescribed.staticSymbolWithOrigin_ae_eq : ∀ (A : OQ7Prescribed.Vector →L[ℂ] OQ7Prescribed.Vector),
  OQ7Prescribed.staticSymbolWithOrigin A =ᵐ[MeasureTheory.volume] OQ7Prescribed.staticSymbol
OQ7Prescribed.staticSymbolWithOrigin_apply_ae_eq : ∀ (A : OQ7Prescribed.Vector →L[ℂ] OQ7Prescribed.Vector)
  (f : ↥OQ7Prescribed.VectorL2),
  (fun ξ => (OQ7Prescribed.staticSymbolWithOrigin A ξ) (↑↑f ξ)) =ᵐ[MeasureTheory.volume] fun ξ =>
    (OQ7Prescribed.staticSymbol ξ) (↑↑f ξ)
OQ7Prescribed.staticSymbolWithOrigin_memLp : ∀ (A : OQ7Prescribed.Vector →L[ℂ] OQ7Prescribed.Vector)
  (f : ↥OQ7Prescribed.VectorL2),
  MeasureTheory.MemLp (fun ξ => (OQ7Prescribed.staticSymbolWithOrigin A ξ) (↑↑f ξ)) 2 MeasureTheory.volume
OQ7Prescribed.staticSymbolWithOrigin_zero : ∀ (A : OQ7Prescribed.Vector →L[ℂ] OQ7Prescribed.Vector),
  OQ7Prescribed.staticSymbolWithOrigin A 0 = A
@OQ7Prescribed.supportedConstCLM_coe : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α)
  (s : Set α) (A : E →L[ℂ] E) (f : ↥(OQ7Prescribed.SetSupportedL2 μ s)),
  ↑↑↑((OQ7Prescribed.supportedConstCLM μ s A) f) =ᵐ[μ] fun x => A (↑↑↑f x)
@OQ7Prescribed.supportedConstMap_coe : ∀ {α : Type u_1} {E : Type u_2} {F : Type u_3} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [CompleteSpace E] [inst_4 : NormedAddCommGroup F]
  [inst_5 : InnerProductSpace ℂ F] [CompleteSpace F] (μ : MeasureTheory.Measure α) (s : Set α) (A : E →L[ℂ] F)
  (f : ↥(OQ7Prescribed.SetSupportedL2 μ s)), ↑↑↑((OQ7Prescribed.supportedConstMap μ s A) f) =ᵐ[μ] fun x => A (↑↑↑f x)
OQ7Prescribed.supportedPolarization_add_current_ae : ∀ (R : ℝ) (hR : 0 ≤ R)
  (f g : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  (OQ7Prescribed.supportedPolarization R hR (f + g)).current =ᵐ[MeasureTheory.volume]
    ((OQ7Prescribed.supportedPolarization R hR f).add (OQ7Prescribed.supportedPolarization R hR g)).current
OQ7Prescribed.supportedPolarization_current_ae : ∀ (R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  (OQ7Prescribed.supportedPolarization R hR f).current =ᵐ[MeasureTheory.volume] ↑↑↑f
OQ7Prescribed.supportedPolarization_current_eLpNorm : ∀ (R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  (MeasureTheory.eLpNorm (OQ7Prescribed.supportedPolarization R hR f).current 2 MeasureTheory.volume).toReal = ‖f‖
OQ7Prescribed.supportedPolarization_smul_current_ae : ∀ (R : ℝ) (hR : 0 ≤ R) (z : ℂ)
  (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  (OQ7Prescribed.supportedPolarization R hR (z • f)).current =ᵐ[MeasureTheory.volume]
    (OQ7Prescribed.CompactPolarization.scale z (OQ7Prescribed.supportedPolarization R hR f)).current
OQ7Prescribed.supportedPolarization_toLp : ∀ (R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  MeasureTheory.MemLp.toLp (OQ7Prescribed.supportedPolarization R hR f).current ⋯ = ↑f
@OQ7Prescribed.supportedSliceCLM_coe : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [inst_3 : CompleteSpace E]
  (μ : MeasureTheory.Measure α) (s t : Set α) (ht : MeasurableSet t) (f : ↥(OQ7Prescribed.SetSupportedL2 μ s)),
  ↑↑↑((OQ7Prescribed.supportedSliceCLM μ s t ht) f) =ᵐ[μ] t.indicator fun x => ↑↑↑f x
OQ7Prescribed.supportedVectorL2_current_ae : ∀ (R : ℝ) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ((Metric.closedBall 0 R).indicator fun x => ↑↑↑f x) =ᵐ[MeasureTheory.volume] fun x => ↑↑↑f x
OQ7Prescribed.supportedVectorL2_isClosed : ∀ (R : ℝ), IsClosed ↑(OQ7Prescribed.supportedVectorL2 R)
OQ7Prescribed.susceptibility_quadratic_im : ∀ (T : OQ7Prescribed.Tensor) (v : OQ7Prescribed.Vector),
  (inner ℂ v ((OQ7Prescribed.tensorMap (T - 1)) v)).im = (OQ7Prescribed.quadratic T v).im
OQ7Prescribed.susceptibility_zero_outside : ∀ (B : OQ7Prescribed.TwoLayerBody), ∀ x ∉ B.domain, B.susceptibility x = 0
OQ7Prescribed.tensor_quadratic_eq_inner : ∀ (T : OQ7Prescribed.Tensor) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.quadratic T v = inner ℂ v ((OQ7Prescribed.tensorMap T) v)
OQ7Prescribed.tensorApply_one : ∀ (v : OQ7Prescribed.Vector), OQ7Prescribed.tensorApply 1 v = v
OQ7Prescribed.tensorApply_rankOne : ∀ (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.tensorApply (OQ7Prescribed.rankOne u) v = OQ7Prescribed.axisCoupling u v • OQ7Prescribed.complexify u
OQ7Prescribed.tensorMap_apply : ∀ (T : OQ7Prescribed.Tensor) (v : OQ7Prescribed.Vector),
  (OQ7Prescribed.tensorMap T) v = OQ7Prescribed.tensorApply T v
OQ7Prescribed.tensorMap_smul_apply : ∀ (z : ℂ) (T : OQ7Prescribed.Tensor) (w : OQ7Prescribed.Vector),
  (OQ7Prescribed.tensorMap (z • T)) w = z • (OQ7Prescribed.tensorMap T) w
OQ7Prescribed.testComponent_fderiv : ∀ (φ : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) φ →
    ∀ (i j : Fin 3) (x : OQ7Prescribed.Position),
      (fderiv ℝ (fun y => (φ y).ofLp i) x) (OQ7Prescribed.basisR j) = ((fderiv ℝ φ x) (OQ7Prescribed.basisR j)).ofLp i
OQ7Prescribed.testLaplacian_apply : ∀ (φ : OQ7Prescribed.ScalarTest),
  OQ7Prescribed.testLaplacian φ = ∑ i, (OQ7Prescribed.testPartial i) ((OQ7Prescribed.testPartial i) φ)
OQ7Prescribed.testPartial_commute : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  (OQ7Prescribed.testPartial i) ((OQ7Prescribed.testPartial j) φ) =
    (OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)
OQ7Prescribed.testPartial_eq_fderiv : ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3) (x : OQ7Prescribed.Position),
  ((OQ7Prescribed.testPartial i) φ) x = (fderiv ℝ (⇑φ) x) (OQ7Prescribed.basisR i)
OQ7Prescribed.testPartial_hasLineDerivAt : ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3) (x : OQ7Prescribed.Position),
  HasLineDerivAt ℝ (⇑φ) (((OQ7Prescribed.testPartial i) φ) x) x (OQ7Prescribed.basisR i)
OQ7Prescribed.testPartial_second_eq_fderiv : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3)
  (x : OQ7Prescribed.Position),
  ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x =
    ((fderiv ℝ (fderiv ℝ ⇑φ) x) (OQ7Prescribed.basisR j)) (OQ7Prescribed.basisR i)
OQ7Prescribed.transition_average_tendsto : ∀ (r : ℝ) (A : ℝ → ℝ),
  Continuous A →
    Filter.Tendsto (fun t => ∫ (u : ℝ) in 0..1, OQ7Prescribed.transitionDerivative u * A (r + t * u)) (nhds 0)
      (nhds (A r))
OQ7Prescribed.transition_radial_integral : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (A : ℝ → ℝ),
        ∫ (s : ℝ) in Set.Ioi 0, OQ7Prescribed.transitionDerivative ((s - r) / t) * A s =
          ∫ (s : ℝ) in r..r + t, OQ7Prescribed.transitionDerivative ((s - r) / t) * A s
OQ7Prescribed.transition_radial_rescale : ∀ (r t : ℝ),
  0 < t →
    ∀ (A : ℝ → ℝ),
      t⁻¹ * ∫ (s : ℝ) in r..r + t, OQ7Prescribed.transitionDerivative ((s - r) / t) * A s =
        ∫ (u : ℝ) in 0..1, OQ7Prescribed.transitionDerivative u * A (r + t * u)
OQ7Prescribed.transitionDerivative_continuous : Continuous OQ7Prescribed.transitionDerivative
OQ7Prescribed.transitionDerivative_global_bound : ∃ M, 0 ≤ M ∧ ∀ (s : ℝ), ‖OQ7Prescribed.transitionDerivative s‖ ≤ M
OQ7Prescribed.transitionDerivative_hasCompactSupport : HasCompactSupport OQ7Prescribed.transitionDerivative
OQ7Prescribed.transitionDerivative_integral : ∫ (s : ℝ) in 0..1, OQ7Prescribed.transitionDerivative s = 1
@OQ7Prescribed.transitionDerivative_zero_of_nonpos : ∀ {s : ℝ}, s ≤ 0 → OQ7Prescribed.transitionDerivative s = 0
@OQ7Prescribed.transitionDerivative_zero_of_one_le : ∀ {s : ℝ}, 1 ≤ s → OQ7Prescribed.transitionDerivative s = 0
@OQ7Prescribed.twoPieceSupportedMap_adjoint_inner : ∀ {α : Type u_1} {E : Type u_2} {F : Type u_3}
  [inst : MeasurableSpace α] [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [inst_3 : CompleteSpace E]
  [inst_4 : NormedAddCommGroup F] [inst_5 : InnerProductSpace ℂ F] [inst_6 : CompleteSpace F]
  (μ : MeasureTheory.Measure α) (s t : Set α) (ht : MeasurableSet t) (A B : E →L[ℂ] F)
  (f : ↥(OQ7Prescribed.SetSupportedL2 μ s)) (g : ↥(OQ7Prescribed.SetSupportedL2 μ s)),
  inner ℂ ((OQ7Prescribed.twoPieceSupportedMap μ s t ht A B) f) g =
    inner ℂ f
      ((OQ7Prescribed.twoPieceSupportedMap μ s t ht (ContinuousLinearMap.adjoint A) (ContinuousLinearMap.adjoint B)) g)
@OQ7Prescribed.twoPieceSupportedMap_coe : ∀ {α : Type u_1} {E : Type u_2} {F : Type u_3} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [inst_3 : CompleteSpace E]
  [inst_4 : NormedAddCommGroup F] [inst_5 : InnerProductSpace ℂ F] [CompleteSpace F] (μ : MeasureTheory.Measure α)
  (s t : Set α) (ht : MeasurableSet t) (A B : E →L[ℂ] F) (f : ↥(OQ7Prescribed.SetSupportedL2 μ s)),
  ↑↑↑((OQ7Prescribed.twoPieceSupportedMap μ s t ht A B) f) =ᵐ[μ] fun x => if x ∈ t then A (↑↑↑f x) else B (↑↑↑f x)
@OQ7Prescribed.twoPieceSupportedOperator_coe : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [inst_3 : CompleteSpace E]
  (μ : MeasureTheory.Measure α) (s t : Set α) (ht : MeasurableSet t) (A B : E →L[ℂ] E)
  (f : ↥(OQ7Prescribed.SetSupportedL2 μ s)),
  ↑↑↑((OQ7Prescribed.twoPieceSupportedOperator μ s t ht A B) f) =ᵐ[μ] fun x => if x ∈ t then A (↑↑↑f x) else B (↑↑↑f x)
@OQ7Prescribed.twoPieceSupportedOperator_negative_imaginary_bound : ∀ {α : Type u_1} {E : Type u_2}
  [inst : MeasurableSpace α] [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [inst_3 : CompleteSpace E]
  (μ : MeasureTheory.Measure α) (s t : Set α) (ht : MeasurableSet t) (A B : E →L[ℂ] E) (c : ℝ),
  (∀ (v : E), c * ‖v‖ ^ 2 ≤ -(inner ℂ v (A v)).im) →
    (∀ (v : E), c * ‖v‖ ^ 2 ≤ -(inner ℂ v (B v)).im) →
      ∀ (f : ↥(OQ7Prescribed.SetSupportedL2 μ s)),
        c * ‖f‖ ^ 2 ≤ -(inner ℂ f ((OQ7Prescribed.twoPieceSupportedOperator μ s t ht A B) f)).im
OQ7Prescribed.unitSphere_norm : ∀ (n : ↑OQ7Prescribed.UnitSphere), ‖↑n‖ = 1
OQ7Prescribed.unitSphere_sum_sq : ∀ (n : ↑OQ7Prescribed.UnitSphere), ∑ i, (↑n).ofLp i ^ 2 = 1
OQ7Prescribed.vector_basisC_expansion : ∀ (v : OQ7Prescribed.Vector), v = ∑ j, v.ofLp j • OQ7Prescribed.basisC j
OQ7Prescribed.vector_clm_coordinate_expansion : ∀ (A : OQ7Prescribed.Vector →L[ℂ] OQ7Prescribed.Vector)
  (v : OQ7Prescribed.Vector) (i : Fin 3), (A v).ofLp i = ∑ j, v.ofLp j * (A (OQ7Prescribed.basisC j)).ofLp i
OQ7Prescribed.vector_inner_real_smul : ∀ (A : OQ7Prescribed.Vector →L[ℂ] OQ7Prescribed.Vector) (r : ℝ)
  (v : OQ7Prescribed.Vector), inner ℂ (↑r • v) (A (↑r • v)) = r ^ 2 • inner ℂ v (A v)
OQ7Prescribed.vector_strict_imaginary_coercive : ∀ (A : OQ7Prescribed.Vector →L[ℂ] OQ7Prescribed.Vector),
  (∀ (v : OQ7Prescribed.Vector), v ≠ 0 → 0 < (inner ℂ v (A v)).im) →
    ∃ c, 0 < c ∧ ∀ (v : OQ7Prescribed.Vector), c * ‖v‖ ^ 2 ≤ (inner ℂ v (A v)).im
OQ7Prescribed.vectorConjugate_apply : ∀ (v : OQ7Prescribed.Vector) (i : Fin 3),
  (OQ7Prescribed.vectorConjugate v).ofLp i = star (v.ofLp i)
OQ7Prescribed.vectorConjugate_component_fderiv : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F →
    ∀ (i j : Fin 3) (x : OQ7Prescribed.Position),
      ((fderiv ℝ (fun y => OQ7Prescribed.vectorConjugate (F y)) x) (OQ7Prescribed.basisR j)).ofLp i =
        star (((fderiv ℝ F x) (OQ7Prescribed.basisR j)).ofLp i)
OQ7Prescribed.vectorConjugate_contDiff : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F → ContDiff ℝ ↑⊤ fun x => OQ7Prescribed.vectorConjugate (F x)
OQ7Prescribed.vectorConjugate_smul : ∀ (z : ℂ) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.vectorConjugate (z • v) = star z • OQ7Prescribed.vectorConjugate v
OQ7Prescribed.vectorL2_locallyIntegrable : ∀ (f : ↥OQ7Prescribed.VectorL2),
  MeasureTheory.LocallyIntegrable (fun x => ↑↑f x) MeasureTheory.volume
OQ7Prescribed.vectorL2ComponentDistribution_apply : ∀ (f : ↥OQ7Prescribed.VectorL2) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.vectorL2ComponentDistribution f i) φ = (∫ (x : OQ7Prescribed.Position), φ x • ↑↑f x).ofLp i
OQ7Prescribed.vectorL2Distribution_apply : ∀ (f : ↥OQ7Prescribed.VectorL2) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.vectorL2Distribution f) φ = ∫ (x : OQ7Prescribed.Position), φ x • ↑↑f x
OQ7Prescribed.vectorL2Distribution_tempered : ∀ (f : ↥OQ7Prescribed.VectorL2) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.vectorL2Distribution f) φ =
    (MeasureTheory.Lp.toTemperedDistribution f) (OQ7Prescribed.scalarTestSchwartz φ)
OQ7Prescribed.vectorScalarMul_apply : ∀ (v : OQ7Prescribed.Vector) (z : ℂ), (OQ7Prescribed.vectorScalarMul v) z = z • v
OQ7Prescribed.volumeAbsorption_body_inner : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.bodyCurrentPolarization B f) →
    OQ7Prescribed.absorption k B (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) =
      k * (inner ℂ (OQ7Prescribed.bodyIncidentCurrent k B σ + (OQ7Prescribed.bodyOutgoingOperator k B) f) f).im
OQ7Prescribed.volumeExtinction_current_work : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
  (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.MaterialVolumeEquation k B σ p →
    OQ7Prescribed.extinction k B σ (OQ7Prescribed.volumeTotalElectric k σ p) =
      k *
        (∫ (x : OQ7Prescribed.Position) in B.domain,
            OQ7Prescribed.pairing (OQ7Prescribed.incidentElectric k σ x) (p.current x)).im
OQ7Prescribed.volumeTotalElectric_locallySquareIntegrable : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction)
  (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.volumeTotalElectric k σ p)
OQ7Prescribed.volumeTotalFields_weakMaxwell : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
  (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.MaterialVolumeEquation k B σ p →
    OQ7Prescribed.WeakMaxwell k B (OQ7Prescribed.volumeTotalElectric k σ p) (OQ7Prescribed.volumeTotalMagnetic k σ p)
OQ7Prescribed.volumeTotalMagnetic_locallySquareIntegrable : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction)
  (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.volumeTotalMagnetic k σ p)
OQ7Prescribed.weakCurlTest_all_finite_orders : ∀ (φ : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) φ → ∀ (n : ℕ), ContDiff ℝ (↑n) φ
OQ7Prescribed.weighted_integral_cauchy_sq : ∀ (w g : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable w MeasureTheory.volume →
    MeasureTheory.Integrable (fun y => w y * g y) MeasureTheory.volume →
      MeasureTheory.Integrable (fun y => w y * g y ^ 2) MeasureTheory.volume →
        (∀ᵐ (y : OQ7Prescribed.Position), 0 ≤ w y) →
          (∫ (y : OQ7Prescribed.Position), w y * g y) ^ 2 ≤
            (∫ (y : OQ7Prescribed.Position), w y) * ∫ (y : OQ7Prescribed.Position), w y * g y ^ 2
OQ7Prescribed.weighted_source_flux_lower_bound_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (M : ℝ),
      0 ≤ M →
        (∀ (s : ℝ), OQ7Prescribed.transitionDerivative s ≤ M) →
          ∀ (r : ℝ),
            0 < r →
              2 * p.radius + 2 ≤ r →
                ∀ᵐ (x : OQ7Prescribed.Position),
                  -(OQ7Prescribed.sourceEnergyErrorConstant k p M / r ^ 4) ≤
                    OQ7Prescribed.sourceEnergyWeight r x *
                      (OQ7Prescribed.pairing (OQ7Prescribed.smoothElectricSource k p x)
                          (OQ7Prescribed.cross (OQ7Prescribed.smoothMagneticSource k p x)
                            (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re
