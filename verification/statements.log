      ∀ (x : ℂ) (r : ℝ), HasDerivAt (OQ7Prescribed.apertureMeanSlope w x) (OQ7Prescribed.apertureMeanSlopeDeriv w x r) r
OQ7Prescribed.apertureMeanSlope_norm_le : ∀ (w : ℂ → ℂ) (x : ℂ) (r C : ℝ),
