    (∫ (z : OQ7Prescribed.Position),
          (OQ7Prescribed.dyadicRemainder k z) (OQ7Prescribed.currentTestCorrelationVector p φ z)).ofLp
      i
OQ7Prescribed.remainderPotentialComponentDistribution_pairing_sum : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.remainderPotentialComponentDistribution k p i) φ =
    ∑ j,
      ∫ (z : OQ7Prescribed.Position),
