OQ7Prescribed.bilinear_radial_smul_norm_le : ∀ (x : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  ‖OQ7Prescribed.bilinear (OQ7Prescribed.complexify x) v • OQ7Prescribed.complexify x‖ ≤ ‖x‖ ^ 2 * ‖v‖
OQ7Prescribed.bilinear_real_smul_right : ∀ (u v : OQ7Prescribed.Vector) (r : ℝ),
