  ContDiff ℝ (↑⊤) w →
    HasCompactSupport w →
      ∀ (x : ℂ) (s t : ℝ),
        |s| < t → HasDerivAt (OQ7Prescribed.apertureRadialLift w x s) (OQ7Prescribed.apertureRadialLiftDeriv w x s t) t
OQ7Prescribed.apertureRadialLift_oscillatory_error : ∀ (k : ℝ),
  0 < k →
    ∀ (w : ℂ → ℂ),
      ContDiff ℝ (↑⊤) w →
        HasCompactSupport w →
          ∀ (x : ℂ) (s T A C₂ C₄ : ℝ),
            |s| < T →
              tsupport w ⊆ Metric.closedBall 0 A →
                A + ‖x‖ < √(T ^ 2 - s ^ 2) →
                  (∀ (y : ℂ), ‖iteratedFDeriv ℝ 2 w y‖ ≤ C₂) →
                    (∀ (y : ℂ), ‖iteratedFDeriv ℝ 4 w y‖ ≤ C₄) →
                      ‖(∫ (t : ℝ) in |s|..T,
                              OQ7Prescribed.apertureRadialLift w x s t * OQ7Prescribed.apertureOscillation k t) +
                            (Complex.I * ↑k)⁻¹ * w x * OQ7Prescribed.apertureOscillation k |s|‖ ≤
                        (|s| * C₂ + (C₂ + T ^ 2 * C₄ / 3) * (T - |s|)) / k ^ 2
