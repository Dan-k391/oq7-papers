OQ7Prescribed.admissible_susceptibility_bounded_inverse : ∀ (P Q : ℝ) (T : OQ7Prescribed.Tensor),
  OQ7Prescribed.MaterialAdmissible P Q T →
    ∃ c,
      0 < c ∧
        ∃ e,
          (∀ (v : OQ7Prescribed.Vector), e v = (OQ7Prescribed.tensorMap (T - 1)) v) ∧
            ‖↑e.symm‖ ≤ 1 / c ∧
              ∀ (v : OQ7Prescribed.Vector),
                c / (‖OQ7Prescribed.tensorMap (T - 1)‖ + 1) ^ 2 * ‖v‖ ^ 2 ≤ -(inner ℂ v (e.symm v)).im
