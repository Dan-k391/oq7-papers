  x ≠ 0 → Filter.Tendsto (fun ε => OQ7Prescribed.exteriorCutoff ε ε x) (nhdsWithin 0 (Set.Ioi 0)) (nhds 1)
OQ7Prescribed.shrinkingCutoffError_integrable : ∀ (ε : ℝ),
  0 < ε →
    ∀ (F : OQ7Prescribed.Position → ℝ),
      (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContinuousAt F x) →
        ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
          MeasureTheory.Integrable (fun x => OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
            MeasureTheory.volume
OQ7Prescribed.shrinkingCutoffError_integrable_and_tendsto : ∀ (F : OQ7Prescribed.Position → ℝ),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContinuousAt F x) →
    (∃ R, 0 < R ∧ ∃ C, 0 ≤ C ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C) →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
        (∀ (ε : ℝ),
            0 < ε →
              MeasureTheory.Integrable (fun x => OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
                MeasureTheory.volume) ∧
          Filter.Tendsto
            (fun ε => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
            (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)
OQ7Prescribed.shrinkingCutoffError_norm_le : ∀ (ε R M C T : ℝ),
  0 < ε →
    2 * ε ≤ R →
      0 ≤ M →
        0 ≤ C →
          0 ≤ T →
            (∀ (s : ℝ), ‖OQ7Prescribed.transitionDerivative s‖ ≤ M) →
              ∀ (F : OQ7Prescribed.Position → ℝ),
                (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C) →
                  ∀ (φ : OQ7Prescribed.ScalarTest),
                    (∀ (x : OQ7Prescribed.Position), ‖φ x‖ ≤ T) →
                      ∀ (i : Fin 3),
                        ‖∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x‖ ≤
                          8 * M * C * T * MeasureTheory.volume.real (Metric.ball 0 1) * ε ^ 2
OQ7Prescribed.shrinkingCutoffError_tendsto : ∀ (F : OQ7Prescribed.Position → ℝ),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContinuousAt F x) →
    (∃ R, 0 < R ∧ ∃ C, 0 ≤ C ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C) →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
        Filter.Tendsto
          (fun ε => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
          (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)
OQ7Prescribed.shrinkingCutoffError_tendsto_of_bound : ∀ (F : OQ7Prescribed.Position → ℝ),
  (∃ R, 0 < R ∧ ∃ C, 0 ≤ C ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C) →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
      Filter.Tendsto (fun ε => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoffPartial ε ε i x * F x * φ x)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)
OQ7Prescribed.shrinkingCutoffPartial_support : ∀ (ε : ℝ),
  0 < ε → ∀ (i : Fin 3), Function.support (OQ7Prescribed.exteriorCutoffPartial ε ε i) ⊆ Metric.closedBall 0 (2 * ε)
OQ7Prescribed.shrinkingCutoffPoleError_norm_le : ∀ (ε R M C T : ℝ),
  0 < ε →
    2 * ε ≤ R →
      0 ≤ M →
        0 ≤ C →
          0 ≤ T →
            (∀ (s : ℝ), ‖OQ7Prescribed.transitionDerivative s‖ ≤ M) →
              ∀ (F : OQ7Prescribed.Position → ℝ),
                (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ C / ‖x‖) →
