OQ7Prescribed.exp_remainder_two_norm : ∀ (z : ℂ), ‖Complex.exp z - 1 - z‖ ≤ ‖z‖ ^ 2 * Real.exp ‖z‖
OQ7Prescribed.exterior_current_component_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i j : Fin 3),
      ∫ (x : OQ7Prescribed.Position) (y : OQ7Prescribed.Position),
          ↑(φ x) * ((OQ7Prescribed.classicalDyadic k (x - y)) (OQ7Prescribed.basisC j)).ofLp i * (p.current y).ofLp j =
        ∫ (z : OQ7Prescribed.Position),
          OQ7Prescribed.newtonCurrentCorrelation p φ j z *
            ((OQ7Prescribed.classicalDyadic k z) (OQ7Prescribed.basisC j)).ofLp i
OQ7Prescribed.exterior_current_correlation_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i j : Fin 3),
      MeasureTheory.Integrable
        (fun q =>
          ↑(φ (q.1 + q.2)) * ((OQ7Prescribed.classicalDyadic k q.1) (OQ7Prescribed.basisC j)).ofLp i *
            (p.current q.2).ofLp j)
        (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.exterior_current_test_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i j : Fin 3),
      MeasureTheory.Integrable
        (fun q =>
          ↑(φ q.1) * ((OQ7Prescribed.classicalDyadic k (q.1 - q.2)) (OQ7Prescribed.basisC j)).ofLp i *
            (p.current q.2).ofLp j)
        (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.exterior_Lorentz_flux_norm_bound : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  2 * p.radius + 2 ≤ ‖x‖ →
    2 * q.radius + 2 ≤ ‖x‖ →
      ‖OQ7Prescribed.bilinear (OQ7Prescribed.exteriorElectric k p x)
              (OQ7Prescribed.cross (OQ7Prescribed.exteriorMagnetic k q x)
                (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x))) -
            OQ7Prescribed.bilinear (OQ7Prescribed.exteriorElectric k q x)
              (OQ7Prescribed.cross (OQ7Prescribed.exteriorMagnetic k p x)
                (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))‖ ≤
        OQ7Prescribed.LorentzDecayConstant k p q / ‖x‖ ^ 3
OQ7Prescribed.exterior_poynting_farField_error : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  2 * p.radius + 2 ≤ ‖x‖ →
    |‖x‖ ^ 2 *
            (OQ7Prescribed.pairing (OQ7Prescribed.exteriorElectric k p x)
                (OQ7Prescribed.cross (OQ7Prescribed.exteriorMagnetic k p x)
                  (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re -
          ‖OQ7Prescribed.compactCurrentFarField k p (OQ7Prescribed.radialDirection x)‖ ^ 2| ≤
      OQ7Prescribed.farFieldFluxConstant k p.radius / ‖x‖ * (∫ (y : OQ7Prescribed.Position), ‖p.current y‖) ^ 2
OQ7Prescribed.exterior_poynting_flux_lower_bound : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  2 * p.radius + 2 ≤ ‖x‖ →
    -((OQ7Prescribed.magneticDecayConstant k / ‖x‖ * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖) *
          (OQ7Prescribed.radiationKernelConstant k p.radius / ‖x‖ ^ 2 *
            ∫ (y : OQ7Prescribed.Position), ‖p.current y‖)) ≤
      (OQ7Prescribed.pairing (OQ7Prescribed.exteriorElectric k p x)
          (OQ7Prescribed.cross (OQ7Prescribed.exteriorMagnetic k p x)
            (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re
OQ7Prescribed.exterior_radiation_integral_norm_le : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  2 * p.radius + 2 ≤ ‖x‖ →
    ‖OQ7Prescribed.cross (OQ7Prescribed.exteriorMagnetic k p x)
            (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)) -
          OQ7Prescribed.exteriorElectric k p x‖ ≤
      OQ7Prescribed.radiationKernelConstant k p.radius / ‖x‖ ^ 2 * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖
OQ7Prescribed.exteriorCurrentFields_outgoing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.Outgoing (OQ7Prescribed.exteriorElectric k p) (OQ7Prescribed.exteriorMagnetic k p)
OQ7Prescribed.exteriorCutoff_contDiff : ∀ (r t : ℝ), 0 < r → 0 < t → ContDiff ℝ 1 (OQ7Prescribed.exteriorCutoff r t)
OQ7Prescribed.exteriorCutoff_contDiff_smooth : ∀ (r t : ℝ),
  0 < r → 0 < t → ContDiff ℝ (↑⊤) (OQ7Prescribed.exteriorCutoff r t)
OQ7Prescribed.exteriorCutoff_gradient_ibp : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
        ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonGradient j x *
              ((OQ7Prescribed.testPartial i) φ) x =
          -∫ (x : OQ7Prescribed.Position),
              (OQ7Prescribed.exteriorCutoffPartial r t i x * OQ7Prescribed.newtonGradient j x +
                  OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonHessianKernel i j x) *
                φ x
OQ7Prescribed.exteriorCutoff_hasLineDerivAt : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (i : Fin 3) (x : OQ7Prescribed.Position),
        HasLineDerivAt ℝ (OQ7Prescribed.exteriorCutoff r t) (OQ7Prescribed.exteriorCutoffPartial r t i x) x
          (OQ7Prescribed.basisR i)
OQ7Prescribed.exteriorCutoff_integral_tendsto : ∀ (r : ℝ) (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume →
    MeasureTheory.IntegrableOn f {x | r < ‖x‖} MeasureTheory.volume →
      Filter.Tendsto (fun t => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoff r t x * f x)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (∫ (x : OQ7Prescribed.Position) in {x | r < ‖x‖}, f x))
OQ7Prescribed.exteriorCutoff_le_one : ∀ (r t : ℝ) (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoff r t x ≤ 1
OQ7Prescribed.exteriorCutoff_mul_contDiff : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (F : OQ7Prescribed.Position → ℝ),
        (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 F x) →
          ContDiff ℝ 1 fun x => OQ7Prescribed.exteriorCutoff r t x * F x
OQ7Prescribed.exteriorCutoff_mul_lineDeriv : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (F F' : OQ7Prescribed.Position → ℝ) (i : Fin 3),
        (∀ (x : OQ7Prescribed.Position), x ≠ 0 → HasLineDerivAt ℝ F (F' x) x (OQ7Prescribed.basisR i)) →
          ∀ (x : OQ7Prescribed.Position),
            lineDeriv ℝ (fun y => OQ7Prescribed.exteriorCutoff r t y * F y) x (OQ7Prescribed.basisR i) =
              OQ7Prescribed.exteriorCutoffPartial r t i x * F x + OQ7Prescribed.exteriorCutoff r t x * F' x
OQ7Prescribed.exteriorCutoff_newton_ibp : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (φ : OQ7Prescribed.ScalarTest) (j : Fin 3),
        ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonReal x * ((OQ7Prescribed.testPartial j) φ) x =
          -∫ (x : OQ7Prescribed.Position),
              (OQ7Prescribed.exteriorCutoffPartial r t j x * OQ7Prescribed.newtonReal x +
                  OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonGradient j x) *
                φ x
OQ7Prescribed.exteriorCutoff_nonneg : ∀ (r t : ℝ) (x : OQ7Prescribed.Position), 0 ≤ OQ7Prescribed.exteriorCutoff r t x
@OQ7Prescribed.exteriorCutoff_one : ∀ {r t : ℝ},
  0 < t → ∀ (x : OQ7Prescribed.Position), r + t ≤ ‖x‖ → OQ7Prescribed.exteriorCutoff r t x = 1
OQ7Prescribed.exteriorCutoff_tendsto : ∀ (r : ℝ) (x : OQ7Prescribed.Position),
  Filter.Tendsto (fun t => OQ7Prescribed.exteriorCutoff r t x) (nhdsWithin 0 (Set.Ioi 0))
    (nhds (if r < ‖x‖ then 1 else 0))
@OQ7Prescribed.exteriorCutoff_zero : ∀ {r t : ℝ},
  0 < t → ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ r → OQ7Prescribed.exteriorCutoff r t x = 0
OQ7Prescribed.exteriorCutoffPartial_mul_continuous : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (i : Fin 3) (F : OQ7Prescribed.Position → ℝ),
        (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContinuousAt F x) →
          Continuous fun x => OQ7Prescribed.exteriorCutoffPartial r t i x * F x
OQ7Prescribed.exteriorCutoffPartial_mul_integrable : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (i : Fin 3) (F : OQ7Prescribed.Position → ℝ),
        (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContinuousAt F x) →
          MeasureTheory.Integrable (fun x => OQ7Prescribed.exteriorCutoffPartial r t i x * F x) MeasureTheory.volume
OQ7Prescribed.exteriorCutoffPartial_norm_le : ∀ (r t M : ℝ),
  0 < t →
    0 ≤ M →
      (∀ (s : ℝ), ‖OQ7Prescribed.transitionDerivative s‖ ≤ M) →
        ∀ (i : Fin 3) (x : OQ7Prescribed.Position), ‖OQ7Prescribed.exteriorCutoffPartial r t i x‖ ≤ M / t
OQ7Prescribed.exteriorCutoffPartial_zero_inner : ∀ (r t : ℝ),
  0 < t → ∀ (i : Fin 3) (x : OQ7Prescribed.Position), ‖x‖ ≤ r → OQ7Prescribed.exteriorCutoffPartial r t i x = 0
OQ7Prescribed.exteriorCutoffPartial_zero_outer : ∀ (r t : ℝ),
  0 < t → ∀ (i : Fin 3) (x : OQ7Prescribed.Position), r + t ≤ ‖x‖ → OQ7Prescribed.exteriorCutoffPartial r t i x = 0
OQ7Prescribed.exteriorElectric_aestronglyMeasurable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.AEStronglyMeasurable (OQ7Prescribed.exteriorElectric k p) MeasureTheory.volume
OQ7Prescribed.exteriorElectric_component_locallyIntegrableOn : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  MeasureTheory.LocallyIntegrableOn (fun x => (OQ7Prescribed.exteriorElectric k p x).ofLp i)
    (↑(OQ7Prescribed.currentExterior p)) MeasureTheory.volume
OQ7Prescribed.exteriorElectric_integrable_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ →
    MeasureTheory.Integrable (fun y => (OQ7Prescribed.classicalDyadic k (x - y)) (p.current y)) MeasureTheory.volume
OQ7Prescribed.exteriorElectric_locallyIntegrableOn : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.LocallyIntegrableOn (OQ7Prescribed.exteriorElectric k p) (↑(OQ7Prescribed.currentExterior p))
    MeasureTheory.volume
OQ7Prescribed.exteriorElectric_norm_decay : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  2 * p.radius + 2 ≤ ‖x‖ →
    ‖OQ7Prescribed.exteriorElectric k p x‖ ≤
      OQ7Prescribed.electricDecayConstant k p.radius / ‖x‖ * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖
OQ7Prescribed.exteriorElectric_norm_le : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ →
    ‖OQ7Prescribed.exteriorElectric k p x‖ ≤
      OQ7Prescribed.exteriorKernelBound k * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖
OQ7Prescribed.exteriorElectric_test_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i : Fin 3),
      MeasureTheory.Integrable (fun x => ↑(φ x) * (OQ7Prescribed.exteriorElectric k p x).ofLp i) MeasureTheory.volume
OQ7Prescribed.exteriorElectric_test_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i : Fin 3),
      ∫ (x : OQ7Prescribed.Position), ↑(φ x) * (OQ7Prescribed.exteriorElectric k p x).ofLp i =
        (OQ7Prescribed.outgoingVolumeDistribution k p i) φ
OQ7Prescribed.exteriorElectric_test_pointwise : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i : Fin 3) (x : OQ7Prescribed.Position),
      ∑ j,
          ∫ (y : OQ7Prescribed.Position),
            ↑(φ x) * ((OQ7Prescribed.classicalDyadic k (x - y)) (OQ7Prescribed.basisC j)).ofLp i *
              (p.current y).ofLp j =
        ↑(φ x) * (OQ7Prescribed.exteriorElectric k p x).ofLp i
OQ7Prescribed.exteriorElectric_uniform_farField_error : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  2 * p.radius + 2 ≤ ‖x‖ →
    ‖(↑‖x‖ * Complex.exp (-Complex.I * ↑(k * ‖x‖))) • OQ7Prescribed.exteriorElectric k p x -
          OQ7Prescribed.compactCurrentFarField k p (OQ7Prescribed.radialDirection x)‖ ≤
      OQ7Prescribed.farFieldKernelConstant k p.radius / ‖x‖ * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖
OQ7Prescribed.exteriorMagnetic_integrable_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ →
    MeasureTheory.Integrable (fun y => OQ7Prescribed.kernelMagnetic k (x - y) (p.current y)) MeasureTheory.volume
OQ7Prescribed.exteriorMagnetic_norm_decay : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  2 * p.radius + 2 ≤ ‖x‖ →
    ‖OQ7Prescribed.exteriorMagnetic k p x‖ ≤
      OQ7Prescribed.magneticDecayConstant k / ‖x‖ * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖
OQ7Prescribed.fieldComponent_locallyIntegrable : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i : Fin 3), MeasureTheory.LocallyIntegrable (fun x => (F x).ofLp i) MeasureTheory.volume
OQ7Prescribed.fieldComponentDistribution_add : ∀ (F G : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    MeasureTheory.LocallyIntegrable G MeasureTheory.volume →
      ∀ (i : Fin 3),
        OQ7Prescribed.fieldComponentDistribution (fun x => F x + G x) i =
          OQ7Prescribed.fieldComponentDistribution F i + OQ7Prescribed.fieldComponentDistribution G i
OQ7Prescribed.fieldComponentDistribution_apply : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
      (OQ7Prescribed.fieldComponentDistribution F i) φ = ∫ (x : OQ7Prescribed.Position), ↑(φ x) * (F x).ofLp i
OQ7Prescribed.fieldComponentDistribution_complex_smul : ∀ (a : ℂ) (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i : Fin 3),
      OQ7Prescribed.fieldComponentDistribution (fun x => a • F x) i = a • OQ7Prescribed.fieldComponentDistribution F i
OQ7Prescribed.fieldComponentDistribution_injective : ∀ (F G : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    MeasureTheory.LocallyIntegrable G MeasureTheory.volume →
      OQ7Prescribed.fieldComponentDistribution F = OQ7Prescribed.fieldComponentDistribution G →
        F =ᵐ[MeasureTheory.volume] G
OQ7Prescribed.fieldComponentDistribution_smul : ∀ (z : ℂ) (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    OQ7Prescribed.fieldComponentDistribution (z • F) = z • OQ7Prescribed.fieldComponentDistribution F
OQ7Prescribed.fieldComponentDistribution_sub : ∀ (F G : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    MeasureTheory.LocallyIntegrable G MeasureTheory.volume →
      OQ7Prescribed.fieldComponentDistribution (F - G) =
        OQ7Prescribed.fieldComponentDistribution F - OQ7Prescribed.fieldComponentDistribution G
@OQ7Prescribed.fourierIntegral_L1L2_ae : ∀ {F : Type u_1} [inst : NormedAddCommGroup F] [inst_1 : InnerProductSpace ℂ F]
  [inst_2 : CompleteSpace F] {f : OQ7Prescribed.Position → F},
  MeasureTheory.MemLp f 1 MeasureTheory.volume →
    ∀ (hf2 : MeasureTheory.MemLp f 2 MeasureTheory.volume),
      FourierTransform.fourier f =ᵐ[MeasureTheory.volume]
        ↑↑((MeasureTheory.Lp.fourierTransformₗᵢ OQ7Prescribed.Position F) (MeasureTheory.MemLp.toLp f hf2))
@OQ7Prescribed.fourierIntegral_L1L2_memLp : ∀ {F : Type u_1} [inst : NormedAddCommGroup F]
  [inst_1 : InnerProductSpace ℂ F] [CompleteSpace F] {f : OQ7Prescribed.Position → F},
  MeasureTheory.MemLp f 1 MeasureTheory.volume →
    MeasureTheory.MemLp f 2 MeasureTheory.volume →
      MeasureTheory.MemLp (FourierTransform.fourier f) 2 MeasureTheory.volume
@OQ7Prescribed.fourierIntegral_L1L2_schwartz_pairing : ∀ {F : Type u_1} [inst : NormedAddCommGroup F]
  [inst_1 : InnerProductSpace ℂ F] [inst_2 : CompleteSpace F] {f : OQ7Prescribed.Position → F},
  MeasureTheory.MemLp f 1 MeasureTheory.volume →
    ∀ (hf2 : MeasureTheory.MemLp f 2 MeasureTheory.volume) (φ : SchwartzMap OQ7Prescribed.Position ℂ),
      ∫ (ξ : OQ7Prescribed.Position), φ ξ • FourierTransform.fourier f ξ =
        ∫ (ξ : OQ7Prescribed.Position),
          φ ξ • ↑↑((MeasureTheory.Lp.fourierTransformₗᵢ OQ7Prescribed.Position F) (MeasureTheory.MemLp.toLp f hf2)) ξ
OQ7Prescribed.gradient_current_correlation_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (j : Fin 3) (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ (q.1 + q.2)) * OQ7Prescribed.outgoingGradient k j q.1 * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.gradient_current_pairing_integrand_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3) (S : ℝ),
  (∀ (x : OQ7Prescribed.Position), φ x ≠ 0 → ‖x‖ ≤ S) →
    ∀ (x y : OQ7Prescribed.Position),
      ↑(φ x) * OQ7Prescribed.outgoingGradient k j (x - y) * (p.current y).ofLp i =
        ↑(φ x) * OQ7Prescribed.cutoffOutgoingGradient k (S + p.radius) j (x - y) * (p.current y).ofLp i
OQ7Prescribed.gradient_current_test_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ q.1) * OQ7Prescribed.outgoingGradient k j (q.1 - q.2) * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.gradientPotential_ae_integrable_on_compact : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (K : Set OQ7Prescribed.Position),
  IsCompact K →
    ∀ᵐ (x : OQ7Prescribed.Position) ∂MeasureTheory.volume.restrict K,
      MeasureTheory.Integrable (fun y => OQ7Prescribed.outgoingGradient k j (x - y) • p.current y) MeasureTheory.volume
OQ7Prescribed.gradientPotential_component_integral_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j i : Fin 3)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ →
    (OQ7Prescribed.gradientPotential k p j x).ofLp i =
      ∫ (y : OQ7Prescribed.Position), OQ7Prescribed.outgoingGradient k j (x - y) * (p.current y).ofLp i
OQ7Prescribed.gradientPotential_eq_cutoff : ∀ (k S : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (x : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    OQ7Prescribed.gradientPotential k p j x =
      OQ7Prescribed.scalarVectorConvolution (OQ7Prescribed.cutoffOutgoingGradient k (S + p.radius) j) p.current x
OQ7Prescribed.gradientPotential_integrable_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ →
    MeasureTheory.Integrable (fun y => OQ7Prescribed.outgoingGradient k j (x - y) • p.current y) MeasureTheory.volume
OQ7Prescribed.gradientPotential_integrand_cutoff : ∀ (k S : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (x y : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    OQ7Prescribed.outgoingGradient k j (x - y) • p.current y =
      OQ7Prescribed.cutoffOutgoingGradient k (S + p.radius) j (x - y) • p.current y
OQ7Prescribed.gradientPotential_locallyIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.gradientPotential k p j) MeasureTheory.volume
OQ7Prescribed.gradientPotential_memLp_on_compact : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (K : Set OQ7Prescribed.Position),
  IsCompact K → MeasureTheory.MemLp (OQ7Prescribed.gradientPotential k p j) 2 (MeasureTheory.volume.restrict K)
OQ7Prescribed.gradientPotentialComponentDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (j i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.gradientPotentialComponentDistribution k p j i) φ =
    ∫ (x : OQ7Prescribed.Position), ↑(φ x) * (OQ7Prescribed.gradientPotential k p j x).ofLp i
OQ7Prescribed.gradientPotentialComponentDistribution_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (j i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.gradientPotentialComponentDistribution k p j i) φ =
    ∫ (z : OQ7Prescribed.Position),
      OQ7Prescribed.outgoingGradient k j z * OQ7Prescribed.newtonCurrentCorrelation p φ i z
OQ7Prescribed.green_first_cancel_norm : ∀ (z : ℂ),
  ‖Complex.exp z * (z - 1) + 1‖ ≤ ‖z‖ ^ 2 * (1 + (‖z‖ + 1) * Real.exp ‖z‖)
OQ7Prescribed.green_second_cancel_norm : ∀ (z : ℂ),
  ‖Complex.exp z * (z ^ 2 - 3 * z + 3) - 3‖ ≤ ‖z‖ ^ 2 * (‖z‖ + 2 + (‖z‖ ^ 2 + 3 * ‖z‖ + 3) * Real.exp ‖z‖)
OQ7Prescribed.green_second_poly_norm : ∀ (z : ℂ), ‖z ^ 2 - 3 * z + 3‖ ≤ ‖z‖ ^ 2 + 3 * ‖z‖ + 3
OQ7Prescribed.greenCancellationEnvelope_mono : ∀ (s t : ℝ),
  0 ≤ s → s ≤ t → OQ7Prescribed.greenCancellationEnvelope s ≤ OQ7Prescribed.greenCancellationEnvelope t
OQ7Prescribed.greenCancellationEnvelope_nonneg : ∀ (s : ℝ), 0 ≤ s → 0 ≤ OQ7Prescribed.greenCancellationEnvelope s
OQ7Prescribed.greenHessian_apply : ∀ (k : ℝ) (i j : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.greenHessian k i j) φ =
    (OQ7Prescribed.outgoingGreenDistribution k) ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ))
OQ7Prescribed.greenHessian_eq_static_add_dynamic : ∀ (k : ℝ) (i j : Fin 3),
  OQ7Prescribed.greenHessian k i j =
    OQ7Prescribed.greenHessian 0 i j +
      Distribution.ofFun ⊤ (OQ7Prescribed.dynamicHessianRemainder k i j) MeasureTheory.volume ⊤
@OQ7Prescribed.HasWeakCurl.add_fields : ∀ {F1 F2 G1 G2 : OQ7Prescribed.Field},
  OQ7Prescribed.HasWeakCurl F1 G1 →
    OQ7Prescribed.HasWeakCurl F2 G2 →
      MeasureTheory.LocallyIntegrable F1 MeasureTheory.volume →
        MeasureTheory.LocallyIntegrable F2 MeasureTheory.volume →
          MeasureTheory.LocallyIntegrable G1 MeasureTheory.volume →
            MeasureTheory.LocallyIntegrable G2 MeasureTheory.volume →
              OQ7Prescribed.HasWeakCurl (fun x => F1 x + F2 x) fun x => G1 x + G2 x
@OQ7Prescribed.HasWeakCurl.congr_ae : ∀ {F G F' G' : OQ7Prescribed.Field},
  OQ7Prescribed.HasWeakCurl F G →
    F =ᵐ[MeasureTheory.volume] F' → G =ᵐ[MeasureTheory.volume] G' → OQ7Prescribed.HasWeakCurl F' G'
OQ7Prescribed.HasWeakCurl.implies_analyticTestWeakCurl : ∀ (F G : OQ7Prescribed.Field),
  OQ7Prescribed.HasWeakCurl F G → OQ7Prescribed.AnalyticTestWeakCurl F G
OQ7Prescribed.heightProfile_fixed_support_smooth_density : ∀ (f : ℝ → ℂ),
  MeasureTheory.MemLp f 2 MeasureTheory.volume →
    ∀ (L : ℝ),
      0 ≤ L →
        (∀ᵐ (t : ℝ), t ∉ Metric.closedBall 0 L → f t = 0) →
          ∀ (ε : ℝ),
            0 < ε →
              ∃ q,
                ContDiff ℝ (↑⊤) q ∧
                  HasCompactSupport q ∧
                    tsupport q ⊆ Metric.closedBall 0 (L + 2) ∧
                      MeasureTheory.eLpNorm (f - q) 2 MeasureTheory.volume ≤ ENNReal.ofReal ε
OQ7Prescribed.heightProfile_integrable : ∀ (q : ℝ → ℂ),
  MeasureTheory.MemLp q 2 MeasureTheory.volume →
    ∀ (L : ℝ), (∀ᵐ (t : ℝ), t ∉ Set.Icc (-L) L → q t = 0) → MeasureTheory.Integrable q MeasureTheory.volume
OQ7Prescribed.heightProfile_integral_norm_bound : ∀ (q : ℝ → ℂ) (hq : MeasureTheory.MemLp q 2 MeasureTheory.volume)
  (L : ℝ),
  0 ≤ L → (∀ᵐ (t : ℝ), t ∉ Set.Icc (-L) L → q t = 0) → ∫ (t : ℝ), ‖q t‖ ≤ ‖MeasureTheory.MemLp.toLp q hq‖ * √(2 * L)
OQ7Prescribed.heightSmoothElement_coe : ∀ (M : ℝ) (f : ℝ → ℂ) (hf : ContDiff ℝ (↑⊤) f) (hc : HasCompactSupport f)
  (hs : tsupport f ⊆ Metric.closedBall 0 M),
  ↑↑↑(OQ7Prescribed.heightSmoothElement M f hf hc hs) =ᵐ[MeasureTheory.volume] f
OQ7Prescribed.heightSupported_fixed_smooth_approximation : ∀ (L : ℝ),
  0 ≤ L →
    ∀ (q : ↥(OQ7Prescribed.HeightSupportedL2 L)) (ε : ℝ),
      0 < ε →
        ∃ f,
          ∃ (hf : ContDiff ℝ (↑⊤) f) (hc : HasCompactSupport f) (hs : tsupport f ⊆ Metric.closedBall 0 (L + 2)),
            ‖OQ7Prescribed.heightSupportEnlargement L q - OQ7Prescribed.heightSmoothElement (L + 2) f hf hc hs‖ ≤ ε
OQ7Prescribed.heightSupportedProfile_integrable : ∀ (M : ℝ) (q : ↥(OQ7Prescribed.HeightSupportedL2 M)),
  MeasureTheory.Integrable (↑↑↑q) MeasureTheory.volume
OQ7Prescribed.heightSupportEnlargement_norm : ∀ (L : ℝ) (q : ↥(OQ7Prescribed.HeightSupportedL2 L)),
  ‖OQ7Prescribed.heightSupportEnlargement L q‖ = ‖q‖
@OQ7Prescribed.homogeneousElectricField_parameter_continuous : ∀ {X : Type u_1} [inst : TopologicalSpace X] (k : ℝ)
  (n E H : X → ℂ) (z : X → ℝ),
  Continuous n →
    Continuous E →
      Continuous H →
        Continuous z → (∀ (x : X), n x ≠ 0) → Continuous fun x => OQ7.electricField k (n x) (E x) (H x) (z x)
OQ7Prescribed.homogeneousField_planarWaveMoments : ∀ (k a b : ℝ),
  a ≤ b →
    ∀ (n E₀ H₀ : ℂ),
      n ≠ 0 →
        Complex.I * ↑k *
              ∫ (t : ℝ) in a..b,
                OQ7Prescribed.apertureOscillation (-k) t * ((n ^ 2 - 1) * OQ7.electricField k n E₀ H₀ t) =
            OQ7Prescribed.apertureOscillation (-k) b * (OQ7.magneticField k n E₀ H₀ b + OQ7.electricField k n E₀ H₀ b) -
              OQ7Prescribed.apertureOscillation (-k) a *
                (OQ7.magneticField k n E₀ H₀ a + OQ7.electricField k n E₀ H₀ a) ∧
          Complex.I * ↑k *
              ∫ (t : ℝ) in a..b, OQ7Prescribed.apertureOscillation k t * ((n ^ 2 - 1) * OQ7.electricField k n E₀ H₀ t) =
            OQ7Prescribed.apertureOscillation k b * (OQ7.magneticField k n E₀ H₀ b - OQ7.electricField k n E₀ H₀ b) -
              OQ7Prescribed.apertureOscillation k a * (OQ7.magneticField k n E₀ H₀ a - OQ7.electricField k n E₀ H₀ a)
OQ7Prescribed.homogeneousSlabAbsorptance_thick_limit : ∀ (k : ℝ),
  0 < k →
    ∀ (n : ℂ),
      n ≠ 0 →
        1 + n ≠ 0 →
          0 < n.im →
            Filter.Tendsto
              (fun d =>
                OQ7.absorptanceLeft (OQ7.transferReflectionLeft (OQ7.waveTransfer (OQ7.homogeneousTransfer k n d)))
                  (OQ7.transferTransmissionRight (OQ7.waveTransfer (OQ7.homogeneousTransfer k n d))))
              Filter.atTop (nhds (1 - Complex.normSq (OQ7Prescribed.slabInterfaceReflection n)))
OQ7Prescribed.homogeneousSlabReflection_interface_formula : ∀ (k d : ℝ) (n : ℂ),
  n ≠ 0 →
    1 + n ≠ 0 →
      OQ7.transferReflectionLeft (OQ7.waveTransfer (OQ7.homogeneousTransfer k n d)) =
        OQ7Prescribed.slabInterfaceReflection n * (1 - OQ7Prescribed.slabPropagation k n d ^ 2) /
          (1 - OQ7Prescribed.slabInterfaceReflection n ^ 2 * OQ7Prescribed.slabPropagation k n d ^ 2)
OQ7Prescribed.homogeneousSlabReflection_thick_limit : ∀ (k : ℝ),
  0 < k →
    ∀ (n : ℂ),
      n ≠ 0 →
        1 + n ≠ 0 →
          0 < n.im →
            Filter.Tendsto (fun d => OQ7.transferReflectionLeft (OQ7.waveTransfer (OQ7.homogeneousTransfer k n d)))
              Filter.atTop (nhds (OQ7Prescribed.slabInterfaceReflection n))
OQ7Prescribed.homogeneousSlabTransmission_interface_formula : ∀ (k d : ℝ) (n : ℂ),
  n ≠ 0 →
    1 + n ≠ 0 →
      OQ7.transferTransmissionRight (OQ7.waveTransfer (OQ7.homogeneousTransfer k n d)) =
        (1 - OQ7Prescribed.slabInterfaceReflection n ^ 2) * OQ7Prescribed.slabPropagation k n d /
          (1 - OQ7Prescribed.slabInterfaceReflection n ^ 2 * OQ7Prescribed.slabPropagation k n d ^ 2)
OQ7Prescribed.homogeneousSlabTransmission_thick_limit : ∀ (k : ℝ),
  0 < k →
    ∀ (n : ℂ),
      n ≠ 0 →
        1 + n ≠ 0 →
          0 < n.im →
            Filter.Tendsto (fun d => OQ7.transferTransmissionRight (OQ7.waveTransfer (OQ7.homogeneousTransfer k n d)))
              Filter.atTop (nhds 0)
OQ7Prescribed.homogeneousTransfer_index_loss_continuous : ∀ (k p d : ℝ),
  0 < p → Continuous fun q => OQ7.homogeneousTransfer k (OQ7Prescribed.dielectricSlabIndex p q) d
OQ7Prescribed.homogeneousWaveTransfer_10_exponential : ∀ (k d : ℝ) (n : ℂ),
  n ≠ 0 →
    OQ7.waveTransfer (OQ7.homogeneousTransfer k n d) 1 0 =
      (1 - n ^ 2) * (OQ7Prescribed.slabPropagation k n d ^ 2 - 1) / (4 * n * OQ7Prescribed.slabPropagation k n d)
OQ7Prescribed.homogeneousWaveTransfer_11_exponential : ∀ (k d : ℝ) (n : ℂ),
  n ≠ 0 →
    OQ7.waveTransfer (OQ7.homogeneousTransfer k n d) 1 1 =
      ((1 + n) ^ 2 - (1 - n) ^ 2 * OQ7Prescribed.slabPropagation k n d ^ 2) /
        (4 * n * OQ7Prescribed.slabPropagation k n d)
OQ7Prescribed.homogeneousWaveTransfer_offdiagonal : ∀ (k d : ℝ) (n : ℂ),
  OQ7.waveTransfer (OQ7.homogeneousTransfer k n d) 1 0 = -OQ7.waveTransfer (OQ7.homogeneousTransfer k n d) 0 1
OQ7Prescribed.horizontalSlabPotential_contDiff : ∀ (k s : ℝ) (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w → HasCompactSupport w → ContDiff ℝ (↑⊤) (OQ7Prescribed.horizontalSlabPotential k s w)
OQ7Prescribed.horizontalSlabPotential_error : ∀ (k : ℝ),
  0 < k →
    ∀ (s : ℝ) (w : ℂ → ℂ),
      ContDiff ℝ (↑⊤) w →
        HasCompactSupport w →
          ∀ (x : ℂ) (U A C₂ C₄ : ℝ),
            0 < U →
              tsupport w ⊆ Metric.closedBall 0 A →
                A + ‖x‖ < U →
                  (∀ (y : ℂ), ‖iteratedFDeriv ℝ 2 w y‖ ≤ C₂) →
                    (∀ (y : ℂ), ‖iteratedFDeriv ℝ 4 w y‖ ≤ C₄) →
                      ‖OQ7Prescribed.horizontalSlabPotential k s w x - OQ7Prescribed.planarScalarGreen k s * w x‖ ≤
                        (|s| * C₂ +
                            (C₂ + OQ7Prescribed.slabHeightRadius s U ^ 2 * C₄ / 3) *
                              (OQ7Prescribed.slabHeightRadius s U - |s|)) /
                          (2 * k ^ 2)
OQ7Prescribed.horizontalSlabPotential_height_integrable : ∀ (k : ℝ) (w : ℂ → ℂ) (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ContDiff ℝ (↑⊤) q →
      HasCompactSupport w →
        HasCompactSupport q →
          ∀ (x : ℂ) (z : ℝ),
            MeasureTheory.Integrable (fun t => OQ7Prescribed.horizontalSlabPotential k (z - t) w x * q t)
              MeasureTheory.volume
OQ7Prescribed.horizontalSlabPotential_hessian_scaled_bound : ∀ (k : ℝ),
  0 < k →
    ∀ (w : ℂ → ℂ),
      ContDiff ℝ (↑⊤) w →
        HasCompactSupport w →
          ∀ (A X L C₂ C₄ C₆ : ℝ),
            0 ≤ A →
              0 ≤ X →
                0 ≤ L →
                  tsupport w ⊆ Metric.closedBall 0 A →
                    (∀ (y : ℂ), ‖iteratedFDeriv ℝ 2 w y‖ ≤ C₂) →
                      (∀ (y : ℂ), ‖iteratedFDeriv ℝ 4 w y‖ ≤ C₄) →
                        (∀ (y : ℂ), ‖iteratedFDeriv ℝ 6 w y‖ ≤ C₆) →
                          ∀ (R s : ℝ) (x u v : ℂ),
                            1 ≤ R →
                              |s| ≤ L →
                                ‖x‖ ≤ X * R →
                                  ‖u‖ ≤ 1 →
                                    ‖v‖ ≤ 1 →
                                      ‖(fderiv ℝ
                                              (fun y =>
                                                (fderiv ℝ
                                                    (OQ7Prescribed.horizontalSlabPotential k s
                                                      (OQ7Prescribed.scaledApertureWindow w R))
                                                    y)
                                                  u)
                                              x)
                                            v‖ ≤
                                        (C₂ / (2 * k) +
                                            (L * C₄ + (A + X + 1 + L) * (C₄ + (A + X + 1 + L) ^ 2 * C₆ / 3)) /
                                              (2 * k ^ 2)) /
                                          R ^ 2
OQ7Prescribed.horizontalSlabPotential_integrable : ∀ (k s : ℝ) (w : ℂ → ℂ),
  Continuous w →
    HasCompactSupport w →
      ∀ (x : ℂ), MeasureTheory.Integrable (fun y => OQ7Prescribed.slabGreen k s y * w (x - y)) MeasureTheory.volume
OQ7Prescribed.horizontalSlabPotential_partial : ∀ (k s : ℝ) (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w →
    HasCompactSupport w →
      ∀ (x v : ℂ),
        (fderiv ℝ (OQ7Prescribed.horizontalSlabPotential k s w) x) v =
          OQ7Prescribed.horizontalSlabPotential k s (OQ7Prescribed.apertureWindowPartial w v) x
OQ7Prescribed.horizontalSlabPotential_polar : ∀ (k s : ℝ) (w : ℂ → ℂ),
  Continuous w →
    HasCompactSupport w →
      ∀ (x : ℂ),
        OQ7Prescribed.horizontalSlabPotential k s w x =
          ∫ (r : ℝ) in Set.Ioi 0,
            (2 * Real.pi) •
              (↑r * OQ7Prescribed.slabGreen k s (circleMap 0 r 0) * OQ7Prescribed.apertureCircleJet 0 w x r)
OQ7Prescribed.horizontalSlabPotential_radialWindow : ∀ (k s : ℝ) (w : ℂ → ℂ),
  Continuous w →
    HasCompactSupport w →
      ∀ (x : ℂ) (U A : ℝ),
        0 < U →
          tsupport w ⊆ Metric.closedBall 0 A →
            A + ‖x‖ < U → OQ7Prescribed.horizontalSlabPotential k s w x = OQ7Prescribed.slabRadialWindow k s w x U
OQ7Prescribed.horizontalSlabPotential_scaled_error : ∀ (k : ℝ),
  0 < k →
    ∀ (w : ℂ → ℂ),
      ContDiff ℝ (↑⊤) w →
        HasCompactSupport w →
          ∀ (A X L C₂ C₄ : ℝ),
            0 ≤ A →
              0 ≤ X →
                0 ≤ L →
                  tsupport w ⊆ Metric.closedBall 0 A →
                    (∀ (y : ℂ), ‖iteratedFDeriv ℝ 2 w y‖ ≤ C₂) →
                      (∀ (y : ℂ), ‖iteratedFDeriv ℝ 4 w y‖ ≤ C₄) →
                        ∀ (R s : ℝ) (x : ℂ),
                          1 ≤ R →
                            |s| ≤ L →
                              ‖x‖ ≤ X * R →
                                ‖OQ7Prescribed.horizontalSlabPotential k s (OQ7Prescribed.scaledApertureWindow w R) x -
                                      OQ7Prescribed.planarScalarGreen k s * OQ7Prescribed.scaledApertureWindow w R x‖ ≤
                                  (L * C₂ + (A + X + 1 + L) * (C₂ + (A + X + 1 + L) ^ 2 * C₄ / 3)) / (2 * k ^ 2 * R)
OQ7Prescribed.horizontalSlabPotential_second_partial : ∀ (k s : ℝ) (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w →
    HasCompactSupport w →
      ∀ (x u v : ℂ),
        (fderiv ℝ (fun y => (fderiv ℝ (OQ7Prescribed.horizontalSlabPotential k s w) y) u) x) v =
          OQ7Prescribed.horizontalSlabPotential k s
            (OQ7Prescribed.apertureWindowPartial (OQ7Prescribed.apertureWindowPartial w u) v) x
OQ7Prescribed.horizontalSlabPotential_second_scaled_error : ∀ (k : ℝ),
  0 < k →
    ∀ (w : ℂ → ℂ),
      ContDiff ℝ (↑⊤) w →
        HasCompactSupport w →
          ∀ (A X L C₄ C₆ : ℝ),
            0 ≤ A →
              0 ≤ X →
                0 ≤ L →
                  tsupport w ⊆ Metric.closedBall 0 A →
                    (∀ (y : ℂ), ‖iteratedFDeriv ℝ 4 w y‖ ≤ C₄) →
                      (∀ (y : ℂ), ‖iteratedFDeriv ℝ 6 w y‖ ≤ C₆) →
                        ∀ (R s : ℝ) (x u v : ℂ),
                          1 ≤ R →
                            |s| ≤ L →
                              ‖x‖ ≤ X * R →
                                ‖u‖ ≤ 1 →
                                  ‖v‖ ≤ 1 →
                                    ‖OQ7Prescribed.horizontalSlabPotential k s
                                            (OQ7Prescribed.apertureWindowSecond (OQ7Prescribed.scaledApertureWindow w R)
                                              u v)
                                            x -
                                          OQ7Prescribed.planarScalarGreen k s *
                                            OQ7Prescribed.apertureWindowSecond (OQ7Prescribed.scaledApertureWindow w R)
                                              u v x‖ ≤
                                      (L * C₄ + (A + X + 1 + L) * (C₄ + (A + X + 1 + L) ^ 2 * C₆ / 3)) /
                                        (2 * k ^ 2 * R ^ 3)
OQ7Prescribed.horizontalSlabPotential_source_form : ∀ (k s : ℝ) (w : ℂ → ℂ) (x : ℂ),
  ∫ (y : ℂ), OQ7Prescribed.slabGreen k s (x - y) * w y = OQ7Prescribed.horizontalSlabPotential k s w x
OQ7Prescribed.horizontalSlabPotential_uniform_aperture_error : ∀ (k : ℝ),
  0 < k →
    ∀ (w : ℂ → ℂ),
      ContDiff ℝ (↑⊤) w →
        HasCompactSupport w →
          ∀ (A X L : ℝ),
            0 ≤ A →
              0 ≤ X →
                0 ≤ L →
                  tsupport w ⊆ Metric.closedBall 0 A →
                    ∃ C,
                      0 < C ∧
                        ∀ (R s : ℝ) (x : ℂ),
                          1 ≤ R →
                            |s| ≤ L →
                              ‖x‖ ≤ X * R →
                                ‖OQ7Prescribed.horizontalSlabPotential k s (OQ7Prescribed.scaledApertureWindow w R) x -
                                      OQ7Prescribed.planarScalarGreen k s * OQ7Prescribed.scaledApertureWindow w R x‖ ≤
                                  C / R
OQ7Prescribed.horizontalSlabTransverseKernel_uniform_error : ∀ (k : ℝ),
  0 < k →
    ∀ (w : ℂ → ℂ),
      ContDiff ℝ (↑⊤) w →
        HasCompactSupport w →
          ∀ (A X L : ℝ),
            0 ≤ A →
              0 ≤ X →
                0 ≤ L →
                  tsupport w ⊆ Metric.closedBall 0 A →
                    ∃ C,
                      0 < C ∧
                        ∀ (R s : ℝ) (x u v : ℂ),
                          1 ≤ R →
                            |s| ≤ L →
                              ‖x‖ ≤ X * R →
                                ‖u‖ ≤ 1 →
                                  ‖v‖ ≤ 1 →
                                    ‖OQ7Prescribed.horizontalSlabTransverseKernel k s
                                            (OQ7Prescribed.scaledApertureWindow w R) x u v -
                                          (k ^ 2 * inner ℝ u v) •
                                            (OQ7Prescribed.planarScalarGreen k s *
                                              OQ7Prescribed.scaledApertureWindow w R x)‖ ≤
                                      C / R
OQ7Prescribed.horizontalSquareAperture_isOpen : ∀ (R : ℝ), IsOpen (OQ7Prescribed.horizontalSquareAperture R)
@OQ7Prescribed.horizontalSquareAperture_mono : ∀ {R S : ℝ},
  R ≤ S → OQ7Prescribed.horizontalSquareAperture R ⊆ OQ7Prescribed.horizontalSquareAperture S
OQ7Prescribed.horizontalSquareAperture_norm_le : ∀ (R : ℝ),
  0 < R → ∀ z ∈ OQ7Prescribed.horizontalSquareAperture R, ‖z‖ ≤ R
OQ7Prescribed.horizontalSquareAperture_physical : ∀ (R : ℝ) (x : OQ7Prescribed.Position),
  OQ7Prescribed.slabHorizontalCoordinate x ∈ OQ7Prescribed.horizontalSquareAperture R ↔
    x ∈ OQ7Prescribed.squareAperture R
OQ7Prescribed.horizontalSquareAperture_scaled_iff : ∀ (R : ℝ),
  0 < R → ∀ (z : ℂ), R⁻¹ • z ∈ OQ7Prescribed.horizontalSquareAperture 1 ↔ z ∈ OQ7Prescribed.horizontalSquareAperture R
OQ7Prescribed.horizontalSquareAperture_subset_ball : OQ7Prescribed.horizontalSquareAperture 1 ⊆ Metric.closedBall 0 1
OQ7Prescribed.horizontalSquareAperture_volume : ∀ (R : ℝ),
  0 ≤ R → MeasureTheory.volume (OQ7Prescribed.horizontalSquareAperture R) = ENNReal.ofReal (R ^ 2)
OQ7Prescribed.incident_absorber_coupling : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.axisCoupling (OQ7Prescribed.basisR 0) (OQ7Prescribed.incidentElectric k σ x) = 0
OQ7Prescribed.incident_plate_coupling : ∀ (θ k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.axisCoupling (OQ7Prescribed.rotatedAxis θ) (OQ7Prescribed.incidentElectric k σ x) =
    ↑(Real.sin θ) * OQ7Prescribed.planePhase k σ x
OQ7Prescribed.incident_plate_rankOne : ∀ (θ k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.tensorApply (OQ7Prescribed.rankOne (OQ7Prescribed.rotatedAxis θ))
      (OQ7Prescribed.incidentElectric k σ x) =
    (↑(Real.sin θ) * OQ7Prescribed.planePhase k σ x) • OQ7Prescribed.complexify (OQ7Prescribed.rotatedAxis θ)
OQ7Prescribed.incident_plate_rankOne_zero_angle : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.tensorApply (OQ7Prescribed.rankOne (OQ7Prescribed.rotatedAxis 0))
      (OQ7Prescribed.incidentElectric k σ x) =
    0
OQ7Prescribed.incidentElectric_contDiff : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  ContDiff ℝ (↑⊤) (OQ7Prescribed.incidentElectric k σ)
OQ7Prescribed.incidentElectric_curl : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.curl (OQ7Prescribed.incidentElectric k σ) x = (Complex.I * ↑k) • OQ7Prescribed.incidentMagnetic k σ x
OQ7Prescribed.incidentElectric_first_weakCurl : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.incidentElectric k σ) fun x =>
    (Complex.I * ↑k) • OQ7Prescribed.incidentMagnetic k σ x
OQ7Prescribed.incidentElectric_locallySquareIntegrable : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.incidentElectric k σ)
OQ7Prescribed.incidentElectric_minus_conjugate : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  OQ7Prescribed.incidentElectric k OQ7Prescribed.Direction.minus x =
    WithLp.toLp 2 fun i => star ((OQ7Prescribed.incidentElectric k OQ7Prescribed.Direction.plus x).ofLp i)
OQ7Prescribed.incidentElectric_norm : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.incidentElectric k σ x‖ = 1
OQ7Prescribed.incidentElectric_squareNorm : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.squareNorm (OQ7Prescribed.incidentElectric k σ x) = 1
OQ7Prescribed.incidentMagnetic_contDiff : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  ContDiff ℝ (↑⊤) (OQ7Prescribed.incidentMagnetic k σ)
OQ7Prescribed.incidentMagnetic_curl : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.curl (OQ7Prescribed.incidentMagnetic k σ) x = (-Complex.I * ↑k) • OQ7Prescribed.incidentElectric k σ x
OQ7Prescribed.incidentMagnetic_eq : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.incidentMagnetic k σ = fun x => (-↑σ.sign * OQ7Prescribed.planePhase k σ x) • OQ7Prescribed.basisC 0
OQ7Prescribed.incidentMagnetic_locallySquareIntegrable : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.incidentMagnetic k σ)
OQ7Prescribed.incidentMagnetic_second_weakCurl : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.incidentMagnetic k σ) fun x =>
    (-Complex.I * ↑k) • OQ7Prescribed.incidentElectric k σ x
@OQ7Prescribed.indicatorL2_add : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α) (s : Set α)
  (hs : MeasurableSet s) (f g : ↥(MeasureTheory.Lp E 2 μ)),
  OQ7Prescribed.indicatorL2 μ s hs (f + g) = OQ7Prescribed.indicatorL2 μ s hs f + OQ7Prescribed.indicatorL2 μ s hs g
@OQ7Prescribed.indicatorL2_coe : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α) (s : Set α)
  (hs : MeasurableSet s) (f : ↥(MeasureTheory.Lp E 2 μ)),
  ↑↑(OQ7Prescribed.indicatorL2 μ s hs f) =ᵐ[μ] s.indicator fun x => ↑↑f x
@OQ7Prescribed.indicatorL2_eq_self_iff : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α)
  (s : Set α) (hs : MeasurableSet s) (f : ↥(MeasureTheory.Lp E 2 μ)),
  OQ7Prescribed.indicatorL2 μ s hs f = f ↔ f ∈ OQ7Prescribed.setSupportedL2 μ s
@OQ7Prescribed.indicatorL2_norm_le : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α) (s : Set α)
  (hs : MeasurableSet s) (f : ↥(MeasureTheory.Lp E 2 μ)), ‖OQ7Prescribed.indicatorL2 μ s hs f‖ ≤ ‖f‖
@OQ7Prescribed.indicatorL2_smul : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α)
  (s : Set α) (hs : MeasurableSet s) (z : ℂ) (f : ↥(MeasureTheory.Lp E 2 μ)),
  OQ7Prescribed.indicatorL2 μ s hs (z • f) = z • OQ7Prescribed.indicatorL2 μ s hs f
@OQ7Prescribed.indicatorL2_supported : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α)
  (s : Set α) (hs : MeasurableSet s) (f : ↥(MeasureTheory.Lp E 2 μ)),
  OQ7Prescribed.indicatorL2 μ s hs f ∈ OQ7Prescribed.setSupportedL2 μ s
@OQ7Prescribed.inner_quadratic_difference_norm_bound : ∀ {E : Type u_1} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℂ E] [CompleteSpace E] (M : E →L[ℂ] E) (r s : E),
  ‖inner ℂ r (M r) - inner ℂ s (M s)‖ ≤ ‖M‖ * (‖r‖ + ‖s‖) * ‖r - s‖
OQ7Prescribed.integrable_polar_actual : ∀ (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable f MeasureTheory.volume →
    MeasureTheory.Integrable (fun p => f (↑p.2 • ↑p.1))
      (OQ7Prescribed.sphereArea.prod (MeasureTheory.Measure.volumeIoiPow 2))
OQ7Prescribed.integral_compact_ball_abs_bound : ∀ (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable f MeasureTheory.volume →
    ∀ (r C : ℝ),
      0 < r →
        (∀ (x : OQ7Prescribed.Position), 2 * r < ‖x‖ → f x = 0) →
          (∀ᵐ (x : OQ7Prescribed.Position), |f x| ≤ C / r ^ 4) →
            |∫ (x : OQ7Prescribed.Position), f x| ≤ 32 * Real.pi / 3 * C / r
OQ7Prescribed.integral_compact_ball_complex_bound : ∀ (f : OQ7Prescribed.Position → ℂ),
  MeasureTheory.Integrable f MeasureTheory.volume →
    ∀ (r C : ℝ),
      0 < r →
        (∀ (x : OQ7Prescribed.Position), 2 * r < ‖x‖ → f x = 0) →
          (∀ᵐ (x : OQ7Prescribed.Position), ‖f x‖ ≤ C / r ^ 4) →
            ‖∫ (x : OQ7Prescribed.Position), f x‖ ≤ 64 * Real.pi / 3 * C / r
OQ7Prescribed.integral_compact_ball_lower_bound : ∀ (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable f MeasureTheory.volume →
    ∀ (r C : ℝ),
      0 < r →
        (∀ (x : OQ7Prescribed.Position), 2 * r < ‖x‖ → f x = 0) →
          (∀ᵐ (x : OQ7Prescribed.Position), -(C / r ^ 4) ≤ f x) →
            -(32 * Real.pi / 3 * C / r) ≤ ∫ (x : OQ7Prescribed.Position), f x
OQ7Prescribed.integral_polar_actual : ∀ (f : OQ7Prescribed.Position → ℝ),
  ∫ (x : OQ7Prescribed.Position), f x =
    ∫ (p : ↑OQ7Prescribed.UnitSphere × ↑(Set.Ioi 0)),
      f (↑p.2 • ↑p.1) ∂OQ7Prescribed.sphereArea.prod (MeasureTheory.Measure.volumeIoiPow 2)
OQ7Prescribed.integral_polar_iterated_actual : ∀ (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable f MeasureTheory.volume →
    ∫ (x : OQ7Prescribed.Position), f x =
      ∫ (s : ℝ) in Set.Ioi 0, s ^ 2 * ∫ (n : ↑OQ7Prescribed.UnitSphere), f (s • ↑n) ∂OQ7Prescribed.sphereArea
@OQ7Prescribed.integral_slabCoordinates : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : NormedSpace ℝ E]
  (f : OQ7Prescribed.Position → E),
  ∫ (x : OQ7Prescribed.Position), f x = ∫ (p : ℂ × ℝ), f (OQ7Prescribed.slabPosition p.1 p.2)
OQ7Prescribed.integral_slabObservationRegion : ∀ (r L : ℝ) (f : OQ7Prescribed.Position → ℝ),
  ∫ (x : OQ7Prescribed.Position) in OQ7Prescribed.slabObservationRegion r L, f x =
    ∫ (y : ℂ × ℝ) in OQ7Prescribed.slabProductRegion r L, f (OQ7Prescribed.slabPosition y.1 y.2)
OQ7Prescribed.integral_spherical_actual : ∀ (f : OQ7Prescribed.Position → ℝ),
  ∫ (x : OQ7Prescribed.Position), f x =
    ∫ (p : Fin 3 → ℝ) in OQ7Prescribed.sphericalDomain,
      p 0 ^ 2 * Real.sin (p 1) * f (WithLp.toLp 2 (OQ7Prescribed.sphericalPoint p))
OQ7Prescribed.integral_three_sub : ∀ (a b c d e f : OQ7Prescribed.Position → ℂ),
  MeasureTheory.Integrable a MeasureTheory.volume →
    MeasureTheory.Integrable b MeasureTheory.volume →
      MeasureTheory.Integrable c MeasureTheory.volume →
        MeasureTheory.Integrable d MeasureTheory.volume →
          MeasureTheory.Integrable e MeasureTheory.volume →
            MeasureTheory.Integrable f MeasureTheory.volume →
              ∫ (x : OQ7Prescribed.Position), a x - b x + (c x - d x) + (e x - f x) =
                ((∫ (x : OQ7Prescribed.Position), a x) - ∫ (x : OQ7Prescribed.Position), b x) +
                    ((∫ (x : OQ7Prescribed.Position), c x) - ∫ (x : OQ7Prescribed.Position), d x) +
                  ((∫ (x : OQ7Prescribed.Position), e x) - ∫ (x : OQ7Prescribed.Position), f x)
@OQ7Prescribed.inverse_trial_residual_estimate : ∀ {𝕜 : Type u_1} {E : Type u_2} {F : Type u_3}
  [inst : NontriviallyNormedField 𝕜] [inst_1 : NormedAddCommGroup E] [inst_2 : NormedSpace 𝕜 E]
  [inst_3 : NormedAddCommGroup F] [inst_4 : NormedSpace 𝕜 F] (e : E ≃L[𝕜] E) (A : F →L[𝕜] F) (J : F →L[𝕜] E) (g : E)
  (f q : F),
  A q = -f →
    ∀ (M C : ℝ), 0 ≤ M → ‖↑e.symm‖ ≤ M → ‖e (J q) - J (A q)‖ ≤ C * ‖q‖ → ‖e.symm (-g) - J q‖ ≤ M * (‖g - J f‖ + C * ‖q‖)
@OQ7Prescribed.isOpen_strict_region_of_continuousAt_on_open : ∀ {X : Type u_1} [inst : TopologicalSpace X] (U : Set X),
  IsOpen U → ∀ (f : X → ℝ), (∀ x ∈ U, ContinuousAt f x) → ∀ (m : ℝ), IsOpen {x | x ∈ U ∧ m < f x}
OQ7Prescribed.isotropicLayer_susceptibility : ∀ (α : ℂ) (ν : ℝ) (u : OQ7Prescribed.Position),
  OQ7Prescribed.layerPermittivity α.re α.im ν u - 1 = α • OQ7Prescribed.rankOne u + (Complex.I * ↑ν) • 1
OQ7Prescribed.isotropicRankOneBody_admissible : ∀ (B : OQ7Prescribed.TwoLayerBody) (ν θ P Q : ℝ) (α β : ℂ),
  0 < ν →
    0 ≤ α.re →
      0 ≤ β.re →
        1 + α.re ≤ P →
          1 + β.re ≤ P →
            0 ≤ α.im →
              0 ≤ β.im → α.im + ν ≤ Q → β.im + ν ≤ Q → (OQ7Prescribed.isotropicRankOneBody B ν θ α β).admissible P Q
OQ7Prescribed.isotropicSusceptibilityOperator_coe : ∀ (B : OQ7Prescribed.TwoLayerBody) (ν θ : ℝ) (α β : ℂ)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.isotropicSusceptibilityOperator B ν θ α β) f) =ᵐ[MeasureTheory.volume] fun x =>
    if x.ofLp 2 < B.absorberThickness then
      (OQ7Prescribed.tensorMap ((OQ7Prescribed.isotropicRankOneBody B ν θ α β).absorberPermittivity - 1)) (↑↑↑f x)
    else (OQ7Prescribed.tensorMap ((OQ7Prescribed.isotropicRankOneBody B ν θ α β).platePermittivity - 1)) (↑↑↑f x)
OQ7Prescribed.isotropicSusceptibilityOperator_imaginary_bound : ∀ (B : OQ7Prescribed.TwoLayerBody) (ν θ : ℝ) (α β : ℂ),
  0 ≤ α.im →
    0 ≤ β.im →
      ∀ (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
        ν * ‖f‖ ^ 2 ≤ (inner ℂ f ((OQ7Prescribed.isotropicSusceptibilityOperator B ν θ α β) f)).im
OQ7Prescribed.isotropicSusceptibilityOperator_joint_continuous : ∀ (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ),
  Continuous fun x => OQ7Prescribed.isotropicSusceptibilityOperator B x.1 x.2 α β
OQ7Prescribed.kernel_radiation_defect : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (v : OQ7Prescribed.Vector),
      OQ7Prescribed.cross (OQ7Prescribed.kernelMagnetic k x v) (OQ7Prescribed.complexify (‖x‖⁻¹ • x)) -
          (OQ7Prescribed.classicalDyadic k x) v =
        (OQ7Prescribed.outgoingRadial k ‖x‖ / ↑‖x‖ ^ 2) • v +
          ((2 * Complex.I * ↑k * ↑‖x‖ - 3) * OQ7Prescribed.outgoingRadial k ‖x‖ / ↑‖x‖ ^ 4) •
            OQ7Prescribed.bilinear (OQ7Prescribed.complexify x) v • OQ7Prescribed.complexify x
OQ7Prescribed.kernel_radiation_defect_norm_le : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (v : OQ7Prescribed.Vector),
      ‖OQ7Prescribed.cross (OQ7Prescribed.kernelMagnetic k x v) (OQ7Prescribed.complexify (‖x‖⁻¹ • x)) -
            (OQ7Prescribed.classicalDyadic k x) v‖ ≤
        (2 * |k| / (4 * Real.pi * ‖x‖ ^ 2) + 1 / (Real.pi * ‖x‖ ^ 3)) * ‖v‖
OQ7Prescribed.kernelMagnetic_gradient : ∀ (k : ℝ) (x : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.kernelMagnetic k x v =
    (-Complex.I * ↑k) •
      !₂[OQ7Prescribed.outgoingGradient k 1 x * v.ofLp 2 - OQ7Prescribed.outgoingGradient k 2 x * v.ofLp 1,
        OQ7Prescribed.outgoingGradient k 2 x * v.ofLp 0 - OQ7Prescribed.outgoingGradient k 0 x * v.ofLp 2,
        OQ7Prescribed.outgoingGradient k 0 x * v.ofLp 1 - OQ7Prescribed.outgoingGradient k 1 x * v.ofLp 0]
OQ7Prescribed.kernelMagnetic_leading : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (v : OQ7Prescribed.Vector),
      OQ7Prescribed.kernelMagnetic k x v =
        (↑(k ^ 2) * OQ7Prescribed.outgoingRadial k ‖x‖) •
            OQ7Prescribed.cross (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)) v +
          (Complex.I * ↑k * OQ7Prescribed.outgoingRadial k ‖x‖ / ↑‖x‖) •
            OQ7Prescribed.cross (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)) v
OQ7Prescribed.kernelMagnetic_norm_decay : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  1 ≤ ‖x‖ →
    ∀ (v : OQ7Prescribed.Vector), ‖OQ7Prescribed.kernelMagnetic k x v‖ ≤ |k| * (|k| + 1) / (4 * Real.pi) / ‖x‖ * ‖v‖
OQ7Prescribed.kernelMagnetic_norm_le : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (v : OQ7Prescribed.Vector),
      ‖OQ7Prescribed.kernelMagnetic k x v‖ ≤ |k| * (|k| * ‖x‖ + 1) / (4 * Real.pi * ‖x‖ ^ 2) * ‖v‖
OQ7Prescribed.kernelMagnetic_norm_le_far : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  1 ≤ ‖x‖ → ∀ (v : OQ7Prescribed.Vector), ‖OQ7Prescribed.kernelMagnetic k x v‖ ≤ |k| * (|k| + 1) / (4 * Real.pi) * ‖v‖
OQ7Prescribed.kernelQuadratic_cosine : ∀ (k : ℝ) (q : ℝ → ℂ),
  MeasureTheory.Integrable q MeasureTheory.volume →
    OQ7Prescribed.kernelQuadratic (fun p => ↑(Real.cos (k * (p.1 - p.2)))) q =
      ↑(Complex.normSq (∫ (z : ℝ), ↑(Real.cos (k * z)) * q z) + Complex.normSq (∫ (z : ℝ), ↑(Real.sin (k * z)) * q z))
OQ7Prescribed.kernelQuadratic_integrable : ∀ (b : ℝ × ℝ → ℂ) (q : ℝ → ℂ),
  MeasureTheory.Integrable q MeasureTheory.volume →
    MeasureTheory.AEStronglyMeasurable b MeasureTheory.volume →
      ∀ (C : ℝ),
        (∀ᵐ (p : ℝ × ℝ), ‖b p‖ ≤ C) →
          MeasureTheory.Integrable (fun p => b p * (starRingEnd ℂ) (q p.1) * q p.2) MeasureTheory.volume
OQ7Prescribed.kernelQuadratic_planar_im : ∀ (k : ℝ),
  0 < k →
    ∀ (q : ℝ → ℂ),
      MeasureTheory.Integrable q MeasureTheory.volume →
        (OQ7Prescribed.kernelQuadratic (fun p => k ^ 2 • OQ7Prescribed.planarScalarGreen k (p.1 - p.2)) q).im =
          k / 2 *
            (Complex.normSq (∫ (z : ℝ), ↑(Real.cos (k * z)) * q z) +
              Complex.normSq (∫ (z : ℝ), ↑(Real.sin (k * z)) * q z))
OQ7Prescribed.kernelQuadratic_planar_im_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (q : ℝ → ℂ),
      MeasureTheory.Integrable q MeasureTheory.volume →
        0 ≤ (OQ7Prescribed.kernelQuadratic (fun p => k ^ 2 • OQ7Prescribed.planarScalarGreen k (p.1 - p.2)) q).im
OQ7Prescribed.kernelQuadratic_real_rankOne : ∀ (c : ℝ → ℝ) (q : ℝ → ℂ),
  OQ7Prescribed.kernelQuadratic (fun p => ↑(c p.1 * c p.2)) q = ↑(Complex.normSq (∫ (z : ℝ), ↑(c z) * q z))
OQ7Prescribed.kernelQuadratic_real_symmetric : ∀ (b : ℝ × ℝ → ℝ) (q : ℝ → ℂ),
  (∀ (p : ℝ × ℝ), b p.swap = b p) → (OQ7Prescribed.kernelQuadratic (fun p => ↑(b p)) q).im = 0
OQ7Prescribed.layerPermittivity_admissible : ∀ (P Q a b ν : ℝ) (u : OQ7Prescribed.Position),
  ‖u‖ ^ 2 = 1 →
    0 ≤ a →
      1 + a ≤ P →
        0 ≤ b → 0 < ν → b + ν ≤ Q → OQ7Prescribed.MaterialAdmissible P Q (OQ7Prescribed.layerPermittivity a b ν u)
OQ7Prescribed.layerPermittivity_reciprocal : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position),
  Matrix.transpose (OQ7Prescribed.layerPermittivity a b ν u) = OQ7Prescribed.layerPermittivity a b ν u
OQ7Prescribed.locallySquareIntegrable_locallyIntegrable : ∀ (F : OQ7Prescribed.Field),
  OQ7Prescribed.LocallySquareIntegrable F → MeasureTheory.LocallyIntegrable F MeasureTheory.volume
OQ7Prescribed.Lorentz_flux_norm_bound : ∀ (E₁ H₁ E₂ H₂ n : OQ7Prescribed.Vector),
  ‖OQ7Prescribed.bilinear E₁ (OQ7Prescribed.cross H₂ n) - OQ7Prescribed.bilinear E₂ (OQ7Prescribed.cross H₁ n)‖ ≤
    ‖E₁‖ * ‖OQ7Prescribed.cross H₂ n - E₂‖ + ‖E₂‖ * ‖OQ7Prescribed.cross H₁ n - E₁‖
OQ7Prescribed.LorentzDecayConstant_nonneg : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  0 ≤ OQ7Prescribed.LorentzDecayConstant k p q
OQ7Prescribed.losslessPlateCartesian_active_projection : ∀ (k h : ℝ) (j : ℕ) (hj : 1 ≤ j) (θ : ℝ) (Ex Ey Hx Hy : ℂ)
  (z : ℝ),
  ↑(Real.cos θ) * (OQ7Prescribed.losslessPlateXLayer k h j hj θ Ex Ey Hx Hy).electric z +
      ↑(Real.sin θ) * (OQ7Prescribed.losslessPlateYLayer k h j hj θ Ex Ey Hx Hy).electric z =
    (OQ7Prescribed.losslessPlateActiveLayer k h j hj θ Ex Ey Hx Hy).electric z
OQ7Prescribed.losslessPlateCartesian_boundary : ∀ (k : ℝ),
  0 < k →
    ∀ (h : ℝ) (j : ℕ) (hj : 1 ≤ j) (θ : ℝ) (Ex Ey Hx Hy : ℂ),
      (OQ7Prescribed.losslessPlateXLayer k h j hj θ Ex Ey Hx Hy).electric (h + OQ7Prescribed.plateDesignThickness k j) =
          (↑(Real.cos θ) ^ 2 - ↑(Real.sin θ) ^ 2) * Ex + 2 * ↑(Real.cos θ) * ↑(Real.sin θ) * Ey ∧
        (OQ7Prescribed.losslessPlateYLayer k h j hj θ Ex Ey Hx Hy).electric
              (h + OQ7Prescribed.plateDesignThickness k j) =
            2 * ↑(Real.cos θ) * ↑(Real.sin θ) * Ex - (↑(Real.cos θ) ^ 2 - ↑(Real.sin θ) ^ 2) * Ey ∧
          (OQ7Prescribed.losslessPlateXLayer k h j hj θ Ex Ey Hx Hy).magnetic
                (h + OQ7Prescribed.plateDesignThickness k j) =
              (↑(Real.cos θ) ^ 2 - ↑(Real.sin θ) ^ 2) * Hx + 2 * ↑(Real.cos θ) * ↑(Real.sin θ) * Hy ∧
            (OQ7Prescribed.losslessPlateYLayer k h j hj θ Ex Ey Hx Hy).magnetic
                (h + OQ7Prescribed.plateDesignThickness k j) =
              2 * ↑(Real.cos θ) * ↑(Real.sin θ) * Hx - (↑(Real.cos θ) ^ 2 - ↑(Real.sin θ) ^ 2) * Hy
OQ7Prescribed.losslessPlateCartesian_current_rankOne : ∀ (k h : ℝ) (j : ℕ) (hj : 1 ≤ j) (θ : ℝ) (Ex Ey Hx Hy : ℂ)
  (z : ℝ),
  (OQ7Prescribed.losslessPlateXLayer k h j hj θ Ex Ey Hx Hy).current z =
      ↑(Real.cos θ) * ↑(OQ7Prescribed.plateDesignPermittivity j - 1) *
        (OQ7Prescribed.losslessPlateActiveLayer k h j hj θ Ex Ey Hx Hy).electric z ∧
    (OQ7Prescribed.losslessPlateYLayer k h j hj θ Ex Ey Hx Hy).current z =
      ↑(Real.sin θ) * ↑(OQ7Prescribed.plateDesignPermittivity j - 1) *
        (OQ7Prescribed.losslessPlateActiveLayer k h j hj θ Ex Ey Hx Hy).electric z
OQ7Prescribed.losslessPlateCartesian_initial : ∀ (k h : ℝ) (j : ℕ) (hj : 1 ≤ j) (θ : ℝ) (Ex Ey Hx Hy : ℂ),
  (OQ7Prescribed.losslessPlateXLayer k h j hj θ Ex Ey Hx Hy).electric h = Ex ∧
    (OQ7Prescribed.losslessPlateYLayer k h j hj θ Ex Ey Hx Hy).electric h = Ey ∧
      (OQ7Prescribed.losslessPlateXLayer k h j hj θ Ex Ey Hx Hy).magnetic h = Hx ∧
        (OQ7Prescribed.losslessPlateYLayer k h j hj θ Ex Ey Hx Hy).magnetic h = Hy
OQ7Prescribed.losslessPlateDesign_active_field_boundary : ∀ (k : ℝ),
  0 < k →
    ∀ (j : ℕ),
      1 ≤ j →
        ∀ (E H : ℂ),
          OQ7.electricField k (↑(OQ7Prescribed.plateDesignIndex j)) E H (OQ7Prescribed.plateDesignThickness k j) = E ∧
            OQ7.magneticField k (↑(OQ7Prescribed.plateDesignIndex j)) E H (OQ7Prescribed.plateDesignThickness k j) = H
OQ7Prescribed.losslessPlateDesign_active_transfer : ∀ (k : ℝ),
  0 < k →
    ∀ (j : ℕ),
      1 ≤ j →
        OQ7.homogeneousTransfer k (↑(OQ7Prescribed.plateDesignIndex j)) (OQ7Prescribed.plateDesignThickness k j) = 1
OQ7Prescribed.losslessPlateDesign_actual_coefficients : ∀ (k : ℝ),
  0 < k →
    ∀ (j : ℕ),
      1 ≤ j →
        OQ7Prescribed.dielectricSlabReflection k (OQ7Prescribed.plateDesignPermittivity j) 0
              (OQ7Prescribed.plateDesignThickness k j) =
            0 ∧
          OQ7Prescribed.dielectricSlabTransmission k (OQ7Prescribed.plateDesignPermittivity j) 0
              (OQ7Prescribed.plateDesignThickness k j) =
            1
OQ7Prescribed.losslessPlateDesign_actual_transfer : ∀ (k : ℝ),
  0 < k →
    ∀ (j : ℕ),
      1 ≤ j →
        OQ7.layerTransfer k
            (OQ7Prescribed.dielectricSlab (OQ7Prescribed.plateDesignPermittivity j) 0
              (OQ7Prescribed.plateDesignThickness k j)) =
          1
OQ7Prescribed.losslessPlateDesign_asymmetry_value : ∀ (k : ℝ),
  0 < k →
    ∀ (A : OQ7.HomogeneousLayer) (hpA : 1 ≤ A.p),
      0 ≤ A.q →
        0 ≤ A.width →
          ∀ (j : ℕ) (hj : 1 ≤ j),
            OQ7Prescribed.slabFormulaAsymmetry k A
                (OQ7Prescribed.dielectricSlab (OQ7Prescribed.plateDesignPermittivity j) 0
                  (OQ7Prescribed.plateDesignThickness k j))
                0 hpA ⋯ =
              OQ7.absorptanceLeft (OQ7Prescribed.dielectricSlabReflection k A.p A.q A.width)
                (OQ7Prescribed.dielectricSlabTransmission k A.p A.q A.width)
OQ7Prescribed.losslessPlateDesign_coupled_amplitudes : ∀ (k : ℝ),
  0 < k →
    ∀ (A : OQ7.HomogeneousLayer) (j : ℕ),
      1 ≤ j →
        OQ7Prescribed.slabAbsorberAmplitude k A
              (OQ7Prescribed.dielectricSlab (OQ7Prescribed.plateDesignPermittivity j) 0
                (OQ7Prescribed.plateDesignThickness k j))
              0 OQ7Prescribed.Direction.plus =
            0 ∧
          Complex.normSq
              (OQ7Prescribed.slabAbsorberAmplitude k A
                (OQ7Prescribed.dielectricSlab (OQ7Prescribed.plateDesignPermittivity j) 0
                  (OQ7Prescribed.plateDesignThickness k j))
                0 OQ7Prescribed.Direction.minus) =
            4
OQ7Prescribed.losslessPlateDesign_coupled_power_values : ∀ (k : ℝ),
  0 < k →
    ∀ (A : OQ7.HomogeneousLayer) (hpA : 1 ≤ A.p),
      0 ≤ A.q →
        0 ≤ A.width →
          ∀ (j : ℕ) (hj : 1 ≤ j),
            let W :=
              OQ7Prescribed.dielectricSlab (OQ7Prescribed.plateDesignPermittivity j) 0
                (OQ7Prescribed.plateDesignThickness k j);
            have hpW := ⋯;
            OQ7Prescribed.slabIntegralAbsorption k A W 0 OQ7Prescribed.Direction.plus hpA hpW = 0 ∧
              OQ7Prescribed.slabIntegralAbsorption k A W 0 OQ7Prescribed.Direction.minus hpA hpW =
                  4 *
                    OQ7.absorptanceLeft (OQ7Prescribed.dielectricSlabReflection k A.p A.q A.width)
                      (OQ7Prescribed.dielectricSlabTransmission k A.p A.q A.width) ∧
                OQ7Prescribed.slabFormulaExtinction k A W 0 = 4
OQ7Prescribed.losslessPlateDesign_vacuum_field_boundary : ∀ (k : ℝ),
  0 < k →
    ∀ (j : ℕ),
      1 ≤ j →
        ∀ (E H : ℂ),
          OQ7.electricField k 1 E H (OQ7Prescribed.plateDesignThickness k j) = -E ∧
            OQ7.magneticField k 1 E H (OQ7Prescribed.plateDesignThickness k j) = -H
OQ7Prescribed.losslessPlateDesign_vacuum_phase : ∀ (k : ℝ),
  0 < k → ∀ (j : ℕ), 1 ≤ j → OQ7Prescribed.apertureOscillation k (OQ7Prescribed.plateDesignThickness k j) = -1
OQ7Prescribed.losslessPlateDesign_vacuum_transfer : ∀ (k : ℝ),
  0 < k → ∀ (j : ℕ), 1 ≤ j → OQ7.homogeneousTransfer k 1 (OQ7Prescribed.plateDesignThickness k j) = -1
OQ7Prescribed.lp_norm_sq_eq_restricted_integral : ∀ (D : ↥OQ7Prescribed.ScalarVolumeL2)
  (s : Set OQ7Prescribed.Position),
  MeasurableSet s →
    ∀ (f : OQ7Prescribed.Position → ℂ),
      ↑↑D =ᵐ[MeasureTheory.volume] s.indicator f → ‖D‖ ^ 2 = ∫ (x : OQ7Prescribed.Position) in s, ‖f x‖ ^ 2
OQ7Prescribed.magneticExterior_eq_pointwise_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ → OQ7Prescribed.exteriorMagnetic k p x = OQ7Prescribed.magneticVolumeField k p x
OQ7Prescribed.magneticVolumeField_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.magneticVolumeField k p) i =
    OQ7Prescribed.outgoingMagneticDistribution k p i
OQ7Prescribed.magneticVolumeField_locallySquareIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.magneticVolumeField k p)
OQ7Prescribed.materialBodyCoercivity_pos : ∀ (B : OQ7Prescribed.TwoLayerBody)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity), 0 < OQ7Prescribed.materialBodyCoercivity B a b
OQ7Prescribed.materialBodyEquiv_apply : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  (OQ7Prescribed.materialBodyEquiv k hk B a b) f = (OQ7Prescribed.materialBodyOperator k B a b) f
OQ7Prescribed.materialBodyEquiv_inverse_norm_le : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity),
  ‖↑(OQ7Prescribed.materialBodyEquiv k hk B a b).symm‖ ≤ 1 / min a.loss b.loss
OQ7Prescribed.materialBodyOperator_imaginary_coercive : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody) (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
      (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
      OQ7Prescribed.materialBodyCoercivity B a b * ‖f‖ ^ 2 ≤
        (inner ℂ f ((OQ7Prescribed.materialBodyOperator k B a b) f)).im
OQ7Prescribed.materialBodySolution_equation : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity),
  (OQ7Prescribed.materialBodyOperator k B a b) (OQ7Prescribed.materialBodySolution k hk B σ a b) =
    -OQ7Prescribed.bodyIncidentCurrent k B σ
OQ7Prescribed.materialBodySolution_physicalVolumeEquation : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity),
  OQ7Prescribed.MaterialVolumeEquation k B σ
    (OQ7Prescribed.bodyCurrentPolarization B (OQ7Prescribed.materialBodySolution k hk B σ a b))
OQ7Prescribed.materialVolumeCurrent_coe : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
  (p : OQ7Prescribed.CompactPolarization) (hp : OQ7Prescribed.MaterialVolumeEquation k B σ p),
  ↑↑↑(OQ7Prescribed.materialVolumeCurrent k B σ p hp) =ᵐ[MeasureTheory.volume] p.current
OQ7Prescribed.materialVolumeCurrent_eq_solution : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (p : OQ7Prescribed.CompactPolarization)
  (hp : OQ7Prescribed.MaterialVolumeEquation k B σ p)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity),
  OQ7Prescribed.materialVolumeCurrent k B σ p hp = OQ7Prescribed.materialBodySolution k hk B σ a b
OQ7Prescribed.materialVolumeCurrent_operator_equation : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (p : OQ7Prescribed.CompactPolarization)
  (hp : OQ7Prescribed.MaterialVolumeEquation k B σ p)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity),
  (OQ7Prescribed.materialBodyOperator k B a b) (OQ7Prescribed.materialVolumeCurrent k B σ p hp) =
    -OQ7Prescribed.bodyIncidentCurrent k B σ
OQ7Prescribed.materialVolumeCurrent_supported : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
  (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.MaterialVolumeEquation k B σ p → ∀ᵐ (x : OQ7Prescribed.Position), x ∉ B.domain → p.current x = 0
OQ7Prescribed.materialVolumeEquation_exists : ∀ (k : ℝ),
  0 < k →
    ∀ (P Q : ℝ) (B : OQ7Prescribed.TwoLayerBody),
      B.admissible P Q → ∀ (σ : OQ7Prescribed.Direction), ∃ p, OQ7Prescribed.MaterialVolumeEquation k B σ p
OQ7Prescribed.materialVolumeEquation_unique_current : ∀ (k : ℝ),
  0 < k →
    ∀ (P Q : ℝ) (B : OQ7Prescribed.TwoLayerBody),
      B.admissible P Q →
        ∀ (σ : OQ7Prescribed.Direction) (p q : OQ7Prescribed.CompactPolarization),
          OQ7Prescribed.MaterialVolumeEquation k B σ p →
            OQ7Prescribed.MaterialVolumeEquation k B σ q → p.current =ᵐ[MeasureTheory.volume] q.current
@OQ7Prescribed.memLp_two_integral_norm_sq : ∀ {α : Type u_1} [inst : MeasurableSpace α] {μ : MeasureTheory.Measure α}
  [MeasureTheory.SFinite μ] (f : α → ℂ) (hf : MeasureTheory.MemLp f 2 μ),
  ∫ (x : α), ‖f x‖ ^ 2 ∂μ = ‖MeasureTheory.MemLp.toLp f hf‖ ^ 2
OQ7Prescribed.newton_classical_hessian : ∀ (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (i j : Fin 3),
      lineDeriv ℝ (fun y => lineDeriv ℝ (OQ7Prescribed.outgoingGreen 0) y (OQ7Prescribed.basisR j)) x
          (OQ7Prescribed.basisR i) =
        ↑((3 * x.ofLp i * x.ofLp j - ‖x‖ ^ 2 * if i = j then 1 else 0) / (4 * Real.pi * ‖x‖ ^ 5))
OQ7Prescribed.newton_compensated_cutoff_tendsto : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  Filter.Tendsto (fun r => ∫ (x : OQ7Prescribed.Position) in {x | r < ‖x‖}, OQ7Prescribed.newtonCompensated φ i j x)
    (nhds 0) (nhds (OQ7Prescribed.newtonPVValue φ i j))
OQ7Prescribed.newton_contact_identity_real : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  ∫ (x : OQ7Prescribed.Position),
      OQ7Prescribed.newtonReal x * ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x =
    OQ7Prescribed.newtonPVValue φ i j - (if i = j then 1 else 0) / 3 * φ 0
OQ7Prescribed.newton_current_correlation_joint_integrable : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ (q.1 + q.2)) * OQ7Prescribed.outgoingGreen 0 q.1 * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.newton_current_correlation_pairing_integrable : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun z => OQ7Prescribed.outgoingGreen 0 z * OQ7Prescribed.newtonCurrentCorrelation p φ i z)
    MeasureTheory.volume
OQ7Prescribed.newton_current_pairing_integrand_cutoff : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3) (S : ℝ),
  (∀ (x : OQ7Prescribed.Position), φ x ≠ 0 → ‖x‖ ≤ S) →
    ∀ (x y : OQ7Prescribed.Position),
      ↑(φ x) * OQ7Prescribed.outgoingGreen 0 (x - y) * (p.current y).ofLp i =
        ↑(φ x) * OQ7Prescribed.cutoffGreen 0 (S + p.radius) (x - y) * (p.current y).ofLp i
OQ7Prescribed.newton_current_test_joint_integrable : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ q.1) * OQ7Prescribed.outgoingGreen 0 (q.1 - q.2) * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.newton_cutoff_contact_shell : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
        ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoffPartial r t i x * OQ7Prescribed.newtonGradient j x * φ x =
          -(4 * Real.pi)⁻¹ *
            ∫ (u : ℝ) in 0..1,
              OQ7Prescribed.transitionDerivative u *
                ∫ (n : ↑OQ7Prescribed.UnitSphere),
                  (↑n).ofLp i * (↑n).ofLp j * φ ((r + t * u) • ↑n) ∂OQ7Prescribed.sphereArea
OQ7Prescribed.newton_cutoff_contact_shell_tendsto : ∀ (r : ℝ),
  0 < r →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
      Filter.Tendsto
        (fun t =>
          ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoffPartial r t i x * OQ7Prescribed.newtonGradient j x * φ x)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (OQ7Prescribed.newtonContactBoundary φ i j r))
OQ7Prescribed.newton_cutoff_derivative_shell : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
        ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoffPartial r t j x * OQ7Prescribed.newtonReal x *
              ((OQ7Prescribed.testPartial i) φ) x =
          (4 * Real.pi)⁻¹ *
            ∫ (u : ℝ) in 0..1,
              OQ7Prescribed.transitionDerivative u *
                ((r + t * u) *
                  ∫ (n : ↑OQ7Prescribed.UnitSphere),
                    (↑n).ofLp j * ((OQ7Prescribed.testPartial i) φ) ((r + t * u) • ↑n) ∂OQ7Prescribed.sphereArea)
OQ7Prescribed.newton_cutoff_derivative_shell_tendsto : ∀ (r : ℝ),
  0 < r →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
      Filter.Tendsto
        (fun t =>
          ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoffPartial r t j x * OQ7Prescribed.newtonReal x *
              ((OQ7Prescribed.testPartial i) φ) x)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (-OQ7Prescribed.newtonDerivativeBoundary φ i j r))
OQ7Prescribed.newton_cutoff_double_ibp : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
        ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonReal x *
              ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x =
          ((∫ (x : OQ7Prescribed.Position),
                OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonHessianKernel i j x * φ x) +
              ∫ (x : OQ7Prescribed.Position),
                OQ7Prescribed.exteriorCutoffPartial r t i x * OQ7Prescribed.newtonGradient j x * φ x) -
            ∫ (x : OQ7Prescribed.Position),
              OQ7Prescribed.exteriorCutoffPartial r t j x * OQ7Prescribed.newtonReal x *
                ((OQ7Prescribed.testPartial i) φ) x
OQ7Prescribed.newton_frequency_heat_joint_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun p => φ p.1 * OQ7Prescribed.newtonFrequencyHeatKernel p.2 p.1)
    (MeasureTheory.volume.prod (MeasureTheory.volume.restrict (Set.Ioi 0)))
OQ7Prescribed.newton_frequency_heat_scalar_integrable : ∀ (ξ : OQ7Prescribed.Position),
  ξ ≠ 0 →
    MeasureTheory.IntegrableOn (fun t => Real.exp (-(4 * Real.pi ^ 2 * t * ‖ξ‖ ^ 2))) (Set.Ioi 0) MeasureTheory.volume
OQ7Prescribed.newton_frequency_heat_scalar_integral : ∀ (ξ : OQ7Prescribed.Position),
  ξ ≠ 0 → ∫ (t : ℝ) in Set.Ioi 0, Real.exp (-(4 * Real.pi ^ 2 * t * ‖ξ‖ ^ 2)) = (4 * Real.pi ^ 2 * ‖ξ‖ ^ 2)⁻¹
OQ7Prescribed.newton_frequency_heat_time_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ)
  (ξ : OQ7Prescribed.Position),
  ξ ≠ 0 →
    MeasureTheory.IntegrableOn (fun t => φ ξ * OQ7Prescribed.newtonFrequencyHeatKernel t ξ) (Set.Ioi 0)
      MeasureTheory.volume
OQ7Prescribed.newton_frequency_heat_time_integral : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ)
  (ξ : OQ7Prescribed.Position),
  ξ ≠ 0 →
    ∫ (t : ℝ) in Set.Ioi 0, φ ξ * OQ7Prescribed.newtonFrequencyHeatKernel t ξ =
      φ ξ * OQ7Prescribed.newtonFrequencyKernel ξ
OQ7Prescribed.newton_frequency_heat_time_norm : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ)
  (ξ : OQ7Prescribed.Position),
  ξ ≠ 0 →
    ∫ (t : ℝ) in Set.Ioi 0, ‖φ ξ * OQ7Prescribed.newtonFrequencyHeatKernel t ξ‖ =
      ‖φ ξ * OQ7Prescribed.newtonFrequencyKernel ξ‖
OQ7Prescribed.newton_heat_fourier_pairing : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ) (t : ℝ),
  0 < t →
    ∫ (x : OQ7Prescribed.Position), (FourierTransform.fourier φ) x * ↑(OQ7Prescribed.newtonHeatKernel t x) =
      ∫ (ξ : OQ7Prescribed.Position), φ ξ * OQ7Prescribed.newtonFrequencyHeatKernel t ξ
OQ7Prescribed.newton_heat_pairing_joint_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun p => φ p.1 * ↑(OQ7Prescribed.newtonHeatKernel p.2 p.1))
    (MeasureTheory.volume.prod (MeasureTheory.volume.restrict (Set.Ioi 0)))
OQ7Prescribed.newton_heat_pairing_time_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ)
  (x : OQ7Prescribed.Position),
  x ≠ 0 →
    MeasureTheory.IntegrableOn (fun t => φ x * ↑(OQ7Prescribed.newtonHeatKernel t x)) (Set.Ioi 0) MeasureTheory.volume
OQ7Prescribed.newton_heat_pairing_time_integral : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ)
  (x : OQ7Prescribed.Position),
  x ≠ 0 → ∫ (t : ℝ) in Set.Ioi 0, φ x * ↑(OQ7Prescribed.newtonHeatKernel t x) = φ x * OQ7Prescribed.outgoingGreen 0 x
OQ7Prescribed.newton_heat_pairing_time_norm : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∫ (t : ℝ) in Set.Ioi 0, ‖φ x * ↑(OQ7Prescribed.newtonHeatKernel t x)‖ = ‖φ x * OQ7Prescribed.outgoingGreen 0 x‖
OQ7Prescribed.newton_heat_pairing_time_space_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun p => φ p.2 * ↑(OQ7Prescribed.newtonHeatKernel p.1 p.2))
    ((MeasureTheory.volume.restrict (Set.Ioi 0)).prod MeasureTheory.volume)
OQ7Prescribed.newton_heat_representation : ∀ (x : OQ7Prescribed.Position),
  x ≠ 0 → ∫ (t : ℝ) in Set.Ioi 0, OQ7Prescribed.newtonHeatKernel t x = OQ7Prescribed.newtonReal x
OQ7Prescribed.newton_heat_scalar_integrable : ∀ (a : ℝ),
  0 < a → MeasureTheory.IntegrableOn (fun t => t ^ (-(3 / 2)) * Real.exp (-a / t)) (Set.Ioi 0) MeasureTheory.volume
OQ7Prescribed.newton_heat_scalar_integral : ∀ (a : ℝ),
  0 < a → ∫ (t : ℝ) in Set.Ioi 0, t ^ (-(3 / 2)) * Real.exp (-a / t) = (1 / a) ^ (1 / 2) * √Real.pi
OQ7Prescribed.newton_heat_schwartz_pairing : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  ∫ (x : OQ7Prescribed.Position), φ x * OQ7Prescribed.outgoingGreen 0 x =
    ∫ (t : ℝ) in Set.Ioi 0, ∫ (x : OQ7Prescribed.Position), φ x * ↑(OQ7Prescribed.newtonHeatKernel t x)
OQ7Prescribed.newton_hessian_contact_apply : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  (OQ7Prescribed.greenHessian 0 i j) φ = ↑(OQ7Prescribed.newtonPVValue φ i j - (if i = j then 1 else 0) / 3 * φ 0)
OQ7Prescribed.newton_hessian_contact_distribution : ∀ (i j : Fin 3),
  OQ7Prescribed.greenHessian 0 i j =
    OQ7Prescribed.newtonPVDistribution i j - ((if i = j then 1 else 0) / 3) • OQ7Prescribed.newtonDirac
OQ7Prescribed.newton_hessian_trace_distribution : ∑ i, OQ7Prescribed.greenHessian 0 i i = -OQ7Prescribed.newtonDirac
OQ7Prescribed.newton_inner_contact_normal : ∀ (r : ℝ),
  0 < r →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3) (n : ↑OQ7Prescribed.UnitSphere),
      -(r ^ 2 * OQ7Prescribed.newtonGradient j (r • ↑n) * φ (r • ↑n) * -(↑n).ofLp i) =
        -(4 * Real.pi)⁻¹ * ((↑n).ofLp i * (↑n).ofLp j * φ (r • ↑n))
OQ7Prescribed.newton_inner_derivative_normal : ∀ (r : ℝ),
  0 < r →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3) (n : ↑OQ7Prescribed.UnitSphere),
      r ^ 2 * OQ7Prescribed.newtonReal (r • ↑n) * ((OQ7Prescribed.testPartial i) φ) (r • ↑n) * -(↑n).ofLp j =
        -r / (4 * Real.pi) * ((↑n).ofLp j * ((OQ7Prescribed.testPartial i) φ) (r • ↑n))
OQ7Prescribed.newton_kernel_split : ∀ (x : OQ7Prescribed.Position),
  OQ7Prescribed.cutoffGreen 0 1 x + OQ7Prescribed.newtonExterior x = OQ7Prescribed.outgoingGreen 0 x
OQ7Prescribed.newton_laplacian_test_integral : ∀ (φ : OQ7Prescribed.ScalarTest),
  ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.newtonReal x * (OQ7Prescribed.testLaplacian φ) x = -φ 0
OQ7Prescribed.newton_outer_boundary_vanishes : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  ∃ R,
    0 < R ∧
      ∀ (T : ℝ),
        R ≤ T → OQ7Prescribed.newtonContactBoundary φ i j T = 0 ∧ OQ7Prescribed.newtonDerivativeBoundary φ i j T = 0
OQ7Prescribed.newton_punctured_double_ibp : ∀ (r : ℝ),
  0 < r →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
      ∫ (x : OQ7Prescribed.Position) in {x | r < ‖x‖},
          OQ7Prescribed.newtonReal x * ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x =
        OQ7Prescribed.newtonPVTruncated φ i j r + OQ7Prescribed.newtonContactBoundary φ i j r +
          OQ7Prescribed.newtonDerivativeBoundary φ i j r
OQ7Prescribed.newton_schwartz_exterior_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun x => φ x * OQ7Prescribed.newtonExterior x) MeasureTheory.volume
OQ7Prescribed.newton_schwartz_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun x => φ x * OQ7Prescribed.outgoingGreen 0 x) MeasureTheory.volume
OQ7Prescribed.newton_schwartz_local_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun x => φ x * OQ7Prescribed.cutoffGreen 0 1 x) MeasureTheory.volume
OQ7Prescribed.newton_test_puncture_removal : ∀ (φ : OQ7Prescribed.ScalarTest),
  Filter.Tendsto (fun r => ∫ (x : OQ7Prescribed.Position) in {x | r < ‖x‖}, OQ7Prescribed.newtonReal x * φ x) (nhds 0)
    (nhds (∫ (x : OQ7Prescribed.Position), OQ7Prescribed.newtonReal x * φ x))
OQ7Prescribed.newtonAnnulus_integrable : ∀ (i j : Fin 3) (r T : ℝ),
