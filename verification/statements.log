@OQ7Prescribed.slabPlateLeftAmplitude_loss_angle_continuous : ∀ {X : Type u_1} [inst : TopologicalSpace X] (k : ℝ),
  0 < k →
    ∀ (A : OQ7.HomogeneousLayer),
      1 ≤ A.p →
        0 ≤ A.q →
          0 ≤ A.width →
            ∀ (p d : ℝ),
              1 ≤ p →
                0 ≤ d →
                  ∀ (q : X → OQ7Prescribed.NonnegativeSlabLoss) (θ : X → ℝ),
                    Continuous q →
                      Continuous θ →
                        ∀ (σ : OQ7Prescribed.Direction),
                          Continuous fun x =>
                            OQ7Prescribed.slabPlateLeftAmplitude k A (OQ7Prescribed.dielectricSlab p (↑(q x)) d) (θ x) σ
OQ7Prescribed.slabPlusAmplitudes_feedback : ∀ (k : ℝ) (A W : OQ7.HomogeneousLayer) (θ : ℝ),
  OQ7Prescribed.slabFeedback k A W θ ≠ 0 →
    OQ7Prescribed.slabPlusPlateAmplitude k A W θ =
      OQ7Prescribed.apertureOscillation k A.width +
        ↑(Real.cos θ) * OQ7Prescribed.dielectricSlabReflection k A.p A.q A.width *
          OQ7Prescribed.slabPlusAbsorberAmplitude k A W θ
OQ7Prescribed.slabPolar_integrable : ∀ (f : ℂ → ℂ),
  Measurable f →
    MeasureTheory.Integrable f MeasureTheory.volume →
      MeasureTheory.IntegrableOn (fun p => p.1 • f (↑Complex.polarCoord.symm p)) polarCoord.target MeasureTheory.volume
OQ7Prescribed.slabPolar_symm : ∀ (r θ : ℝ), ↑Complex.polarCoord.symm (r, θ) = circleMap 0 r θ
OQ7Prescribed.slabPosition_horizontal_height : ∀ (y : OQ7Prescribed.Position),
  OQ7Prescribed.slabPosition (OQ7Prescribed.slabHorizontalCoordinate y) (y.ofLp 2) = y
OQ7Prescribed.slabPosition_I : OQ7Prescribed.slabPosition Complex.I 0 = OQ7Prescribed.basisR 1
OQ7Prescribed.slabPosition_norm : ∀ (w : ℂ) (z : ℝ), ‖OQ7Prescribed.slabPosition w z‖ = √(‖w‖ ^ 2 + z ^ 2)
OQ7Prescribed.slabPosition_norm_ge : ∀ (w : ℂ) (z : ℝ), ‖w‖ ≤ ‖OQ7Prescribed.slabPosition w z‖
OQ7Prescribed.slabPosition_norm_le_sum : ∀ (x : ℂ) (z : ℝ), ‖OQ7Prescribed.slabPosition x z‖ ≤ ‖x‖ + |z|
OQ7Prescribed.slabPosition_norm_sq : ∀ (w : ℂ) (z : ℝ), ‖OQ7Prescribed.slabPosition w z‖ ^ 2 = ‖w‖ ^ 2 + z ^ 2
OQ7Prescribed.slabPosition_one : OQ7Prescribed.slabPosition 1 0 = OQ7Prescribed.basisR 0
OQ7Prescribed.slabPosition_sub : ∀ (w y : ℂ) (z t : ℝ),
  OQ7Prescribed.slabPosition w z - OQ7Prescribed.slabPosition y t = OQ7Prescribed.slabPosition (w - y) (z - t)
OQ7Prescribed.slabProduct_uniform_error_integral_sq : ∀ (f : ℂ × ℝ → ℂ),
  MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume →
    ∀ (D X L R : ℝ),
      0 ≤ D →
        0 ≤ X →
          0 ≤ L →
            0 < R →
              (∀ᵐ (y : ℂ × ℝ), y ∈ OQ7Prescribed.slabProductRegion (X * R) L → ‖f y‖ ≤ D / R) →
                ∫ (y : ℂ × ℝ) in OQ7Prescribed.slabProductRegion (X * R) L, ‖f y‖ ^ 2 ≤ D ^ 2 * X ^ 2 * Real.pi * L
OQ7Prescribed.slabProductFunction_hasCompactSupport : ∀ (w : ℂ → ℂ) (q : ℝ → ℂ),
  HasCompactSupport w → HasCompactSupport q → HasCompactSupport (OQ7Prescribed.slabProductFunction w q)
OQ7Prescribed.slabProductRegion_measurable : ∀ (r L : ℝ), MeasurableSet (OQ7Prescribed.slabProductRegion r L)
OQ7Prescribed.slabProductRegion_measure_lt_top : ∀ (r L : ℝ),
  MeasureTheory.volume (OQ7Prescribed.slabProductRegion r L) < ⊤
OQ7Prescribed.slabProductRegion_volume_real : ∀ (r L : ℝ),
  0 ≤ r → 0 ≤ L → (MeasureTheory.volume (OQ7Prescribed.slabProductRegion r L)).toReal = r ^ 2 * Real.pi * L
OQ7Prescribed.slabPropagation_ne_zero : ∀ (k : ℝ) (n : ℂ) (d : ℝ), OQ7Prescribed.slabPropagation k n d ≠ 0
OQ7Prescribed.slabPropagation_norm : ∀ (k : ℝ) (n : ℂ) (d : ℝ),
  ‖OQ7Prescribed.slabPropagation k n d‖ = Real.exp (-(k * n.im) * d)
OQ7Prescribed.slabPropagation_tendsto_zero : ∀ (k : ℝ),
  0 < k → ∀ (n : ℂ), 0 < n.im → Filter.Tendsto (OQ7Prescribed.slabPropagation k n) Filter.atTop (nhds 0)
OQ7Prescribed.slabRadial_change_variables : ∀ (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ∀ (x : ℂ) (k s U : ℝ),
      0 < U →
        ∫ (r : ℝ) in 0..U,
            OQ7Prescribed.slabHeightRadiusDeriv s r •
              (OQ7Prescribed.apertureOscillation k (OQ7Prescribed.slabHeightRadius s r) *
                OQ7Prescribed.apertureCircleJet 0 w x r) =
          ∫ (t : ℝ) in |s|..OQ7Prescribed.slabHeightRadius s U,
            OQ7Prescribed.apertureOscillation k t * OQ7Prescribed.apertureRadialLift w x s t
OQ7Prescribed.slabRadialWindow_error : ∀ (k : ℝ),
  0 < k →
    ∀ (s : ℝ) (w : ℂ → ℂ),
      ContDiff ℝ (↑⊤) w →
        HasCompactSupport w →
          ∀ (x : ℂ) (U A C₂ C₄ : ℝ),
            0 < U →
              tsupport w ⊆ Metric.closedBall 0 A →
                A + ‖x‖ < U →
                  (∀ (y : ℂ), ‖iteratedFDeriv ℝ 2 w y‖ ≤ C₂) →
                    (∀ (y : ℂ), ‖iteratedFDeriv ℝ 4 w y‖ ≤ C₄) →
                      ‖OQ7Prescribed.slabRadialWindow k s w x U - OQ7Prescribed.planarScalarGreen k s * w x‖ ≤
                        (|s| * C₂ +
                            (C₂ + OQ7Prescribed.slabHeightRadius s U ^ 2 * C₄ / 3) *
                              (OQ7Prescribed.slabHeightRadius s U - |s|)) /
                          (2 * k ^ 2)
OQ7Prescribed.slabRadialWindow_identity : ∀ (k s : ℝ) (w : ℂ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ∀ (x : ℂ) (U : ℝ),
      0 < U →
        OQ7Prescribed.slabRadialWindow k s w x U =
          (1 / 2) •
            ∫ (t : ℝ) in |s|..OQ7Prescribed.slabHeightRadius s U,
              OQ7Prescribed.apertureOscillation k t * OQ7Prescribed.apertureRadialLift w x s t
OQ7Prescribed.slabScalarLift_coe : ∀ (w : ℂ → ℂ) (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume)
  (q : ↥OQ7Prescribed.HeightL2),
  ↑↑((OQ7Prescribed.slabScalarLift w hw) q) =ᵐ[MeasureTheory.volume] OQ7Prescribed.slabSeparatedFunction w ↑↑q
OQ7Prescribed.slabScalarLift_norm : ∀ (w : ℂ → ℂ) (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume)
  (q : ↥OQ7Prescribed.HeightL2), ‖(OQ7Prescribed.slabScalarLift w hw) q‖ = ‖MeasureTheory.MemLp.toLp w hw‖ * ‖q‖
OQ7Prescribed.slabScalarLiftRaw_coe : ∀ (w : ℂ → ℂ) (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume)
  (q : ↥OQ7Prescribed.HeightL2),
  ↑↑(OQ7Prescribed.slabScalarLiftRaw w hw q) =ᵐ[MeasureTheory.volume] OQ7Prescribed.slabSeparatedFunction w ↑↑q
OQ7Prescribed.slabScalarLiftRaw_norm : ∀ (w : ℂ → ℂ) (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume)
  (q : ↥OQ7Prescribed.HeightL2), ‖OQ7Prescribed.slabScalarLiftRaw w hw q‖ = ‖MeasureTheory.MemLp.toLp w hw‖ * ‖q‖
OQ7Prescribed.slabScaled_error_algebra : ∀ (k R L B C₂ C₄ T s : ℝ),
  0 < k →
    1 ≤ R →
      0 ≤ L →
        0 ≤ B →
          0 ≤ C₂ →
            0 ≤ C₄ →
              |s| ≤ L →
                |s| < T →
                  T ≤ B * R →
                    (|s| * (C₂ / R ^ 2) + (C₂ / R ^ 2 + T ^ 2 * (C₄ / R ^ 4) / 3) * (T - |s|)) / (2 * k ^ 2) ≤
                      (L * C₂ + B * (C₂ + B ^ 2 * C₄ / 3)) / (2 * k ^ 2 * R)
OQ7Prescribed.slabScaled_radius_bound : ∀ (s R c L : ℝ),
  1 ≤ R → 0 ≤ c → 0 ≤ L → |s| ≤ L → OQ7Prescribed.slabHeightRadius s (c * R) ≤ (c + L) * R
OQ7Prescribed.slabSeparatedFunction_at_slab : ∀ (w : ℂ → ℂ) (q : ℝ → ℂ) (y : ℂ) (t : ℝ),
  OQ7Prescribed.slabSeparatedFunction w q (OQ7Prescribed.slabPosition y t) = w y * q t
OQ7Prescribed.slabSeparatedFunction_contDiff : ∀ (w : ℂ → ℂ) (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) w → ContDiff ℝ (↑⊤) q → ContDiff ℝ (↑⊤) (OQ7Prescribed.slabSeparatedFunction w q)
OQ7Prescribed.slabSeparatedFunction_hasCompactSupport : ∀ (w : ℂ → ℂ) (q : ℝ → ℂ),
  HasCompactSupport w → HasCompactSupport q → HasCompactSupport (OQ7Prescribed.slabSeparatedFunction w q)
OQ7Prescribed.slabSeparatedFunction_horizontal_partial : ∀ (w : ℂ → ℂ) (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ContDiff ℝ (↑⊤) q →
      ∀ (x : OQ7Prescribed.Position) (v : ℂ),
        (fderiv ℝ (OQ7Prescribed.slabSeparatedFunction w q) x) (OQ7Prescribed.slabPosition v 0) =
          OQ7Prescribed.slabSeparatedFunction (OQ7Prescribed.apertureWindowPartial w v) q x
OQ7Prescribed.slabSeparatedFunction_L2_norm : ∀ (w : ℂ → ℂ) (q : ℝ → ℂ)
  (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume) (hq : MeasureTheory.MemLp q 2 MeasureTheory.volume),
  ‖MeasureTheory.MemLp.toLp (OQ7Prescribed.slabSeparatedFunction w q) ⋯‖ =
    ‖MeasureTheory.MemLp.toLp w hw‖ * ‖MeasureTheory.MemLp.toLp q hq‖
OQ7Prescribed.slabSeparatedFunction_memLp_two : ∀ (w : ℂ → ℂ) (q : ℝ → ℂ),
  MeasureTheory.MemLp w 2 MeasureTheory.volume →
    MeasureTheory.MemLp q 2 MeasureTheory.volume →
      MeasureTheory.MemLp (OQ7Prescribed.slabSeparatedFunction w q) 2 MeasureTheory.volume
OQ7Prescribed.slabSupportedAxisLift_coe : ∀ (w : ℂ → ℂ) (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume) (A L : ℝ)
  (hA : tsupport w ⊆ Metric.closedBall 0 A) (u : ℂ) (q : ↥(OQ7Prescribed.HeightSupportedL2 L)),
  ↑↑↑((OQ7Prescribed.slabSupportedAxisLift w hw A L hA u) q) =ᵐ[MeasureTheory.volume] fun x =>
    OQ7Prescribed.slabSeparatedFunction w (↑↑↑q) x • OQ7Prescribed.complexify (OQ7Prescribed.slabPosition u 0)
OQ7Prescribed.slabWindow_circle : ∀ (w : ℂ → ℂ) (x : ℂ) (r : ℝ),
  ∫ (θ : ℝ) in Set.Ioo (-Real.pi) Real.pi, w (x - circleMap 0 r θ) =
    (2 * Real.pi) • OQ7Prescribed.apertureCircleJet 0 w x r
OQ7Prescribed.smooth_cutoff_bilinear_flux_integrable : ∀ (k : ℝ) (E H G : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) E →
    ContDiff ℝ (↑⊤) H →
      Continuous G →
        (OQ7Prescribed.curl E = fun x => (Complex.I * ↑k) • G x) →
          ∀ (ψ : OQ7Prescribed.Position → ℝ),
            ContDiff ℝ (↑⊤) ψ →
              HasCompactSupport ψ →
                MeasureTheory.Integrable
                  (fun x =>
                    OQ7Prescribed.bilinear (E x)
                      (OQ7Prescribed.cross (H x) (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x))))
                  MeasureTheory.volume
OQ7Prescribed.smooth_cutoff_flux_integrable : ∀ (k : ℝ) (E H : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) E →
    ContDiff ℝ (↑⊤) H →
      (OQ7Prescribed.curl E = fun x => (Complex.I * ↑k) • H x) →
        ∀ (ψ : OQ7Prescribed.Position → ℝ),
          ContDiff ℝ (↑⊤) ψ →
            HasCompactSupport ψ →
              MeasureTheory.Integrable
                (fun x =>
                  (OQ7Prescribed.pairing (E x)
                      (OQ7Prescribed.cross (H x) (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)))).re)
                MeasureTheory.volume
OQ7Prescribed.smooth_pair_cutoff_curl : ∀ (k : ℝ) (E₁ H₁ p₁ E₂ H₂ : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) H₁ →
    ContDiff ℝ (↑⊤) E₂ →
      Continuous E₁ →
        Continuous H₂ →
          Continuous p₁ →
            (OQ7Prescribed.curl E₂ = fun x => (Complex.I * ↑k) • H₂ x) →
              (OQ7Prescribed.curl H₁ = fun x => (-Complex.I * ↑k) • (E₁ x + p₁ x)) →
                ∀ (ψ : OQ7Prescribed.Position → ℝ),
                  ContDiff ℝ (↑⊤) ψ →
                    HasCompactSupport ψ →
                      (∫ (x : OQ7Prescribed.Position),
                            OQ7Prescribed.bilinear (E₂ x)
                              (OQ7Prescribed.cross (H₁ x)
                                (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)))) +
                          Complex.I * ↑k *
                            ∫ (x : OQ7Prescribed.Position), ↑(ψ x) * OQ7Prescribed.bilinear (H₁ x) (H₂ x) =
                        -Complex.I * ↑k *
                          ∫ (x : OQ7Prescribed.Position), ↑(ψ x) * OQ7Prescribed.bilinear (E₁ x + p₁ x) (E₂ x)
OQ7Prescribed.smooth_source_cutoff_energy : ∀ (k : ℝ) (E H p : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) E →
    ContDiff ℝ (↑⊤) H →
      Continuous p →
        (OQ7Prescribed.curl E = fun x => (Complex.I * ↑k) • H x) →
          (OQ7Prescribed.curl H = fun x => (-Complex.I * ↑k) • (E x + p x)) →
            ∀ (ψ : OQ7Prescribed.Position → ℝ),
              ContDiff ℝ (↑⊤) ψ →
                HasCompactSupport ψ →
                  k * (∫ (x : OQ7Prescribed.Position), ↑(ψ x) * OQ7Prescribed.pairing (p x) (E x)).im =
                    -∫ (x : OQ7Prescribed.Position),
                        (OQ7Prescribed.pairing (E x)
                            (OQ7Prescribed.cross (H x)
                              (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)))).re
OQ7Prescribed.smooth_sources_cutoff_Lorentz : ∀ (k : ℝ) (E₁ H₁ p₁ E₂ H₂ p₂ : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) E₁ →
    ContDiff ℝ (↑⊤) H₁ →
      Continuous p₁ →
        ContDiff ℝ (↑⊤) E₂ →
          ContDiff ℝ (↑⊤) H₂ →
            Continuous p₂ →
              (OQ7Prescribed.curl E₁ = fun x => (Complex.I * ↑k) • H₁ x) →
                (OQ7Prescribed.curl H₁ = fun x => (-Complex.I * ↑k) • (E₁ x + p₁ x)) →
                  (OQ7Prescribed.curl E₂ = fun x => (Complex.I * ↑k) • H₂ x) →
                    (OQ7Prescribed.curl H₂ = fun x => (-Complex.I * ↑k) • (E₂ x + p₂ x)) →
                      ∀ (ψ : OQ7Prescribed.Position → ℝ),
                        ContDiff ℝ (↑⊤) ψ →
                          HasCompactSupport ψ →
                            ∫ (x : OQ7Prescribed.Position),
                                OQ7Prescribed.bilinear (E₂ x)
                                    (OQ7Prescribed.cross (H₁ x)
                                      (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x))) -
                                  OQ7Prescribed.bilinear (E₁ x)
                                    (OQ7Prescribed.cross (H₂ x)
                                      (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x))) =
                              -Complex.I * ↑k *
                                ∫ (x : OQ7Prescribed.Position),
                                  ↑(ψ x) * (OQ7Prescribed.bilinear (p₁ x) (E₂ x) - OQ7Prescribed.bilinear (p₂ x) (E₁ x))
OQ7Prescribed.smoothDyadicComponent_contDiff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current → ∀ (i : Fin 3), ContDiff ℝ (↑⊤) (OQ7Prescribed.smoothDyadicComponent k p i)
OQ7Prescribed.smoothDyadicComponent_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (i : Fin 3),
      Distribution.ofFun ⊤ (OQ7Prescribed.smoothDyadicComponent k p i) MeasureTheory.volume ⊤ =
        OQ7Prescribed.outgoingVolumeDistribution k p i
OQ7Prescribed.smoothDyadicComponent_eq_divergence_partial : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (i : Fin 3) (x : OQ7Prescribed.Position),
      OQ7Prescribed.smoothDyadicComponent k p i x =
        k ^ 2 • (OQ7Prescribed.outgoingPotential k p x).ofLp i +
          (fderiv ℝ (OQ7Prescribed.smoothPotentialDivergence k p) x) (OQ7Prescribed.basisR i)
OQ7Prescribed.smoothDyadicField_axis_source_projection : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (f : OQ7Prescribed.Position → ℂ),
  ContDiff ℝ (↑⊤) f →
    HasCompactSupport f →
      ∀ (a b : OQ7Prescribed.Position),
        (p.current = fun x => f x • OQ7Prescribed.complexify a) →
          ∀ (x : OQ7Prescribed.Position),
            OQ7Prescribed.axisCoupling b (OQ7Prescribed.smoothDyadicField k p x) =
              (k ^ 2 * inner ℝ b a) • OQ7Prescribed.scalarOutgoingPotential k f x +
                (fderiv ℝ (fun y => (fderiv ℝ (OQ7Prescribed.scalarOutgoingPotential k f) y) a) x) b
OQ7Prescribed.smoothDyadicField_axisCoupling : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (b x : OQ7Prescribed.Position),
      OQ7Prescribed.axisCoupling b (OQ7Prescribed.smoothDyadicField k p x) =
        k ^ 2 • OQ7Prescribed.axisCoupling b (OQ7Prescribed.outgoingPotential k p x) +
          (fderiv ℝ (OQ7Prescribed.smoothPotentialDivergence k p) x) b
OQ7Prescribed.smoothDyadicField_contDiff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current → ContDiff ℝ (↑⊤) (OQ7Prescribed.smoothDyadicField k p)
OQ7Prescribed.smoothDyadicField_eq_electricVolumeField : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.smoothDyadicField k p =ᵐ[MeasureTheory.volume] OQ7Prescribed.electricVolumeField k p
OQ7Prescribed.smoothDyadicField_slab_source_projection : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (w : ℂ → ℂ)
  (q : ℝ → ℂ),
  ContDiff ℝ (↑⊤) w →
    ContDiff ℝ (↑⊤) q →
      HasCompactSupport w →
        HasCompactSupport q →
          ∀ (u v x : ℂ) (z : ℝ),
            (p.current = fun y =>
                OQ7Prescribed.slabSeparatedFunction w q y • OQ7Prescribed.complexify (OQ7Prescribed.slabPosition u 0)) →
              OQ7Prescribed.axisCoupling (OQ7Prescribed.slabPosition v 0)
                  (OQ7Prescribed.smoothDyadicField k p (OQ7Prescribed.slabPosition x z)) =
                OQ7Prescribed.scalarOutgoingSlabTransverse k w q x z u v
OQ7Prescribed.smoothElectricSource_contDiff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current → ContDiff ℝ (↑⊤) (OQ7Prescribed.smoothElectricSource k p)
OQ7Prescribed.smoothElectricSource_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.curl (OQ7Prescribed.smoothElectricSource k p) = fun x =>
      (Complex.I * ↑k) • OQ7Prescribed.smoothMagneticSource k p x
OQ7Prescribed.smoothElectricSource_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.smoothElectricSource k p) =
      OQ7Prescribed.outgoingVolumeDistribution k p
OQ7Prescribed.smoothElectricSource_eq_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.smoothElectricSource k p =ᵐ[MeasureTheory.volume] OQ7Prescribed.electricVolumeField k p
OQ7Prescribed.smoothField_component_partial : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F →
    ∀ (i j : Fin 3),
      (OQ7Prescribed.distributionPartial j) (OQ7Prescribed.fieldComponentDistribution F i) =
        Distribution.ofFun ⊤ (fun x => ((fderiv ℝ F x) (OQ7Prescribed.basisR j)).ofLp i) MeasureTheory.volume ⊤
OQ7Prescribed.smoothField_curl_contDiff : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F → ContDiff ℝ (↑⊤) (OQ7Prescribed.curl F)
OQ7Prescribed.smoothField_curl_continuous : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F → Continuous (OQ7Prescribed.curl F)
OQ7Prescribed.smoothField_distributionCurl : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F →
    OQ7Prescribed.distributionCurl (OQ7Prescribed.fieldComponentDistribution F) =
      OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.curl F)
OQ7Prescribed.smoothField_hasWeakCurl : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F → OQ7Prescribed.HasWeakCurl F (OQ7Prescribed.curl F)
OQ7Prescribed.smoothField_partial_contDiff : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F → ∀ (j : Fin 3), ContDiff ℝ ↑⊤ fun x => (fderiv ℝ F x) (OQ7Prescribed.basisR j)
OQ7Prescribed.smoothMagneticSource_contDiff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current → ContDiff ℝ (↑⊤) (OQ7Prescribed.smoothMagneticSource k p)
OQ7Prescribed.smoothMagneticSource_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.curl (OQ7Prescribed.smoothMagneticSource k p) = fun x =>
      (-Complex.I * ↑k) • (OQ7Prescribed.smoothElectricSource k p x + p.current x)
OQ7Prescribed.smoothMagneticSource_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.smoothMagneticSource k p) =
      OQ7Prescribed.outgoingMagneticDistribution k p
OQ7Prescribed.smoothMagneticSource_eq_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    OQ7Prescribed.smoothMagneticSource k p =ᵐ[MeasureTheory.volume] OQ7Prescribed.magneticVolumeField k p
OQ7Prescribed.smoothPhysicalSource_cutoff_energy : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (ψ : OQ7Prescribed.Position → ℝ),
      ContDiff ℝ (↑⊤) ψ →
        HasCompactSupport ψ →
          k *
              (∫ (x : OQ7Prescribed.Position),
                  ↑(ψ x) * OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.smoothElectricSource k p x)).im =
            -∫ (x : OQ7Prescribed.Position),
                (OQ7Prescribed.pairing (OQ7Prescribed.smoothElectricSource k p x)
                    (OQ7Prescribed.cross (OQ7Prescribed.smoothMagneticSource k p x)
                      (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)))).re
OQ7Prescribed.smoothPhysicalSource_farField_work : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    k *
        (∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.electricVolumeField k p x)).im =
      ∫ (n : ↑OQ7Prescribed.UnitSphere), ‖OQ7Prescribed.compactCurrentFarField k p ↑n‖ ^ 2 ∂OQ7Prescribed.sphereArea
OQ7Prescribed.smoothPhysicalSource_farField_work_error : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (M : ℝ),
      0 ≤ M →
        (∀ (s : ℝ), OQ7Prescribed.transitionDerivative s ≤ M) →
          ∀ (r : ℝ),
            0 < r →
              2 * p.radius + 2 ≤ r →
                |k *
                        (∫ (x : OQ7Prescribed.Position),
                            OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.smoothElectricSource k p x)).im -
                      ∫ (n : ↑OQ7Prescribed.UnitSphere),
                        ‖OQ7Prescribed.compactCurrentFarField k p ↑n‖ ^ 2 ∂OQ7Prescribed.sphereArea| ≤
                  32 * Real.pi / 3 * OQ7Prescribed.farFieldWorkErrorConstant k p M / r
OQ7Prescribed.smoothPhysicalSource_flux_lower_bound_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ᵐ (x : OQ7Prescribed.Position),
      2 * p.radius + 2 ≤ ‖x‖ →
        -((OQ7Prescribed.magneticDecayConstant k / ‖x‖ * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖) *
              (OQ7Prescribed.radiationKernelConstant k p.radius / ‖x‖ ^ 2 *
                ∫ (y : OQ7Prescribed.Position), ‖p.current y‖)) ≤
          (OQ7Prescribed.pairing (OQ7Prescribed.smoothElectricSource k p x)
              (OQ7Prescribed.cross (OQ7Prescribed.smoothMagneticSource k p x)
                (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re
OQ7Prescribed.smoothPhysicalSource_radial_energy : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (r : ℝ),
      0 < r →
        p.radius ≤ r →
          k *
              (∫ (x : OQ7Prescribed.Position),
                  OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.smoothElectricSource k p x)).im =
            ∫ (x : OQ7Prescribed.Position),
              OQ7Prescribed.sourceEnergyWeight r x *
                (OQ7Prescribed.pairing (OQ7Prescribed.smoothElectricSource k p x)
                    (OQ7Prescribed.cross (OQ7Prescribed.smoothMagneticSource k p x)
                      (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re
OQ7Prescribed.smoothPhysicalSource_radial_flux_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (r : ℝ),
      0 < r →
        MeasureTheory.Integrable
          (fun x =>
            OQ7Prescribed.sourceEnergyWeight r x *
              (OQ7Prescribed.pairing (OQ7Prescribed.smoothElectricSource k p x)
                  (OQ7Prescribed.cross (OQ7Prescribed.smoothMagneticSource k p x)
                    (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re)
          MeasureTheory.volume
OQ7Prescribed.smoothPhysicalSource_weighted_farField_error : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (M : ℝ),
      0 ≤ M →
        (∀ (s : ℝ), OQ7Prescribed.transitionDerivative s ≤ M) →
          ∀ (r : ℝ),
            0 < r →
              2 * p.radius + 2 ≤ r →
                ∀ᵐ (x : OQ7Prescribed.Position),
                  |OQ7Prescribed.sourceEnergyWeight r x *
                          (OQ7Prescribed.pairing (OQ7Prescribed.smoothElectricSource k p x)
                              (OQ7Prescribed.cross (OQ7Prescribed.smoothMagneticSource k p x)
                                (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re -
                        OQ7Prescribed.sourceEnergyWeight r x / ‖x‖ ^ 2 *
                          ‖OQ7Prescribed.compactCurrentFarField k p (OQ7Prescribed.radialDirection x)‖ ^ 2| ≤
                    OQ7Prescribed.farFieldWorkErrorConstant k p M / r ^ 4
OQ7Prescribed.smoothPhysicalSource_work_lower_bound : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ∀ (M : ℝ),
      0 ≤ M →
        (∀ (s : ℝ), OQ7Prescribed.transitionDerivative s ≤ M) →
          ∀ (r : ℝ),
            0 < r →
              2 * p.radius + 2 ≤ r →
                -(32 * Real.pi / 3 * OQ7Prescribed.sourceEnergyErrorConstant k p M / r) ≤
                  k *
                    (∫ (x : OQ7Prescribed.Position),
                        OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.smoothElectricSource k p x)).im
OQ7Prescribed.smoothPhysicalSource_work_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (p : OQ7Prescribed.CompactPolarization),
      ContDiff ℝ (↑⊤) p.current →
        0 ≤
          (∫ (x : OQ7Prescribed.Position),
              OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.smoothElectricSource k p x)).im
OQ7Prescribed.smoothPhysicalSources_Lorentz_boundary_error : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ContDiff ℝ (↑⊤) q.current →
      ∀ (M : ℝ),
        0 ≤ M →
          (∀ (s : ℝ), OQ7Prescribed.transitionDerivative s ≤ M) →
            ∀ (r : ℝ),
              0 < r →
                2 * p.radius + 2 ≤ r →
                  2 * q.radius + 2 ≤ r →
                    ‖-Complex.I * ↑k *
                          ∫ (x : OQ7Prescribed.Position),
                            OQ7Prescribed.bilinear (p.current x) (OQ7Prescribed.smoothElectricSource k q x) -
                              OQ7Prescribed.bilinear (q.current x) (OQ7Prescribed.smoothElectricSource k p x)‖ ≤
                      64 * Real.pi / 3 * (M * OQ7Prescribed.LorentzDecayConstant k p q) / r
OQ7Prescribed.smoothPhysicalSources_radial_flux_bound_ae : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ContDiff ℝ (↑⊤) q.current →
      ∀ (M : ℝ),
        0 ≤ M →
          (∀ (s : ℝ), OQ7Prescribed.transitionDerivative s ≤ M) →
            ∀ (r : ℝ),
              0 < r →
                2 * p.radius + 2 ≤ r →
                  2 * q.radius + 2 ≤ r →
                    ∀ᵐ (x : OQ7Prescribed.Position),
                      ‖OQ7Prescribed.smoothLorentzRadialFlux k p q r x‖ ≤
                        M * OQ7Prescribed.LorentzDecayConstant k p q / r ^ 4
OQ7Prescribed.smoothPhysicalSources_radial_flux_integrable : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ContDiff ℝ (↑⊤) q.current →
      ∀ (r : ℝ), 0 < r → MeasureTheory.Integrable (OQ7Prescribed.smoothLorentzRadialFlux k p q r) MeasureTheory.volume
OQ7Prescribed.smoothPhysicalSources_radial_Lorentz : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current →
    ContDiff ℝ (↑⊤) q.current →
      ∀ (r : ℝ),
        0 < r →
          p.radius ≤ r →
            q.radius ≤ r →
              ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.smoothLorentzRadialFlux k p q r x =
                -Complex.I * ↑k *
                  ∫ (x : OQ7Prescribed.Position),
                    OQ7Prescribed.bilinear (p.current x) (OQ7Prescribed.smoothElectricSource k q x) -
                      OQ7Prescribed.bilinear (q.current x) (OQ7Prescribed.smoothElectricSource k p x)
OQ7Prescribed.smoothPhysicalSources_reciprocity : ∀ (k : ℝ),
  0 < k →
    ∀ (p q : OQ7Prescribed.CompactPolarization),
      ContDiff ℝ (↑⊤) p.current →
        ContDiff ℝ (↑⊤) q.current →
          ∫ (x : OQ7Prescribed.Position),
              OQ7Prescribed.bilinear (p.current x) (OQ7Prescribed.electricVolumeField k q x) =
            ∫ (x : OQ7Prescribed.Position),
              OQ7Prescribed.bilinear (q.current x) (OQ7Prescribed.electricVolumeField k p x)
OQ7Prescribed.smoothPotentialComponent_contDiff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current → ∀ (j : Fin 3), ContDiff ℝ (↑⊤) (OQ7Prescribed.smoothPotentialComponent k p j)
OQ7Prescribed.smoothPotentialDivergence_axis_source : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (f : OQ7Prescribed.Position → ℂ),
  ContDiff ℝ (↑⊤) f →
    HasCompactSupport f →
      ∀ (a : OQ7Prescribed.Position),
        (p.current = fun x => f x • OQ7Prescribed.complexify a) →
          OQ7Prescribed.smoothPotentialDivergence k p = fun x =>
            (fderiv ℝ (OQ7Prescribed.scalarOutgoingPotential k f) x) a
OQ7Prescribed.smoothPotentialDivergence_contDiff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current → ContDiff ℝ (↑⊤) (OQ7Prescribed.smoothPotentialDivergence k p)
OQ7Prescribed.smoothScalar_distributionPartial : ∀ (f : OQ7Prescribed.Position → ℂ),
  ContDiff ℝ (↑⊤) f →
    ∀ (j : Fin 3),
      (OQ7Prescribed.distributionPartial j) (Distribution.ofFun ⊤ f MeasureTheory.volume ⊤) =
        Distribution.ofFun ⊤ (fun x => (fderiv ℝ f x) (OQ7Prescribed.basisR j)) MeasureTheory.volume ⊤
OQ7Prescribed.smoothScalarPartial_contDiff : ∀ (f : OQ7Prescribed.Position → ℂ),
  ContDiff ℝ (↑⊤) f → ∀ (j : Fin 3), ContDiff ℝ (↑⊤) (OQ7Prescribed.smoothScalarPartial f j)
OQ7Prescribed.sourceEnergyCutoff_bilinear_work : ∀ (p : OQ7Prescribed.CompactPolarization) (E : OQ7Prescribed.Field)
  (r : ℝ),
  0 < r →
    p.radius ≤ r →
      (fun x => ↑(OQ7Prescribed.sourceEnergyCutoff r x) * OQ7Prescribed.bilinear (p.current x) (E x)) = fun x =>
        OQ7Prescribed.bilinear (p.current x) (E x)
OQ7Prescribed.sourceEnergyCutoff_contDiff : ∀ (r : ℝ), 0 < r → ContDiff ℝ (↑⊤) (OQ7Prescribed.sourceEnergyCutoff r)
OQ7Prescribed.sourceEnergyCutoff_current_work : ∀ (p : OQ7Prescribed.CompactPolarization) (E : OQ7Prescribed.Field)
  (r : ℝ),
  0 < r →
    p.radius ≤ r →
      (fun x => ↑(OQ7Prescribed.sourceEnergyCutoff r x) * OQ7Prescribed.pairing (p.current x) (E x)) = fun x =>
        OQ7Prescribed.pairing (p.current x) (E x)
OQ7Prescribed.sourceEnergyCutoff_gradient : ∀ (r : ℝ),
  0 < r →
    ∀ (x : OQ7Prescribed.Position),
      OQ7Prescribed.scalarGradient (OQ7Prescribed.sourceEnergyCutoff r) x =
        -OQ7Prescribed.sourceEnergyWeight r x • OQ7Prescribed.radialDirection x
OQ7Prescribed.sourceEnergyCutoff_hasCompactSupport : ∀ (r : ℝ),
  0 < r → HasCompactSupport (OQ7Prescribed.sourceEnergyCutoff r)
OQ7Prescribed.sourceEnergyErrorConstant_nonneg : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (M : ℝ),
  0 ≤ M → 0 ≤ OQ7Prescribed.sourceEnergyErrorConstant k p M
OQ7Prescribed.sourceEnergyWeight_continuous : ∀ (r : ℝ), Continuous (OQ7Prescribed.sourceEnergyWeight r)
OQ7Prescribed.sourceEnergyWeight_direction_continuous : ∀ (r : ℝ),
  0 < r →
    ∀ (A : OQ7Prescribed.Position → ℝ),
      Continuous A →
        Continuous fun x => OQ7Prescribed.sourceEnergyWeight r x / ‖x‖ ^ 2 * A (OQ7Prescribed.radialDirection x)
OQ7Prescribed.sourceEnergyWeight_direction_integrable : ∀ (r : ℝ),
  0 < r →
    ∀ (A : OQ7Prescribed.Position → ℝ),
      Continuous A →
        MeasureTheory.Integrable
          (fun x => OQ7Prescribed.sourceEnergyWeight r x / ‖x‖ ^ 2 * A (OQ7Prescribed.radialDirection x))
          MeasureTheory.volume
OQ7Prescribed.sourceEnergyWeight_direction_integral : ∀ (r : ℝ),
  0 < r →
    ∀ (A : OQ7Prescribed.Position → ℝ),
      ∫ (x : OQ7Prescribed.Position),
          OQ7Prescribed.sourceEnergyWeight r x / ‖x‖ ^ 2 * A (OQ7Prescribed.radialDirection x) =
        ∫ (n : ↑OQ7Prescribed.UnitSphere), A ↑n ∂OQ7Prescribed.sphereArea
OQ7Prescribed.sourceEnergyWeight_hasCompactSupport : ∀ (r : ℝ),
  0 < r → HasCompactSupport (OQ7Prescribed.sourceEnergyWeight r)
OQ7Prescribed.sourceEnergyWeight_le : ∀ (r M : ℝ),
  0 < r →
    (∀ (s : ℝ), OQ7Prescribed.transitionDerivative s ≤ M) →
      ∀ (x : OQ7Prescribed.Position), OQ7Prescribed.sourceEnergyWeight r x ≤ M / r
OQ7Prescribed.sourceEnergyWeight_nonneg : ∀ (r : ℝ),
  0 < r → ∀ (x : OQ7Prescribed.Position), 0 ≤ OQ7Prescribed.sourceEnergyWeight r x
OQ7Prescribed.sourceEnergyWeight_zero_inner : ∀ (r : ℝ),
  0 < r → ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ r → OQ7Prescribed.sourceEnergyWeight r x = 0
OQ7Prescribed.sourceEnergyWeight_zero_outer : ∀ (r : ℝ),
  0 < r → ∀ (x : OQ7Prescribed.Position), 2 * r ≤ ‖x‖ → OQ7Prescribed.sourceEnergyWeight r x = 0
OQ7Prescribed.sphere_coordinate_cross_zero : ∀ (i j : Fin 3),
  i ≠ j → ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i * (↑n).ofLp j ∂OQ7Prescribed.sphereArea = 0
OQ7Prescribed.sphere_coordinate_mul_integrable : ∀ (i j : Fin 3),
  MeasureTheory.Integrable (fun n => (↑n).ofLp i * (↑n).ofLp j) OQ7Prescribed.sphereArea
OQ7Prescribed.sphere_coordinate_sq_equal : ∀ (i j : Fin 3),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i ^ 2 ∂OQ7Prescribed.sphereArea =
    ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp j ^ 2 ∂OQ7Prescribed.sphereArea
OQ7Prescribed.sphere_coordinate_sq_integral : ∀ (i : Fin 3),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i ^ 2 ∂OQ7Prescribed.sphereArea = 4 * Real.pi / 3
OQ7Prescribed.sphere_integral_orthogonal : ∀ (e : OQ7Prescribed.Position ≃ₗᵢ[ℝ] OQ7Prescribed.Position)
  (f : ↑OQ7Prescribed.UnitSphere → ℝ),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), f ((OQ7Prescribed.orthogonalSphere e) n) ∂OQ7Prescribed.sphereArea =
    ∫ (n : ↑OQ7Prescribed.UnitSphere), f n ∂OQ7Prescribed.sphereArea
OQ7Prescribed.sphere_newton_angular_cancellation : ∀ (i j : Fin 3),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), 3 * (↑n).ofLp i * (↑n).ofLp j - if i = j then 1 else 0 ∂OQ7Prescribed.sphereArea =
    0
OQ7Prescribed.sphere_second_moment : ∀ (i j : Fin 3),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i * (↑n).ofLp j ∂OQ7Prescribed.sphereArea =
    if i = j then 4 * Real.pi / 3 else 0
OQ7Prescribed.sphere_test_derivative_continuous : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  Continuous fun r =>
    ∫ (n : ↑OQ7Prescribed.UnitSphere),
      (↑n).ofLp j * ((OQ7Prescribed.testPartial i) φ) (r • ↑n) ∂OQ7Prescribed.sphereArea
OQ7Prescribed.sphere_test_moment_continuous : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  Continuous fun r =>
    ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i * (↑n).ofLp j * φ (r • ↑n) ∂OQ7Prescribed.sphereArea
OQ7Prescribed.sphere_test_moment_zero : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), (↑n).ofLp i * (↑n).ofLp j * φ (0 • ↑n) ∂OQ7Prescribed.sphereArea =
    (if i = j then 4 * Real.pi / 3 else 0) * φ 0
OQ7Prescribed.sphereArea_integral_angular_centered : ∀ (A : OQ7Prescribed.Position → ℝ),
  Continuous A →
    ∫ (n : ↑OQ7Prescribed.UnitSphere), A ↑n ∂OQ7Prescribed.sphereArea =
      ∫ (θ : ℝ) in 0..Real.pi, ∫ (φ : ℝ) in -Real.pi..Real.pi, Real.sin θ * A (OQ7Prescribed.sphereDirection θ φ)
OQ7Prescribed.sphereArea_integral_angular_product : ∀ (A : OQ7Prescribed.Position → ℝ),
  ∫ (n : ↑OQ7Prescribed.UnitSphere), A ↑n ∂OQ7Prescribed.sphereArea =
    ∫ (p : ℝ × ℝ) in Set.Ioo 0 Real.pi ×ˢ Set.Ioo (-Real.pi) Real.pi,
      Real.sin p.1 * A (OQ7Prescribed.sphereDirection p.1 p.2)
OQ7Prescribed.sphereArea_integral_original_angles : ∀ (A : OQ7Prescribed.Position → ℝ),
  Continuous A →
    ∫ (n : ↑OQ7Prescribed.UnitSphere), A ↑n ∂OQ7Prescribed.sphereArea =
      ∫ (θ : ℝ) in 0..Real.pi, ∫ (φ : ℝ) in 0..2 * Real.pi, A (OQ7Prescribed.sphereDirection θ φ) * Real.sin θ
OQ7Prescribed.sphereArea_real_univ : OQ7Prescribed.sphereArea.real Set.univ = 4 * Real.pi
OQ7Prescribed.sphereDirection_continuous : Continuous fun p => OQ7Prescribed.sphereDirection p.1 p.2
OQ7Prescribed.sphereDirection_norm : ∀ (θ φ : ℝ), ‖OQ7Prescribed.sphereDirection θ φ‖ = 1
OQ7Prescribed.sphereDirection_periodic : ∀ (θ : ℝ), Function.Periodic (OQ7Prescribed.sphereDirection θ) (2 * Real.pi)
OQ7Prescribed.sphereDirection_unit : ∀ (θ φ : ℝ), ‖OQ7Prescribed.sphereDirection θ φ‖ ^ 2 = 1
OQ7Prescribed.sphericalDerivative_det : ∀ (p : Fin 3 → ℝ),
  (OQ7Prescribed.sphericalDerivative p).det = p 0 ^ 2 * Real.sin (p 1)
OQ7Prescribed.sphericalDomain_measurableSet : MeasurableSet OQ7Prescribed.sphericalDomain
OQ7Prescribed.sphericalDomain_product_integral : ∀ (f : ℝ × ℝ × ℝ → ℝ),
  ∫ (p : Fin 3 → ℝ) in OQ7Prescribed.sphericalDomain, f (p 0, p 1, p 2) =
    ∫ (p : ℝ × ℝ × ℝ) in Set.Ioi 0 ×ˢ Set.Ioo 0 Real.pi ×ˢ Set.Ioo (-Real.pi) Real.pi, f p
OQ7Prescribed.sphericalPoint_hasFDerivAt : ∀ (p : Fin 3 → ℝ),
  HasFDerivAt OQ7Prescribed.sphericalPoint (OQ7Prescribed.sphericalDerivative p) p
OQ7Prescribed.sphericalPoint_image_ae_eq_univ : OQ7Prescribed.sphericalPoint ''
    OQ7Prescribed.sphericalDomain =ᵐ[MeasureTheory.volume]
