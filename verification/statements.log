    ∀ (p q a b : ℝ) (hp : 1 ≤ p),
      0 ≤ q →
        a ≤ b →
          (OQ7Prescribed.dielectricSlabLeftAt k p q a b hp).electric a =
              1 + OQ7Prescribed.dielectricSlabReflection k p q (b - a) ∧
            (OQ7Prescribed.dielectricSlabLeftAt k p q a b hp).magnetic a =
                1 - OQ7Prescribed.dielectricSlabReflection k p q (b - a) ∧
              (OQ7Prescribed.dielectricSlabLeftAt k p q a b hp).electric b =
                  OQ7Prescribed.dielectricSlabTransmission k p q (b - a) ∧
                (OQ7Prescribed.dielectricSlabLeftAt k p q a b hp).magnetic b =
                  OQ7Prescribed.dielectricSlabTransmission k p q (b - a)
OQ7Prescribed.dielectricSlabLeftAt_constitutive : ∀ (k p q a b : ℝ) (hp : 1 ≤ p) (z : ℝ),
  (OQ7Prescribed.dielectricSlabLeftAt k p q a b hp).current z =
    (↑p + Complex.I * ↑q - 1) * (OQ7Prescribed.dielectricSlabLeftAt k p q a b hp).electric z
OQ7Prescribed.dielectricSlabLeftAt_Green_exterior_left : ∀ (k : ℝ),
  0 < k →
    ∀ (p q a b L : ℝ) (hp : 1 ≤ p),
      0 ≤ q →
        ∀ (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ L),
          ∀ z ≤ a,
            k ^ 2 •
                OQ7Prescribed.scalarPlanarPotential k
                  (↑↑↑(OQ7Prescribed.planarLayerL2Current k a b L ha hab hb
                          (OQ7Prescribed.dielectricSlabLeftAt k p q a b hp)))
                  z =
              OQ7Prescribed.dielectricSlabReflection k p q (b - a) * OQ7Prescribed.apertureOscillation k (a - z)
OQ7Prescribed.dielectricSlabLeftAt_Green_exterior_right : ∀ (k : ℝ),
  0 < k →
    ∀ (p q a b L : ℝ) (hp : 1 ≤ p),
      0 ≤ q →
        ∀ (ha : 0 ≤ a) (hab : a ≤ b) (hb : b ≤ L) (z : ℝ),
          b ≤ z →
            k ^ 2 •
                OQ7Prescribed.scalarPlanarPotential k
                  (↑↑↑(OQ7Prescribed.planarLayerL2Current k a b L ha hab hb
                          (OQ7Prescribed.dielectricSlabLeftAt k p q a b hp)))
                  z =
              (OQ7Prescribed.dielectricSlabTransmission k p q (b - a) - OQ7Prescribed.apertureOscillation k (b - a)) *
