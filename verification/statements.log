OQ7Prescribed.normalizedExtinction_reciprocity : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody) (θ : ℝ)
  (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
