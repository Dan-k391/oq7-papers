    OQ7Prescribed.normalizedExtinction k hk B OQ7Prescribed.Direction.minus θ α β hα hβ
OQ7Prescribed.normalizedExtinction_reciprocity_of_sine_ne_zero : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (θ : ℝ),
  Real.sin θ ≠ 0 →
    ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
      OQ7Prescribed.normalizedExtinction k hk B OQ7Prescribed.Direction.plus θ α β hα hβ =
        OQ7Prescribed.normalizedExtinction k hk B OQ7Prescribed.Direction.minus θ α β hα hβ
OQ7Prescribed.normalizedExtinction_work_balance : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.normalizedExtinction k hk B σ θ α β hα hβ =
    OQ7Prescribed.normalizedAbsorption k hk B σ θ α β hα hβ +
      k *
        (inner ℂ
            ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
              (OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ))
            ((OQ7Prescribed.bodyOutgoingOperator k B)
              ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
                (OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ)))).im
OQ7Prescribed.normalizedIncidentDrive_coe : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction),
  ↑↑↑(OQ7Prescribed.normalizedIncidentDrive k B σ) =ᵐ[MeasureTheory.volume]
    B.domain.indicator fun x => if x.ofLp 2 < B.absorberThickness then 0 else OQ7Prescribed.planePhase k σ x
OQ7Prescribed.normalizedIncidentDrive_eq_sharpLift : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
