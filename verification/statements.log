    OQ7Prescribed.sphereArea
OQ7Prescribed.outgoing_classical_hessian : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (i j : Fin 3),
      lineDeriv ℝ (fun y => lineDeriv ℝ (OQ7Prescribed.outgoingGreen k) y (OQ7Prescribed.basisR j)) x
          (OQ7Prescribed.basisR i) =
        (x.ofLp i * x.ofLp j / ‖x‖ ^ 2) • OQ7Prescribed.outgoingRadialSecond k ‖x‖ +
          ((if i = j then 1 else 0) / ‖x‖ - x.ofLp i * x.ofLp j / ‖x‖ ^ 3) • OQ7Prescribed.outgoingRadialFirst k ‖x‖
OQ7Prescribed.outgoing_current_correlation_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ (q.1 + q.2)) * OQ7Prescribed.outgoingGreen k q.1 * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.outgoing_current_correlation_pairing_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun z => OQ7Prescribed.outgoingGreen k z * OQ7Prescribed.newtonCurrentCorrelation p φ i z)
    MeasureTheory.volume
OQ7Prescribed.outgoing_current_pairing_integrand_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3) (S : ℝ),
  (∀ (x : OQ7Prescribed.Position), φ x ≠ 0 → ‖x‖ ≤ S) →
    ∀ (x y : OQ7Prescribed.Position),
      ↑(φ x) * OQ7Prescribed.outgoingGreen k (x - y) * (p.current y).ofLp i =
        ↑(φ x) * OQ7Prescribed.cutoffGreen k (S + p.radius) (x - y) * (p.current y).ofLp i
OQ7Prescribed.outgoing_current_test_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ q.1) * OQ7Prescribed.outgoingGreen k (q.1 - q.2) * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.outgoing_dyadic_contact_identity : ∀ (k : ℝ) (i j : Fin 3),
  OQ7Prescribed.dyadicGreenDistribution k i j =
    OQ7Prescribed.newtonPVDistribution i j - ((if i = j then 1 else 0) / 3) • OQ7Prescribed.newtonDirac +
      Distribution.ofFun ⊤ (fun x => ((OQ7Prescribed.dyadicRemainder k x) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume ⊤
OQ7Prescribed.outgoing_helmholtz_fundamental_apply : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.testLaplacian φ) +
      k ^ 2 • (OQ7Prescribed.outgoingGreenDistribution k) φ =
    -↑(φ 0)
OQ7Prescribed.outgoing_helmholtz_fundamental_distribution : ∀ (k : ℝ),
  ∑ i, OQ7Prescribed.greenHessian k i i + k ^ 2 • OQ7Prescribed.outgoingGreenDistribution k = -OQ7Prescribed.newtonDirac
OQ7Prescribed.outgoingElectric_uniform_physical_farField_error : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.bodyCurrentPolarization B f) →
    ∀ (x : OQ7Prescribed.Position),
      2 * (OQ7Prescribed.bodyCurrentPolarization B f).radius + 2 ≤ ‖x‖ →
        ‖(↑‖x‖ * Complex.exp (-Complex.I * ↑(k * ‖x‖))) •
                (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f) x -
                  OQ7Prescribed.incidentElectric k σ x) -
              OQ7Prescribed.currentFarField k B
                (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f))
                (OQ7Prescribed.radialDirection x)‖ ≤
          OQ7Prescribed.farFieldKernelConstant k (OQ7Prescribed.bodyCurrentPolarization B f).radius / ‖x‖ *
            ∫ (y : OQ7Prescribed.Position), ‖(OQ7Prescribed.bodyCurrentPolarization B f).current y‖
OQ7Prescribed.outgoingElectricField_eq_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
