OQ7Prescribed.bodyIncidentCurrent_ne_zero : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.bodyIncidentCurrent k B σ ≠ 0
OQ7Prescribed.bodyInverseSusceptibility_coe : ∀ (B : OQ7Prescribed.TwoLayerBody)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.bodyInverseSusceptibility B a b) f) =ᵐ[MeasureTheory.volume] fun x =>
    if x.ofLp 2 < B.absorberThickness then a.inverse.symm (↑↑↑f x) else b.inverse.symm (↑↑↑f x)
OQ7Prescribed.bodyInverseSusceptibility_negative_imaginary_bound : ∀ (B : OQ7Prescribed.TwoLayerBody)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.materialBodyCoercivity B a b * ‖f‖ ^ 2 ≤
    -(inner ℂ f ((OQ7Prescribed.bodyInverseSusceptibility B a b) f)).im
OQ7Prescribed.bodyLayerSeparatedPolarization_current_ae : ∀ (B : OQ7Prescribed.TwoLayerBody) (w : ℂ → ℂ)
  (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume)
  (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture B.aperture) (θ : ℝ)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  (OQ7Prescribed.bodyLayerSeparatedPolarization B w hw hs θ q).current =ᵐ[MeasureTheory.volume] fun x =>
    w (OQ7Prescribed.slabHorizontalCoordinate x) •
      (↑↑↑((OQ7Prescribed.planarLayerAxisMap (B.absorberThickness + B.plateThickness) B.absorberThickness 1
                      (Real.cos θ))
                    q)
            (x.ofLp 2) •
          OQ7Prescribed.basisC 0 +
        ↑↑↑((OQ7Prescribed.planarLayerAxisMap (B.absorberThickness + B.plateThickness) B.absorberThickness 0
                      (Real.sin θ))
                    q)
            (x.ofLp 2) •
          OQ7Prescribed.basisC 1)
OQ7Prescribed.bodyOutgoingOperator_coe : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.bodyOutgoingOperator k B) f) =ᵐ[MeasureTheory.volume]
    B.domain.indicator (OQ7Prescribed.electricVolumeField k (OQ7Prescribed.bodyCurrentPolarization B f))
OQ7Prescribed.bodyOutgoingOperator_farField_work : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  k * (inner ℂ f ((OQ7Prescribed.bodyOutgoingOperator k B) f)).im =
    ∫ (n : ↑OQ7Prescribed.UnitSphere),
      ‖OQ7Prescribed.compactCurrentFarField k (OQ7Prescribed.bodyCurrentPolarization B f) ↑n‖ ^
        2 ∂OQ7Prescribed.sphereArea
OQ7Prescribed.bodyOutgoingOperator_im_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
      0 ≤ (inner ℂ f ((OQ7Prescribed.bodyOutgoingOperator k B) f)).im
OQ7Prescribed.bodyOutgoingOperator_inner : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  inner ℂ f ((OQ7Prescribed.bodyOutgoingOperator k B) f) =
    inner ℂ ((OQ7Prescribed.bodyCurrentInclusion B) f)
      ((OQ7Prescribed.compactOutgoingOperator k (OQ7Prescribed.bodySupportRadius B) ⋯)
        ((OQ7Prescribed.bodyCurrentInclusion B) f))
OQ7Prescribed.bodyPlateInterior_nonempty : ∀ (B : OQ7Prescribed.TwoLayerBody),
  (B.domain ∩ {x | B.absorberThickness < x.ofLp 2}).Nonempty
OQ7Prescribed.bodyPlateInterior_volume_pos : ∀ (B : OQ7Prescribed.TwoLayerBody),
  0 < MeasureTheory.volume (B.domain ∩ {x | B.absorberThickness < x.ofLp 2})
OQ7Prescribed.bodyScaledLayerField_decomposition : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (hR : 1 ≤ B.aperture)
  (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w) (hwc : HasCompactSupport w)
  (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture 1) (θ : ℝ)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  OQ7Prescribed.electricVolumeField k
      (OQ7Prescribed.bodyCurrentPolarization B
        ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
          ((OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs) q))) =ᵐ[MeasureTheory.volume]
    fun x =>
    OQ7Prescribed.electricVolumeField k
        (OQ7Prescribed.bodySlabComponent B hR w hw hwc hs 1
          ((OQ7Prescribed.planarLayerAxisMap (B.absorberThickness + B.plateThickness) B.absorberThickness 1
              (Real.cos θ))
            q))
        x +
      OQ7Prescribed.electricVolumeField k
        (OQ7Prescribed.bodySlabComponent B hR w hw hwc hs Complex.I
          ((OQ7Prescribed.planarLayerAxisMap (B.absorberThickness + B.plateThickness) B.absorberThickness 0
              (Real.sin θ))
            q))
        x
OQ7Prescribed.bodyScaledScalarLift_inverse_material : ∀ (B : OQ7Prescribed.TwoLayerBody) (w : ℂ → ℂ)
  (hw : ContDiff ℝ (↑⊤) w) (hwc : HasCompactSupport w) (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture 1)
  (α β : ℂ) (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  (OQ7Prescribed.activeInverseMaterial B α β) ((OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs) q) =
    (OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs)
      ((OQ7Prescribed.planarInverseMaterial (B.absorberThickness + B.plateThickness) B.absorberThickness α β) q)
OQ7Prescribed.bodyScaledScalarLift_material_residual_identity : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w) (hwc : HasCompactSupport w)
  (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture 1) (θ : ℝ) (α β : ℂ)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  (OQ7Prescribed.activeMaterialOperator k B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β)
        ((OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs) q) -
      (OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs)
        ((OQ7Prescribed.planarActiveMaterialOperator k hk (B.absorberThickness + B.plateThickness) ⋯ B.absorberThickness
            θ α β)
          q) =
    (OQ7Prescribed.activeProjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
        ((OQ7Prescribed.bodyOutgoingOperator k B)
          ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
            ((OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs) q))) -
      (OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs)
        ((OQ7Prescribed.planarActiveOutgoing k hk (B.absorberThickness + B.plateThickness) ⋯ B.absorberThickness θ) q)
OQ7Prescribed.bodyScaledScalarLift_norm : ∀ (B : OQ7Prescribed.TwoLayerBody) (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w)
  (hwc : HasCompactSupport w) (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture 1)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  ‖(OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs) q‖ = B.aperture * ‖MeasureTheory.MemLp.toLp w ⋯‖ * ‖q‖
OQ7Prescribed.bodySeparatedScalarLift_coe : ∀ (B : OQ7Prescribed.TwoLayerBody) (w : ℂ → ℂ)
  (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume)
  (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture B.aperture)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  ↑↑↑((OQ7Prescribed.bodySeparatedScalarLift B w hw hs) q) =ᵐ[MeasureTheory.volume]
    OQ7Prescribed.slabSeparatedFunction w ↑↑↑q
OQ7Prescribed.bodySeparatedScalarLift_norm : ∀ (B : OQ7Prescribed.TwoLayerBody) (w : ℂ → ℂ)
  (hw : MeasureTheory.MemLp w 2 MeasureTheory.volume)
  (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture B.aperture)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  ‖(OQ7Prescribed.bodySeparatedScalarLift B w hw hs) q‖ = ‖MeasureTheory.MemLp.toLp w hw‖ * ‖q‖
OQ7Prescribed.bodySharpScalarLift_coe : ∀ (B : OQ7Prescribed.TwoLayerBody)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  ↑↑↑((OQ7Prescribed.bodySharpScalarLift B) q) =ᵐ[MeasureTheory.volume]
    OQ7Prescribed.slabSeparatedFunction (OQ7Prescribed.squareApertureWindow B.aperture) ↑↑↑q
OQ7Prescribed.bodySharpScalarLift_inner : ∀ (B : OQ7Prescribed.TwoLayerBody)
  (q r : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  inner ℂ ((OQ7Prescribed.bodySharpScalarLift B) q) ((OQ7Prescribed.bodySharpScalarLift B) r) =
    B.aperture ^ 2 • inner ℂ q r
OQ7Prescribed.bodySharpScalarLift_inverse_material : ∀ (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  (OQ7Prescribed.activeInverseMaterial B α β) ((OQ7Prescribed.bodySharpScalarLift B) q) =
    (OQ7Prescribed.bodySharpScalarLift B)
      ((OQ7Prescribed.planarInverseMaterial (B.absorberThickness + B.plateThickness) B.absorberThickness α β) q)
OQ7Prescribed.bodySharpScalarLift_norm : ∀ (B : OQ7Prescribed.TwoLayerBody)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  ‖(OQ7Prescribed.bodySharpScalarLift B) q‖ = B.aperture * ‖q‖
OQ7Prescribed.bodySharpScalarLift_window_difference_norm : ∀ (B : OQ7Prescribed.TwoLayerBody) (w : ℂ → ℂ)
  (hw : ContDiff ℝ (↑⊤) w) (hwc : HasCompactSupport w) (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture 1)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  ‖(OQ7Prescribed.bodySharpScalarLift B) q - (OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs) q‖ =
    B.aperture * ‖MeasureTheory.MemLp.toLp (OQ7Prescribed.squareApertureWindow 1 - w) ⋯‖ * ‖q‖
OQ7Prescribed.bodySlabError_coe : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody) (hR : 1 ≤ B.aperture)
  (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w) (hwc : HasCompactSupport w)
  (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture 1) (u v : ℂ)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  ↑↑(OQ7Prescribed.bodySlabError k hk B hR w hw hwc hs u v q) =ᵐ[MeasureTheory.volume]
    (OQ7Prescribed.slabObservationRegion B.aperture (B.absorberThickness + B.plateThickness + 2)).indicator fun x =>
      OQ7Prescribed.axisCoupling (OQ7Prescribed.slabPosition v 0)
          (OQ7Prescribed.electricVolumeField k (OQ7Prescribed.bodySlabComponent B hR w hw hwc hs u q) x) -
        (k ^ 2 * inner ℝ u v) •
          (OQ7Prescribed.scaledApertureWindow w B.aperture (OQ7Prescribed.slabHorizontalCoordinate x) *
            OQ7Prescribed.scalarPlanarPotential k (↑↑↑q) (x.ofLp 2))
OQ7Prescribed.bodySlabError_uniform_bound : ∀ (k : ℝ) (hk : 0 < k) (h d : ℝ),
  0 ≤ h + d →
    ∀ (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w) (hwc : HasCompactSupport w)
      (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture 1),
      ∃ K,
        0 < K ∧
          ∀ (B : OQ7Prescribed.TwoLayerBody),
            B.absorberThickness = h →
              B.plateThickness = d →
                ∀ (hR : 1 ≤ B.aperture) (u v : ℂ),
                  ‖u‖ ≤ 1 →
                    ‖v‖ ≤ 1 →
                      ∀ (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
                        ‖OQ7Prescribed.bodySlabError k hk B hR w hw hwc hs u v q‖ ≤ K * ‖q‖
OQ7Prescribed.bodySupportRadius_nonneg : ∀ (B : OQ7Prescribed.TwoLayerBody), 0 ≤ OQ7Prescribed.bodySupportRadius B
OQ7Prescribed.bodySusceptibility_reciprocal : ∀ (B : OQ7Prescribed.TwoLayerBody),
  Matrix.transpose B.absorberPermittivity = B.absorberPermittivity →
    Matrix.transpose B.platePermittivity = B.platePermittivity →
      ∀ (x : OQ7Prescribed.Position), Matrix.transpose (B.susceptibility x) = B.susceptibility x
OQ7Prescribed.bodyVolumeTotalElectricCurrent_eq : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.bodyFieldCurrent B (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f))
      ⋯ =
    OQ7Prescribed.bodyIncidentCurrent k B σ + (OQ7Prescribed.bodyOutgoingOperator k B) f
OQ7Prescribed.classicalDyadic_coordinate : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (i j : Fin 3),
      ((OQ7Prescribed.classicalDyadic k x) (OQ7Prescribed.basisC j)).ofLp i =
        (if i = j then ↑(k ^ 2) * OQ7Prescribed.outgoingGreen k x else 0) +
          lineDeriv ℝ (fun y => lineDeriv ℝ (OQ7Prescribed.outgoingGreen k) y (OQ7Prescribed.basisR j)) x
            (OQ7Prescribed.basisR i)
OQ7Prescribed.classicalDyadic_leading_error : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  1 ≤ ‖x‖ →
    ∀ (v : OQ7Prescribed.Vector),
      ‖(OQ7Prescribed.classicalDyadic k x) v -
            (↑(k ^ 2) * OQ7Prescribed.outgoingRadial k ‖x‖) •
              OQ7Prescribed.transverseProjection (OQ7Prescribed.radialDirection x) v‖ ≤
        OQ7Prescribed.farFieldLowerConstant k / ‖x‖ ^ 2 * ‖v‖
OQ7Prescribed.classicalDyadic_measurable : ∀ (k : ℝ), Measurable (OQ7Prescribed.classicalDyadic k)
OQ7Prescribed.classicalDyadic_norm_le_far : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  1 ≤ ‖x‖ →
    ∀ (v : OQ7Prescribed.Vector), ‖(OQ7Prescribed.classicalDyadic k x) v‖ ≤ OQ7Prescribed.exteriorKernelBound k * ‖v‖
OQ7Prescribed.classicalDyadic_test_integrable_of_zero : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  φ 0 = 0 →
    ∀ (i j : Fin 3),
      MeasureTheory.Integrable (fun x => ↑(φ x) * ((OQ7Prescribed.classicalDyadic k x) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume
OQ7Prescribed.classicalDyadic_zero_coordinate : ∀ (x : OQ7Prescribed.Position) (i j : Fin 3),
  ((OQ7Prescribed.classicalDyadic 0 x) (OQ7Prescribed.basisC j)).ofLp i = ↑(OQ7Prescribed.newtonHessianKernel i j x)
OQ7Prescribed.compact_scalar_weight_integrable : ∀ (ψ : OQ7Prescribed.Position → ℝ),
  Continuous ψ →
    HasCompactSupport ψ →
      ∀ (f : OQ7Prescribed.Position → ℂ),
        Continuous f → MeasureTheory.Integrable (fun x => ↑(ψ x) * f x) MeasureTheory.volume
OQ7Prescribed.compactCurrent_incident_bilinear_integrable : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction)
  (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.Integrable (fun x => OQ7Prescribed.bilinear (p.current x) (OQ7Prescribed.incidentElectric k σ x))
    MeasureTheory.volume
OQ7Prescribed.compactCurrent_outgoingOperator_coe : ∀ (k R : ℝ) (hR : 0 ≤ R) (p : OQ7Prescribed.CompactPolarization)
  (hpR : p.radius ≤ R),
  ↑↑↑((OQ7Prescribed.compactOutgoingOperator k R hR) (p.toSupportedLp R hpR)) =ᵐ[MeasureTheory.volume]
    (Metric.closedBall 0 R).indicator (OQ7Prescribed.electricVolumeField k p)
OQ7Prescribed.compactCurrent_outgoingOperator_im_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (p : OQ7Prescribed.CompactPolarization),
      0 ≤
        (inner ℂ (p.toSupportedLp (p.radius + 2) ⋯)
            ((OQ7Prescribed.compactOutgoingOperator k (p.radius + 2) ⋯) (p.toSupportedLp (p.radius + 2) ⋯))).im
OQ7Prescribed.compactCurrent_outgoingOperator_im_nonneg_of_smooth : ∀ (k : ℝ),
  0 < k →
    ∀ (R : ℝ) (hR : 0 ≤ R) (p : OQ7Prescribed.CompactPolarization) (hpR : p.radius ≤ R),
      ContDiff ℝ (↑⊤) p.current →
        0 ≤
          (inner ℂ (p.toSupportedLp R hpR) ((OQ7Prescribed.compactOutgoingOperator k R hR) (p.toSupportedLp R hpR))).im
OQ7Prescribed.compactCurrent_outgoingOperator_inner : ∀ (k R : ℝ) (hR : 0 ≤ R) (p : OQ7Prescribed.CompactPolarization)
  (hpR : p.radius ≤ R),
  inner ℂ (p.toSupportedLp R hpR) ((OQ7Prescribed.compactOutgoingOperator k R hR) (p.toSupportedLp R hpR)) =
    ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.electricVolumeField k p x)
OQ7Prescribed.compactCurrent_phase_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (n : OQ7Prescribed.Position),
  MeasureTheory.Integrable (fun y => OQ7Prescribed.currentPlanePhase k n y • p.current y) MeasureTheory.volume
OQ7Prescribed.compactCurrentFarField_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.compactCurrentFarField k (p.add q) =
    OQ7Prescribed.compactCurrentFarField k p + OQ7Prescribed.compactCurrentFarField k q
OQ7Prescribed.compactCurrentFarField_congr_current : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  p.current =ᵐ[MeasureTheory.volume] q.current →
    OQ7Prescribed.compactCurrentFarField k p = OQ7Prescribed.compactCurrentFarField k q
OQ7Prescribed.compactCurrentFarField_continuous : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  Continuous (OQ7Prescribed.compactCurrentFarField k p)
OQ7Prescribed.compactCurrentFarField_integral : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (n : OQ7Prescribed.Position),
  OQ7Prescribed.compactCurrentFarField k p n =
    ∫ (y : OQ7Prescribed.Position),
      (↑(k ^ 2 / (4 * Real.pi)) * OQ7Prescribed.currentPlanePhase k n y) •
        OQ7Prescribed.transverseProjection n (p.current y)
OQ7Prescribed.compactCurrentFarField_norm_le : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (n : OQ7Prescribed.Position),
  ‖n‖ = 1 →
    ‖OQ7Prescribed.compactCurrentFarField k p n‖ ≤ k ^ 2 / (4 * Real.pi) * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖
OQ7Prescribed.compactCurrentFarField_scale : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (z : ℂ),
  OQ7Prescribed.compactCurrentFarField k (OQ7Prescribed.CompactPolarization.scale z p) =
    z • OQ7Prescribed.compactCurrentFarField k p
OQ7Prescribed.compactCurrents_bilinear_volume_integrable : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  MeasureTheory.Integrable (fun x => OQ7Prescribed.bilinear (p.current x) (OQ7Prescribed.electricVolumeField k q x))
    MeasureTheory.volume
OQ7Prescribed.compactCurrents_outgoingOperator_bilinear : ∀ (k R : ℝ) (hR : 0 ≤ R)
  (p q : OQ7Prescribed.CompactPolarization) (hpR : p.radius ≤ R) (hqR : q.radius ≤ R),
  inner ℂ ((OQ7Prescribed.supportedVectorConjugate R) (p.toSupportedLp R hpR))
      ((OQ7Prescribed.compactOutgoingOperator k R hR) (q.toSupportedLp R hqR)) =
    ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.bilinear (p.current x) (OQ7Prescribed.electricVolumeField k q x)
OQ7Prescribed.compactField_bilinear_integrable : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (ψ : OQ7Prescribed.Field),
      Continuous ψ →
        HasCompactSupport ψ →
          MeasureTheory.Integrable (fun x => OQ7Prescribed.bilinear (F x) (ψ x)) MeasureTheory.volume
OQ7Prescribed.compactField_curl_hasCompactSupport : ∀ (φ : OQ7Prescribed.Field),
  HasCompactSupport φ → HasCompactSupport (OQ7Prescribed.curl φ)
OQ7Prescribed.compactOutgoingOperator_apply_norm_le : ∀ (k R : ℝ) (hR : 0 ≤ R)
  (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ‖(OQ7Prescribed.compactOutgoingOperator k R hR) f‖ ≤ (1 + OQ7Prescribed.compactRemainderConstant k R) * ‖f‖
OQ7Prescribed.compactOutgoingOperator_coe : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ↑↑↑((OQ7Prescribed.compactOutgoingOperator k R hR) f) =ᵐ[MeasureTheory.volume]
    (Metric.closedBall 0 R).indicator fun x =>
      ↑↑(OQ7Prescribed.staticFourierOperator ↑f) x +
        OQ7Prescribed.remainderPotential k (OQ7Prescribed.supportedPolarization R hR f) x
OQ7Prescribed.compactOutgoingOperator_im_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
      0 ≤ (inner ℂ f ((OQ7Prescribed.compactOutgoingOperator k R hR) f)).im
OQ7Prescribed.compactOutgoingOperator_norm_le : ∀ (k R : ℝ) (hR : 0 ≤ R),
  ‖OQ7Prescribed.compactOutgoingOperator k R hR‖ ≤ 1 + OQ7Prescribed.compactRemainderConstant k R
OQ7Prescribed.compactOutgoingOperator_physical_distribution : ∀ (k R : ℝ) (hR : 0 ≤ R)
  (f : ↥(OQ7Prescribed.SupportedVectorL2 R)) (i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  Function.support ⇑φ ⊆ Metric.closedBall 0 R →
    (OQ7Prescribed.vectorL2ComponentDistribution (↑((OQ7Prescribed.compactOutgoingOperator k R hR) f)) i) φ =
      (OQ7Prescribed.outgoingVolumeDistribution k (OQ7Prescribed.supportedPolarization R hR f) i) φ
OQ7Prescribed.compactOutgoingOperator_test_pairing : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R))
  (φ : OQ7Prescribed.ScalarTest),
  Function.support ⇑φ ⊆ Metric.closedBall 0 R →
    ∫ (x : OQ7Prescribed.Position), φ x • ↑↑↑((OQ7Prescribed.compactOutgoingOperator k R hR) f) x =
      (∫ (x : OQ7Prescribed.Position), φ x • ↑↑(OQ7Prescribed.staticFourierOperator ↑f) x) +
        ∫ (x : OQ7Prescribed.Position),
          φ x • OQ7Prescribed.remainderPotential k (OQ7Prescribed.supportedPolarization R hR f) x
OQ7Prescribed.compactPolarization_current_hasCompactSupport : ∀ (p : OQ7Prescribed.CompactPolarization),
  HasCompactSupport p.current
OQ7Prescribed.compactPolarization_current_integrable : ∀ (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.Integrable p.current MeasureTheory.volume
OQ7Prescribed.compactPolarization_smooth_approximation : ∀ (p : OQ7Prescribed.CompactPolarization) (ε : ℝ),
  0 < ε →
    ∃ q,
      q.radius = p.radius + 2 ∧
        ContDiff ℝ (↑⊤) q.current ∧ ‖MeasureTheory.MemLp.toLp p.current ⋯ - MeasureTheory.MemLp.toLp q.current ⋯‖ ≤ ε
OQ7Prescribed.compactPolarization_smooth_function_approximation : ∀ (p : OQ7Prescribed.CompactPolarization) (ε : ℝ),
  0 < ε →
    ∃ f,
      ContDiff ℝ (↑⊤) f ∧
        HasCompactSupport f ∧
          (∀ (x : OQ7Prescribed.Position), p.radius + 2 < ‖x‖ → f x = 0) ∧
            MeasureTheory.eLpNorm (p.current - f) 2 MeasureTheory.volume ≤ ENNReal.ofReal ε
OQ7Prescribed.compactRemainderConstant_nonneg : ∀ (k R : ℝ), 0 ≤ OQ7Prescribed.compactRemainderConstant k R
OQ7Prescribed.compactRemainderField_memLp : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  MeasureTheory.MemLp (OQ7Prescribed.compactRemainderField k R hR f) 2 MeasureTheory.volume
OQ7Prescribed.compactRemainderLp_add : ∀ (k R : ℝ) (hR : 0 ≤ R) (f g : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  OQ7Prescribed.compactRemainderLp k R hR (f + g) =
    OQ7Prescribed.compactRemainderLp k R hR f + OQ7Prescribed.compactRemainderLp k R hR g
OQ7Prescribed.compactRemainderLp_coe : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ↑↑(OQ7Prescribed.compactRemainderLp k R hR f) =ᵐ[MeasureTheory.volume] OQ7Prescribed.compactRemainderField k R hR f
OQ7Prescribed.compactRemainderLp_norm_le : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ‖OQ7Prescribed.compactRemainderLp k R hR f‖ ≤ OQ7Prescribed.compactRemainderConstant k R * ‖f‖
OQ7Prescribed.compactRemainderLp_smul : ∀ (k R : ℝ) (hR : 0 ≤ R) (z : ℂ) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  OQ7Prescribed.compactRemainderLp k R hR (z • f) = z • OQ7Prescribed.compactRemainderLp k R hR f
OQ7Prescribed.compactRemainderLp_supported : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  OQ7Prescribed.compactRemainderLp k R hR f ∈ OQ7Prescribed.supportedVectorL2 R
OQ7Prescribed.compactRemainderOperator_norm_le : ∀ (k R : ℝ) (hR : 0 ≤ R),
  ‖OQ7Prescribed.compactRemainderOperator k R hR‖ ≤ OQ7Prescribed.compactRemainderConstant k R
OQ7Prescribed.compactRestrictionCLM_norm_le : ∀ (R : ℝ), ‖OQ7Prescribed.compactRestrictionCLM R‖ ≤ 1
OQ7Prescribed.compactRestrictionLp_add : ∀ (R : ℝ) (f g : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.compactRestrictionLp R (f + g) =
    OQ7Prescribed.compactRestrictionLp R f + OQ7Prescribed.compactRestrictionLp R g
OQ7Prescribed.compactRestrictionLp_coe : ∀ (R : ℝ) (f : ↥OQ7Prescribed.VectorL2),
  ↑↑(OQ7Prescribed.compactRestrictionLp R f) =ᵐ[MeasureTheory.volume] (Metric.closedBall 0 R).indicator fun x => ↑↑f x
OQ7Prescribed.compactRestrictionLp_eq_self_iff_supported : ∀ (R : ℝ) (f : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.compactRestrictionLp R f = f ↔ f ∈ OQ7Prescribed.supportedVectorL2 R
OQ7Prescribed.compactRestrictionLp_norm_le : ∀ (R : ℝ) (f : ↥OQ7Prescribed.VectorL2),
  ‖OQ7Prescribed.compactRestrictionLp R f‖ ≤ ‖f‖
OQ7Prescribed.compactRestrictionLp_smul : ∀ (R : ℝ) (z : ℂ) (f : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.compactRestrictionLp R (z • f) = z • OQ7Prescribed.compactRestrictionLp R f
OQ7Prescribed.compactRestrictionLp_supported : ∀ (R : ℝ) (f : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.compactRestrictionLp R f ∈ OQ7Prescribed.supportedVectorL2 R
OQ7Prescribed.compactStaticOperator_apply_norm_le : ∀ (R : ℝ) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ‖(OQ7Prescribed.compactStaticOperator R) f‖ ≤ ‖f‖
OQ7Prescribed.compactTest_component_integrable : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i : Fin 3) (ψ : OQ7Prescribed.Position → ℂ),
      Continuous ψ → HasCompactSupport ψ → MeasureTheory.Integrable (fun x => ψ x * (F x).ofLp i) MeasureTheory.volume
@OQ7Prescribed.complex_imaginary_coercive_bijective : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] (A : H →L[ℂ] H) (c : ℝ),
  0 < c → (∀ (u : H), c * ‖u‖ ^ 2 ≤ (inner ℂ u (A u)).im) → Function.Bijective ⇑A
@OQ7Prescribed.complex_imaginary_coercive_norm_bound : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] (A : H →L[ℂ] H) (c : ℝ),
  0 < c → (∀ (u : H), c * ‖u‖ ^ 2 ≤ (inner ℂ u (A u)).im) → ∀ (u : H), c * ‖u‖ ≤ ‖A u‖
OQ7Prescribed.complex_re_im_coefficient : ∀ (α : ℂ), ↑α.re + Complex.I * ↑α.im = α
OQ7Prescribed.complexify_continuous : Continuous OQ7Prescribed.complexify
OQ7Prescribed.complexify_norm : ∀ (x : OQ7Prescribed.Position), ‖OQ7Prescribed.complexify x‖ = ‖x‖
OQ7Prescribed.complexify_norm_sq : ∀ (u : OQ7Prescribed.Position), ‖OQ7Prescribed.complexify u‖ ^ 2 = ‖u‖ ^ 2
OQ7Prescribed.complexify_sub : ∀ (x y : OQ7Prescribed.Position),
  OQ7Prescribed.complexify (x - y) = OQ7Prescribed.complexify x - OQ7Prescribed.complexify y
@OQ7Prescribed.complexImaginaryCoerciveEquiv_apply : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [inst_2 : CompleteSpace H] (A : H →L[ℂ] H) (c : ℝ) (hc : 0 < c)
  (hA : ∀ (u : H), c * ‖u‖ ^ 2 ≤ (inner ℂ u (A u)).im) (u : H),
  (OQ7Prescribed.complexImaginaryCoerciveEquiv A c hc hA) u = A u
@OQ7Prescribed.complexImaginaryCoerciveEquiv_inverse_imaginary_bound : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [inst_2 : CompleteSpace H] (A : H →L[ℂ] H) (c : ℝ) (hc : 0 < c)
  (hA : ∀ (u : H), c * ‖u‖ ^ 2 ≤ (inner ℂ u (A u)).im) (u : H),
  c / (‖A‖ + 1) ^ 2 * ‖u‖ ^ 2 ≤ -(inner ℂ u ((OQ7Prescribed.complexImaginaryCoerciveEquiv A c hc hA).symm u)).im
@OQ7Prescribed.complexImaginaryCoerciveEquiv_inverse_norm_le : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [inst_2 : CompleteSpace H] (A : H →L[ℂ] H) (c : ℝ) (hc : 0 < c)
  (hA : ∀ (u : H), c * ‖u‖ ^ 2 ≤ (inner ℂ u (A u)).im),
  ‖↑(OQ7Prescribed.complexImaginaryCoerciveEquiv A c hc hA).symm‖ ≤ 1 / c
OQ7Prescribed.complexRealTest_partial : ∀ (ψ : OQ7Prescribed.Position → ℂ) (hψ : ContDiff ℝ (↑⊤) ψ)
  (hs : HasCompactSupport ψ) (L : ℂ →L[ℝ] ℝ) (j : Fin 3) (x : OQ7Prescribed.Position),
  ((OQ7Prescribed.testPartial j) (OQ7Prescribed.complexRealTest ψ hψ hs L)) x =
    L ((fderiv ℝ ψ x) (OQ7Prescribed.basisR j))
OQ7Prescribed.complexTestEval_field : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i : Fin 3) (ψ : OQ7Prescribed.Position → ℂ) (hψ : ContDiff ℝ (↑⊤) ψ) (hs : HasCompactSupport ψ),
      OQ7Prescribed.complexTestEval (OQ7Prescribed.fieldComponentDistribution F i) ψ hψ hs =
        ∫ (x : OQ7Prescribed.Position), ψ x * (F x).ofLp i
OQ7Prescribed.complexTestEval_partial_field : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i j : Fin 3) (ψ : OQ7Prescribed.Position → ℂ) (hψ : ContDiff ℝ (↑⊤) ψ) (hs : HasCompactSupport ψ),
      OQ7Prescribed.complexTestEval
          ((OQ7Prescribed.distributionPartial j) (OQ7Prescribed.fieldComponentDistribution F i)) ψ hψ hs =
        -∫ (x : OQ7Prescribed.Position), (fderiv ℝ ψ x) (OQ7Prescribed.basisR j) * (F x).ofLp i
OQ7Prescribed.complexTestEval_sub : ∀ (S T : OQ7Prescribed.ScalarDistribution) (ψ : OQ7Prescribed.Position → ℂ)
  (hψ : ContDiff ℝ (↑⊤) ψ) (hs : HasCompactSupport ψ),
  OQ7Prescribed.complexTestEval (S - T) ψ hψ hs =
    OQ7Prescribed.complexTestEval S ψ hψ hs - OQ7Prescribed.complexTestEval T ψ hψ hs
OQ7Prescribed.contDiff_lineDeriv_continuous : ∀ (F : OQ7Prescribed.Position → ℝ),
  ContDiff ℝ 1 F → ∀ (i : Fin 3), Continuous fun x => lineDeriv ℝ F x (OQ7Prescribed.basisR i)
OQ7Prescribed.contDiff_test_ibp : ∀ (F : OQ7Prescribed.Position → ℝ),
  ContDiff ℝ 1 F →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
      ∫ (x : OQ7Prescribed.Position), F x * ((OQ7Prescribed.testPartial i) φ) x =
        -∫ (x : OQ7Prescribed.Position), lineDeriv ℝ F x (OQ7Prescribed.basisR i) * φ x
@OQ7Prescribed.continuousLinearEquiv_response_continuousAt : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] {X : Type u_2} [inst_3 : TopologicalSpace X] (e : X → H ≃L[ℂ] H)
  (s : X → H) (x : X) (M : ℝ),
  (∀ (a : X), ‖↑(e a).symm‖ ≤ M) →
    ContinuousAt (fun a => ↑(e a)) x → ContinuousAt s x → ContinuousAt (fun a => (e a).symm (s a)) x
@OQ7Prescribed.continuousLinearEquiv_response_difference_bound : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] (e f : H ≃L[ℂ] H) (s t : H),
  ‖e.symm s - f.symm t‖ ≤ ‖↑e.symm‖ * (‖s - t‖ + ‖↑e - ↑f‖ * ‖f.symm t‖)
@OQ7Prescribed.continuousLinearEquiv_solution_residual_bound : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] (e : H ≃L[ℂ] H) (s v : H), ‖e.symm s - v‖ ≤ ‖↑e.symm‖ * ‖s - e v‖
@OQ7Prescribed.continuousLinearMap_inner_of_norm_mul : ∀ {E : Type u_1} {F : Type u_2} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℂ E] [inst_2 : NormedAddCommGroup F] [inst_3 : InnerProductSpace ℂ F] (J : E →L[ℂ] F)
  (R : ℝ), (∀ (q : E), ‖J q‖ = R * ‖q‖) → ∀ (q r : E), inner ℂ (J q) (J r) = R ^ 2 • inner ℂ q r
OQ7Prescribed.continuousOn_Ioc_indicator_memLp : ∀ (a b : ℝ) (q : ℝ → ℂ),
  ContinuousOn q (Set.Icc a b) → MeasureTheory.MemLp ((Set.Ioc a b).indicator q) 2 MeasureTheory.volume
OQ7Prescribed.coordinateReflect_apply : ∀ (i j : Fin 3) (x : OQ7Prescribed.Position),
  ((OQ7Prescribed.coordinateReflect i) x).ofLp j = if j = i then -x.ofLp j else x.ofLp j
OQ7Prescribed.coordinateSwap_apply : ∀ (i j a : Fin 3) (x : OQ7Prescribed.Position),
  ((OQ7Prescribed.coordinateSwap i j) x).ofLp a = x.ofLp ((Equiv.swap i j) a)
OQ7Prescribed.cos_mul_abs : ∀ (k s : ℝ), Real.cos (k * |s|) = Real.cos (k * s)
OQ7Prescribed.cross_add_left : ∀ (u v w : OQ7Prescribed.Vector),
  OQ7Prescribed.cross (u + v) w = OQ7Prescribed.cross u w + OQ7Prescribed.cross v w
OQ7Prescribed.cross_complexify_real_smul : ∀ (H : OQ7Prescribed.Vector) (n : OQ7Prescribed.Position) (r : ℝ),
  OQ7Prescribed.cross H (OQ7Prescribed.complexify (r • n)) = r • OQ7Prescribed.cross H (OQ7Prescribed.complexify n)
OQ7Prescribed.cross_cross : ∀ (a b c : OQ7Prescribed.Vector),
  OQ7Prescribed.cross (OQ7Prescribed.cross a b) c = OQ7Prescribed.bilinear a c • b - OQ7Prescribed.bilinear b c • a
OQ7Prescribed.cross_norm_le : ∀ (u v : OQ7Prescribed.Vector), ‖OQ7Prescribed.cross u v‖ ≤ ‖u‖ * ‖v‖
OQ7Prescribed.cross_smul_left : ∀ (a : ℂ) (u v : OQ7Prescribed.Vector),
  OQ7Prescribed.cross (a • u) v = a • OQ7Prescribed.cross u v
OQ7Prescribed.cross_squareNorm_identity : ∀ (u v : OQ7Prescribed.Vector),
  OQ7Prescribed.squareNorm (OQ7Prescribed.cross u v) + Complex.normSq (OQ7Prescribed.pairing u v) =
    OQ7Prescribed.squareNorm u * OQ7Prescribed.squareNorm v
OQ7Prescribed.cross_sub_left : ∀ (u v w : OQ7Prescribed.Vector),
  OQ7Prescribed.cross (u - v) w = OQ7Prescribed.cross u w - OQ7Prescribed.cross v w
OQ7Prescribed.cross_sub_right : ∀ (u v w : OQ7Prescribed.Vector),
  OQ7Prescribed.cross u (v - w) = OQ7Prescribed.cross u v - OQ7Prescribed.cross u w
OQ7Prescribed.crossRightMap_apply : ∀ (n v : OQ7Prescribed.Vector),
  (OQ7Prescribed.crossRightMap n) v = OQ7Prescribed.cross v n
OQ7Prescribed.curl_real_smul : ∀ (ψ : OQ7Prescribed.Position → ℝ) (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) ψ →
    ContDiff ℝ (↑⊤) F →
      ∀ (x : OQ7Prescribed.Position),
        OQ7Prescribed.curl (fun y => ψ y • F y) x =
          OQ7Prescribed.cross (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)) (F x) +
            ψ x • OQ7Prescribed.curl F x
OQ7Prescribed.curl_vectorConjugate : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F →
    (OQ7Prescribed.curl fun x => OQ7Prescribed.vectorConjugate (F x)) = fun x =>
      OQ7Prescribed.vectorConjugate (OQ7Prescribed.curl F x)
OQ7Prescribed.current_component_fourier : ∀ (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (ξ : OQ7Prescribed.Position),
  FourierTransform.fourier (fun y => (p.current y).ofLp j) ξ = (FourierTransform.fourier p.current ξ).ofLp j
OQ7Prescribed.current_component_integrable : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  MeasureTheory.Integrable (fun y => (p.current y).ofLp i) MeasureTheory.volume
OQ7Prescribed.currentCorrelation_green_distribution_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3),
  (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.currentCorrelationRealTest Complex.reCLM p φ j) +
      Complex.I *
        (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.currentCorrelationRealTest Complex.imCLM p φ j) =
    (OQ7Prescribed.potentialComponentDistribution k p j) φ
OQ7Prescribed.currentCorrelation_green_first_ibp : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  ∫ (z : OQ7Prescribed.Position),
      OQ7Prescribed.newtonCurrentCorrelation p ((OQ7Prescribed.testPartial j) φ) i z * OQ7Prescribed.outgoingGreen k z =
    -∫ (z : OQ7Prescribed.Position),
        OQ7Prescribed.newtonCurrentCorrelation p φ i z * OQ7Prescribed.outgoingGradient k j z
OQ7Prescribed.currentCorrelation_greenHessian_distribution_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  (OQ7Prescribed.greenHessian k i j) (OQ7Prescribed.currentCorrelationRealTest Complex.reCLM p φ j) +
      Complex.I * (OQ7Prescribed.greenHessian k i j) (OQ7Prescribed.currentCorrelationRealTest Complex.imCLM p φ j) =
    (OQ7Prescribed.potentialComponentDistribution k p j)
      ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ))
OQ7Prescribed.currentCorrelation_kernel_integrable : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3) {f : OQ7Prescribed.Position → ℂ},
  MeasureTheory.LocallyIntegrable f MeasureTheory.volume →
    MeasureTheory.Integrable (fun z => OQ7Prescribed.newtonCurrentCorrelation p φ j z * f z) MeasureTheory.volume
OQ7Prescribed.currentCorrelation_pairing_re_im : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3) {f : OQ7Prescribed.Position → ℂ},
  MeasureTheory.LocallyIntegrable f MeasureTheory.volume →
    ∫ (z : OQ7Prescribed.Position), OQ7Prescribed.newtonCurrentCorrelation p φ j z * f z =
      (∫ (z : OQ7Prescribed.Position), (OQ7Prescribed.currentCorrelationRealTest Complex.reCLM p φ j) z • f z) +
        Complex.I *
          ∫ (z : OQ7Prescribed.Position), (OQ7Prescribed.currentCorrelationRealTest Complex.imCLM p φ j) z • f z
OQ7Prescribed.currentCorrelation_zero_eq_current_test_integral : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  OQ7Prescribed.newtonCurrentCorrelation p φ i 0 = ∫ (x : OQ7Prescribed.Position), φ x • (p.current x).ofLp i
OQ7Prescribed.currentCorrelation_zero_of_exterior_test : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius → φ x = 0) →
    ∀ (i : Fin 3), OQ7Prescribed.newtonCurrentCorrelation p φ i 0 = 0
OQ7Prescribed.currentCorrelationRealTest_apply : ∀ (L : ℂ →L[ℝ] ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3) (z : OQ7Prescribed.Position),
  (OQ7Prescribed.currentCorrelationRealTest L p φ j) z = L (OQ7Prescribed.newtonCurrentCorrelation p φ j z)
OQ7Prescribed.currentCorrelationRealTest_partial : ∀ (L : ℂ →L[ℝ] ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j i : Fin 3),
  (OQ7Prescribed.testPartial i) (OQ7Prescribed.currentCorrelationRealTest L p φ j) =
    OQ7Prescribed.currentCorrelationRealTest L p ((OQ7Prescribed.testPartial i) φ) j
OQ7Prescribed.currentDyadicTestPairing_eq : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  OQ7Prescribed.currentDyadicTestPairing k p φ i j =
    (if i = j then k ^ 2 • (OQ7Prescribed.potentialComponentDistribution k p j) φ else 0) +
      (OQ7Prescribed.potentialComponentDistribution k p j)
        ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ))
OQ7Prescribed.currentDyadicTestPairing_exterior_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius → φ x = 0) →
    ∀ (i j : Fin 3),
      MeasureTheory.Integrable
        (fun z =>
          OQ7Prescribed.newtonCurrentCorrelation p φ j z *
            ((OQ7Prescribed.classicalDyadic k z) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume
OQ7Prescribed.currentDyadicTestPairing_exterior_integral : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius → φ x = 0) →
    ∀ (i j : Fin 3),
      OQ7Prescribed.currentDyadicTestPairing k p φ i j =
        ∫ (z : OQ7Prescribed.Position),
          OQ7Prescribed.newtonCurrentCorrelation p φ j z *
            ((OQ7Prescribed.classicalDyadic k z) (OQ7Prescribed.basisC j)).ofLp i
OQ7Prescribed.currentPlanePhase_norm : ∀ (k : ℝ) (n y : OQ7Prescribed.Position),
  ‖OQ7Prescribed.currentPlanePhase k n y‖ = 1
OQ7Prescribed.currentTestCorrelationVector_coordinate : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (z : OQ7Prescribed.Position) (i : Fin 3),
  (OQ7Prescribed.currentTestCorrelationVector p φ z).ofLp i = OQ7Prescribed.newtonCurrentCorrelation p φ i z
OQ7Prescribed.currentTestCorrelationVector_integrable : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (z : OQ7Prescribed.Position),
  MeasureTheory.Integrable (fun y => ↑(φ (z + y)) • p.current y) MeasureTheory.volume
OQ7Prescribed.cutoff_curl_pairing_real : ∀ (ψ : OQ7Prescribed.Position → ℝ) (E H : OQ7Prescribed.Field) (k : ℝ),
  ContDiff ℝ (↑⊤) ψ →
    ContDiff ℝ (↑⊤) E →
      (OQ7Prescribed.curl E = fun x => (Complex.I * ↑k) • H x) →
        ∀ (x : OQ7Prescribed.Position),
          (OQ7Prescribed.bilinear (H x)
                (OQ7Prescribed.curl (fun y => ψ y • OQ7Prescribed.vectorConjugate (E y)) x)).re =
            (OQ7Prescribed.pairing (E x)
                (OQ7Prescribed.cross (H x) (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)))).re
OQ7Prescribed.cutoff_source_pairing_real : ∀ (ψ : OQ7Prescribed.Position → ℝ) (E H p : OQ7Prescribed.Field) (k : ℝ),
  (OQ7Prescribed.curl H = fun x => (-Complex.I * ↑k) • (E x + p x)) →
    ∀ (x : OQ7Prescribed.Position),
      (OQ7Prescribed.bilinear (OQ7Prescribed.curl H x) (ψ x • OQ7Prescribed.vectorConjugate (E x))).re =
        -k * (↑(ψ x) * OQ7Prescribed.pairing (p x) (E x)).im
OQ7Prescribed.cutoffDyadicRemainder_eLpNorm_le : ∀ (k T : ℝ),
  MeasureTheory.eLpNorm (OQ7Prescribed.cutoffDyadicRemainder k T) 2 MeasureTheory.volume ≤
    ENNReal.ofReal (OQ7Prescribed.dyadicRemainderCutoffConstant k T) *
      MeasureTheory.eLpNorm (OQ7Prescribed.cutoffGreen 0 T) 2 MeasureTheory.volume
OQ7Prescribed.cutoffDyadicRemainder_integrable : ∀ (k T : ℝ),
  MeasureTheory.Integrable (OQ7Prescribed.cutoffDyadicRemainder k T) MeasureTheory.volume
OQ7Prescribed.cutoffDyadicRemainder_memLp : ∀ (k T : ℝ),
  MeasureTheory.MemLp (OQ7Prescribed.cutoffDyadicRemainder k T) 2 MeasureTheory.volume
OQ7Prescribed.cutoffDyadicRemainder_norm_le : ∀ (k T : ℝ) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.cutoffDyadicRemainder k T x‖ ≤
    OQ7Prescribed.dyadicRemainderCutoffConstant k T * ‖OQ7Prescribed.cutoffGreen 0 T x‖
OQ7Prescribed.cutoffGreen_integrable : ∀ (k T : ℝ),
  MeasureTheory.Integrable (OQ7Prescribed.cutoffGreen k T) MeasureTheory.volume
OQ7Prescribed.cutoffGreen_memLp : ∀ (k T : ℝ),
  MeasureTheory.MemLp (OQ7Prescribed.cutoffGreen k T) 2 MeasureTheory.volume
OQ7Prescribed.cutoffOutgoingGradient_integrable : ∀ (k R : ℝ) (j : Fin 3),
  MeasureTheory.Integrable (OQ7Prescribed.cutoffOutgoingGradient k R j) MeasureTheory.volume
OQ7Prescribed.dielectricSlab_absorptance_lt_one : ∀ (k : ℝ),
  0 < k →
    ∀ (p q d : ℝ),
      1 ≤ p →
        0 ≤ q →
          0 ≤ d →
            OQ7.absorptanceLeft (OQ7Prescribed.dielectricSlabReflection k p q d)
                (OQ7Prescribed.dielectricSlabTransmission k p q d) <
              1
OQ7Prescribed.dielectricSlab_absorptance_pos : ∀ (k : ℝ),
  0 < k →
    ∀ (p q d : ℝ),
      1 ≤ p →
        0 < q →
          0 < d →
            0 <
              OQ7.absorptanceLeft (OQ7Prescribed.dielectricSlabReflection k p q d)
                (OQ7Prescribed.dielectricSlabTransmission k p q d)
OQ7Prescribed.dielectricSlab_absorptance_strict_bounds : ∀ (k : ℝ),
  0 < k →
    ∀ (p q d : ℝ),
      1 ≤ p →
        0 < q →
          0 < d →
            0 <
                OQ7.absorptanceLeft (OQ7Prescribed.dielectricSlabReflection k p q d)
                  (OQ7Prescribed.dielectricSlabTransmission k p q d) ∧
              OQ7.absorptanceLeft (OQ7Prescribed.dielectricSlabReflection k p q d)
                  (OQ7Prescribed.dielectricSlabTransmission k p q d) <
                1
OQ7Prescribed.dielectricSlab_absorptance_thick_limit : ∀ (k : ℝ),
