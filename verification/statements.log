  (k : ℝ),
  0 < k →
    ∀ (A : OQ7.HomogeneousLayer) (hpA : 1 ≤ A.p),
      0 ≤ A.q →
        0 ≤ A.width →
          ∀ (p d : ℝ),
            1 ≤ p →
              0 ≤ d →
                ∀ (q : X → OQ7Prescribed.NonnegativeSlabLoss) (θ z : X → ℝ),
                  Continuous q →
                    Continuous θ →
                      Continuous z →
                        ∀ (σ : OQ7Prescribed.Direction),
                          Continuous fun x =>
                            (OQ7Prescribed.slabCoupledAbsorber k A (OQ7Prescribed.dielectricSlab p (↑(q x)) d) (θ x) σ
                                  hpA).electric
                              (z x)
OQ7Prescribed.slabCoupledCurrent_absorption_integral : ∀ (k : ℝ) (A W : OQ7.HomogeneousLayer) (θ : ℝ)
  (σ : OQ7Prescribed.Direction) (hpA : 1 ≤ A.p) (hpW : 1 ≤ W.p) (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
  OQ7.relativePermittivity A - 1 ≠ 0 →
    OQ7.relativePermittivity W - 1 ≠ 0 →
      -(inner ℂ (OQ7Prescribed.slabCoupledCurrent k A W θ σ hpA hpW hdA hdW)
              ((OQ7Prescribed.planarInverseMaterial (A.width + W.width) A.width (OQ7.relativePermittivity A - 1)
                  (OQ7.relativePermittivity W - 1))
                (OQ7Prescribed.slabCoupledCurrent k A W θ σ hpA hpW hdA hdW))).im =
        (A.q * ∫ (z : ℝ) in 0..A.width, Complex.normSq ((OQ7Prescribed.slabCoupledAbsorber k A W θ σ hpA).electric z)) +
          W.q *
            ∫ (z : ℝ) in A.width..A.width + W.width,
              Complex.normSq ((OQ7Prescribed.slabCoupledPlate k A W θ σ hpW).electric z)
OQ7Prescribed.slabCoupledCurrent_coe : ∀ (k : ℝ) (A W : OQ7.HomogeneousLayer) (θ : ℝ) (σ : OQ7Prescribed.Direction)
  (hpA : 1 ≤ A.p) (hpW : 1 ≤ W.p) (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
  ↑↑↑(OQ7Prescribed.slabCoupledCurrent k A W θ σ hpA hpW hdA hdW) =ᵐ[MeasureTheory.volume] fun z =>
    (Set.Ioc 0 A.width).indicator
        (fun t => (OQ7.relativePermittivity A - 1) * (OQ7Prescribed.slabCoupledAbsorber k A W θ σ hpA).electric t) z +
      (Set.Ioc A.width (A.width + W.width)).indicator
        (fun t => (OQ7.relativePermittivity W - 1) * (OQ7Prescribed.slabCoupledPlate k A W θ σ hpW).electric t) z
OQ7Prescribed.slabCoupledCurrent_eq_planarNormalizedResponse : ∀ (k : ℝ) (hk : 0 < k) (A W : OQ7.HomogeneousLayer)
  (θ : ℝ) (σ : OQ7Prescribed.Direction) (hpA : 1 ≤ A.p) (hpW : 1 ≤ W.p) (hqA : 0 < A.q) (hqW : 0 < W.q)
  (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
  OQ7Prescribed.slabCoupledCurrent k A W θ σ hpA hpW hdA hdW =
    OQ7Prescribed.planarNormalizedResponse k hk σ (A.width + W.width) ⋯ A.width θ (OQ7.relativePermittivity A - 1)
      (OQ7.relativePermittivity W - 1) ⋯ ⋯
OQ7Prescribed.slabCoupledCurrent_material_equation : ∀ (k : ℝ) (hk : 0 < k) (A W : OQ7.HomogeneousLayer) (θ : ℝ)
  (σ : OQ7Prescribed.Direction) (hpA : 1 ≤ A.p) (hpW : 1 ≤ W.p),
  0 ≤ A.q →
    0 ≤ W.q →
      ∀ (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
        OQ7.relativePermittivity A - 1 ≠ 0 →
          OQ7.relativePermittivity W - 1 ≠ 0 →
            (OQ7Prescribed.planarActiveMaterialOperator k hk (A.width + W.width) ⋯ A.width θ
                  (OQ7.relativePermittivity A - 1) (OQ7.relativePermittivity W - 1))
                (OQ7Prescribed.slabCoupledCurrent k A W θ σ hpA hpW hdA hdW) =
              -OQ7Prescribed.planarNormalizedDrive k σ (A.width + W.width) A.width
OQ7Prescribed.slabCoupledCurrent_plus_drive_inner : ∀ (k : ℝ) (A W : OQ7.HomogeneousLayer) (θ : ℝ) (hpA : 1 ≤ A.p)
  (hpW : 1 ≤ W.p) (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
  inner ℂ (OQ7Prescribed.planarNormalizedDrive k OQ7Prescribed.Direction.plus (A.width + W.width) A.width)
      (OQ7Prescribed.slabCoupledCurrent k A W θ OQ7Prescribed.Direction.plus hpA hpW hdA hdW) =
    ∫ (z : ℝ) in A.width..A.width + W.width,
      OQ7Prescribed.apertureOscillation (-k) z *
        (OQ7Prescribed.slabCoupledPlate k A W θ OQ7Prescribed.Direction.plus hpW).current z
OQ7Prescribed.slabCoupledPlate_constitutive : ∀ (k : ℝ) (A W : OQ7.HomogeneousLayer) (θ : ℝ)
  (σ : OQ7Prescribed.Direction) (hpW : 1 ≤ W.p) (z : ℝ),
  (OQ7Prescribed.slabCoupledPlate k A W θ σ hpW).current z =
    (OQ7.relativePermittivity W - 1) * (OQ7Prescribed.slabCoupledPlate k A W θ σ hpW).electric z
OQ7Prescribed.slabCoupledPlate_electric_eq_green : ∀ (k : ℝ),
  0 < k →
    ∀ (A W : OQ7.HomogeneousLayer) (θ : ℝ) (σ : OQ7Prescribed.Direction) (hpA : 1 ≤ A.p) (hpW : 1 ≤ W.p),
      0 ≤ A.q →
        0 ≤ W.q →
          ∀ (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
            ∀ z ∈ Set.Icc A.width (A.width + W.width),
              (OQ7Prescribed.slabCoupledPlate k A W θ σ hpW).electric z =
                OQ7Prescribed.planarIncidentPhase k σ z +
                    ↑(Real.cos θ) *
                      k ^ 2 •
                        OQ7Prescribed.scalarPlanarPotential k
                          (↑↑↑(OQ7Prescribed.planarLayerL2Current k 0 A.width (A.width + W.width) ⋯ hdA ⋯
                                  (OQ7Prescribed.slabCoupledAbsorber k A W θ σ hpA)))
                          z +
                  k ^ 2 •
                    OQ7Prescribed.scalarPlanarPotential k
                      (↑↑↑(OQ7Prescribed.planarLayerL2Current k A.width (A.width + W.width) (A.width + W.width) hdA ⋯ ⋯
                              (OQ7Prescribed.slabCoupledPlate k A W θ σ hpW)))
                      z
OQ7Prescribed.slabCoupledPlate_Green_exterior_left : ∀ (k : ℝ),
  0 < k →
    ∀ (A W : OQ7.HomogeneousLayer) (θ : ℝ) (σ : OQ7Prescribed.Direction) (hpW : 1 ≤ W.p),
      0 ≤ W.q →
        ∀ (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
          ∀ z ≤ A.width,
            k ^ 2 •
                OQ7Prescribed.scalarPlanarPotential k
                  (↑↑↑(OQ7Prescribed.planarLayerL2Current k A.width (A.width + W.width) (A.width + W.width) hdA ⋯ ⋯
                          (OQ7Prescribed.slabCoupledPlate k A W θ σ hpW)))
                  z =
              (OQ7Prescribed.dielectricSlabReflection k W.p W.q W.width *
                    OQ7Prescribed.slabPlateLeftAmplitude k A W θ σ +
                  (OQ7Prescribed.dielectricSlabTransmission k W.p W.q W.width -
                      OQ7Prescribed.apertureOscillation k W.width) *
                    OQ7Prescribed.slabPlateRightAmplitude k A W σ) *
                OQ7Prescribed.apertureOscillation k (A.width - z)
OQ7Prescribed.slabCoupledPlate_Green_interior : ∀ (k : ℝ),
  0 < k →
    ∀ (A W : OQ7.HomogeneousLayer) (θ : ℝ) (σ : OQ7Prescribed.Direction) (hpW : 1 ≤ W.p),
      0 ≤ W.q →
        ∀ (hdA : 0 ≤ A.width) (hdW : 0 ≤ W.width),
          ∀ z ∈ Set.Icc A.width (A.width + W.width),
            k ^ 2 •
                OQ7Prescribed.scalarPlanarPotential k
                  (↑↑↑(OQ7Prescribed.planarLayerL2Current k A.width (A.width + W.width) (A.width + W.width) hdA ⋯ ⋯
                          (OQ7Prescribed.slabCoupledPlate k A W θ σ hpW)))
                  z =
              (OQ7Prescribed.slabCoupledPlate k A W θ σ hpW).electric z -
                  OQ7Prescribed.slabPlateLeftAmplitude k A W θ σ * OQ7Prescribed.apertureOscillation k (z - A.width) -
                OQ7Prescribed.slabPlateRightAmplitude k A W σ *
                  OQ7Prescribed.apertureOscillation k (A.width + W.width - z)
@OQ7Prescribed.slabCoupledPlate_loss_angle_position_continuous : ∀ {X : Type u_1} [inst : TopologicalSpace X] (k : ℝ),
  0 < k →
    ∀ (A : OQ7.HomogeneousLayer),
      1 ≤ A.p →
        0 ≤ A.q →
          0 ≤ A.width →
            ∀ (p d : ℝ) (hp : 1 ≤ p),
              0 ≤ d →
                ∀ (q : X → OQ7Prescribed.NonnegativeSlabLoss) (θ z : X → ℝ),
                  Continuous q →
