OQ7Prescribed.slabIntegralAbsorption_absorber_part : ∀ (k : ℝ),
  0 < k →
    ∀ (A W : OQ7.HomogeneousLayer) (θ : ℝ) (σ : OQ7Prescribed.Direction) (hpA : 1 ≤ A.p) (hpW : 1 ≤ W.p),
      0 ≤ A.q →
        0 ≤ A.width →
          OQ7Prescribed.slabIntegralAbsorption k A W θ σ hpA hpW =
            Complex.normSq (OQ7Prescribed.slabAbsorberAmplitude k A W θ σ) *
                OQ7.absorptanceLeft (OQ7Prescribed.dielectricSlabReflection k A.p A.q A.width)
                  (OQ7Prescribed.dielectricSlabTransmission k A.p A.q A.width) +
              k * W.q *
                ∫ (z : ℝ) in A.width..A.width + W.width,
                  Complex.normSq ((OQ7Prescribed.slabCoupledPlate k A W θ σ hpW).electric z)
