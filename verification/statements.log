OQ7Prescribed.normalizedActiveResponse_equation : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  (OQ7Prescribed.activeMaterialOperator k B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β)
      (OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ) =
    -OQ7Prescribed.normalizedIncidentDrive k B σ
OQ7Prescribed.normalizedActiveResponse_ne_zero : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ ≠ 0
OQ7Prescribed.normalizedActiveResponse_norm_le : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  ‖OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ‖ ≤
    1 / min (α.im / Complex.normSq α) (β.im / Complex.normSq β) * ‖OQ7Prescribed.normalizedIncidentDrive k B σ‖
OQ7Prescribed.normalizedActiveResponse_residual_bound : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  ‖OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ - q‖ ≤
