OQ7Prescribed.outgoingGradient_measurable : ∀ (k : ℝ) (j : Fin 3), Measurable (OQ7Prescribed.outgoingGradient k j)
OQ7Prescribed.outgoingGradient_norm_le_far : ∀ (k : ℝ) (j : Fin 3) (x : OQ7Prescribed.Position),
  1 ≤ ‖x‖ → ‖OQ7Prescribed.outgoingGradient k j x‖ ≤ (|k| + 1) / (4 * Real.pi)
OQ7Prescribed.outgoingGradient_zero_locallyIntegrable : ∀ (j : Fin 3),
