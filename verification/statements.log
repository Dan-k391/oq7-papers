OQ7Prescribed.remainderPotentialComponentDistribution_dynamic_pairing : ∀ (k : ℝ)
  (p : OQ7Prescribed.CompactPolarization) (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.remainderPotentialComponentDistribution k p i) φ =
    k ^ 2 • (OQ7Prescribed.potentialComponentDistribution k p i) φ +
      ∑ j,
        ∫ (z : OQ7Prescribed.Position),
          OQ7Prescribed.newtonCurrentCorrelation p φ j z * OQ7Prescribed.dynamicHessianRemainder k i j z
OQ7Prescribed.remainderPotentialComponentDistribution_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
