  (A M : ℝ) (hAM : 0 ≤ A + M) (hA : tsupport w ⊆ Metric.closedBall 0 A) (u : ℂ) (f : ℝ → ℂ) (hf : ContDiff ℝ (↑⊤) f)
  (hc : HasCompactSupport f) (hs : tsupport f ⊆ Metric.closedBall 0 M),
