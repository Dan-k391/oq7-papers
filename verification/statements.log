OQ7Prescribed.normalizedRotationAsymmetry_scaled : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody) (θ : ℝ)
  (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
