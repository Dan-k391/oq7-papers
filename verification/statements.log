def OQ7Prescribed.Theorem11Statement : Prop :=
∀ (k P Q target : ℝ),
  0 < k →
    1 < P →
      0 < Q →
        0 < target →
          ∀ (ε : ℝ),
            0 < ε →
              ε < 1 →
                ∃ B,
                  B.admissible P Q ∧
                    ∃ sp sm,
                      OQ7Prescribed.extinction k B OQ7Prescribed.Direction.plus sp.electric = target ∧
                        OQ7Prescribed.extinction k B OQ7Prescribed.Direction.minus sm.electric = target ∧
                          1 - ε < OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric ∧
                            OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric < 1
'OQ7Prescribed.Theorem11Statement' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.activeForwardMaterial_coe : ∀ (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.activeForwardMaterial B α β) q) =ᵐ[MeasureTheory.volume] fun x =>
    if x.ofLp 2 < B.absorberThickness then α * ↑↑↑q x else β * ↑↑↑q x
OQ7Prescribed.activeForwardMaterial_inverse_left : ∀ (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ),
  α ≠ 0 →
    β ≠ 0 →
      OQ7Prescribed.activeInverseMaterial B α β ∘SL OQ7Prescribed.activeForwardMaterial B α β =
        ContinuousLinearMap.id ℂ ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)
OQ7Prescribed.activeForwardMaterial_inverse_right : ∀ (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ),
  α ≠ 0 →
    β ≠ 0 →
      OQ7Prescribed.activeForwardMaterial B α β ∘SL OQ7Prescribed.activeInverseMaterial B α β =
        ContinuousLinearMap.id ℂ ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)
OQ7Prescribed.activeInjection_coe : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.activeInjection B u v) q) =ᵐ[MeasureTheory.volume] fun x =>
    if x.ofLp 2 < B.absorberThickness then ↑↑↑q x • OQ7Prescribed.complexify u else ↑↑↑q x • OQ7Prescribed.complexify v
OQ7Prescribed.activeInjection_inner : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)) (p : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  inner ℂ ((OQ7Prescribed.activeInjection B u v) q) p = inner ℂ q ((OQ7Prescribed.activeProjection B u v) p)
OQ7Prescribed.activeInjection_norm : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position),
  ‖u‖ ^ 2 = 1 →
    ‖v‖ ^ 2 = 1 → ∀ (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)), ‖(OQ7Prescribed.activeInjection B u v) q‖ = ‖q‖
OQ7Prescribed.activeInjection_rotation_continuous : ∀ (B : OQ7Prescribed.TwoLayerBody),
  Continuous fun θ => OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ)
OQ7Prescribed.activeInverseMaterial_coe : ∀ (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.activeInverseMaterial B α β) q) =ᵐ[MeasureTheory.volume] fun x =>
    if x.ofLp 2 < B.absorberThickness then α⁻¹ * ↑↑↑q x else β⁻¹ * ↑↑↑q x
