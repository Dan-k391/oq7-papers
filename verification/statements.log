OQ7Prescribed.slabCoupledPlate_plus_weighted_moment : ∀ (k : ℝ),
  0 < k →
    ∀ (A W : OQ7.HomogeneousLayer) (θ : ℝ) (hpW : 1 ≤ W.p),
      0 ≤ W.q →
        0 ≤ W.width →
          Complex.I * ↑k *
              ∫ (z : ℝ) in A.width..A.width + W.width,
                OQ7Prescribed.apertureOscillation (-k) z *
                  (OQ7Prescribed.slabCoupledPlate k A W θ OQ7Prescribed.Direction.plus hpW).current z =
            2 * OQ7Prescribed.slabPlusPlateAmplitude k A W θ *
              (OQ7Prescribed.apertureOscillation (-k) (A.width + W.width) *
                  OQ7Prescribed.dielectricSlabTransmission k W.p W.q W.width -
                OQ7Prescribed.apertureOscillation (-k) A.width)
