  (OQ7Prescribed.slabLiftPolarization w hw A M hAM hA u q).current =ᵐ[MeasureTheory.volume] fun x =>
    OQ7Prescribed.slabSeparatedFunction w (↑↑↑q) x • OQ7Prescribed.complexify (OQ7Prescribed.slabPosition u 0)
