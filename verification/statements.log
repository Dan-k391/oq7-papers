OQ7Prescribed.bodyCurrentPolarization_current_ae : ∀ (B : OQ7Prescribed.TwoLayerBody)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  (OQ7Prescribed.bodyCurrentPolarization B f).current =ᵐ[MeasureTheory.volume] ↑↑↑f
