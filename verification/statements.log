OQ7Prescribed.remainder_current_correlation_inner : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (z : OQ7Prescribed.Position),
  ∫ (y : OQ7Prescribed.Position), ↑(φ (z + y)) • (OQ7Prescribed.dyadicRemainder k z) (p.current y) =
    (OQ7Prescribed.dyadicRemainder k z) (OQ7Prescribed.currentTestCorrelationVector p φ z)
OQ7Prescribed.remainder_current_correlation_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  MeasureTheory.Integrable (fun q => ↑(φ (q.1 + q.2)) • (OQ7Prescribed.dyadicRemainder k q.1) (p.current q.2))
