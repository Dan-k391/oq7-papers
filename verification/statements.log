OQ7Prescribed.removable_point_complex_test_ibp : ∀ (F D : OQ7Prescribed.Position → ℂ) (i : Fin 3),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 F x) →
    (∀ (x : OQ7Prescribed.Position), x ≠ 0 → HasLineDerivAt ℝ F (D x) x (OQ7Prescribed.basisR i)) →
      MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
        MeasureTheory.LocallyIntegrable D MeasureTheory.volume →
          (∃ R, 0 < R ∧ ∃ M, 0 ≤ M ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ M) →
            ∀ (φ : OQ7Prescribed.ScalarTest),
              ∫ (x : OQ7Prescribed.Position), ((OQ7Prescribed.testPartial i) φ) x • F x =
                -∫ (x : OQ7Prescribed.Position), φ x • D x
OQ7Prescribed.removable_point_test_ibp : ∀ (F D : OQ7Prescribed.Position → ℝ) (i : Fin 3),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 F x) →
    (∀ (x : OQ7Prescribed.Position), x ≠ 0 → HasLineDerivAt ℝ F (D x) x (OQ7Prescribed.basisR i)) →
      MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
        MeasureTheory.LocallyIntegrable D MeasureTheory.volume →
          (∃ R, 0 < R ∧ ∃ M, 0 ≤ M ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ M) →
            ∀ (φ : OQ7Prescribed.ScalarTest),
              ∫ (x : OQ7Prescribed.Position), F x * ((OQ7Prescribed.testPartial i) φ) x =
                -∫ (x : OQ7Prescribed.Position), D x * φ x
OQ7Prescribed.rotatedAxis_unit : ∀ (θ : ℝ), ‖OQ7Prescribed.rotatedAxis θ‖ ^ 2 = 1
