OQ7Prescribed.outgoingGreenDistribution_apply : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingGreenDistribution k) φ = ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingGreen k x
OQ7Prescribed.outgoingMagneticDistribution_second_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingMagneticDistribution k p) =
    (-Complex.I * ↑k) •
      (OQ7Prescribed.outgoingVolumeDistribution k p + OQ7Prescribed.polarizationCurrentComponentDistribution p)
OQ7Prescribed.outgoingMagneticField_locallySquareIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.outgoingMagneticField k p)
OQ7Prescribed.outgoingPhysicalSourceFields : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.outgoingElectricField k p) ∧
    OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.outgoingMagneticField k p) ∧
      (OQ7Prescribed.HasWeakCurl (OQ7Prescribed.outgoingElectricField k p) fun x =>
          (Complex.I * ↑k) • OQ7Prescribed.outgoingMagneticField k p x) ∧
        (OQ7Prescribed.HasWeakCurl (OQ7Prescribed.outgoingMagneticField k p) fun x =>
            (-Complex.I * ↑k) • (OQ7Prescribed.outgoingElectricField k p x + p.current x)) ∧
          OQ7Prescribed.Outgoing (OQ7Prescribed.outgoingElectricField k p) (OQ7Prescribed.outgoingMagneticField k p)
OQ7Prescribed.outgoingPotential_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.outgoingPotential k (p.add q) =
    OQ7Prescribed.outgoingPotential k p + OQ7Prescribed.outgoingPotential k q
OQ7Prescribed.outgoingPotential_aestronglyMeasurable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.AEStronglyMeasurable (OQ7Prescribed.outgoingPotential k p) MeasureTheory.volume
OQ7Prescribed.outgoingPotential_axis_source : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (f : OQ7Prescribed.Position → ℂ) (a : OQ7Prescribed.Position),
  (p.current = fun x => f x • OQ7Prescribed.complexify a) →
    ∀ (x : OQ7Prescribed.Position),
      OQ7Prescribed.outgoingPotential k p x = OQ7Prescribed.scalarOutgoingPotential k f x • OQ7Prescribed.complexify a
OQ7Prescribed.outgoingPotential_component_integral : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (x : OQ7Prescribed.Position),
  (OQ7Prescribed.outgoingPotential k p x).ofLp i =
    ∫ (y : OQ7Prescribed.Position), OQ7Prescribed.outgoingGreen k (x - y) * (p.current y).ofLp i
OQ7Prescribed.outgoingPotential_congr_current : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  p.current =ᵐ[MeasureTheory.volume] q.current →
    OQ7Prescribed.outgoingPotential k p = OQ7Prescribed.outgoingPotential k q
OQ7Prescribed.outgoingPotential_contDiff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current → ContDiff ℝ (↑⊤) (OQ7Prescribed.outgoingPotential k p)
OQ7Prescribed.outgoingPotential_curlCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.distributionCurl (OQ7Prescribed.potentialComponentDistribution k p)) i =
    OQ7Prescribed.outgoingVolumeDistribution k p i + OQ7Prescribed.polarizationCurrentComponentDistribution p i
OQ7Prescribed.outgoingPotential_enorm_le : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x : OQ7Prescribed.Position), ‖x‖ ≤ S → ‖OQ7Prescribed.outgoingPotential k p x‖ₑ ≤ OQ7Prescribed.potentialBound k p S
OQ7Prescribed.outgoingPotential_eq_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    OQ7Prescribed.outgoingPotential k p x =
      MeasureTheory.convolution p.current (OQ7Prescribed.cutoffGreen k (S + p.radius)) OQ7Prescribed.vectorScalarMul
        MeasureTheory.volume x
OQ7Prescribed.outgoingPotential_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  MeasureTheory.Integrable (fun y => OQ7Prescribed.outgoingGreen k (x - y) • p.current y) MeasureTheory.volume
OQ7Prescribed.outgoingPotential_integrand_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x y : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    (OQ7Prescribed.vectorScalarMul (p.current y)) (OQ7Prescribed.outgoingGreen k (x - y)) =
      (OQ7Prescribed.vectorScalarMul (p.current y)) (OQ7Prescribed.cutoffGreen k (S + p.radius) (x - y))
OQ7Prescribed.outgoingPotential_locallyIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.outgoingPotential k p) MeasureTheory.volume
OQ7Prescribed.outgoingPotential_zero_component_integral : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (x : OQ7Prescribed.Position),
  (OQ7Prescribed.outgoingPotential 0 p x).ofLp i =
    ∫ (y : OQ7Prescribed.Position), OQ7Prescribed.outgoingGreen 0 (x - y) * (p.current y).ofLp i
OQ7Prescribed.outgoingRadial_contDiffAt : ∀ (k r : ℝ), r ≠ 0 → ContDiffAt ℝ 1 (OQ7Prescribed.outgoingRadial k) r
OQ7Prescribed.outgoingRadial_hasDerivAt : ∀ (k r : ℝ),
  r ≠ 0 → HasDerivAt (OQ7Prescribed.outgoingRadial k) (OQ7Prescribed.outgoingRadialFirst k r) r
OQ7Prescribed.outgoingRadial_helmholtz : ∀ (k r : ℝ),
  OQ7Prescribed.outgoingRadialSecond k r + (2 / r) • OQ7Prescribed.outgoingRadialFirst k r =
    -↑(k ^ 2) * OQ7Prescribed.outgoingRadial k r
OQ7Prescribed.outgoingRadialFirst_contDiffAt : ∀ (k r : ℝ),
  r ≠ 0 → ContDiffAt ℝ 1 (OQ7Prescribed.outgoingRadialFirst k) r
OQ7Prescribed.outgoingRadialFirst_hasDerivAt : ∀ (k r : ℝ),
  r ≠ 0 → HasDerivAt (OQ7Prescribed.outgoingRadialFirst k) (OQ7Prescribed.outgoingRadialSecond k r) r
OQ7Prescribed.outgoingRadialFirst_sub_static : ∀ (k r : ℝ),
  OQ7Prescribed.outgoingRadialFirst k r - OQ7Prescribed.outgoingRadialFirst 0 r =
    (Complex.exp (Complex.I * ↑k * ↑r) * (Complex.I * ↑k * ↑r - 1) + 1) / (↑(4 * Real.pi) * ↑r ^ 2)
OQ7Prescribed.outgoingRadialFirst_sub_static_norm_le : ∀ (k r : ℝ),
  0 < r →
    ‖OQ7Prescribed.outgoingRadialFirst k r - OQ7Prescribed.outgoingRadialFirst 0 r‖ ≤
      OQ7Prescribed.dynamicGradientBound k r
OQ7Prescribed.outgoingSourceFields_first_weakCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.outgoingElectricField k p) fun x =>
    (Complex.I * ↑k) • OQ7Prescribed.outgoingMagneticField k p x
OQ7Prescribed.outgoingSourceFields_outgoing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.Outgoing (OQ7Prescribed.outgoingElectricField k p) (OQ7Prescribed.outgoingMagneticField k p)
OQ7Prescribed.outgoingSourceFields_second_weakCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.outgoingMagneticField k p) fun x =>
    (-Complex.I * ↑k) • (OQ7Prescribed.outgoingElectricField k p x + p.current x)
OQ7Prescribed.outgoingVolumeDistribution_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.outgoingVolumeDistribution k (p.add q) i =
    OQ7Prescribed.outgoingVolumeDistribution k p i + OQ7Prescribed.outgoingVolumeDistribution k q i
OQ7Prescribed.outgoingVolumeDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingVolumeDistribution k p i) φ =
    k ^ 2 • (∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingPotential k p x).ofLp i +
      ∑ j,
        (∫ (x : OQ7Prescribed.Position),
              ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x •
                OQ7Prescribed.outgoingPotential k p x).ofLp
          j
OQ7Prescribed.outgoingVolumeDistribution_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p) =
    k ^ 2 • OQ7Prescribed.distributionCurl (OQ7Prescribed.potentialComponentDistribution k p)
OQ7Prescribed.outgoingVolumeDistribution_current_dyadic_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.outgoingVolumeDistribution k p i) φ = ∑ j, OQ7Prescribed.currentDyadicTestPairing k p φ i j
OQ7Prescribed.outgoingVolumeDistribution_eq_gradient : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.outgoingVolumeDistribution k p =
    k ^ 2 • OQ7Prescribed.potentialComponentDistribution k p + fun i =>
      (OQ7Prescribed.distributionPartial i)
        (OQ7Prescribed.distributionDivergence (OQ7Prescribed.potentialComponentDistribution k p))
OQ7Prescribed.outgoingVolumeDistribution_eq_staticFourier_add_remainder : ∀ (k : ℝ)
  (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.outgoingVolumeDistribution k p i =
    OQ7Prescribed.vectorL2ComponentDistribution
        (OQ7Prescribed.staticFourierOperator (MeasureTheory.MemLp.toLp p.current ⋯)) i +
      OQ7Prescribed.remainderPotentialComponentDistribution k p i
OQ7Prescribed.outgoingVolumeDistribution_eq_zero_add_remainder : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  OQ7Prescribed.outgoingVolumeDistribution k p i =
    OQ7Prescribed.outgoingVolumeDistribution 0 p i + OQ7Prescribed.remainderPotentialComponentDistribution k p i
OQ7Prescribed.outgoingVolumeDistribution_first_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p) =
    (Complex.I * ↑k) • OQ7Prescribed.outgoingMagneticDistribution k p
OQ7Prescribed.outgoingVolumeDistribution_maxwell_source : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p)) i -
      k ^ 2 • OQ7Prescribed.outgoingVolumeDistribution k p i =
    k ^ 2 • OQ7Prescribed.polarizationCurrentComponentDistribution p i
OQ7Prescribed.outgoingVolumeDistribution_maxwell_source_L2 : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p)) i -
      k ^ 2 • OQ7Prescribed.outgoingVolumeDistribution k p i =
    k ^ 2 • OQ7Prescribed.vectorL2ComponentDistribution (MeasureTheory.MemLp.toLp p.current ⋯) i
OQ7Prescribed.outgoingVolumeDistribution_on_ball_bounded_L2_realization : ∀ (k R : ℝ) (hR : 0 ≤ R)
  (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ∃ u,
    (∀ (i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
        Function.support ⇑φ ⊆ Metric.closedBall 0 R →
          (OQ7Prescribed.vectorL2ComponentDistribution (↑u) i) φ =
            (OQ7Prescribed.outgoingVolumeDistribution k (OQ7Prescribed.supportedPolarization R hR f) i) φ) ∧
      ‖u‖ ≤ (1 + OQ7Prescribed.compactRemainderConstant k R) * ‖f‖
OQ7Prescribed.outgoingVolumeDistribution_zero_bounded_L2_realization : ∀ (p : OQ7Prescribed.CompactPolarization),
  ∃ u,
    (∀ (i : Fin 3), OQ7Prescribed.outgoingVolumeDistribution 0 p i = OQ7Prescribed.vectorL2ComponentDistribution u i) ∧
      ‖u‖ ≤ ‖MeasureTheory.MemLp.toLp p.current ⋯‖
OQ7Prescribed.outgoingVolumeDistribution_zero_eq_staticFourier : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.outgoingVolumeDistribution 0 p i =
    OQ7Prescribed.vectorL2ComponentDistribution
      (OQ7Prescribed.staticFourierOperator (MeasureTheory.MemLp.toLp p.current ⋯)) i
OQ7Prescribed.outgoingVolumeDistribution_zero_hessian_pairing : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingVolumeDistribution 0 p i) φ =
    ∑ j, (OQ7Prescribed.newtonTemperedHessian i j) (OQ7Prescribed.newtonCurrentCorrelationSchwartz p φ j)
OQ7Prescribed.pairing_eq_inner : ∀ (u v : OQ7Prescribed.Vector), OQ7Prescribed.pairing u v = inner ℂ u v
OQ7Prescribed.pairing_real_smul_right : ∀ (E v : OQ7Prescribed.Vector) (r : ℝ),
  OQ7Prescribed.pairing E (r • v) = ↑r * OQ7Prescribed.pairing E v
OQ7Prescribed.pairing_self : ∀ (v : OQ7Prescribed.Vector), OQ7Prescribed.pairing v v = ↑(OQ7Prescribed.squareNorm v)
OQ7Prescribed.permittivity_one_outside : ∀ (B : OQ7Prescribed.TwoLayerBody), ∀ x ∉ B.domain, B.permittivity x = 1
OQ7Prescribed.permittivity_reciprocal : ∀ (B : OQ7Prescribed.TwoLayerBody) (P Q : ℝ),
  B.admissible P Q → ∀ (x : OQ7Prescribed.Position), Matrix.transpose (B.permittivity x) = B.permittivity x
OQ7Prescribed.physicalAbsorption_current_inner : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field)
  (hE : OQ7Prescribed.LocallySquareIntegrable E) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  ↑↑↑f =ᵐ[MeasureTheory.volume] OQ7Prescribed.polarization B E →
    OQ7Prescribed.absorption k B E = k * (inner ℂ (OQ7Prescribed.bodyFieldCurrent B E hE) f).im
OQ7Prescribed.physicalAbsorption_sine_squared_factorization : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.absorption k (OQ7Prescribed.rankOneBody B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β)
      (OQ7Prescribed.volumeTotalElectric k σ
        (OQ7Prescribed.bodyCurrentPolarization B
          ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
            (OQ7Prescribed.activePhysicalSolution k hk B σ (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β hα
              hβ)))) =
    Real.sin θ ^ 2 * OQ7Prescribed.normalizedAbsorption k hk B σ θ α β hα hβ
OQ7Prescribed.physicalAsymmetry_normalized_factorization : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (θ : ℝ),
  Real.sin θ ≠ 0 →
    ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
      OQ7Prescribed.normalizedAsymmetry k
          (OQ7Prescribed.rankOneBody B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β)
          (OQ7Prescribed.volumeTotalElectric k OQ7Prescribed.Direction.plus
            (OQ7Prescribed.bodyCurrentPolarization B
              ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
                (OQ7Prescribed.activePhysicalSolution k hk B OQ7Prescribed.Direction.plus (OQ7Prescribed.basisR 0)
                  (OQ7Prescribed.rotatedAxis θ) α β hα hβ))))
          (OQ7Prescribed.volumeTotalElectric k OQ7Prescribed.Direction.minus
            (OQ7Prescribed.bodyCurrentPolarization B
              ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
                (OQ7Prescribed.activePhysicalSolution k hk B OQ7Prescribed.Direction.minus (OQ7Prescribed.basisR 0)
                  (OQ7Prescribed.rotatedAxis θ) α β hα hβ)))) =
        OQ7Prescribed.normalizedRotationAsymmetry k hk B θ α β hα hβ
OQ7Prescribed.physicalBody_normalized_asymmetry_uniform_aperture_localization : ∀ (k : ℝ) (hk : 0 < k) (h d : ℝ),
  0 < h →
    0 < d →
      ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) (s : Set ℝ),
        IsCompact s →
          ∀ (ε : ℝ),
            0 < ε →
              ∃ R0,
                1 ≤ R0 ∧
                  ∀ (B : OQ7Prescribed.TwoLayerBody),
                    B.absorberThickness = h →
                      B.plateThickness = d →
                        R0 ≤ B.aperture →
                          ∀ θ ∈ s,
                            |OQ7Prescribed.normalizedRotationAsymmetry k hk B θ α β hα hβ -
                                  OQ7Prescribed.planarNormalizedAsymmetry k hk (B.absorberThickness + B.plateThickness)
                                    ⋯ B.absorberThickness θ α β hα hβ| ≤
                              ε
OQ7Prescribed.physicalBody_normalized_powers_uniform_aperture_localization : ∀ (k : ℝ) (hk : 0 < k) (h d : ℝ),
  0 < h →
    0 < d →
      ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) (ε : ℝ),
        0 < ε →
          ∃ R0,
            1 ≤ R0 ∧
              ∀ (B : OQ7Prescribed.TwoLayerBody),
                B.absorberThickness = h →
                  B.plateThickness = d →
                    R0 ≤ B.aperture →
                      ∀ (σ : OQ7Prescribed.Direction) (θ : ℝ),
                        |OQ7Prescribed.normalizedExtinction k hk B σ θ α β hα hβ -
                                B.aperture ^ 2 *
                                  OQ7Prescribed.planarNormalizedExtinction k hk σ
                                    (B.absorberThickness + B.plateThickness) ⋯ B.absorberThickness θ α β hα hβ| +
                            |OQ7Prescribed.normalizedAbsorption k hk B σ θ α β hα hβ -
                                B.aperture ^ 2 *
                                  OQ7Prescribed.planarNormalizedAbsorption k hk σ
                                    (B.absorberThickness + B.plateThickness) ⋯ B.absorberThickness θ α β hα hβ| ≤
                          ε * B.aperture ^ 2
OQ7Prescribed.physicalBody_normalized_response_uniform_aperture_localization : ∀ (k : ℝ) (hk : 0 < k) (h d : ℝ),
  0 < h →
    0 < d →
      ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) (ε : ℝ),
        0 < ε →
          ∃ R0,
            1 ≤ R0 ∧
              ∀ (B : OQ7Prescribed.TwoLayerBody),
                B.absorberThickness = h →
                  B.plateThickness = d →
                    R0 ≤ B.aperture →
                      ∀ (σ : OQ7Prescribed.Direction) (θ : ℝ),
                        ‖OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ -
                              (OQ7Prescribed.bodySharpScalarLift B)
                                (OQ7Prescribed.planarNormalizedResponse k hk σ (B.absorberThickness + B.plateThickness)
                                  ⋯ B.absorberThickness θ α β hα hβ)‖ ≤
                          ε * B.aperture
OQ7Prescribed.physicalBody_normalized_vector_current_uniform_aperture_localization : ∀ (k : ℝ) (hk : 0 < k) (h d : ℝ),
  0 < h →
    0 < d →
      ∀ (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) (ε : ℝ),
        0 < ε →
          ∃ R0,
            1 ≤ R0 ∧
              ∀ (B : OQ7Prescribed.TwoLayerBody),
                B.absorberThickness = h →
                  B.plateThickness = d →
                    R0 ≤ B.aperture →
                      ∀ (σ : OQ7Prescribed.Direction) (θ : ℝ),
                        ‖(OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
                                (OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ) -
                              (OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
                                ((OQ7Prescribed.bodySharpScalarLift B)
                                  (OQ7Prescribed.planarNormalizedResponse k hk σ
                                    (B.absorberThickness + B.plateThickness) ⋯ B.absorberThickness θ α β hα hβ))‖ ≤
                          ε * B.aperture
OQ7Prescribed.physicalBody_uniform_planar_operator_residual : ∀ (k : ℝ) (hk : 0 < k) (h d : ℝ),
  0 ≤ h + d →
    ∀ (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w) (hwc : HasCompactSupport w)
      (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture 1),
      ∃ K,
        0 < K ∧
          ∀ (B : OQ7Prescribed.TwoLayerBody),
            B.absorberThickness = h →
              B.plateThickness = d →
                1 ≤ B.aperture →
                  ∀ (θ : ℝ) (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
                    ‖(OQ7Prescribed.activeProjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
                            ((OQ7Prescribed.bodyOutgoingOperator k B)
                              ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
                                ((OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs) q))) -
                          (OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs)
                            ((OQ7Prescribed.planarActiveOutgoing k hk (B.absorberThickness + B.plateThickness) ⋯
                                B.absorberThickness θ)
                              q)‖ ≤
                      K * ‖q‖
OQ7Prescribed.physicalBody_uniform_planar_response_estimate : ∀ (k : ℝ) (hk : 0 < k) (h d : ℝ),
  0 ≤ h + d →
    ∀ (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w) (hwc : HasCompactSupport w)
      (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture 1),
      ∃ K,
        0 < K ∧
          ∀ (B : OQ7Prescribed.TwoLayerBody),
            B.absorberThickness = h →
              B.plateThickness = d →
                1 ≤ B.aperture →
                  ∀ (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
                    ‖OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ -
                          (OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs)
                            (OQ7Prescribed.planarNormalizedResponse k hk σ (B.absorberThickness + B.plateThickness) ⋯
                              B.absorberThickness θ α β hα hβ)‖ ≤
                      1 / OQ7Prescribed.activeMaterialCoercivity α β *
                        (‖OQ7Prescribed.normalizedIncidentDrive k B σ -
                              (OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs)
                                (OQ7Prescribed.planarNormalizedDrive k σ (B.absorberThickness + B.plateThickness)
                                  B.absorberThickness)‖ +
                          K * (1 / OQ7Prescribed.activeMaterialCoercivity α β) *
                            ‖OQ7Prescribed.planarNormalizedDrive k σ (B.absorberThickness + B.plateThickness)
                                B.absorberThickness‖)
