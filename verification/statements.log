  MeasurableSet (OQ7Prescribed.bodyAbsorberSlice B)
OQ7Prescribed.bodyCompressed_aperture_error_identity : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (hR : 1 ≤ B.aperture) (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w) (hwc : HasCompactSupport w)
  (hs : tsupport w ⊆ OQ7Prescribed.horizontalSquareAperture 1) (θ : ℝ)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))),
  (OQ7Prescribed.activeProjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
        ((OQ7Prescribed.bodyOutgoingOperator k B)
          ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
            ((OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs) q))) -
      (OQ7Prescribed.bodyScaledScalarLift B w hw hwc hs)
        ((OQ7Prescribed.planarActiveOutgoing k hk (B.absorberThickness + B.plateThickness) ⋯ B.absorberThickness θ) q) =
    OQ7Prescribed.bodyCompressFourErrors B θ
      (OQ7Prescribed.bodySlabError k hk B hR w hw hwc hs 1 1
        ((OQ7Prescribed.planarLayerAxisMap (B.absorberThickness + B.plateThickness) B.absorberThickness 1 (Real.cos θ))
          q))
      (OQ7Prescribed.bodySlabError k hk B hR w hw hwc hs Complex.I 1
        ((OQ7Prescribed.planarLayerAxisMap (B.absorberThickness + B.plateThickness) B.absorberThickness 0 (Real.sin θ))
          q))
      (OQ7Prescribed.bodySlabError k hk B hR w hw hwc hs 1 Complex.I
        ((OQ7Prescribed.planarLayerAxisMap (B.absorberThickness + B.plateThickness) B.absorberThickness 1 (Real.cos θ))
          q))
      (OQ7Prescribed.bodySlabError k hk B hR w hw hwc hs Complex.I Complex.I
        ((OQ7Prescribed.planarLayerAxisMap (B.absorberThickness + B.plateThickness) B.absorberThickness 0 (Real.sin θ))
          q))
OQ7Prescribed.bodyCompressedOutgoing_coe : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (θ : ℝ)
  (f : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.activeProjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
            ((OQ7Prescribed.bodyOutgoingOperator k B)
              ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
                f))) =ᵐ[MeasureTheory.volume]
    B.domain.indicator fun x =>
      if x.ofLp 2 < B.absorberThickness then
        OQ7Prescribed.axisCoupling (OQ7Prescribed.basisR 0)
          (OQ7Prescribed.electricVolumeField k
            (OQ7Prescribed.bodyCurrentPolarization B
              ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ)) f))
            x)
      else
        OQ7Prescribed.axisCoupling (OQ7Prescribed.rotatedAxis θ)
          (OQ7Prescribed.electricVolumeField k
            (OQ7Prescribed.bodyCurrentPolarization B
              ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ)) f))
            x)
OQ7Prescribed.bodyCompressFourErrors_coe : ∀ (B : OQ7Prescribed.TwoLayerBody) (θ : ℝ)
  (D00 D10 D01 D11 : ↥OQ7Prescribed.ScalarVolumeL2),
  ↑↑↑(OQ7Prescribed.bodyCompressFourErrors B θ D00 D10 D01 D11) =ᵐ[MeasureTheory.volume]
    B.domain.indicator fun x =>
      if x.ofLp 2 < B.absorberThickness then ↑↑D00 x + ↑↑D10 x
      else ↑(Real.cos θ) * (↑↑D00 x + ↑↑D10 x) + ↑(Real.sin θ) * (↑↑D01 x + ↑↑D11 x)
OQ7Prescribed.bodyCompressFourErrors_norm_le : ∀ (B : OQ7Prescribed.TwoLayerBody) (θ : ℝ)
  (D00 D10 D01 D11 : ↥OQ7Prescribed.ScalarVolumeL2),
  ‖OQ7Prescribed.bodyCompressFourErrors B θ D00 D10 D01 D11‖ ≤ ‖D00‖ + ‖D10‖ + (‖D01‖ + ‖D11‖)
OQ7Prescribed.bodyCurrent_incident_work : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
