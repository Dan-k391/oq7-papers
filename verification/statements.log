  ∫ (z : OQ7Prescribed.Position),
      OQ7Prescribed.newtonCurrentCorrelation p φ j z *
        ((OQ7Prescribed.dyadicRemainder k z) (OQ7Prescribed.basisC j)).ofLp i =
    (∫ (z : OQ7Prescribed.Position),
        OQ7Prescribed.newtonCurrentCorrelation p φ j z * OQ7Prescribed.dynamicHessianRemainder k i j z) +
      if j = i then k ^ 2 • (OQ7Prescribed.potentialComponentDistribution k p i) φ else 0
