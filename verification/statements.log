OQ7Prescribed.bodyField_memLp : ∀ (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field),
  OQ7Prescribed.LocallySquareIntegrable E → MeasureTheory.MemLp (B.domain.indicator E) 2 MeasureTheory.volume
OQ7Prescribed.bodyFieldCurrent_coe : ∀ (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field)
  (hE : OQ7Prescribed.LocallySquareIntegrable E),
  ↑↑↑(OQ7Prescribed.bodyFieldCurrent B E hE) =ᵐ[MeasureTheory.volume] B.domain.indicator E
OQ7Prescribed.bodyIncident_memLp : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction),
  MeasureTheory.MemLp (B.domain.indicator (OQ7Prescribed.incidentElectric k σ)) 2 MeasureTheory.volume
OQ7Prescribed.bodyIncidentCurrent_coe : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction),
  ↑↑↑(OQ7Prescribed.bodyIncidentCurrent k B σ) =ᵐ[MeasureTheory.volume]
    B.domain.indicator (OQ7Prescribed.incidentElectric k σ)
OQ7Prescribed.bodyInverseSusceptibility_coe : ∀ (B : OQ7Prescribed.TwoLayerBody)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.bodyInverseSusceptibility B a b) f) =ᵐ[MeasureTheory.volume] fun x =>
    if x.ofLp 2 < B.absorberThickness then a.inverse.symm (↑↑↑f x) else b.inverse.symm (↑↑↑f x)
OQ7Prescribed.bodyInverseSusceptibility_negative_imaginary_bound : ∀ (B : OQ7Prescribed.TwoLayerBody)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.materialBodyCoercivity B a b * ‖f‖ ^ 2 ≤
    -(inner ℂ f ((OQ7Prescribed.bodyInverseSusceptibility B a b) f)).im
OQ7Prescribed.bodyOutgoingOperator_coe : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  ↑↑↑((OQ7Prescribed.bodyOutgoingOperator k B) f) =ᵐ[MeasureTheory.volume]
    B.domain.indicator (OQ7Prescribed.electricVolumeField k (OQ7Prescribed.bodyCurrentPolarization B f))
OQ7Prescribed.bodyOutgoingOperator_im_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
      0 ≤ (inner ℂ f ((OQ7Prescribed.bodyOutgoingOperator k B) f)).im
OQ7Prescribed.bodyOutgoingOperator_inner : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  inner ℂ f ((OQ7Prescribed.bodyOutgoingOperator k B) f) =
    inner ℂ ((OQ7Prescribed.bodyCurrentInclusion B) f)
      ((OQ7Prescribed.compactOutgoingOperator k (OQ7Prescribed.bodySupportRadius B) ⋯)
        ((OQ7Prescribed.bodyCurrentInclusion B) f))
OQ7Prescribed.bodySupportRadius_nonneg : ∀ (B : OQ7Prescribed.TwoLayerBody), 0 ≤ OQ7Prescribed.bodySupportRadius B
OQ7Prescribed.bodyVolumeTotalElectricCurrent_eq : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.bodyFieldCurrent B (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f))
      ⋯ =
    OQ7Prescribed.bodyIncidentCurrent k B σ + (OQ7Prescribed.bodyOutgoingOperator k B) f
OQ7Prescribed.classicalDyadic_coordinate : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (i j : Fin 3),
      ((OQ7Prescribed.classicalDyadic k x) (OQ7Prescribed.basisC j)).ofLp i =
        (if i = j then ↑(k ^ 2) * OQ7Prescribed.outgoingGreen k x else 0) +
          lineDeriv ℝ (fun y => lineDeriv ℝ (OQ7Prescribed.outgoingGreen k) y (OQ7Prescribed.basisR j)) x
            (OQ7Prescribed.basisR i)
OQ7Prescribed.classicalDyadic_measurable : ∀ (k : ℝ), Measurable (OQ7Prescribed.classicalDyadic k)
OQ7Prescribed.classicalDyadic_norm_le_far : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  1 ≤ ‖x‖ →
    ∀ (v : OQ7Prescribed.Vector), ‖(OQ7Prescribed.classicalDyadic k x) v‖ ≤ OQ7Prescribed.exteriorKernelBound k * ‖v‖
OQ7Prescribed.classicalDyadic_test_integrable_of_zero : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  φ 0 = 0 →
    ∀ (i j : Fin 3),
      MeasureTheory.Integrable (fun x => ↑(φ x) * ((OQ7Prescribed.classicalDyadic k x) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume
OQ7Prescribed.classicalDyadic_zero_coordinate : ∀ (x : OQ7Prescribed.Position) (i j : Fin 3),
  ((OQ7Prescribed.classicalDyadic 0 x) (OQ7Prescribed.basisC j)).ofLp i = ↑(OQ7Prescribed.newtonHessianKernel i j x)
OQ7Prescribed.compact_scalar_weight_integrable : ∀ (ψ : OQ7Prescribed.Position → ℝ),
  Continuous ψ →
    HasCompactSupport ψ →
      ∀ (f : OQ7Prescribed.Position → ℂ),
        Continuous f → MeasureTheory.Integrable (fun x => ↑(ψ x) * f x) MeasureTheory.volume
OQ7Prescribed.compactCurrent_outgoingOperator_coe : ∀ (k R : ℝ) (hR : 0 ≤ R) (p : OQ7Prescribed.CompactPolarization)
  (hpR : p.radius ≤ R),
  ↑↑↑((OQ7Prescribed.compactOutgoingOperator k R hR) (p.toSupportedLp R hpR)) =ᵐ[MeasureTheory.volume]
    (Metric.closedBall 0 R).indicator (OQ7Prescribed.electricVolumeField k p)
OQ7Prescribed.compactCurrent_outgoingOperator_im_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (p : OQ7Prescribed.CompactPolarization),
      0 ≤
        (inner ℂ (p.toSupportedLp (p.radius + 2) ⋯)
            ((OQ7Prescribed.compactOutgoingOperator k (p.radius + 2) ⋯) (p.toSupportedLp (p.radius + 2) ⋯))).im
OQ7Prescribed.compactCurrent_outgoingOperator_im_nonneg_of_smooth : ∀ (k : ℝ),
  0 < k →
    ∀ (R : ℝ) (hR : 0 ≤ R) (p : OQ7Prescribed.CompactPolarization) (hpR : p.radius ≤ R),
      ContDiff ℝ (↑⊤) p.current →
        0 ≤
          (inner ℂ (p.toSupportedLp R hpR) ((OQ7Prescribed.compactOutgoingOperator k R hR) (p.toSupportedLp R hpR))).im
OQ7Prescribed.compactCurrent_outgoingOperator_inner : ∀ (k R : ℝ) (hR : 0 ≤ R) (p : OQ7Prescribed.CompactPolarization)
  (hpR : p.radius ≤ R),
  inner ℂ (p.toSupportedLp R hpR) ((OQ7Prescribed.compactOutgoingOperator k R hR) (p.toSupportedLp R hpR)) =
    ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.electricVolumeField k p x)
OQ7Prescribed.compactField_bilinear_integrable : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (ψ : OQ7Prescribed.Field),
      Continuous ψ →
        HasCompactSupport ψ →
          MeasureTheory.Integrable (fun x => OQ7Prescribed.bilinear (F x) (ψ x)) MeasureTheory.volume
OQ7Prescribed.compactField_curl_hasCompactSupport : ∀ (φ : OQ7Prescribed.Field),
  HasCompactSupport φ → HasCompactSupport (OQ7Prescribed.curl φ)
OQ7Prescribed.compactOutgoingOperator_apply_norm_le : ∀ (k R : ℝ) (hR : 0 ≤ R)
  (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ‖(OQ7Prescribed.compactOutgoingOperator k R hR) f‖ ≤ (1 + OQ7Prescribed.compactRemainderConstant k R) * ‖f‖
OQ7Prescribed.compactOutgoingOperator_coe : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ↑↑↑((OQ7Prescribed.compactOutgoingOperator k R hR) f) =ᵐ[MeasureTheory.volume]
    (Metric.closedBall 0 R).indicator fun x =>
      ↑↑(OQ7Prescribed.staticFourierOperator ↑f) x +
        OQ7Prescribed.remainderPotential k (OQ7Prescribed.supportedPolarization R hR f) x
OQ7Prescribed.compactOutgoingOperator_im_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
      0 ≤ (inner ℂ f ((OQ7Prescribed.compactOutgoingOperator k R hR) f)).im
OQ7Prescribed.compactOutgoingOperator_norm_le : ∀ (k R : ℝ) (hR : 0 ≤ R),
  ‖OQ7Prescribed.compactOutgoingOperator k R hR‖ ≤ 1 + OQ7Prescribed.compactRemainderConstant k R
OQ7Prescribed.compactOutgoingOperator_physical_distribution : ∀ (k R : ℝ) (hR : 0 ≤ R)
  (f : ↥(OQ7Prescribed.SupportedVectorL2 R)) (i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  Function.support ⇑φ ⊆ Metric.closedBall 0 R →
    (OQ7Prescribed.vectorL2ComponentDistribution (↑((OQ7Prescribed.compactOutgoingOperator k R hR) f)) i) φ =
      (OQ7Prescribed.outgoingVolumeDistribution k (OQ7Prescribed.supportedPolarization R hR f) i) φ
OQ7Prescribed.compactOutgoingOperator_test_pairing : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R))
  (φ : OQ7Prescribed.ScalarTest),
  Function.support ⇑φ ⊆ Metric.closedBall 0 R →
    ∫ (x : OQ7Prescribed.Position), φ x • ↑↑↑((OQ7Prescribed.compactOutgoingOperator k R hR) f) x =
      (∫ (x : OQ7Prescribed.Position), φ x • ↑↑(OQ7Prescribed.staticFourierOperator ↑f) x) +
        ∫ (x : OQ7Prescribed.Position),
          φ x • OQ7Prescribed.remainderPotential k (OQ7Prescribed.supportedPolarization R hR f) x
OQ7Prescribed.compactPolarization_current_hasCompactSupport : ∀ (p : OQ7Prescribed.CompactPolarization),
  HasCompactSupport p.current
OQ7Prescribed.compactPolarization_current_integrable : ∀ (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.Integrable p.current MeasureTheory.volume
OQ7Prescribed.compactPolarization_smooth_approximation : ∀ (p : OQ7Prescribed.CompactPolarization) (ε : ℝ),
  0 < ε →
    ∃ q,
      q.radius = p.radius + 2 ∧
        ContDiff ℝ (↑⊤) q.current ∧ ‖MeasureTheory.MemLp.toLp p.current ⋯ - MeasureTheory.MemLp.toLp q.current ⋯‖ ≤ ε
OQ7Prescribed.compactPolarization_smooth_function_approximation : ∀ (p : OQ7Prescribed.CompactPolarization) (ε : ℝ),
  0 < ε →
    ∃ f,
      ContDiff ℝ (↑⊤) f ∧
        HasCompactSupport f ∧
          (∀ (x : OQ7Prescribed.Position), p.radius + 2 < ‖x‖ → f x = 0) ∧
            MeasureTheory.eLpNorm (p.current - f) 2 MeasureTheory.volume ≤ ENNReal.ofReal ε
OQ7Prescribed.compactRemainderConstant_nonneg : ∀ (k R : ℝ), 0 ≤ OQ7Prescribed.compactRemainderConstant k R
OQ7Prescribed.compactRemainderField_memLp : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  MeasureTheory.MemLp (OQ7Prescribed.compactRemainderField k R hR f) 2 MeasureTheory.volume
OQ7Prescribed.compactRemainderLp_add : ∀ (k R : ℝ) (hR : 0 ≤ R) (f g : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  OQ7Prescribed.compactRemainderLp k R hR (f + g) =
    OQ7Prescribed.compactRemainderLp k R hR f + OQ7Prescribed.compactRemainderLp k R hR g
OQ7Prescribed.compactRemainderLp_coe : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ↑↑(OQ7Prescribed.compactRemainderLp k R hR f) =ᵐ[MeasureTheory.volume] OQ7Prescribed.compactRemainderField k R hR f
OQ7Prescribed.compactRemainderLp_norm_le : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ‖OQ7Prescribed.compactRemainderLp k R hR f‖ ≤ OQ7Prescribed.compactRemainderConstant k R * ‖f‖
OQ7Prescribed.compactRemainderLp_smul : ∀ (k R : ℝ) (hR : 0 ≤ R) (z : ℂ) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  OQ7Prescribed.compactRemainderLp k R hR (z • f) = z • OQ7Prescribed.compactRemainderLp k R hR f
OQ7Prescribed.compactRemainderLp_supported : ∀ (k R : ℝ) (hR : 0 ≤ R) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  OQ7Prescribed.compactRemainderLp k R hR f ∈ OQ7Prescribed.supportedVectorL2 R
OQ7Prescribed.compactRemainderOperator_norm_le : ∀ (k R : ℝ) (hR : 0 ≤ R),
  ‖OQ7Prescribed.compactRemainderOperator k R hR‖ ≤ OQ7Prescribed.compactRemainderConstant k R
OQ7Prescribed.compactRestrictionCLM_norm_le : ∀ (R : ℝ), ‖OQ7Prescribed.compactRestrictionCLM R‖ ≤ 1
OQ7Prescribed.compactRestrictionLp_add : ∀ (R : ℝ) (f g : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.compactRestrictionLp R (f + g) =
    OQ7Prescribed.compactRestrictionLp R f + OQ7Prescribed.compactRestrictionLp R g
OQ7Prescribed.compactRestrictionLp_coe : ∀ (R : ℝ) (f : ↥OQ7Prescribed.VectorL2),
  ↑↑(OQ7Prescribed.compactRestrictionLp R f) =ᵐ[MeasureTheory.volume] (Metric.closedBall 0 R).indicator fun x => ↑↑f x
OQ7Prescribed.compactRestrictionLp_eq_self_iff_supported : ∀ (R : ℝ) (f : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.compactRestrictionLp R f = f ↔ f ∈ OQ7Prescribed.supportedVectorL2 R
OQ7Prescribed.compactRestrictionLp_norm_le : ∀ (R : ℝ) (f : ↥OQ7Prescribed.VectorL2),
  ‖OQ7Prescribed.compactRestrictionLp R f‖ ≤ ‖f‖
OQ7Prescribed.compactRestrictionLp_smul : ∀ (R : ℝ) (z : ℂ) (f : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.compactRestrictionLp R (z • f) = z • OQ7Prescribed.compactRestrictionLp R f
OQ7Prescribed.compactRestrictionLp_supported : ∀ (R : ℝ) (f : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.compactRestrictionLp R f ∈ OQ7Prescribed.supportedVectorL2 R
OQ7Prescribed.compactStaticOperator_apply_norm_le : ∀ (R : ℝ) (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ‖(OQ7Prescribed.compactStaticOperator R) f‖ ≤ ‖f‖
OQ7Prescribed.compactTest_component_integrable : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i : Fin 3) (ψ : OQ7Prescribed.Position → ℂ),
      Continuous ψ → HasCompactSupport ψ → MeasureTheory.Integrable (fun x => ψ x * (F x).ofLp i) MeasureTheory.volume
@OQ7Prescribed.complex_imaginary_coercive_bijective : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] (A : H →L[ℂ] H) (c : ℝ),
  0 < c → (∀ (u : H), c * ‖u‖ ^ 2 ≤ (inner ℂ u (A u)).im) → Function.Bijective ⇑A
@OQ7Prescribed.complex_imaginary_coercive_norm_bound : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] (A : H →L[ℂ] H) (c : ℝ),
  0 < c → (∀ (u : H), c * ‖u‖ ^ 2 ≤ (inner ℂ u (A u)).im) → ∀ (u : H), c * ‖u‖ ≤ ‖A u‖
OQ7Prescribed.complexify_continuous : Continuous OQ7Prescribed.complexify
OQ7Prescribed.complexify_norm : ∀ (x : OQ7Prescribed.Position), ‖OQ7Prescribed.complexify x‖ = ‖x‖
OQ7Prescribed.complexify_norm_sq : ∀ (u : OQ7Prescribed.Position), ‖OQ7Prescribed.complexify u‖ ^ 2 = ‖u‖ ^ 2
OQ7Prescribed.complexify_sub : ∀ (x y : OQ7Prescribed.Position),
  OQ7Prescribed.complexify (x - y) = OQ7Prescribed.complexify x - OQ7Prescribed.complexify y
@OQ7Prescribed.complexImaginaryCoerciveEquiv_apply : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [inst_2 : CompleteSpace H] (A : H →L[ℂ] H) (c : ℝ) (hc : 0 < c)
  (hA : ∀ (u : H), c * ‖u‖ ^ 2 ≤ (inner ℂ u (A u)).im) (u : H),
  (OQ7Prescribed.complexImaginaryCoerciveEquiv A c hc hA) u = A u
@OQ7Prescribed.complexImaginaryCoerciveEquiv_inverse_imaginary_bound : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [inst_2 : CompleteSpace H] (A : H →L[ℂ] H) (c : ℝ) (hc : 0 < c)
  (hA : ∀ (u : H), c * ‖u‖ ^ 2 ≤ (inner ℂ u (A u)).im) (u : H),
  c / (‖A‖ + 1) ^ 2 * ‖u‖ ^ 2 ≤ -(inner ℂ u ((OQ7Prescribed.complexImaginaryCoerciveEquiv A c hc hA).symm u)).im
@OQ7Prescribed.complexImaginaryCoerciveEquiv_inverse_norm_le : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [inst_2 : CompleteSpace H] (A : H →L[ℂ] H) (c : ℝ) (hc : 0 < c)
  (hA : ∀ (u : H), c * ‖u‖ ^ 2 ≤ (inner ℂ u (A u)).im),
  ‖↑(OQ7Prescribed.complexImaginaryCoerciveEquiv A c hc hA).symm‖ ≤ 1 / c
OQ7Prescribed.complexRealTest_partial : ∀ (ψ : OQ7Prescribed.Position → ℂ) (hψ : ContDiff ℝ (↑⊤) ψ)
  (hs : HasCompactSupport ψ) (L : ℂ →L[ℝ] ℝ) (j : Fin 3) (x : OQ7Prescribed.Position),
  ((OQ7Prescribed.testPartial j) (OQ7Prescribed.complexRealTest ψ hψ hs L)) x =
    L ((fderiv ℝ ψ x) (OQ7Prescribed.basisR j))
OQ7Prescribed.complexTestEval_field : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i : Fin 3) (ψ : OQ7Prescribed.Position → ℂ) (hψ : ContDiff ℝ (↑⊤) ψ) (hs : HasCompactSupport ψ),
      OQ7Prescribed.complexTestEval (OQ7Prescribed.fieldComponentDistribution F i) ψ hψ hs =
        ∫ (x : OQ7Prescribed.Position), ψ x * (F x).ofLp i
OQ7Prescribed.complexTestEval_partial_field : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i j : Fin 3) (ψ : OQ7Prescribed.Position → ℂ) (hψ : ContDiff ℝ (↑⊤) ψ) (hs : HasCompactSupport ψ),
      OQ7Prescribed.complexTestEval
          ((OQ7Prescribed.distributionPartial j) (OQ7Prescribed.fieldComponentDistribution F i)) ψ hψ hs =
        -∫ (x : OQ7Prescribed.Position), (fderiv ℝ ψ x) (OQ7Prescribed.basisR j) * (F x).ofLp i
OQ7Prescribed.complexTestEval_sub : ∀ (S T : OQ7Prescribed.ScalarDistribution) (ψ : OQ7Prescribed.Position → ℂ)
  (hψ : ContDiff ℝ (↑⊤) ψ) (hs : HasCompactSupport ψ),
  OQ7Prescribed.complexTestEval (S - T) ψ hψ hs =
    OQ7Prescribed.complexTestEval S ψ hψ hs - OQ7Prescribed.complexTestEval T ψ hψ hs
OQ7Prescribed.contDiff_lineDeriv_continuous : ∀ (F : OQ7Prescribed.Position → ℝ),
  ContDiff ℝ 1 F → ∀ (i : Fin 3), Continuous fun x => lineDeriv ℝ F x (OQ7Prescribed.basisR i)
OQ7Prescribed.contDiff_test_ibp : ∀ (F : OQ7Prescribed.Position → ℝ),
  ContDiff ℝ 1 F →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
      ∫ (x : OQ7Prescribed.Position), F x * ((OQ7Prescribed.testPartial i) φ) x =
        -∫ (x : OQ7Prescribed.Position), lineDeriv ℝ F x (OQ7Prescribed.basisR i) * φ x
@OQ7Prescribed.continuousLinearEquiv_response_continuousAt : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] {X : Type u_2} [inst_3 : TopologicalSpace X] (e : X → H ≃L[ℂ] H)
  (s : X → H) (x : X) (M : ℝ),
  (∀ (a : X), ‖↑(e a).symm‖ ≤ M) →
    ContinuousAt (fun a => ↑(e a)) x → ContinuousAt s x → ContinuousAt (fun a => (e a).symm (s a)) x
@OQ7Prescribed.continuousLinearEquiv_response_difference_bound : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] (e f : H ≃L[ℂ] H) (s t : H),
  ‖e.symm s - f.symm t‖ ≤ ‖↑e.symm‖ * (‖s - t‖ + ‖↑e - ↑f‖ * ‖f.symm t‖)
@OQ7Prescribed.continuousLinearEquiv_solution_residual_bound : ∀ {H : Type u_1} [inst : NormedAddCommGroup H]
  [inst_1 : InnerProductSpace ℂ H] [CompleteSpace H] (e : H ≃L[ℂ] H) (s v : H), ‖e.symm s - v‖ ≤ ‖↑e.symm‖ * ‖s - e v‖
OQ7Prescribed.coordinateReflect_apply : ∀ (i j : Fin 3) (x : OQ7Prescribed.Position),
  ((OQ7Prescribed.coordinateReflect i) x).ofLp j = if j = i then -x.ofLp j else x.ofLp j
OQ7Prescribed.coordinateSwap_apply : ∀ (i j a : Fin 3) (x : OQ7Prescribed.Position),
  ((OQ7Prescribed.coordinateSwap i j) x).ofLp a = x.ofLp ((Equiv.swap i j) a)
OQ7Prescribed.cross_complexify_real_smul : ∀ (H : OQ7Prescribed.Vector) (n : OQ7Prescribed.Position) (r : ℝ),
  OQ7Prescribed.cross H (OQ7Prescribed.complexify (r • n)) = r • OQ7Prescribed.cross H (OQ7Prescribed.complexify n)
OQ7Prescribed.cross_cross : ∀ (a b c : OQ7Prescribed.Vector),
  OQ7Prescribed.cross (OQ7Prescribed.cross a b) c = OQ7Prescribed.bilinear a c • b - OQ7Prescribed.bilinear b c • a
OQ7Prescribed.cross_norm_le : ∀ (u v : OQ7Prescribed.Vector), ‖OQ7Prescribed.cross u v‖ ≤ ‖u‖ * ‖v‖
OQ7Prescribed.cross_squareNorm_identity : ∀ (u v : OQ7Prescribed.Vector),
  OQ7Prescribed.squareNorm (OQ7Prescribed.cross u v) + Complex.normSq (OQ7Prescribed.pairing u v) =
    OQ7Prescribed.squareNorm u * OQ7Prescribed.squareNorm v
OQ7Prescribed.cross_sub_right : ∀ (u v w : OQ7Prescribed.Vector),
  OQ7Prescribed.cross u (v - w) = OQ7Prescribed.cross u v - OQ7Prescribed.cross u w
OQ7Prescribed.crossRightMap_apply : ∀ (n v : OQ7Prescribed.Vector),
  (OQ7Prescribed.crossRightMap n) v = OQ7Prescribed.cross v n
OQ7Prescribed.curl_real_smul : ∀ (ψ : OQ7Prescribed.Position → ℝ) (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) ψ →
    ContDiff ℝ (↑⊤) F →
      ∀ (x : OQ7Prescribed.Position),
        OQ7Prescribed.curl (fun y => ψ y • F y) x =
          OQ7Prescribed.cross (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)) (F x) +
            ψ x • OQ7Prescribed.curl F x
OQ7Prescribed.curl_vectorConjugate : ∀ (F : OQ7Prescribed.Field),
  ContDiff ℝ (↑⊤) F →
    (OQ7Prescribed.curl fun x => OQ7Prescribed.vectorConjugate (F x)) = fun x =>
      OQ7Prescribed.vectorConjugate (OQ7Prescribed.curl F x)
OQ7Prescribed.current_component_fourier : ∀ (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (ξ : OQ7Prescribed.Position),
  FourierTransform.fourier (fun y => (p.current y).ofLp j) ξ = (FourierTransform.fourier p.current ξ).ofLp j
OQ7Prescribed.current_component_integrable : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  MeasureTheory.Integrable (fun y => (p.current y).ofLp i) MeasureTheory.volume
OQ7Prescribed.currentCorrelation_green_distribution_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3),
  (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.currentCorrelationRealTest Complex.reCLM p φ j) +
      Complex.I *
        (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.currentCorrelationRealTest Complex.imCLM p φ j) =
    (OQ7Prescribed.potentialComponentDistribution k p j) φ
OQ7Prescribed.currentCorrelation_green_first_ibp : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  ∫ (z : OQ7Prescribed.Position),
      OQ7Prescribed.newtonCurrentCorrelation p ((OQ7Prescribed.testPartial j) φ) i z * OQ7Prescribed.outgoingGreen k z =
    -∫ (z : OQ7Prescribed.Position),
        OQ7Prescribed.newtonCurrentCorrelation p φ i z * OQ7Prescribed.outgoingGradient k j z
OQ7Prescribed.currentCorrelation_greenHessian_distribution_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  (OQ7Prescribed.greenHessian k i j) (OQ7Prescribed.currentCorrelationRealTest Complex.reCLM p φ j) +
      Complex.I * (OQ7Prescribed.greenHessian k i j) (OQ7Prescribed.currentCorrelationRealTest Complex.imCLM p φ j) =
    (OQ7Prescribed.potentialComponentDistribution k p j)
      ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ))
OQ7Prescribed.currentCorrelation_kernel_integrable : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3) {f : OQ7Prescribed.Position → ℂ},
  MeasureTheory.LocallyIntegrable f MeasureTheory.volume →
    MeasureTheory.Integrable (fun z => OQ7Prescribed.newtonCurrentCorrelation p φ j z * f z) MeasureTheory.volume
OQ7Prescribed.currentCorrelation_pairing_re_im : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3) {f : OQ7Prescribed.Position → ℂ},
  MeasureTheory.LocallyIntegrable f MeasureTheory.volume →
    ∫ (z : OQ7Prescribed.Position), OQ7Prescribed.newtonCurrentCorrelation p φ j z * f z =
      (∫ (z : OQ7Prescribed.Position), (OQ7Prescribed.currentCorrelationRealTest Complex.reCLM p φ j) z • f z) +
        Complex.I *
          ∫ (z : OQ7Prescribed.Position), (OQ7Prescribed.currentCorrelationRealTest Complex.imCLM p φ j) z • f z
OQ7Prescribed.currentCorrelation_zero_eq_current_test_integral : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  OQ7Prescribed.newtonCurrentCorrelation p φ i 0 = ∫ (x : OQ7Prescribed.Position), φ x • (p.current x).ofLp i
OQ7Prescribed.currentCorrelation_zero_of_exterior_test : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius → φ x = 0) →
    ∀ (i : Fin 3), OQ7Prescribed.newtonCurrentCorrelation p φ i 0 = 0
OQ7Prescribed.currentCorrelationRealTest_apply : ∀ (L : ℂ →L[ℝ] ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3) (z : OQ7Prescribed.Position),
  (OQ7Prescribed.currentCorrelationRealTest L p φ j) z = L (OQ7Prescribed.newtonCurrentCorrelation p φ j z)
OQ7Prescribed.currentCorrelationRealTest_partial : ∀ (L : ℂ →L[ℝ] ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j i : Fin 3),
  (OQ7Prescribed.testPartial i) (OQ7Prescribed.currentCorrelationRealTest L p φ j) =
    OQ7Prescribed.currentCorrelationRealTest L p ((OQ7Prescribed.testPartial i) φ) j
OQ7Prescribed.currentDyadicTestPairing_eq : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  OQ7Prescribed.currentDyadicTestPairing k p φ i j =
    (if i = j then k ^ 2 • (OQ7Prescribed.potentialComponentDistribution k p j) φ else 0) +
      (OQ7Prescribed.potentialComponentDistribution k p j)
        ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ))
OQ7Prescribed.currentDyadicTestPairing_exterior_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius → φ x = 0) →
    ∀ (i j : Fin 3),
      MeasureTheory.Integrable
        (fun z =>
          OQ7Prescribed.newtonCurrentCorrelation p φ j z *
            ((OQ7Prescribed.classicalDyadic k z) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume
OQ7Prescribed.currentDyadicTestPairing_exterior_integral : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius → φ x = 0) →
    ∀ (i j : Fin 3),
      OQ7Prescribed.currentDyadicTestPairing k p φ i j =
        ∫ (z : OQ7Prescribed.Position),
          OQ7Prescribed.newtonCurrentCorrelation p φ j z *
            ((OQ7Prescribed.classicalDyadic k z) (OQ7Prescribed.basisC j)).ofLp i
OQ7Prescribed.currentTestCorrelationVector_coordinate : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (z : OQ7Prescribed.Position) (i : Fin 3),
  (OQ7Prescribed.currentTestCorrelationVector p φ z).ofLp i = OQ7Prescribed.newtonCurrentCorrelation p φ i z
OQ7Prescribed.currentTestCorrelationVector_integrable : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (z : OQ7Prescribed.Position),
  MeasureTheory.Integrable (fun y => ↑(φ (z + y)) • p.current y) MeasureTheory.volume
OQ7Prescribed.cutoff_curl_pairing_real : ∀ (ψ : OQ7Prescribed.Position → ℝ) (E H : OQ7Prescribed.Field) (k : ℝ),
  ContDiff ℝ (↑⊤) ψ →
    ContDiff ℝ (↑⊤) E →
      (OQ7Prescribed.curl E = fun x => (Complex.I * ↑k) • H x) →
        ∀ (x : OQ7Prescribed.Position),
          (OQ7Prescribed.bilinear (H x)
                (OQ7Prescribed.curl (fun y => ψ y • OQ7Prescribed.vectorConjugate (E y)) x)).re =
            (OQ7Prescribed.pairing (E x)
                (OQ7Prescribed.cross (H x) (OQ7Prescribed.complexify (OQ7Prescribed.scalarGradient ψ x)))).re
OQ7Prescribed.cutoff_source_pairing_real : ∀ (ψ : OQ7Prescribed.Position → ℝ) (E H p : OQ7Prescribed.Field) (k : ℝ),
  (OQ7Prescribed.curl H = fun x => (-Complex.I * ↑k) • (E x + p x)) →
    ∀ (x : OQ7Prescribed.Position),
      (OQ7Prescribed.bilinear (OQ7Prescribed.curl H x) (ψ x • OQ7Prescribed.vectorConjugate (E x))).re =
        -k * (↑(ψ x) * OQ7Prescribed.pairing (p x) (E x)).im
OQ7Prescribed.cutoffDyadicRemainder_eLpNorm_le : ∀ (k T : ℝ),
  MeasureTheory.eLpNorm (OQ7Prescribed.cutoffDyadicRemainder k T) 2 MeasureTheory.volume ≤
    ENNReal.ofReal (OQ7Prescribed.dyadicRemainderCutoffConstant k T) *
      MeasureTheory.eLpNorm (OQ7Prescribed.cutoffGreen 0 T) 2 MeasureTheory.volume
OQ7Prescribed.cutoffDyadicRemainder_integrable : ∀ (k T : ℝ),
  MeasureTheory.Integrable (OQ7Prescribed.cutoffDyadicRemainder k T) MeasureTheory.volume
OQ7Prescribed.cutoffDyadicRemainder_memLp : ∀ (k T : ℝ),
  MeasureTheory.MemLp (OQ7Prescribed.cutoffDyadicRemainder k T) 2 MeasureTheory.volume
OQ7Prescribed.cutoffDyadicRemainder_norm_le : ∀ (k T : ℝ) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.cutoffDyadicRemainder k T x‖ ≤
    OQ7Prescribed.dyadicRemainderCutoffConstant k T * ‖OQ7Prescribed.cutoffGreen 0 T x‖
OQ7Prescribed.cutoffGreen_integrable : ∀ (k T : ℝ),
  MeasureTheory.Integrable (OQ7Prescribed.cutoffGreen k T) MeasureTheory.volume
OQ7Prescribed.cutoffGreen_memLp : ∀ (k T : ℝ),
  MeasureTheory.MemLp (OQ7Prescribed.cutoffGreen k T) 2 MeasureTheory.volume
OQ7Prescribed.cutoffOutgoingGradient_integrable : ∀ (k R : ℝ) (j : Fin 3),
  MeasureTheory.Integrable (OQ7Prescribed.cutoffOutgoingGradient k R j) MeasureTheory.volume
OQ7Prescribed.displaced_kernel_radiation_norm_le : ∀ (k R : ℝ),
  0 ≤ R →
    ∀ (x y : OQ7Prescribed.Position),
      2 * R + 2 ≤ ‖x‖ →
        ‖y‖ ≤ R →
          ∀ (v : OQ7Prescribed.Vector),
            ‖OQ7Prescribed.cross (OQ7Prescribed.kernelMagnetic k (x - y) v)
                    (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)) -
                  (OQ7Prescribed.classicalDyadic k (x - y)) v‖ ≤
              OQ7Prescribed.radiationKernelConstant k R / ‖x‖ ^ 2 * ‖v‖
OQ7Prescribed.displaced_kernelMagnetic_norm_decay : ∀ (k R : ℝ),
  0 ≤ R →
    ∀ (x y : OQ7Prescribed.Position),
      2 * R + 2 ≤ ‖x‖ →
        ‖y‖ ≤ R →
          ∀ (v : OQ7Prescribed.Vector),
            ‖OQ7Prescribed.kernelMagnetic k (x - y) v‖ ≤ OQ7Prescribed.magneticDecayConstant k / ‖x‖ * ‖v‖
OQ7Prescribed.distributionCurl_add : ∀ (U V : OQ7Prescribed.CartesianDistribution),
  OQ7Prescribed.distributionCurl (U + V) = OQ7Prescribed.distributionCurl U + OQ7Prescribed.distributionCurl V
OQ7Prescribed.distributionCurl_complex_smul : ∀ (a : ℂ) (U : OQ7Prescribed.CartesianDistribution),
  OQ7Prescribed.distributionCurl (a • U) = a • OQ7Prescribed.distributionCurl U
OQ7Prescribed.distributionCurl_eq_implies_hasWeakCurl : ∀ (F G : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    MeasureTheory.LocallyIntegrable G MeasureTheory.volume →
      OQ7Prescribed.distributionCurl (OQ7Prescribed.fieldComponentDistribution F) =
          OQ7Prescribed.fieldComponentDistribution G →
        OQ7Prescribed.HasWeakCurl F G
OQ7Prescribed.distributionCurl_gradient : ∀ (T : OQ7Prescribed.ScalarDistribution),
  (OQ7Prescribed.distributionCurl fun i => (OQ7Prescribed.distributionPartial i) T) = 0
OQ7Prescribed.distributionCurl_real_smul : ∀ (a : ℝ) (U : OQ7Prescribed.CartesianDistribution),
  OQ7Prescribed.distributionCurl (a • U) = a • OQ7Prescribed.distributionCurl U
OQ7Prescribed.distributionCurlCurl : ∀ (U : OQ7Prescribed.CartesianDistribution) (i : Fin 3),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.distributionCurl U) i =
    (OQ7Prescribed.distributionPartial i) (OQ7Prescribed.distributionDivergence U) -
      OQ7Prescribed.distributionLaplacian (U i)
OQ7Prescribed.distributionPartial_commute : ∀ (T : OQ7Prescribed.ScalarDistribution) (i j : Fin 3),
  (OQ7Prescribed.distributionPartial i) ((OQ7Prescribed.distributionPartial j) T) =
    (OQ7Prescribed.distributionPartial j) ((OQ7Prescribed.distributionPartial i) T)
OQ7Prescribed.distributionPartial_complex_smul : ∀ (a : ℂ) (T : OQ7Prescribed.ScalarDistribution) (i : Fin 3),
  (OQ7Prescribed.distributionPartial i) (a • T) = a • (OQ7Prescribed.distributionPartial i) T
OQ7Prescribed.domain_compact_closure : ∀ (B : OQ7Prescribed.TwoLayerBody), IsCompact (closure B.domain)
OQ7Prescribed.domain_subset_closedBall : ∀ (B : OQ7Prescribed.TwoLayerBody),
  B.domain ⊆ Metric.closedBall 0 (B.aperture + B.absorberThickness + B.plateThickness)
OQ7Prescribed.dyadicGreenDistribution_apply : ∀ (k : ℝ) (i j : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.dyadicGreenDistribution k i j) φ =
    (if i = j then k ^ 2 • ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingGreen k x else 0) +
      ∫ (x : OQ7Prescribed.Position),
        ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x • OQ7Prescribed.outgoingGreen k x
OQ7Prescribed.dyadicGreenDistribution_apply_of_zero : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  φ 0 = 0 →
    ∀ (i j : Fin 3),
      (OQ7Prescribed.dyadicGreenDistribution k i j) φ =
        ∫ (x : OQ7Prescribed.Position), ↑(φ x) * ((OQ7Prescribed.classicalDyadic k x) (OQ7Prescribed.basisC j)).ofLp i
OQ7Prescribed.dyadicGreenDistribution_eq_static_add_remainder : ∀ (k : ℝ) (i j : Fin 3),
  OQ7Prescribed.dyadicGreenDistribution k i j =
    OQ7Prescribed.greenHessian 0 i j +
      Distribution.ofFun ⊤ (fun x => ((OQ7Prescribed.dyadicRemainder k x) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume ⊤
OQ7Prescribed.dyadicRemainder_cancel : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  OQ7Prescribed.dyadicRemainder k x =
    (↑(k ^ 2) * Complex.exp (Complex.I * ↑k * ↑‖x‖) / (↑(4 * Real.pi) * ↑‖x‖) +
          (Complex.exp (Complex.I * ↑k * ↑‖x‖) * (Complex.I * ↑k * ↑‖x‖ - 1) + 1) / (↑(4 * Real.pi) * ↑‖x‖ ^ 3)) •
        ContinuousLinearMap.id ℂ OQ7Prescribed.Vector +
      ((Complex.exp (Complex.I * ↑k * ↑‖x‖) * ((Complex.I * ↑k * ↑‖x‖) ^ 2 - 3 * (Complex.I * ↑k * ↑‖x‖) + 3) - 3) /
          (↑(4 * Real.pi) * ↑‖x‖ ^ 5)) •
        ((InnerProductSpace.rankOne ℂ) (OQ7Prescribed.complexify x)) (OQ7Prescribed.complexify x)
OQ7Prescribed.dyadicRemainder_current_entry_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  ∫ (z : OQ7Prescribed.Position),
      OQ7Prescribed.newtonCurrentCorrelation p φ j z *
        ((OQ7Prescribed.dyadicRemainder k z) (OQ7Prescribed.basisC j)).ofLp i =
    (∫ (z : OQ7Prescribed.Position),
        OQ7Prescribed.newtonCurrentCorrelation p φ j z * OQ7Prescribed.dynamicHessianRemainder k i j z) +
      if j = i then k ^ 2 • (OQ7Prescribed.potentialComponentDistribution k p i) φ else 0
OQ7Prescribed.dyadicRemainder_measurable : ∀ (k : ℝ), Measurable (OQ7Prescribed.dyadicRemainder k)
OQ7Prescribed.dyadicRemainder_memLp_on_compact : ∀ (k : ℝ) (K : Set OQ7Prescribed.Position),
  IsCompact K → MeasureTheory.MemLp (OQ7Prescribed.dyadicRemainder k) 2 (MeasureTheory.volume.restrict K)
OQ7Prescribed.dyadicRemainder_norm_le : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.dyadicRemainder k x‖ ≤
    k ^ 2 / (4 * Real.pi) * OQ7Prescribed.greenCancellationEnvelope (|k| * ‖x‖) * ‖x‖⁻¹
OQ7Prescribed.dyadicRemainder_norm_le_on_ball : ∀ (k R : ℝ) (x : OQ7Prescribed.Position),
  ‖x‖ ≤ R →
    ‖OQ7Prescribed.dyadicRemainder k x‖ ≤
      k ^ 2 / (4 * Real.pi) * OQ7Prescribed.greenCancellationEnvelope (|k| * R) * ‖x‖⁻¹
OQ7Prescribed.dyadicRemainderEntry_locallyIntegrable : ∀ (k : ℝ) (i j : Fin 3),
  MeasureTheory.LocallyIntegrable (fun x => ((OQ7Prescribed.dyadicRemainder k x) (OQ7Prescribed.basisC j)).ofLp i)
    MeasureTheory.volume
OQ7Prescribed.dynamicGradientBound_nonneg : ∀ (k R : ℝ), 0 ≤ R → 0 ≤ OQ7Prescribed.dynamicGradientBound k R
OQ7Prescribed.dynamicGradientRemainder_contDiffAt : ∀ (k : ℝ) (j : Fin 3) (x : OQ7Prescribed.Position),
  x ≠ 0 → ContDiffAt ℝ 1 (OQ7Prescribed.dynamicGradientRemainder k j) x
OQ7Prescribed.dynamicGradientRemainder_hasLineDerivAt : ∀ (k : ℝ) (i j : Fin 3) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    HasLineDerivAt ℝ (OQ7Prescribed.dynamicGradientRemainder k j) (OQ7Prescribed.dynamicHessianRemainder k i j x) x
      (OQ7Prescribed.basisR i)
OQ7Prescribed.dynamicGradientRemainder_locallyIntegrable : ∀ (k : ℝ) (j : Fin 3),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.dynamicGradientRemainder k j) MeasureTheory.volume
OQ7Prescribed.dynamicGradientRemainder_measurable : ∀ (k : ℝ) (j : Fin 3),
  Measurable (OQ7Prescribed.dynamicGradientRemainder k j)
OQ7Prescribed.dynamicGradientRemainder_norm_le : ∀ (k : ℝ) (j : Fin 3) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.dynamicGradientRemainder k j x‖ ≤ OQ7Prescribed.dynamicGradientBound k ‖x‖
OQ7Prescribed.dynamicGradientRemainder_norm_le_on_ball : ∀ (k R : ℝ) (j : Fin 3) (x : OQ7Prescribed.Position),
  ‖x‖ ≤ R → ‖OQ7Prescribed.dynamicGradientRemainder k j x‖ ≤ OQ7Prescribed.dynamicGradientBound k R
OQ7Prescribed.dynamicGradientRemainder_test_ibp : ∀ (k : ℝ) (i j : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  ∫ (x : OQ7Prescribed.Position), ((OQ7Prescribed.testPartial i) φ) x • OQ7Prescribed.dynamicGradientRemainder k j x =
    -∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.dynamicHessianRemainder k i j x
OQ7Prescribed.dynamicHessianRemainder_eq_radial : ∀ (k : ℝ) (i j : Fin 3) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    OQ7Prescribed.dynamicHessianRemainder k i j x =
      (x.ofLp i * x.ofLp j / ‖x‖ ^ 2) •
          (OQ7Prescribed.outgoingRadialSecond k ‖x‖ - OQ7Prescribed.outgoingRadialSecond 0 ‖x‖) +
        ((if i = j then 1 else 0) / ‖x‖ - x.ofLp i * x.ofLp j / ‖x‖ ^ 3) •
          (OQ7Prescribed.outgoingRadialFirst k ‖x‖ - OQ7Prescribed.outgoingRadialFirst 0 ‖x‖)
OQ7Prescribed.dynamicHessianRemainder_locallyIntegrable : ∀ (k : ℝ) (i j : Fin 3),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.dynamicHessianRemainder k i j) MeasureTheory.volume
OQ7Prescribed.dynamicHessianRemainder_memLp_on_compact : ∀ (k : ℝ) (i j : Fin 3) (K : Set OQ7Prescribed.Position),
  IsCompact K → MeasureTheory.MemLp (OQ7Prescribed.dynamicHessianRemainder k i j) 2 (MeasureTheory.volume.restrict K)
OQ7Prescribed.dynamicHessianRemainder_trace : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  ∑ i, OQ7Prescribed.dynamicHessianRemainder k i i x = -↑(k ^ 2) * OQ7Prescribed.outgoingGreen k x
OQ7Prescribed.dynamicHessianRemainder_trace_distribution : ∀ (k : ℝ),
  ∑ i, Distribution.ofFun ⊤ (OQ7Prescribed.dynamicHessianRemainder k i i) MeasureTheory.volume ⊤ =
    -k ^ 2 • OQ7Prescribed.outgoingGreenDistribution k
OQ7Prescribed.dynamicScalarBound_nonneg : ∀ (k R : ℝ), 0 ≤ R → 0 ≤ OQ7Prescribed.dynamicScalarBound k R
OQ7Prescribed.dynamicScalarRemainder_contDiffAt : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 → ContDiffAt ℝ 1 (OQ7Prescribed.dynamicScalarRemainder k) x
OQ7Prescribed.dynamicScalarRemainder_correlation_double_ibp : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (l i j : Fin 3),
  ∫ (z : OQ7Prescribed.Position),
      OQ7Prescribed.newtonCurrentCorrelation p ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) l z *
        OQ7Prescribed.dynamicScalarRemainder k z =
    ∫ (z : OQ7Prescribed.Position),
      OQ7Prescribed.newtonCurrentCorrelation p φ l z * OQ7Prescribed.dynamicHessianRemainder k i j z
OQ7Prescribed.dynamicScalarRemainder_double_ibp : ∀ (k : ℝ) (i j : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  ∫ (x : OQ7Prescribed.Position),
      ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x • OQ7Prescribed.dynamicScalarRemainder k x =
    ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.dynamicHessianRemainder k i j x
OQ7Prescribed.dynamicScalarRemainder_eq_cancel : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  OQ7Prescribed.dynamicScalarRemainder k x = (Complex.exp (Complex.I * ↑k * ↑‖x‖) - 1) / (↑(4 * Real.pi) * ↑‖x‖)
OQ7Prescribed.dynamicScalarRemainder_hasLineDerivAt : ∀ (k : ℝ) (j : Fin 3) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    HasLineDerivAt ℝ (OQ7Prescribed.dynamicScalarRemainder k) (OQ7Prescribed.dynamicGradientRemainder k j x) x
      (OQ7Prescribed.basisR j)
OQ7Prescribed.dynamicScalarRemainder_locallyIntegrable : ∀ (k : ℝ),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.dynamicScalarRemainder k) MeasureTheory.volume
OQ7Prescribed.dynamicScalarRemainder_norm_le : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.dynamicScalarRemainder k x‖ ≤ OQ7Prescribed.dynamicScalarBound k ‖x‖
OQ7Prescribed.dynamicScalarRemainder_norm_le_on_ball : ∀ (k R : ℝ) (x : OQ7Prescribed.Position),
  ‖x‖ ≤ R → ‖OQ7Prescribed.dynamicScalarRemainder k x‖ ≤ OQ7Prescribed.dynamicScalarBound k R
OQ7Prescribed.dynamicScalarRemainder_test_ibp : ∀ (k : ℝ) (j : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  ∫ (x : OQ7Prescribed.Position), ((OQ7Prescribed.testPartial j) φ) x • OQ7Prescribed.dynamicScalarRemainder k x =
    -∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.dynamicGradientRemainder k j x
OQ7Prescribed.electric_add_polarization : ∀ (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field)
  (x : OQ7Prescribed.Position),
  E x + OQ7Prescribed.polarization B E x = OQ7Prescribed.tensorApply (B.permittivity x) (E x)
OQ7Prescribed.electricExterior_component_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  Distribution.ofFun (OQ7Prescribed.currentExterior p) (fun x => (OQ7Prescribed.exteriorElectric k p x).ofLp i)
      MeasureTheory.volume ⊤ =
    Distribution.ofFun (OQ7Prescribed.currentExterior p) (fun x => (OQ7Prescribed.electricVolumeField k p x).ofLp i)
      MeasureTheory.volume ⊤
OQ7Prescribed.electricExterior_eq_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.exteriorElectric k p =ᵐ[MeasureTheory.volume.restrict ↑(OQ7Prescribed.currentExterior p)]
    OQ7Prescribed.electricVolumeField k p
OQ7Prescribed.electricVolumeField_component_locallyIntegrableOn : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  MeasureTheory.LocallyIntegrableOn (fun x => (OQ7Prescribed.electricVolumeField k p x).ofLp i)
    (↑(OQ7Prescribed.currentExterior p)) MeasureTheory.volume
OQ7Prescribed.electricVolumeField_congr_current : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  p.current =ᵐ[MeasureTheory.volume] q.current →
    OQ7Prescribed.electricVolumeField k p = OQ7Prescribed.electricVolumeField k q
OQ7Prescribed.electricVolumeField_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.electricVolumeField k p) i =
    OQ7Prescribed.outgoingVolumeDistribution k p i
OQ7Prescribed.electricVolumeField_locallySquareIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.electricVolumeField k p)
OQ7Prescribed.exp_remainder_two_norm : ∀ (z : ℂ), ‖Complex.exp z - 1 - z‖ ≤ ‖z‖ ^ 2 * Real.exp ‖z‖
OQ7Prescribed.exterior_current_component_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i j : Fin 3),
      ∫ (x : OQ7Prescribed.Position) (y : OQ7Prescribed.Position),
          ↑(φ x) * ((OQ7Prescribed.classicalDyadic k (x - y)) (OQ7Prescribed.basisC j)).ofLp i * (p.current y).ofLp j =
        ∫ (z : OQ7Prescribed.Position),
          OQ7Prescribed.newtonCurrentCorrelation p φ j z *
            ((OQ7Prescribed.classicalDyadic k z) (OQ7Prescribed.basisC j)).ofLp i
OQ7Prescribed.exterior_current_correlation_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i j : Fin 3),
      MeasureTheory.Integrable
        (fun q =>
          ↑(φ (q.1 + q.2)) * ((OQ7Prescribed.classicalDyadic k q.1) (OQ7Prescribed.basisC j)).ofLp i *
            (p.current q.2).ofLp j)
        (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.exterior_current_test_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i j : Fin 3),
      MeasureTheory.Integrable
        (fun q =>
          ↑(φ q.1) * ((OQ7Prescribed.classicalDyadic k (q.1 - q.2)) (OQ7Prescribed.basisC j)).ofLp i *
            (p.current q.2).ofLp j)
        (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.exterior_poynting_flux_lower_bound : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  2 * p.radius + 2 ≤ ‖x‖ →
    -((OQ7Prescribed.magneticDecayConstant k / ‖x‖ * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖) *
          (OQ7Prescribed.radiationKernelConstant k p.radius / ‖x‖ ^ 2 *
            ∫ (y : OQ7Prescribed.Position), ‖p.current y‖)) ≤
      (OQ7Prescribed.pairing (OQ7Prescribed.exteriorElectric k p x)
          (OQ7Prescribed.cross (OQ7Prescribed.exteriorMagnetic k p x)
            (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)))).re
OQ7Prescribed.exterior_radiation_integral_norm_le : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  2 * p.radius + 2 ≤ ‖x‖ →
    ‖OQ7Prescribed.cross (OQ7Prescribed.exteriorMagnetic k p x)
            (OQ7Prescribed.complexify (OQ7Prescribed.radialDirection x)) -
          OQ7Prescribed.exteriorElectric k p x‖ ≤
      OQ7Prescribed.radiationKernelConstant k p.radius / ‖x‖ ^ 2 * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖
OQ7Prescribed.exteriorCurrentFields_outgoing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.Outgoing (OQ7Prescribed.exteriorElectric k p) (OQ7Prescribed.exteriorMagnetic k p)
OQ7Prescribed.exteriorCutoff_contDiff : ∀ (r t : ℝ), 0 < r → 0 < t → ContDiff ℝ 1 (OQ7Prescribed.exteriorCutoff r t)
OQ7Prescribed.exteriorCutoff_contDiff_smooth : ∀ (r t : ℝ),
  0 < r → 0 < t → ContDiff ℝ (↑⊤) (OQ7Prescribed.exteriorCutoff r t)
OQ7Prescribed.exteriorCutoff_gradient_ibp : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
        ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonGradient j x *
              ((OQ7Prescribed.testPartial i) φ) x =
          -∫ (x : OQ7Prescribed.Position),
              (OQ7Prescribed.exteriorCutoffPartial r t i x * OQ7Prescribed.newtonGradient j x +
                  OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonHessianKernel i j x) *
                φ x
OQ7Prescribed.exteriorCutoff_hasLineDerivAt : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (i : Fin 3) (x : OQ7Prescribed.Position),
        HasLineDerivAt ℝ (OQ7Prescribed.exteriorCutoff r t) (OQ7Prescribed.exteriorCutoffPartial r t i x) x
          (OQ7Prescribed.basisR i)
OQ7Prescribed.exteriorCutoff_integral_tendsto : ∀ (r : ℝ) (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume →
    MeasureTheory.IntegrableOn f {x | r < ‖x‖} MeasureTheory.volume →
      Filter.Tendsto (fun t => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoff r t x * f x)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (∫ (x : OQ7Prescribed.Position) in {x | r < ‖x‖}, f x))
OQ7Prescribed.exteriorCutoff_le_one : ∀ (r t : ℝ) (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoff r t x ≤ 1
OQ7Prescribed.exteriorCutoff_mul_contDiff : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (F : OQ7Prescribed.Position → ℝ),
        (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 F x) →
          ContDiff ℝ 1 fun x => OQ7Prescribed.exteriorCutoff r t x * F x
OQ7Prescribed.exteriorCutoff_mul_lineDeriv : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (F F' : OQ7Prescribed.Position → ℝ) (i : Fin 3),
        (∀ (x : OQ7Prescribed.Position), x ≠ 0 → HasLineDerivAt ℝ F (F' x) x (OQ7Prescribed.basisR i)) →
          ∀ (x : OQ7Prescribed.Position),
            lineDeriv ℝ (fun y => OQ7Prescribed.exteriorCutoff r t y * F y) x (OQ7Prescribed.basisR i) =
              OQ7Prescribed.exteriorCutoffPartial r t i x * F x + OQ7Prescribed.exteriorCutoff r t x * F' x
OQ7Prescribed.exteriorCutoff_newton_ibp : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (φ : OQ7Prescribed.ScalarTest) (j : Fin 3),
        ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonReal x * ((OQ7Prescribed.testPartial j) φ) x =
          -∫ (x : OQ7Prescribed.Position),
              (OQ7Prescribed.exteriorCutoffPartial r t j x * OQ7Prescribed.newtonReal x +
                  OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonGradient j x) *
                φ x
OQ7Prescribed.exteriorCutoff_nonneg : ∀ (r t : ℝ) (x : OQ7Prescribed.Position), 0 ≤ OQ7Prescribed.exteriorCutoff r t x
@OQ7Prescribed.exteriorCutoff_one : ∀ {r t : ℝ},
  0 < t → ∀ (x : OQ7Prescribed.Position), r + t ≤ ‖x‖ → OQ7Prescribed.exteriorCutoff r t x = 1
OQ7Prescribed.exteriorCutoff_tendsto : ∀ (r : ℝ) (x : OQ7Prescribed.Position),
  Filter.Tendsto (fun t => OQ7Prescribed.exteriorCutoff r t x) (nhdsWithin 0 (Set.Ioi 0))
    (nhds (if r < ‖x‖ then 1 else 0))
@OQ7Prescribed.exteriorCutoff_zero : ∀ {r t : ℝ},
  0 < t → ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ r → OQ7Prescribed.exteriorCutoff r t x = 0
OQ7Prescribed.exteriorCutoffPartial_mul_continuous : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (i : Fin 3) (F : OQ7Prescribed.Position → ℝ),
        (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContinuousAt F x) →
          Continuous fun x => OQ7Prescribed.exteriorCutoffPartial r t i x * F x
OQ7Prescribed.exteriorCutoffPartial_mul_integrable : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (i : Fin 3) (F : OQ7Prescribed.Position → ℝ),
        (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContinuousAt F x) →
          MeasureTheory.Integrable (fun x => OQ7Prescribed.exteriorCutoffPartial r t i x * F x) MeasureTheory.volume
OQ7Prescribed.exteriorCutoffPartial_norm_le : ∀ (r t M : ℝ),
  0 < t →
    0 ≤ M →
      (∀ (s : ℝ), ‖OQ7Prescribed.transitionDerivative s‖ ≤ M) →
        ∀ (i : Fin 3) (x : OQ7Prescribed.Position), ‖OQ7Prescribed.exteriorCutoffPartial r t i x‖ ≤ M / t
OQ7Prescribed.exteriorCutoffPartial_zero_inner : ∀ (r t : ℝ),
  0 < t → ∀ (i : Fin 3) (x : OQ7Prescribed.Position), ‖x‖ ≤ r → OQ7Prescribed.exteriorCutoffPartial r t i x = 0
OQ7Prescribed.exteriorCutoffPartial_zero_outer : ∀ (r t : ℝ),
  0 < t → ∀ (i : Fin 3) (x : OQ7Prescribed.Position), r + t ≤ ‖x‖ → OQ7Prescribed.exteriorCutoffPartial r t i x = 0
OQ7Prescribed.exteriorElectric_aestronglyMeasurable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.AEStronglyMeasurable (OQ7Prescribed.exteriorElectric k p) MeasureTheory.volume
OQ7Prescribed.exteriorElectric_component_locallyIntegrableOn : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  MeasureTheory.LocallyIntegrableOn (fun x => (OQ7Prescribed.exteriorElectric k p x).ofLp i)
    (↑(OQ7Prescribed.currentExterior p)) MeasureTheory.volume
OQ7Prescribed.exteriorElectric_integrable_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ →
    MeasureTheory.Integrable (fun y => (OQ7Prescribed.classicalDyadic k (x - y)) (p.current y)) MeasureTheory.volume
OQ7Prescribed.exteriorElectric_locallyIntegrableOn : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.LocallyIntegrableOn (OQ7Prescribed.exteriorElectric k p) (↑(OQ7Prescribed.currentExterior p))
    MeasureTheory.volume
OQ7Prescribed.exteriorElectric_norm_le : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ →
    ‖OQ7Prescribed.exteriorElectric k p x‖ ≤
      OQ7Prescribed.exteriorKernelBound k * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖
OQ7Prescribed.exteriorElectric_test_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i : Fin 3),
      MeasureTheory.Integrable (fun x => ↑(φ x) * (OQ7Prescribed.exteriorElectric k p x).ofLp i) MeasureTheory.volume
OQ7Prescribed.exteriorElectric_test_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i : Fin 3),
      ∫ (x : OQ7Prescribed.Position), ↑(φ x) * (OQ7Prescribed.exteriorElectric k p x).ofLp i =
        (OQ7Prescribed.outgoingVolumeDistribution k p i) φ
OQ7Prescribed.exteriorElectric_test_pointwise : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ p.radius + 1 → φ x = 0) →
    ∀ (i : Fin 3) (x : OQ7Prescribed.Position),
      ∑ j,
          ∫ (y : OQ7Prescribed.Position),
            ↑(φ x) * ((OQ7Prescribed.classicalDyadic k (x - y)) (OQ7Prescribed.basisC j)).ofLp i *
              (p.current y).ofLp j =
        ↑(φ x) * (OQ7Prescribed.exteriorElectric k p x).ofLp i
OQ7Prescribed.exteriorMagnetic_integrable_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ →
    MeasureTheory.Integrable (fun y => OQ7Prescribed.kernelMagnetic k (x - y) (p.current y)) MeasureTheory.volume
OQ7Prescribed.exteriorMagnetic_norm_decay : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  2 * p.radius + 2 ≤ ‖x‖ →
    ‖OQ7Prescribed.exteriorMagnetic k p x‖ ≤
      OQ7Prescribed.magneticDecayConstant k / ‖x‖ * ∫ (y : OQ7Prescribed.Position), ‖p.current y‖
OQ7Prescribed.fieldComponent_locallyIntegrable : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i : Fin 3), MeasureTheory.LocallyIntegrable (fun x => (F x).ofLp i) MeasureTheory.volume
OQ7Prescribed.fieldComponentDistribution_add : ∀ (F G : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    MeasureTheory.LocallyIntegrable G MeasureTheory.volume →
      ∀ (i : Fin 3),
        OQ7Prescribed.fieldComponentDistribution (fun x => F x + G x) i =
          OQ7Prescribed.fieldComponentDistribution F i + OQ7Prescribed.fieldComponentDistribution G i
OQ7Prescribed.fieldComponentDistribution_apply : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
      (OQ7Prescribed.fieldComponentDistribution F i) φ = ∫ (x : OQ7Prescribed.Position), ↑(φ x) * (F x).ofLp i
OQ7Prescribed.fieldComponentDistribution_complex_smul : ∀ (a : ℂ) (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i : Fin 3),
      OQ7Prescribed.fieldComponentDistribution (fun x => a • F x) i = a • OQ7Prescribed.fieldComponentDistribution F i
OQ7Prescribed.fieldComponentDistribution_injective : ∀ (F G : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    MeasureTheory.LocallyIntegrable G MeasureTheory.volume →
      OQ7Prescribed.fieldComponentDistribution F = OQ7Prescribed.fieldComponentDistribution G →
        F =ᵐ[MeasureTheory.volume] G
OQ7Prescribed.fieldComponentDistribution_smul : ∀ (z : ℂ) (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    OQ7Prescribed.fieldComponentDistribution (z • F) = z • OQ7Prescribed.fieldComponentDistribution F
OQ7Prescribed.fieldComponentDistribution_sub : ∀ (F G : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    MeasureTheory.LocallyIntegrable G MeasureTheory.volume →
      OQ7Prescribed.fieldComponentDistribution (F - G) =
        OQ7Prescribed.fieldComponentDistribution F - OQ7Prescribed.fieldComponentDistribution G
@OQ7Prescribed.fourierIntegral_L1L2_ae : ∀ {F : Type u_1} [inst : NormedAddCommGroup F] [inst_1 : InnerProductSpace ℂ F]
  [inst_2 : CompleteSpace F] {f : OQ7Prescribed.Position → F},
  MeasureTheory.MemLp f 1 MeasureTheory.volume →
    ∀ (hf2 : MeasureTheory.MemLp f 2 MeasureTheory.volume),
      FourierTransform.fourier f =ᵐ[MeasureTheory.volume]
        ↑↑((MeasureTheory.Lp.fourierTransformₗᵢ OQ7Prescribed.Position F) (MeasureTheory.MemLp.toLp f hf2))
@OQ7Prescribed.fourierIntegral_L1L2_memLp : ∀ {F : Type u_1} [inst : NormedAddCommGroup F]
  [inst_1 : InnerProductSpace ℂ F] [CompleteSpace F] {f : OQ7Prescribed.Position → F},
  MeasureTheory.MemLp f 1 MeasureTheory.volume →
    MeasureTheory.MemLp f 2 MeasureTheory.volume →
      MeasureTheory.MemLp (FourierTransform.fourier f) 2 MeasureTheory.volume
@OQ7Prescribed.fourierIntegral_L1L2_schwartz_pairing : ∀ {F : Type u_1} [inst : NormedAddCommGroup F]
  [inst_1 : InnerProductSpace ℂ F] [inst_2 : CompleteSpace F] {f : OQ7Prescribed.Position → F},
  MeasureTheory.MemLp f 1 MeasureTheory.volume →
    ∀ (hf2 : MeasureTheory.MemLp f 2 MeasureTheory.volume) (φ : SchwartzMap OQ7Prescribed.Position ℂ),
      ∫ (ξ : OQ7Prescribed.Position), φ ξ • FourierTransform.fourier f ξ =
        ∫ (ξ : OQ7Prescribed.Position),
          φ ξ • ↑↑((MeasureTheory.Lp.fourierTransformₗᵢ OQ7Prescribed.Position F) (MeasureTheory.MemLp.toLp f hf2)) ξ
OQ7Prescribed.gradient_current_correlation_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (j : Fin 3) (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ (q.1 + q.2)) * OQ7Prescribed.outgoingGradient k j q.1 * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.gradient_current_pairing_integrand_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3) (S : ℝ),
  (∀ (x : OQ7Prescribed.Position), φ x ≠ 0 → ‖x‖ ≤ S) →
    ∀ (x y : OQ7Prescribed.Position),
      ↑(φ x) * OQ7Prescribed.outgoingGradient k j (x - y) * (p.current y).ofLp i =
        ↑(φ x) * OQ7Prescribed.cutoffOutgoingGradient k (S + p.radius) j (x - y) * (p.current y).ofLp i
OQ7Prescribed.gradient_current_test_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ q.1) * OQ7Prescribed.outgoingGradient k j (q.1 - q.2) * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.gradientPotential_ae_integrable_on_compact : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (K : Set OQ7Prescribed.Position),
  IsCompact K →
    ∀ᵐ (x : OQ7Prescribed.Position) ∂MeasureTheory.volume.restrict K,
      MeasureTheory.Integrable (fun y => OQ7Prescribed.outgoingGradient k j (x - y) • p.current y) MeasureTheory.volume
OQ7Prescribed.gradientPotential_component_integral_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j i : Fin 3)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ →
    (OQ7Prescribed.gradientPotential k p j x).ofLp i =
      ∫ (y : OQ7Prescribed.Position), OQ7Prescribed.outgoingGradient k j (x - y) * (p.current y).ofLp i
OQ7Prescribed.gradientPotential_eq_cutoff : ∀ (k S : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (x : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    OQ7Prescribed.gradientPotential k p j x =
      OQ7Prescribed.scalarVectorConvolution (OQ7Prescribed.cutoffOutgoingGradient k (S + p.radius) j) p.current x
OQ7Prescribed.gradientPotential_integrable_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ →
    MeasureTheory.Integrable (fun y => OQ7Prescribed.outgoingGradient k j (x - y) • p.current y) MeasureTheory.volume
OQ7Prescribed.gradientPotential_integrand_cutoff : ∀ (k S : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (x y : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    OQ7Prescribed.outgoingGradient k j (x - y) • p.current y =
      OQ7Prescribed.cutoffOutgoingGradient k (S + p.radius) j (x - y) • p.current y
OQ7Prescribed.gradientPotential_locallyIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.gradientPotential k p j) MeasureTheory.volume
OQ7Prescribed.gradientPotential_memLp_on_compact : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j : Fin 3)
  (K : Set OQ7Prescribed.Position),
  IsCompact K → MeasureTheory.MemLp (OQ7Prescribed.gradientPotential k p j) 2 (MeasureTheory.volume.restrict K)
OQ7Prescribed.gradientPotentialComponentDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (j i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.gradientPotentialComponentDistribution k p j i) φ =
    ∫ (x : OQ7Prescribed.Position), ↑(φ x) * (OQ7Prescribed.gradientPotential k p j x).ofLp i
OQ7Prescribed.gradientPotentialComponentDistribution_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (j i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.gradientPotentialComponentDistribution k p j i) φ =
    ∫ (z : OQ7Prescribed.Position),
      OQ7Prescribed.outgoingGradient k j z * OQ7Prescribed.newtonCurrentCorrelation p φ i z
OQ7Prescribed.green_first_cancel_norm : ∀ (z : ℂ),
  ‖Complex.exp z * (z - 1) + 1‖ ≤ ‖z‖ ^ 2 * (1 + (‖z‖ + 1) * Real.exp ‖z‖)
OQ7Prescribed.green_second_cancel_norm : ∀ (z : ℂ),
  ‖Complex.exp z * (z ^ 2 - 3 * z + 3) - 3‖ ≤ ‖z‖ ^ 2 * (‖z‖ + 2 + (‖z‖ ^ 2 + 3 * ‖z‖ + 3) * Real.exp ‖z‖)
OQ7Prescribed.green_second_poly_norm : ∀ (z : ℂ), ‖z ^ 2 - 3 * z + 3‖ ≤ ‖z‖ ^ 2 + 3 * ‖z‖ + 3
OQ7Prescribed.greenCancellationEnvelope_mono : ∀ (s t : ℝ),
  0 ≤ s → s ≤ t → OQ7Prescribed.greenCancellationEnvelope s ≤ OQ7Prescribed.greenCancellationEnvelope t
OQ7Prescribed.greenCancellationEnvelope_nonneg : ∀ (s : ℝ), 0 ≤ s → 0 ≤ OQ7Prescribed.greenCancellationEnvelope s
OQ7Prescribed.greenHessian_apply : ∀ (k : ℝ) (i j : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.greenHessian k i j) φ =
    (OQ7Prescribed.outgoingGreenDistribution k) ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ))
OQ7Prescribed.greenHessian_eq_static_add_dynamic : ∀ (k : ℝ) (i j : Fin 3),
  OQ7Prescribed.greenHessian k i j =
    OQ7Prescribed.greenHessian 0 i j +
      Distribution.ofFun ⊤ (OQ7Prescribed.dynamicHessianRemainder k i j) MeasureTheory.volume ⊤
@OQ7Prescribed.HasWeakCurl.add_fields : ∀ {F1 F2 G1 G2 : OQ7Prescribed.Field},
  OQ7Prescribed.HasWeakCurl F1 G1 →
    OQ7Prescribed.HasWeakCurl F2 G2 →
      MeasureTheory.LocallyIntegrable F1 MeasureTheory.volume →
        MeasureTheory.LocallyIntegrable F2 MeasureTheory.volume →
          MeasureTheory.LocallyIntegrable G1 MeasureTheory.volume →
            MeasureTheory.LocallyIntegrable G2 MeasureTheory.volume →
              OQ7Prescribed.HasWeakCurl (fun x => F1 x + F2 x) fun x => G1 x + G2 x
@OQ7Prescribed.HasWeakCurl.congr_ae : ∀ {F G F' G' : OQ7Prescribed.Field},
  OQ7Prescribed.HasWeakCurl F G →
    F =ᵐ[MeasureTheory.volume] F' → G =ᵐ[MeasureTheory.volume] G' → OQ7Prescribed.HasWeakCurl F' G'
OQ7Prescribed.HasWeakCurl.implies_analyticTestWeakCurl : ∀ (F G : OQ7Prescribed.Field),
  OQ7Prescribed.HasWeakCurl F G → OQ7Prescribed.AnalyticTestWeakCurl F G
OQ7Prescribed.incident_absorber_coupling : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.axisCoupling (OQ7Prescribed.basisR 0) (OQ7Prescribed.incidentElectric k σ x) = 0
OQ7Prescribed.incident_plate_coupling : ∀ (θ k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.axisCoupling (OQ7Prescribed.rotatedAxis θ) (OQ7Prescribed.incidentElectric k σ x) =
    ↑(Real.sin θ) * OQ7Prescribed.planePhase k σ x
OQ7Prescribed.incident_plate_rankOne : ∀ (θ k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.tensorApply (OQ7Prescribed.rankOne (OQ7Prescribed.rotatedAxis θ))
      (OQ7Prescribed.incidentElectric k σ x) =
    (↑(Real.sin θ) * OQ7Prescribed.planePhase k σ x) • OQ7Prescribed.complexify (OQ7Prescribed.rotatedAxis θ)
OQ7Prescribed.incident_plate_rankOne_zero_angle : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.tensorApply (OQ7Prescribed.rankOne (OQ7Prescribed.rotatedAxis 0))
      (OQ7Prescribed.incidentElectric k σ x) =
    0
OQ7Prescribed.incidentElectric_contDiff : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  ContDiff ℝ (↑⊤) (OQ7Prescribed.incidentElectric k σ)
OQ7Prescribed.incidentElectric_curl : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.curl (OQ7Prescribed.incidentElectric k σ) x = (Complex.I * ↑k) • OQ7Prescribed.incidentMagnetic k σ x
OQ7Prescribed.incidentElectric_first_weakCurl : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.incidentElectric k σ) fun x =>
    (Complex.I * ↑k) • OQ7Prescribed.incidentMagnetic k σ x
OQ7Prescribed.incidentElectric_locallySquareIntegrable : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.incidentElectric k σ)
OQ7Prescribed.incidentElectric_minus_conjugate : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  OQ7Prescribed.incidentElectric k OQ7Prescribed.Direction.minus x =
    WithLp.toLp 2 fun i => star ((OQ7Prescribed.incidentElectric k OQ7Prescribed.Direction.plus x).ofLp i)
OQ7Prescribed.incidentElectric_squareNorm : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.squareNorm (OQ7Prescribed.incidentElectric k σ x) = 1
OQ7Prescribed.incidentMagnetic_contDiff : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  ContDiff ℝ (↑⊤) (OQ7Prescribed.incidentMagnetic k σ)
OQ7Prescribed.incidentMagnetic_curl : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.curl (OQ7Prescribed.incidentMagnetic k σ) x = (-Complex.I * ↑k) • OQ7Prescribed.incidentElectric k σ x
OQ7Prescribed.incidentMagnetic_eq : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.incidentMagnetic k σ = fun x => (-↑σ.sign * OQ7Prescribed.planePhase k σ x) • OQ7Prescribed.basisC 0
OQ7Prescribed.incidentMagnetic_locallySquareIntegrable : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.incidentMagnetic k σ)
OQ7Prescribed.incidentMagnetic_second_weakCurl : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.incidentMagnetic k σ) fun x =>
    (-Complex.I * ↑k) • OQ7Prescribed.incidentElectric k σ x
@OQ7Prescribed.indicatorL2_add : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α) (s : Set α)
  (hs : MeasurableSet s) (f g : ↥(MeasureTheory.Lp E 2 μ)),
  OQ7Prescribed.indicatorL2 μ s hs (f + g) = OQ7Prescribed.indicatorL2 μ s hs f + OQ7Prescribed.indicatorL2 μ s hs g
@OQ7Prescribed.indicatorL2_coe : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α) (s : Set α)
  (hs : MeasurableSet s) (f : ↥(MeasureTheory.Lp E 2 μ)),
  ↑↑(OQ7Prescribed.indicatorL2 μ s hs f) =ᵐ[μ] s.indicator fun x => ↑↑f x
@OQ7Prescribed.indicatorL2_eq_self_iff : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α)
  (s : Set α) (hs : MeasurableSet s) (f : ↥(MeasureTheory.Lp E 2 μ)),
  OQ7Prescribed.indicatorL2 μ s hs f = f ↔ f ∈ OQ7Prescribed.setSupportedL2 μ s
@OQ7Prescribed.indicatorL2_norm_le : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α) (s : Set α)
  (hs : MeasurableSet s) (f : ↥(MeasureTheory.Lp E 2 μ)), ‖OQ7Prescribed.indicatorL2 μ s hs f‖ ≤ ‖f‖
@OQ7Prescribed.indicatorL2_smul : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α)
  (s : Set α) (hs : MeasurableSet s) (z : ℂ) (f : ↥(MeasureTheory.Lp E 2 μ)),
  OQ7Prescribed.indicatorL2 μ s hs (z • f) = z • OQ7Prescribed.indicatorL2 μ s hs f
@OQ7Prescribed.indicatorL2_supported : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α)
  (s : Set α) (hs : MeasurableSet s) (f : ↥(MeasureTheory.Lp E 2 μ)),
  OQ7Prescribed.indicatorL2 μ s hs f ∈ OQ7Prescribed.setSupportedL2 μ s
OQ7Prescribed.integrable_polar_actual : ∀ (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable f MeasureTheory.volume →
    MeasureTheory.Integrable (fun p => f (↑p.2 • ↑p.1))
      (OQ7Prescribed.sphereArea.prod (MeasureTheory.Measure.volumeIoiPow 2))
OQ7Prescribed.integral_compact_ball_lower_bound : ∀ (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable f MeasureTheory.volume →
    ∀ (r C : ℝ),
      0 < r →
        (∀ (x : OQ7Prescribed.Position), 2 * r < ‖x‖ → f x = 0) →
          (∀ᵐ (x : OQ7Prescribed.Position), -(C / r ^ 4) ≤ f x) →
            -(32 * Real.pi / 3 * C / r) ≤ ∫ (x : OQ7Prescribed.Position), f x
OQ7Prescribed.integral_polar_actual : ∀ (f : OQ7Prescribed.Position → ℝ),
  ∫ (x : OQ7Prescribed.Position), f x =
    ∫ (p : ↑OQ7Prescribed.UnitSphere × ↑(Set.Ioi 0)),
      f (↑p.2 • ↑p.1) ∂OQ7Prescribed.sphereArea.prod (MeasureTheory.Measure.volumeIoiPow 2)
OQ7Prescribed.integral_polar_iterated_actual : ∀ (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable f MeasureTheory.volume →
    ∫ (x : OQ7Prescribed.Position), f x =
      ∫ (s : ℝ) in Set.Ioi 0, s ^ 2 * ∫ (n : ↑OQ7Prescribed.UnitSphere), f (s • ↑n) ∂OQ7Prescribed.sphereArea
OQ7Prescribed.integral_three_sub : ∀ (a b c d e f : OQ7Prescribed.Position → ℂ),
  MeasureTheory.Integrable a MeasureTheory.volume →
    MeasureTheory.Integrable b MeasureTheory.volume →
      MeasureTheory.Integrable c MeasureTheory.volume →
        MeasureTheory.Integrable d MeasureTheory.volume →
          MeasureTheory.Integrable e MeasureTheory.volume →
            MeasureTheory.Integrable f MeasureTheory.volume →
              ∫ (x : OQ7Prescribed.Position), a x - b x + (c x - d x) + (e x - f x) =
                ((∫ (x : OQ7Prescribed.Position), a x) - ∫ (x : OQ7Prescribed.Position), b x) +
                    ((∫ (x : OQ7Prescribed.Position), c x) - ∫ (x : OQ7Prescribed.Position), d x) +
                  ((∫ (x : OQ7Prescribed.Position), e x) - ∫ (x : OQ7Prescribed.Position), f x)
OQ7Prescribed.kernel_radiation_defect : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (v : OQ7Prescribed.Vector),
      OQ7Prescribed.cross (OQ7Prescribed.kernelMagnetic k x v) (OQ7Prescribed.complexify (‖x‖⁻¹ • x)) -
          (OQ7Prescribed.classicalDyadic k x) v =
        (OQ7Prescribed.outgoingRadial k ‖x‖ / ↑‖x‖ ^ 2) • v +
          ((2 * Complex.I * ↑k * ↑‖x‖ - 3) * OQ7Prescribed.outgoingRadial k ‖x‖ / ↑‖x‖ ^ 4) •
            OQ7Prescribed.bilinear (OQ7Prescribed.complexify x) v • OQ7Prescribed.complexify x
OQ7Prescribed.kernel_radiation_defect_norm_le : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (v : OQ7Prescribed.Vector),
      ‖OQ7Prescribed.cross (OQ7Prescribed.kernelMagnetic k x v) (OQ7Prescribed.complexify (‖x‖⁻¹ • x)) -
            (OQ7Prescribed.classicalDyadic k x) v‖ ≤
        (2 * |k| / (4 * Real.pi * ‖x‖ ^ 2) + 1 / (Real.pi * ‖x‖ ^ 3)) * ‖v‖
OQ7Prescribed.kernelMagnetic_gradient : ∀ (k : ℝ) (x : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.kernelMagnetic k x v =
    (-Complex.I * ↑k) •
      !₂[OQ7Prescribed.outgoingGradient k 1 x * v.ofLp 2 - OQ7Prescribed.outgoingGradient k 2 x * v.ofLp 1,
        OQ7Prescribed.outgoingGradient k 2 x * v.ofLp 0 - OQ7Prescribed.outgoingGradient k 0 x * v.ofLp 2,
        OQ7Prescribed.outgoingGradient k 0 x * v.ofLp 1 - OQ7Prescribed.outgoingGradient k 1 x * v.ofLp 0]
OQ7Prescribed.kernelMagnetic_norm_decay : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  1 ≤ ‖x‖ →
    ∀ (v : OQ7Prescribed.Vector), ‖OQ7Prescribed.kernelMagnetic k x v‖ ≤ |k| * (|k| + 1) / (4 * Real.pi) / ‖x‖ * ‖v‖
OQ7Prescribed.kernelMagnetic_norm_le : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (v : OQ7Prescribed.Vector),
      ‖OQ7Prescribed.kernelMagnetic k x v‖ ≤ |k| * (|k| * ‖x‖ + 1) / (4 * Real.pi * ‖x‖ ^ 2) * ‖v‖
OQ7Prescribed.kernelMagnetic_norm_le_far : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  1 ≤ ‖x‖ → ∀ (v : OQ7Prescribed.Vector), ‖OQ7Prescribed.kernelMagnetic k x v‖ ≤ |k| * (|k| + 1) / (4 * Real.pi) * ‖v‖
OQ7Prescribed.layerPermittivity_admissible : ∀ (P Q a b ν : ℝ) (u : OQ7Prescribed.Position),
  ‖u‖ ^ 2 = 1 →
    0 ≤ a →
      1 + a ≤ P →
        0 ≤ b → 0 < ν → b + ν ≤ Q → OQ7Prescribed.MaterialAdmissible P Q (OQ7Prescribed.layerPermittivity a b ν u)
OQ7Prescribed.layerPermittivity_reciprocal : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position),
  Matrix.transpose (OQ7Prescribed.layerPermittivity a b ν u) = OQ7Prescribed.layerPermittivity a b ν u
OQ7Prescribed.locallySquareIntegrable_locallyIntegrable : ∀ (F : OQ7Prescribed.Field),
  OQ7Prescribed.LocallySquareIntegrable F → MeasureTheory.LocallyIntegrable F MeasureTheory.volume
OQ7Prescribed.magneticExterior_eq_pointwise_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ → OQ7Prescribed.exteriorMagnetic k p x = OQ7Prescribed.magneticVolumeField k p x
OQ7Prescribed.magneticVolumeField_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.magneticVolumeField k p) i =
    OQ7Prescribed.outgoingMagneticDistribution k p i
OQ7Prescribed.magneticVolumeField_locallySquareIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.magneticVolumeField k p)
OQ7Prescribed.materialBodyCoercivity_pos : ∀ (B : OQ7Prescribed.TwoLayerBody)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity), 0 < OQ7Prescribed.materialBodyCoercivity B a b
OQ7Prescribed.materialBodyEquiv_apply : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  (OQ7Prescribed.materialBodyEquiv k hk B a b) f = (OQ7Prescribed.materialBodyOperator k B a b) f
OQ7Prescribed.materialBodyEquiv_inverse_norm_le : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity),
  ‖↑(OQ7Prescribed.materialBodyEquiv k hk B a b).symm‖ ≤ 1 / min a.loss b.loss
OQ7Prescribed.materialBodyOperator_imaginary_coercive : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody) (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
      (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
      OQ7Prescribed.materialBodyCoercivity B a b * ‖f‖ ^ 2 ≤
        (inner ℂ f ((OQ7Prescribed.materialBodyOperator k B a b) f)).im
OQ7Prescribed.materialBodySolution_equation : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity),
  (OQ7Prescribed.materialBodyOperator k B a b) (OQ7Prescribed.materialBodySolution k hk B σ a b) =
    -OQ7Prescribed.bodyIncidentCurrent k B σ
OQ7Prescribed.materialBodySolution_physicalVolumeEquation : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity),
  OQ7Prescribed.MaterialVolumeEquation k B σ
    (OQ7Prescribed.bodyCurrentPolarization B (OQ7Prescribed.materialBodySolution k hk B σ a b))
OQ7Prescribed.materialVolumeCurrent_coe : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
  (p : OQ7Prescribed.CompactPolarization) (hp : OQ7Prescribed.MaterialVolumeEquation k B σ p),
  ↑↑↑(OQ7Prescribed.materialVolumeCurrent k B σ p hp) =ᵐ[MeasureTheory.volume] p.current
OQ7Prescribed.materialVolumeCurrent_eq_solution : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (p : OQ7Prescribed.CompactPolarization)
  (hp : OQ7Prescribed.MaterialVolumeEquation k B σ p)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity),
  OQ7Prescribed.materialVolumeCurrent k B σ p hp = OQ7Prescribed.materialBodySolution k hk B σ a b
OQ7Prescribed.materialVolumeCurrent_operator_equation : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (p : OQ7Prescribed.CompactPolarization)
  (hp : OQ7Prescribed.MaterialVolumeEquation k B σ p)
  (a : OQ7Prescribed.SusceptibilityInverseData B.absorberPermittivity)
  (b : OQ7Prescribed.SusceptibilityInverseData B.platePermittivity),
  (OQ7Prescribed.materialBodyOperator k B a b) (OQ7Prescribed.materialVolumeCurrent k B σ p hp) =
    -OQ7Prescribed.bodyIncidentCurrent k B σ
OQ7Prescribed.materialVolumeCurrent_supported : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
  (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.MaterialVolumeEquation k B σ p → ∀ᵐ (x : OQ7Prescribed.Position), x ∉ B.domain → p.current x = 0
OQ7Prescribed.materialVolumeEquation_exists : ∀ (k : ℝ),
  0 < k →
    ∀ (P Q : ℝ) (B : OQ7Prescribed.TwoLayerBody),
      B.admissible P Q → ∀ (σ : OQ7Prescribed.Direction), ∃ p, OQ7Prescribed.MaterialVolumeEquation k B σ p
OQ7Prescribed.materialVolumeEquation_unique_current : ∀ (k : ℝ),
  0 < k →
    ∀ (P Q : ℝ) (B : OQ7Prescribed.TwoLayerBody),
      B.admissible P Q →
        ∀ (σ : OQ7Prescribed.Direction) (p q : OQ7Prescribed.CompactPolarization),
          OQ7Prescribed.MaterialVolumeEquation k B σ p →
            OQ7Prescribed.MaterialVolumeEquation k B σ q → p.current =ᵐ[MeasureTheory.volume] q.current
OQ7Prescribed.newton_classical_hessian : ∀ (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (i j : Fin 3),
      lineDeriv ℝ (fun y => lineDeriv ℝ (OQ7Prescribed.outgoingGreen 0) y (OQ7Prescribed.basisR j)) x
          (OQ7Prescribed.basisR i) =
        ↑((3 * x.ofLp i * x.ofLp j - ‖x‖ ^ 2 * if i = j then 1 else 0) / (4 * Real.pi * ‖x‖ ^ 5))
OQ7Prescribed.newton_compensated_cutoff_tendsto : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  Filter.Tendsto (fun r => ∫ (x : OQ7Prescribed.Position) in {x | r < ‖x‖}, OQ7Prescribed.newtonCompensated φ i j x)
    (nhds 0) (nhds (OQ7Prescribed.newtonPVValue φ i j))
OQ7Prescribed.newton_contact_identity_real : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  ∫ (x : OQ7Prescribed.Position),
      OQ7Prescribed.newtonReal x * ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x =
    OQ7Prescribed.newtonPVValue φ i j - (if i = j then 1 else 0) / 3 * φ 0
OQ7Prescribed.newton_current_correlation_joint_integrable : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ (q.1 + q.2)) * OQ7Prescribed.outgoingGreen 0 q.1 * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.newton_current_correlation_pairing_integrable : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun z => OQ7Prescribed.outgoingGreen 0 z * OQ7Prescribed.newtonCurrentCorrelation p φ i z)
    MeasureTheory.volume
OQ7Prescribed.newton_current_pairing_integrand_cutoff : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3) (S : ℝ),
  (∀ (x : OQ7Prescribed.Position), φ x ≠ 0 → ‖x‖ ≤ S) →
    ∀ (x y : OQ7Prescribed.Position),
      ↑(φ x) * OQ7Prescribed.outgoingGreen 0 (x - y) * (p.current y).ofLp i =
        ↑(φ x) * OQ7Prescribed.cutoffGreen 0 (S + p.radius) (x - y) * (p.current y).ofLp i
OQ7Prescribed.newton_current_test_joint_integrable : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ q.1) * OQ7Prescribed.outgoingGreen 0 (q.1 - q.2) * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.newton_cutoff_contact_shell : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
        ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoffPartial r t i x * OQ7Prescribed.newtonGradient j x * φ x =
          -(4 * Real.pi)⁻¹ *
            ∫ (u : ℝ) in 0..1,
              OQ7Prescribed.transitionDerivative u *
                ∫ (n : ↑OQ7Prescribed.UnitSphere),
                  (↑n).ofLp i * (↑n).ofLp j * φ ((r + t * u) • ↑n) ∂OQ7Prescribed.sphereArea
OQ7Prescribed.newton_cutoff_contact_shell_tendsto : ∀ (r : ℝ),
  0 < r →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
      Filter.Tendsto
        (fun t =>
          ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoffPartial r t i x * OQ7Prescribed.newtonGradient j x * φ x)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (OQ7Prescribed.newtonContactBoundary φ i j r))
OQ7Prescribed.newton_cutoff_derivative_shell : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
        ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoffPartial r t j x * OQ7Prescribed.newtonReal x *
              ((OQ7Prescribed.testPartial i) φ) x =
          (4 * Real.pi)⁻¹ *
            ∫ (u : ℝ) in 0..1,
              OQ7Prescribed.transitionDerivative u *
                ((r + t * u) *
                  ∫ (n : ↑OQ7Prescribed.UnitSphere),
                    (↑n).ofLp j * ((OQ7Prescribed.testPartial i) φ) ((r + t * u) • ↑n) ∂OQ7Prescribed.sphereArea)
OQ7Prescribed.newton_cutoff_derivative_shell_tendsto : ∀ (r : ℝ),
  0 < r →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
      Filter.Tendsto
        (fun t =>
          ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoffPartial r t j x * OQ7Prescribed.newtonReal x *
              ((OQ7Prescribed.testPartial i) φ) x)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds (-OQ7Prescribed.newtonDerivativeBoundary φ i j r))
OQ7Prescribed.newton_cutoff_double_ibp : ∀ (r t : ℝ),
  0 < r →
    0 < t →
      ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
        ∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonReal x *
              ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x =
          ((∫ (x : OQ7Prescribed.Position),
                OQ7Prescribed.exteriorCutoff r t x * OQ7Prescribed.newtonHessianKernel i j x * φ x) +
              ∫ (x : OQ7Prescribed.Position),
                OQ7Prescribed.exteriorCutoffPartial r t i x * OQ7Prescribed.newtonGradient j x * φ x) -
            ∫ (x : OQ7Prescribed.Position),
              OQ7Prescribed.exteriorCutoffPartial r t j x * OQ7Prescribed.newtonReal x *
                ((OQ7Prescribed.testPartial i) φ) x
OQ7Prescribed.newton_frequency_heat_joint_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun p => φ p.1 * OQ7Prescribed.newtonFrequencyHeatKernel p.2 p.1)
    (MeasureTheory.volume.prod (MeasureTheory.volume.restrict (Set.Ioi 0)))
OQ7Prescribed.newton_frequency_heat_scalar_integrable : ∀ (ξ : OQ7Prescribed.Position),
  ξ ≠ 0 →
    MeasureTheory.IntegrableOn (fun t => Real.exp (-(4 * Real.pi ^ 2 * t * ‖ξ‖ ^ 2))) (Set.Ioi 0) MeasureTheory.volume
OQ7Prescribed.newton_frequency_heat_scalar_integral : ∀ (ξ : OQ7Prescribed.Position),
  ξ ≠ 0 → ∫ (t : ℝ) in Set.Ioi 0, Real.exp (-(4 * Real.pi ^ 2 * t * ‖ξ‖ ^ 2)) = (4 * Real.pi ^ 2 * ‖ξ‖ ^ 2)⁻¹
OQ7Prescribed.newton_frequency_heat_time_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ)
  (ξ : OQ7Prescribed.Position),
  ξ ≠ 0 →
    MeasureTheory.IntegrableOn (fun t => φ ξ * OQ7Prescribed.newtonFrequencyHeatKernel t ξ) (Set.Ioi 0)
      MeasureTheory.volume
OQ7Prescribed.newton_frequency_heat_time_integral : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ)
  (ξ : OQ7Prescribed.Position),
  ξ ≠ 0 →
    ∫ (t : ℝ) in Set.Ioi 0, φ ξ * OQ7Prescribed.newtonFrequencyHeatKernel t ξ =
      φ ξ * OQ7Prescribed.newtonFrequencyKernel ξ
OQ7Prescribed.newton_frequency_heat_time_norm : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ)
  (ξ : OQ7Prescribed.Position),
  ξ ≠ 0 →
    ∫ (t : ℝ) in Set.Ioi 0, ‖φ ξ * OQ7Prescribed.newtonFrequencyHeatKernel t ξ‖ =
      ‖φ ξ * OQ7Prescribed.newtonFrequencyKernel ξ‖
OQ7Prescribed.newton_heat_fourier_pairing : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ) (t : ℝ),
  0 < t →
    ∫ (x : OQ7Prescribed.Position), (FourierTransform.fourier φ) x * ↑(OQ7Prescribed.newtonHeatKernel t x) =
      ∫ (ξ : OQ7Prescribed.Position), φ ξ * OQ7Prescribed.newtonFrequencyHeatKernel t ξ
OQ7Prescribed.newton_heat_pairing_joint_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun p => φ p.1 * ↑(OQ7Prescribed.newtonHeatKernel p.2 p.1))
    (MeasureTheory.volume.prod (MeasureTheory.volume.restrict (Set.Ioi 0)))
OQ7Prescribed.newton_heat_pairing_time_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ)
  (x : OQ7Prescribed.Position),
  x ≠ 0 →
    MeasureTheory.IntegrableOn (fun t => φ x * ↑(OQ7Prescribed.newtonHeatKernel t x)) (Set.Ioi 0) MeasureTheory.volume
OQ7Prescribed.newton_heat_pairing_time_integral : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ)
  (x : OQ7Prescribed.Position),
  x ≠ 0 → ∫ (t : ℝ) in Set.Ioi 0, φ x * ↑(OQ7Prescribed.newtonHeatKernel t x) = φ x * OQ7Prescribed.outgoingGreen 0 x
OQ7Prescribed.newton_heat_pairing_time_norm : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∫ (t : ℝ) in Set.Ioi 0, ‖φ x * ↑(OQ7Prescribed.newtonHeatKernel t x)‖ = ‖φ x * OQ7Prescribed.outgoingGreen 0 x‖
OQ7Prescribed.newton_heat_pairing_time_space_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun p => φ p.2 * ↑(OQ7Prescribed.newtonHeatKernel p.1 p.2))
    ((MeasureTheory.volume.restrict (Set.Ioi 0)).prod MeasureTheory.volume)
OQ7Prescribed.newton_heat_representation : ∀ (x : OQ7Prescribed.Position),
  x ≠ 0 → ∫ (t : ℝ) in Set.Ioi 0, OQ7Prescribed.newtonHeatKernel t x = OQ7Prescribed.newtonReal x
OQ7Prescribed.newton_heat_scalar_integrable : ∀ (a : ℝ),
  0 < a → MeasureTheory.IntegrableOn (fun t => t ^ (-(3 / 2)) * Real.exp (-a / t)) (Set.Ioi 0) MeasureTheory.volume
OQ7Prescribed.newton_heat_scalar_integral : ∀ (a : ℝ),
  0 < a → ∫ (t : ℝ) in Set.Ioi 0, t ^ (-(3 / 2)) * Real.exp (-a / t) = (1 / a) ^ (1 / 2) * √Real.pi
OQ7Prescribed.newton_heat_schwartz_pairing : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  ∫ (x : OQ7Prescribed.Position), φ x * OQ7Prescribed.outgoingGreen 0 x =
    ∫ (t : ℝ) in Set.Ioi 0, ∫ (x : OQ7Prescribed.Position), φ x * ↑(OQ7Prescribed.newtonHeatKernel t x)
OQ7Prescribed.newton_hessian_contact_apply : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  (OQ7Prescribed.greenHessian 0 i j) φ = ↑(OQ7Prescribed.newtonPVValue φ i j - (if i = j then 1 else 0) / 3 * φ 0)
OQ7Prescribed.newton_hessian_contact_distribution : ∀ (i j : Fin 3),
  OQ7Prescribed.greenHessian 0 i j =
    OQ7Prescribed.newtonPVDistribution i j - ((if i = j then 1 else 0) / 3) • OQ7Prescribed.newtonDirac
OQ7Prescribed.newton_hessian_trace_distribution : ∑ i, OQ7Prescribed.greenHessian 0 i i = -OQ7Prescribed.newtonDirac
OQ7Prescribed.newton_inner_contact_normal : ∀ (r : ℝ),
  0 < r →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3) (n : ↑OQ7Prescribed.UnitSphere),
      -(r ^ 2 * OQ7Prescribed.newtonGradient j (r • ↑n) * φ (r • ↑n) * -(↑n).ofLp i) =
        -(4 * Real.pi)⁻¹ * ((↑n).ofLp i * (↑n).ofLp j * φ (r • ↑n))
OQ7Prescribed.newton_inner_derivative_normal : ∀ (r : ℝ),
  0 < r →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3) (n : ↑OQ7Prescribed.UnitSphere),
      r ^ 2 * OQ7Prescribed.newtonReal (r • ↑n) * ((OQ7Prescribed.testPartial i) φ) (r • ↑n) * -(↑n).ofLp j =
        -r / (4 * Real.pi) * ((↑n).ofLp j * ((OQ7Prescribed.testPartial i) φ) (r • ↑n))
OQ7Prescribed.newton_kernel_split : ∀ (x : OQ7Prescribed.Position),
  OQ7Prescribed.cutoffGreen 0 1 x + OQ7Prescribed.newtonExterior x = OQ7Prescribed.outgoingGreen 0 x
OQ7Prescribed.newton_laplacian_test_integral : ∀ (φ : OQ7Prescribed.ScalarTest),
  ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.newtonReal x * (OQ7Prescribed.testLaplacian φ) x = -φ 0
OQ7Prescribed.newton_outer_boundary_vanishes : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  ∃ R,
    0 < R ∧
      ∀ (T : ℝ),
        R ≤ T → OQ7Prescribed.newtonContactBoundary φ i j T = 0 ∧ OQ7Prescribed.newtonDerivativeBoundary φ i j T = 0
OQ7Prescribed.newton_punctured_double_ibp : ∀ (r : ℝ),
  0 < r →
    ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
      ∫ (x : OQ7Prescribed.Position) in {x | r < ‖x‖},
          OQ7Prescribed.newtonReal x * ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x =
        OQ7Prescribed.newtonPVTruncated φ i j r + OQ7Prescribed.newtonContactBoundary φ i j r +
          OQ7Prescribed.newtonDerivativeBoundary φ i j r
OQ7Prescribed.newton_schwartz_exterior_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun x => φ x * OQ7Prescribed.newtonExterior x) MeasureTheory.volume
OQ7Prescribed.newton_schwartz_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun x => φ x * OQ7Prescribed.outgoingGreen 0 x) MeasureTheory.volume
OQ7Prescribed.newton_schwartz_local_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun x => φ x * OQ7Prescribed.cutoffGreen 0 1 x) MeasureTheory.volume
OQ7Prescribed.newton_test_puncture_removal : ∀ (φ : OQ7Prescribed.ScalarTest),
  Filter.Tendsto (fun r => ∫ (x : OQ7Prescribed.Position) in {x | r < ‖x‖}, OQ7Prescribed.newtonReal x * φ x) (nhds 0)
    (nhds (∫ (x : OQ7Prescribed.Position), OQ7Prescribed.newtonReal x * φ x))
OQ7Prescribed.newtonAnnulus_integrable : ∀ (i j : Fin 3) (r T : ℝ),
  0 < r → MeasureTheory.Integrable (OQ7Prescribed.newtonAnnulus i j r T) MeasureTheory.volume
OQ7Prescribed.newtonAnnulus_integral_zero : ∀ (i j : Fin 3) (r T : ℝ),
  ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.newtonAnnulus i j r T x = 0
OQ7Prescribed.newtonAnnulus_measurableSet : ∀ (r T : ℝ), MeasurableSet {x | r < ‖x‖ ∧ ‖x‖ ≤ T}
OQ7Prescribed.newtonCompensated_bound : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  ∃ C, 0 ≤ C ∧ ∀ (x : OQ7Prescribed.Position), ‖OQ7Prescribed.newtonCompensated φ i j x‖ ≤ C * ‖x‖⁻¹ ^ 2
OQ7Prescribed.newtonCompensated_integrable : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  MeasureTheory.Integrable (OQ7Prescribed.newtonCompensated φ i j) MeasureTheory.volume
OQ7Prescribed.newtonCompensated_measurable : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  Measurable (OQ7Prescribed.newtonCompensated φ i j)
OQ7Prescribed.newtonCompensated_trace : ∀ (φ : OQ7Prescribed.ScalarTest) (x : OQ7Prescribed.Position),
  ∑ i, OQ7Prescribed.newtonCompensated φ i i x = 0
OQ7Prescribed.newtonContactBoundary_tendsto : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  Filter.Tendsto (OQ7Prescribed.newtonContactBoundary φ i j) (nhds 0) (nhds (-((if i = j then 1 else 0) / 3) * φ 0))
OQ7Prescribed.newtonCurrentCorrelation_complex_convolution : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3),
  OQ7Prescribed.newtonCurrentCorrelation p φ j =
    MeasureTheory.convolution (OQ7Prescribed.reflectedCurrentComponent p j) (⇑(OQ7Prescribed.scalarTestSchwartz φ))
      (ContinuousLinearMap.mul ℂ ℂ) MeasureTheory.volume
OQ7Prescribed.newtonCurrentCorrelation_contDiff : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3), ContDiff ℝ (↑⊤) (OQ7Prescribed.newtonCurrentCorrelation p φ j)
OQ7Prescribed.newtonCurrentCorrelation_eq_convolution : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3),
  OQ7Prescribed.newtonCurrentCorrelation p φ j =
    MeasureTheory.convolution (OQ7Prescribed.reflectedCurrentComponent p j) (⇑(OQ7Prescribed.scalarTestSchwartz φ))
      (ContinuousLinearMap.mul ℝ ℂ) MeasureTheory.volume
OQ7Prescribed.newtonCurrentCorrelation_hasCompactSupport : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3), HasCompactSupport (OQ7Prescribed.newtonCurrentCorrelation p φ j)
OQ7Prescribed.newtonCurrentCorrelation_hasLineDerivAt : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j i : Fin 3) (z : OQ7Prescribed.Position),
  HasLineDerivAt ℝ (OQ7Prescribed.newtonCurrentCorrelation p φ j)
    (OQ7Prescribed.newtonCurrentCorrelation p ((OQ7Prescribed.testPartial i) φ) j z) z (OQ7Prescribed.basisR i)
OQ7Prescribed.newtonCurrentCorrelation_lineDeriv : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j i : Fin 3) (z : OQ7Prescribed.Position),
  lineDeriv ℝ (OQ7Prescribed.newtonCurrentCorrelation p φ j) z (OQ7Prescribed.basisR i) =
    OQ7Prescribed.newtonCurrentCorrelation p ((OQ7Prescribed.testPartial i) φ) j z
OQ7Prescribed.newtonCurrentCorrelationSchwartz_apply : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3) (z : OQ7Prescribed.Position),
  (OQ7Prescribed.newtonCurrentCorrelationSchwartz p φ j) z = OQ7Prescribed.newtonCurrentCorrelation p φ j z
OQ7Prescribed.newtonCurrentCorrelationSchwartz_fourierInv : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3) (ξ : OQ7Prescribed.Position),
  (FourierTransformInv.fourierInv (OQ7Prescribed.newtonCurrentCorrelationSchwartz p φ j)) ξ =
    (FourierTransformInv.fourierInv (OQ7Prescribed.scalarTestSchwartz φ)) ξ *
      (FourierTransform.fourier p.current ξ).ofLp j
OQ7Prescribed.newtonCurrentCorrelationSchwartz_partial : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j i : Fin 3),
  LineDeriv.lineDerivOp (OQ7Prescribed.basisR i) (OQ7Prescribed.newtonCurrentCorrelationSchwartz p φ j) =
    OQ7Prescribed.newtonCurrentCorrelationSchwartz p ((OQ7Prescribed.testPartial i) φ) j
OQ7Prescribed.newtonCurrentCorrelationSchwartz_secondPartial : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (l i j : Fin 3),
  LineDeriv.lineDerivOp (OQ7Prescribed.basisR j)
      (LineDeriv.lineDerivOp (OQ7Prescribed.basisR i) (OQ7Prescribed.newtonCurrentCorrelationSchwartz p φ l)) =
    OQ7Prescribed.newtonCurrentCorrelationSchwartz p ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) l
OQ7Prescribed.newtonDerivativeBoundary_tendsto : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  Filter.Tendsto (OQ7Prescribed.newtonDerivativeBoundary φ i j) (nhds 0) (nhds 0)
OQ7Prescribed.newtonDirac_apply : ∀ (φ : OQ7Prescribed.ScalarTest), OQ7Prescribed.newtonDirac φ = ↑(φ 0)
OQ7Prescribed.newtonExterior_memLp : MeasureTheory.MemLp OQ7Prescribed.newtonExterior ⊤ MeasureTheory.volume
OQ7Prescribed.newtonFrequency_exterior_schwartz_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun ξ => φ ξ * OQ7Prescribed.newtonFrequencyExterior ξ) MeasureTheory.volume
OQ7Prescribed.newtonFrequency_local_schwartz_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun ξ => φ ξ * OQ7Prescribed.newtonFrequencyLocal ξ) MeasureTheory.volume
OQ7Prescribed.newtonFrequency_schwartz_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  MeasureTheory.Integrable (fun ξ => φ ξ * OQ7Prescribed.newtonFrequencyKernel ξ) MeasureTheory.volume
OQ7Prescribed.newtonFrequencyExterior_memLp : MeasureTheory.MemLp OQ7Prescribed.newtonFrequencyExterior ⊤
  MeasureTheory.volume
OQ7Prescribed.newtonFrequencyHeatKernel_eq_real : ∀ (t : ℝ) (ξ : OQ7Prescribed.Position),
  OQ7Prescribed.newtonFrequencyHeatKernel t ξ = ↑(Real.exp (-(4 * Real.pi ^ 2 * t * ‖ξ‖ ^ 2)))
OQ7Prescribed.newtonFrequencyHeatKernel_joint_measurable : Measurable fun p =>
  OQ7Prescribed.newtonFrequencyHeatKernel p.2 p.1
OQ7Prescribed.newtonFrequencyKernel_locallyIntegrable : MeasureTheory.LocallyIntegrable
  OQ7Prescribed.newtonFrequencyKernel MeasureTheory.volume
OQ7Prescribed.newtonFrequencyKernel_measurable : Measurable OQ7Prescribed.newtonFrequencyKernel
OQ7Prescribed.newtonFrequencyKernel_norm : ∀ (ξ : OQ7Prescribed.Position),
  ‖OQ7Prescribed.newtonFrequencyKernel ξ‖ = (4 * Real.pi ^ 2 * ‖ξ‖ ^ 2)⁻¹
OQ7Prescribed.newtonFrequencyKernel_split : ∀ (ξ : OQ7Prescribed.Position),
  OQ7Prescribed.newtonFrequencyLocal ξ + OQ7Prescribed.newtonFrequencyExterior ξ = OQ7Prescribed.newtonFrequencyKernel ξ
OQ7Prescribed.newtonFrequencyKernel_zero : OQ7Prescribed.newtonFrequencyKernel 0 = 0
OQ7Prescribed.newtonFrequencyLocal_memLp : MeasureTheory.MemLp OQ7Prescribed.newtonFrequencyLocal 1 MeasureTheory.volume
OQ7Prescribed.newtonFrequencyTempered_apply : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  OQ7Prescribed.newtonFrequencyTempered φ = ∫ (ξ : OQ7Prescribed.Position), φ ξ * OQ7Prescribed.newtonFrequencyKernel ξ
OQ7Prescribed.newtonFrequencyTempered_heat_pairing : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  OQ7Prescribed.newtonFrequencyTempered φ =
    ∫ (t : ℝ) in Set.Ioi 0, ∫ (ξ : OQ7Prescribed.Position), φ ξ * OQ7Prescribed.newtonFrequencyHeatKernel t ξ
OQ7Prescribed.newtonGradient_contDiffAt : ∀ (j : Fin 3) (x : OQ7Prescribed.Position),
  x ≠ 0 → ContDiffAt ℝ 1 (OQ7Prescribed.newtonGradient j) x
OQ7Prescribed.newtonGradient_hasLineDerivAt : ∀ (i j : Fin 3) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    HasLineDerivAt ℝ (OQ7Prescribed.newtonGradient j) (OQ7Prescribed.newtonHessianKernel i j x) x
      (OQ7Prescribed.basisR i)
OQ7Prescribed.newtonHeatKernel_complex_gaussian : ∀ (t : ℝ) (x : OQ7Prescribed.Position),
  ↑(OQ7Prescribed.newtonHeatKernel t x) = ↑((4 * Real.pi * t) ^ (-(3 / 2))) * Complex.exp (-↑(4 * t)⁻¹ * ↑‖x‖ ^ 2)
OQ7Prescribed.newtonHeatKernel_factor : ∀ (t : ℝ),
  0 < t →
    ∀ (x : OQ7Prescribed.Position),
      OQ7Prescribed.newtonHeatKernel t x = (4 * Real.pi) ^ (-(3 / 2)) * (t ^ (-(3 / 2)) * Real.exp (-(‖x‖ ^ 2 / 4) / t))
OQ7Prescribed.newtonHeatKernel_fourier : ∀ (t : ℝ),
  0 < t →
    ∀ (ξ : OQ7Prescribed.Position),
      FourierTransform.fourier (fun x => ↑(OQ7Prescribed.newtonHeatKernel t x)) ξ =
        Complex.exp ↑(-4 * Real.pi ^ 2 * t * ‖ξ‖ ^ 2)
OQ7Prescribed.newtonHeatKernel_integrable : ∀ (x : OQ7Prescribed.Position),
  x ≠ 0 → MeasureTheory.IntegrableOn (fun t => OQ7Prescribed.newtonHeatKernel t x) (Set.Ioi 0) MeasureTheory.volume
OQ7Prescribed.newtonHeatKernel_integral_one : ∀ (t : ℝ),
  0 < t → ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.newtonHeatKernel t x = 1
OQ7Prescribed.newtonHeatKernel_joint_measurable : Measurable fun p => OQ7Prescribed.newtonHeatKernel p.2 p.1
OQ7Prescribed.newtonHeatKernel_nonneg : ∀ (t : ℝ),
  0 < t → ∀ (x : OQ7Prescribed.Position), 0 ≤ OQ7Prescribed.newtonHeatKernel t x
OQ7Prescribed.newtonHeatKernel_not_integrable_at_origin : ¬MeasureTheory.IntegrableOn
    (fun t => OQ7Prescribed.newtonHeatKernel t 0) (Set.Ioi 0) MeasureTheory.volume
OQ7Prescribed.newtonHeatKernel_space_integrable : ∀ (t : ℝ),
  0 < t → MeasureTheory.Integrable (OQ7Prescribed.newtonHeatKernel t) MeasureTheory.volume
OQ7Prescribed.newtonHeatKernel_space_integrable_complex : ∀ (t : ℝ),
  0 < t → MeasureTheory.Integrable (fun x => ↑(OQ7Prescribed.newtonHeatKernel t x)) MeasureTheory.volume
OQ7Prescribed.newtonHessian_current_fourier_pairing : ∀ (p : OQ7Prescribed.CompactPolarization) (i j : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.newtonTemperedHessian i j) (OQ7Prescribed.newtonCurrentCorrelationSchwartz p φ j) =
    ∫ (ξ : OQ7Prescribed.Position),
      (FourierTransformInv.fourierInv (OQ7Prescribed.scalarTestSchwartz φ)) ξ *
          OQ7Prescribed.newtonHessianFrequency i j ξ *
        (FourierTransform.fourier p.current ξ).ofLp j
OQ7Prescribed.newtonHessian_radial_integral_zero : ∀ (i j : Fin 3) (w : ℝ → ℝ),
  ∫ (x : OQ7Prescribed.Position), w ‖x‖ * OQ7Prescribed.newtonHessianKernel i j x = 0
OQ7Prescribed.newtonHessian_test_integrable_of_zero : ∀ (φ : OQ7Prescribed.ScalarTest),
  φ 0 = 0 →
    ∀ (i j : Fin 3),
      MeasureTheory.Integrable (fun x => OQ7Prescribed.newtonHessianKernel i j x * φ x) MeasureTheory.volume
OQ7Prescribed.newtonHessianFrequency_measurable : ∀ (i j : Fin 3), Measurable (OQ7Prescribed.newtonHessianFrequency i j)
OQ7Prescribed.newtonHessianFrequency_memLp : ∀ (i j : Fin 3),
  MeasureTheory.MemLp (OQ7Prescribed.newtonHessianFrequency i j) ⊤ MeasureTheory.volume
OQ7Prescribed.newtonHessianFrequency_norm_le : ∀ (i j : Fin 3) (ξ : OQ7Prescribed.Position),
  ‖OQ7Prescribed.newtonHessianFrequency i j ξ‖ ≤ 1
OQ7Prescribed.newtonHessianFrequency_schwartz_integrable : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ) (i j : Fin 3),
  MeasureTheory.Integrable (fun ξ => φ ξ * OQ7Prescribed.newtonHessianFrequency i j ξ) MeasureTheory.volume
OQ7Prescribed.newtonHessianFrequency_staticSymbol : ∀ (i j : Fin 3) (ξ : OQ7Prescribed.Position),
  OQ7Prescribed.newtonHessianFrequency i j ξ = ((OQ7Prescribed.staticSymbol ξ) (OQ7Prescribed.basisC j)).ofLp i
OQ7Prescribed.newtonHessianFrequency_zero : ∀ (i j : Fin 3), OQ7Prescribed.newtonHessianFrequency i j 0 = 0
OQ7Prescribed.newtonHessianFrequencyTempered_apply : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ) (i j : Fin 3),
  (OQ7Prescribed.newtonHessianFrequencyTempered i j) φ =
    ∫ (ξ : OQ7Prescribed.Position), φ ξ * OQ7Prescribed.newtonHessianFrequency i j ξ
OQ7Prescribed.newtonHessianKernel_classical : ∀ (i j : Fin 3) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ↑(OQ7Prescribed.newtonHessianKernel i j x) =
      lineDeriv ℝ (fun y => lineDeriv ℝ (OQ7Prescribed.outgoingGreen 0) y (OQ7Prescribed.basisR j)) x
        (OQ7Prescribed.basisR i)
OQ7Prescribed.newtonHessianKernel_contDiffAt : ∀ (i j : Fin 3) (x : OQ7Prescribed.Position),
  x ≠ 0 → ContDiffAt ℝ 1 (OQ7Prescribed.newtonHessianKernel i j) x
OQ7Prescribed.newtonHessianKernel_measurable : ∀ (i j : Fin 3), Measurable (OQ7Prescribed.newtonHessianKernel i j)
OQ7Prescribed.newtonHessianKernel_norm_le : ∀ (i j : Fin 3) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.newtonHessianKernel i j x‖ ≤ Real.pi⁻¹ * ‖x‖⁻¹ ^ 3
OQ7Prescribed.newtonHessianKernel_smul : ∀ (i j : Fin 3) (n : ↑OQ7Prescribed.UnitSphere) (r : ℝ),
  0 < r →
    OQ7Prescribed.newtonHessianKernel i j (r • ↑n) =
      (3 * (↑n).ofLp i * (↑n).ofLp j - if i = j then 1 else 0) / (4 * Real.pi * r ^ 3)
OQ7Prescribed.newtonHessianKernel_trace : ∀ (x : OQ7Prescribed.Position),
  ∑ i, OQ7Prescribed.newtonHessianKernel i i x = 0
OQ7Prescribed.newtonPrincipalValue_tendsto : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  Filter.Tendsto (OQ7Prescribed.newtonPVTruncated φ i j) (nhdsWithin 0 (Set.Ioi 0))
    (nhds (OQ7Prescribed.newtonPVValue φ i j))
OQ7Prescribed.newtonPV_indicator_decomposition : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3) (r : ℝ),
  ({x | r < ‖x‖}.indicator fun x => OQ7Prescribed.newtonHessianKernel i j x * φ x) =
    {x | r < ‖x‖}.indicator (OQ7Prescribed.newtonCompensated φ i j) + fun x =>
      φ 0 * OQ7Prescribed.newtonAnnulus i j r 1 x
OQ7Prescribed.newtonPVDistribution_apply : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  (OQ7Prescribed.newtonPVDistribution i j) φ = ↑(OQ7Prescribed.newtonPVValue φ i j)
OQ7Prescribed.newtonPVRepresentation_apply : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  (OQ7Prescribed.newtonPVRepresentation i j) φ = ↑(OQ7Prescribed.newtonPVValue φ i j)
OQ7Prescribed.newtonPVTruncated_eq_compensated : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3) (r : ℝ),
  0 < r →
    OQ7Prescribed.newtonPVTruncated φ i j r =
      ∫ (x : OQ7Prescribed.Position) in {x | r < ‖x‖}, OQ7Prescribed.newtonCompensated φ i j x
OQ7Prescribed.newtonPVTruncated_integrable : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3) (r : ℝ),
  0 < r →
    MeasureTheory.IntegrableOn (fun x => OQ7Prescribed.newtonHessianKernel i j x * φ x) {x | r < ‖x‖}
      MeasureTheory.volume
OQ7Prescribed.newtonPVValue_continuous : ∀ (i j : Fin 3), Continuous fun φ => OQ7Prescribed.newtonPVValue φ i j
OQ7Prescribed.newtonPVValue_eq_integral_of_zero : ∀ (φ : OQ7Prescribed.ScalarTest),
  φ 0 = 0 →
    ∀ (i j : Fin 3),
      OQ7Prescribed.newtonPVValue φ i j = ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.newtonHessianKernel i j x * φ x
OQ7Prescribed.newtonPVValue_trace : ∀ (φ : OQ7Prescribed.ScalarTest), ∑ i, OQ7Prescribed.newtonPVValue φ i i = 0
OQ7Prescribed.newtonRadial_hasDerivAt : ∀ (r : ℝ),
  r ≠ 0 → HasDerivAt OQ7Prescribed.newtonRadial (OQ7Prescribed.newtonRadialFirst r) r
OQ7Prescribed.newtonRadialFirst_hasDerivAt : ∀ (r : ℝ),
  r ≠ 0 → HasDerivAt OQ7Prescribed.newtonRadialFirst (OQ7Prescribed.newtonRadialSecond r) r
OQ7Prescribed.newtonReal_contDiffAt : ∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 OQ7Prescribed.newtonReal x
OQ7Prescribed.newtonReal_eq_green : ∀ (x : OQ7Prescribed.Position),
  ↑(OQ7Prescribed.newtonReal x) = OQ7Prescribed.outgoingGreen 0 x
OQ7Prescribed.newtonReal_hasLineDerivAt : ∀ (j : Fin 3) (x : OQ7Prescribed.Position),
  x ≠ 0 → HasLineDerivAt ℝ OQ7Prescribed.newtonReal (OQ7Prescribed.newtonGradient j x) x (OQ7Prescribed.basisR j)
OQ7Prescribed.newtonReal_locallyIntegrable : MeasureTheory.LocallyIntegrable OQ7Prescribed.newtonReal
  MeasureTheory.volume
OQ7Prescribed.newtonReal_test_integrable : ∀ (φ : OQ7Prescribed.ScalarTest),
  MeasureTheory.Integrable (fun x => OQ7Prescribed.newtonReal x * φ x) MeasureTheory.volume
OQ7Prescribed.newtonTempered_apply : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  OQ7Prescribed.newtonTempered φ = ∫ (x : OQ7Prescribed.Position), φ x * OQ7Prescribed.outgoingGreen 0 x
OQ7Prescribed.newtonTempered_fourier_apply : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  (FourierTransform.fourier OQ7Prescribed.newtonTempered) φ =
    ∫ (x : OQ7Prescribed.Position), (FourierTransform.fourier φ) x * OQ7Prescribed.outgoingGreen 0 x
OQ7Prescribed.newtonTempered_fourier_eq : FourierTransform.fourier OQ7Prescribed.newtonTempered =
  OQ7Prescribed.newtonFrequencyTempered
OQ7Prescribed.newtonTempered_fourier_integral : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  (FourierTransform.fourier OQ7Prescribed.newtonTempered) φ =
    ∫ (ξ : OQ7Prescribed.Position), φ ξ * OQ7Prescribed.newtonFrequencyKernel ξ
OQ7Prescribed.newtonTempered_heat_pairing : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ),
  OQ7Prescribed.newtonTempered φ =
    ∫ (t : ℝ) in Set.Ioi 0, ∫ (x : OQ7Prescribed.Position), φ x * ↑(OQ7Prescribed.newtonHeatKernel t x)
OQ7Prescribed.newtonTempered_scalarTest : ∀ (φ : OQ7Prescribed.ScalarTest),
  OQ7Prescribed.newtonTempered (OQ7Prescribed.scalarTestSchwartz φ) = (OQ7Prescribed.outgoingGreenDistribution 0) φ
OQ7Prescribed.newtonTemperedHessian_apply : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ) (i j : Fin 3),
  (OQ7Prescribed.newtonTemperedHessian i j) φ =
    OQ7Prescribed.newtonTempered
      (LineDeriv.lineDerivOp (OQ7Prescribed.basisR j) (LineDeriv.lineDerivOp (OQ7Prescribed.basisR i) φ))
OQ7Prescribed.newtonTemperedHessian_contact_apply : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  (OQ7Prescribed.newtonTemperedHessian i j) (OQ7Prescribed.scalarTestSchwartz φ) =
    ↑(OQ7Prescribed.newtonPVValue φ i j - (if i = j then 1 else 0) / 3 * φ 0)
OQ7Prescribed.newtonTemperedHessian_fourier : ∀ (i j : Fin 3),
  FourierTransform.fourier (OQ7Prescribed.newtonTemperedHessian i j) =
    -(2 * ↑Real.pi) ^ 2 •
      (TemperedDistribution.smulLeftCLM ℂ fun ξ => ↑(ξ.ofLp i) * ↑(ξ.ofLp j))
        (FourierTransform.fourier OQ7Prescribed.newtonTempered)
OQ7Prescribed.newtonTemperedHessian_fourier_eq : ∀ (i j : Fin 3),
  FourierTransform.fourier (OQ7Prescribed.newtonTemperedHessian i j) = OQ7Prescribed.newtonHessianFrequencyTempered i j
OQ7Prescribed.newtonTemperedHessian_fourier_integral : ∀ (φ : SchwartzMap OQ7Prescribed.Position ℂ) (i j : Fin 3),
  (FourierTransform.fourier (OQ7Prescribed.newtonTemperedHessian i j)) φ =
    ∫ (ξ : OQ7Prescribed.Position), φ ξ * ↑(-(ξ.ofLp i * ξ.ofLp j) / ‖ξ‖ ^ 2)
OQ7Prescribed.newtonTemperedHessian_scalarTest : ∀ (φ : OQ7Prescribed.ScalarTest) (i j : Fin 3),
  (OQ7Prescribed.newtonTemperedHessian i j) (OQ7Prescribed.scalarTestSchwartz φ) = (OQ7Prescribed.greenHessian 0 i j) φ
OQ7Prescribed.normalizedActiveResponse_angle_difference_bound : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ φ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  ‖OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ -
        OQ7Prescribed.normalizedActiveResponse k hk B σ φ α β hα hβ‖ ≤
    1 / min (α.im / Complex.normSq α) (β.im / Complex.normSq β) *
      (‖OQ7Prescribed.activeMaterialOperator k B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β -
            OQ7Prescribed.activeMaterialOperator k B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis φ) α β‖ *
        ‖OQ7Prescribed.normalizedActiveResponse k hk B σ φ α β hα hβ‖)
OQ7Prescribed.normalizedActiveResponse_norm_le : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  ‖OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ‖ ≤
    1 / min (α.im / Complex.normSq α) (β.im / Complex.normSq β) * ‖OQ7Prescribed.normalizedIncidentDrive k B σ‖
OQ7Prescribed.normalizedActiveResponse_residual_bound : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im)
  (q : ↥(OQ7Prescribed.ScalarBodyCurrentL2 B)),
  ‖OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ - q‖ ≤
    1 / min (α.im / Complex.normSq α) (β.im / Complex.normSq β) *
      ‖-OQ7Prescribed.normalizedIncidentDrive k B σ -
          (OQ7Prescribed.activeMaterialOperator k B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β) q‖
OQ7Prescribed.normalizedIncidentDrive_coe : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction),
  ↑↑↑(OQ7Prescribed.normalizedIncidentDrive k B σ) =ᵐ[MeasureTheory.volume]
    B.domain.indicator fun x => if x.ofLp 2 < B.absorberThickness then 0 else OQ7Prescribed.planePhase k σ x
OQ7Prescribed.orthogonalSphere_cone_preimage : ∀ (e : OQ7Prescribed.Position ≃ₗᵢ[ℝ] OQ7Prescribed.Position)
  (s : Set ↑OQ7Prescribed.UnitSphere),
  Set.Ioo 0 1 • Subtype.val '' ⇑(OQ7Prescribed.orthogonalSphere e) ⁻¹' s = ⇑e ⁻¹' (Set.Ioo 0 1 • Subtype.val '' s)
OQ7Prescribed.orthogonalSphere_measurePreserving : ∀ (e : OQ7Prescribed.Position ≃ₗᵢ[ℝ] OQ7Prescribed.Position),
  MeasureTheory.MeasurePreserving (⇑(OQ7Prescribed.orthogonalSphere e)) OQ7Prescribed.sphereArea
    OQ7Prescribed.sphereArea
OQ7Prescribed.outgoing_classical_hessian : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (i j : Fin 3),
      lineDeriv ℝ (fun y => lineDeriv ℝ (OQ7Prescribed.outgoingGreen k) y (OQ7Prescribed.basisR j)) x
          (OQ7Prescribed.basisR i) =
        (x.ofLp i * x.ofLp j / ‖x‖ ^ 2) • OQ7Prescribed.outgoingRadialSecond k ‖x‖ +
          ((if i = j then 1 else 0) / ‖x‖ - x.ofLp i * x.ofLp j / ‖x‖ ^ 3) • OQ7Prescribed.outgoingRadialFirst k ‖x‖
OQ7Prescribed.outgoing_current_correlation_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ (q.1 + q.2)) * OQ7Prescribed.outgoingGreen k q.1 * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.outgoing_current_correlation_pairing_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun z => OQ7Prescribed.outgoingGreen k z * OQ7Prescribed.newtonCurrentCorrelation p φ i z)
    MeasureTheory.volume
OQ7Prescribed.outgoing_current_pairing_integrand_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3) (S : ℝ),
  (∀ (x : OQ7Prescribed.Position), φ x ≠ 0 → ‖x‖ ≤ S) →
    ∀ (x y : OQ7Prescribed.Position),
      ↑(φ x) * OQ7Prescribed.outgoingGreen k (x - y) * (p.current y).ofLp i =
        ↑(φ x) * OQ7Prescribed.cutoffGreen k (S + p.radius) (x - y) * (p.current y).ofLp i
OQ7Prescribed.outgoing_current_test_joint_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  MeasureTheory.Integrable (fun q => ↑(φ q.1) * OQ7Prescribed.outgoingGreen k (q.1 - q.2) * (p.current q.2).ofLp i)
    (MeasureTheory.volume.prod MeasureTheory.volume)
OQ7Prescribed.outgoing_dyadic_contact_identity : ∀ (k : ℝ) (i j : Fin 3),
  OQ7Prescribed.dyadicGreenDistribution k i j =
    OQ7Prescribed.newtonPVDistribution i j - ((if i = j then 1 else 0) / 3) • OQ7Prescribed.newtonDirac +
      Distribution.ofFun ⊤ (fun x => ((OQ7Prescribed.dyadicRemainder k x) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume ⊤
OQ7Prescribed.outgoing_helmholtz_fundamental_apply : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.testLaplacian φ) +
      k ^ 2 • (OQ7Prescribed.outgoingGreenDistribution k) φ =
    -↑(φ 0)
OQ7Prescribed.outgoing_helmholtz_fundamental_distribution : ∀ (k : ℝ),
  ∑ i, OQ7Prescribed.greenHessian k i i + k ^ 2 • OQ7Prescribed.outgoingGreenDistribution k = -OQ7Prescribed.newtonDirac
OQ7Prescribed.outgoingElectricField_eq_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.outgoingElectricField k p =ᵐ[MeasureTheory.volume] OQ7Prescribed.electricVolumeField k p
OQ7Prescribed.outgoingElectricField_locallySquareIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.outgoingElectricField k p)
OQ7Prescribed.outgoingGradient_eq_static_add_dynamic : ∀ (k : ℝ) (j : Fin 3),
  OQ7Prescribed.outgoingGradient k j = OQ7Prescribed.outgoingGradient 0 j + OQ7Prescribed.dynamicGradientRemainder k j
OQ7Prescribed.outgoingGradient_hasLineDerivAt : ∀ (k : ℝ) (j : Fin 3) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    HasLineDerivAt ℝ (OQ7Prescribed.outgoingGreen k) (OQ7Prescribed.outgoingGradient k j x) x (OQ7Prescribed.basisR j)
OQ7Prescribed.outgoingGradient_locallyIntegrable : ∀ (k : ℝ) (j : Fin 3),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.outgoingGradient k j) MeasureTheory.volume
OQ7Prescribed.outgoingGradient_measurable : ∀ (k : ℝ) (j : Fin 3), Measurable (OQ7Prescribed.outgoingGradient k j)
OQ7Prescribed.outgoingGradient_norm_le_far : ∀ (k : ℝ) (j : Fin 3) (x : OQ7Prescribed.Position),
  1 ≤ ‖x‖ → ‖OQ7Prescribed.outgoingGradient k j x‖ ≤ (|k| + 1) / (4 * Real.pi)
OQ7Prescribed.outgoingGradient_zero_locallyIntegrable : ∀ (j : Fin 3),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.outgoingGradient 0 j) MeasureTheory.volume
OQ7Prescribed.outgoingGradient_zero_norm_le : ∀ (j : Fin 3) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.outgoingGradient 0 j x‖ ≤ (4 * Real.pi)⁻¹ * ‖x‖⁻¹ ^ 2
OQ7Prescribed.outgoingGreen_contDiffAt : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  x ≠ 0 → ContDiffAt ℝ 1 (OQ7Prescribed.outgoingGreen k) x
OQ7Prescribed.outgoingGreen_eq_radial : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  OQ7Prescribed.outgoingGreen k x = OQ7Prescribed.outgoingRadial k ‖x‖
OQ7Prescribed.outgoingGreen_first_distribution : ∀ (k : ℝ) (j : Fin 3),
  (OQ7Prescribed.distributionPartial j) (OQ7Prescribed.outgoingGreenDistribution k) =
    Distribution.ofFun ⊤ (OQ7Prescribed.outgoingGradient k j) MeasureTheory.volume ⊤
OQ7Prescribed.outgoingGreen_first_test_ibp : ∀ (k : ℝ) (j : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  ∫ (x : OQ7Prescribed.Position), ((OQ7Prescribed.testPartial j) φ) x • OQ7Prescribed.outgoingGreen k x =
    -∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingGradient k j x
OQ7Prescribed.outgoingGreen_helmholtz_test_integral : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  ∫ (x : OQ7Prescribed.Position), ((OQ7Prescribed.testLaplacian φ) x + k ^ 2 * φ x) • OQ7Prescribed.outgoingGreen k x =
    -↑(φ 0)
OQ7Prescribed.outgoingGreen_locallyIntegrable : ∀ (k : ℝ),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.outgoingGreen k) MeasureTheory.volume
OQ7Prescribed.outgoingGreen_measurable : ∀ (k : ℝ), Measurable (OQ7Prescribed.outgoingGreen k)
OQ7Prescribed.outgoingGreen_memLp_on_compact : ∀ (k : ℝ) (K : Set OQ7Prescribed.Position),
  IsCompact K → MeasureTheory.MemLp (OQ7Prescribed.outgoingGreen k) 2 (MeasureTheory.volume.restrict K)
OQ7Prescribed.outgoingGreen_norm : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.outgoingGreen k x‖ = (4 * Real.pi * ‖x‖)⁻¹
OQ7Prescribed.outgoingGreen_sq_norm_locallyIntegrable : ∀ (k : ℝ),
  MeasureTheory.LocallyIntegrable (fun x => ‖OQ7Prescribed.outgoingGreen k x‖ ^ 2) MeasureTheory.volume
OQ7Prescribed.outgoingGreen_zero_eq_newton : ∀ (x : OQ7Prescribed.Position),
  OQ7Prescribed.outgoingGreen 0 x = OQ7Prescribed.newtonRadial ‖x‖
OQ7Prescribed.outgoingGreenDistribution_apply : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingGreenDistribution k) φ = ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingGreen k x
OQ7Prescribed.outgoingMagneticDistribution_second_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingMagneticDistribution k p) =
    (-Complex.I * ↑k) •
      (OQ7Prescribed.outgoingVolumeDistribution k p + OQ7Prescribed.polarizationCurrentComponentDistribution p)
OQ7Prescribed.outgoingMagneticField_locallySquareIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.outgoingMagneticField k p)
OQ7Prescribed.outgoingPhysicalSourceFields : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.outgoingElectricField k p) ∧
    OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.outgoingMagneticField k p) ∧
      (OQ7Prescribed.HasWeakCurl (OQ7Prescribed.outgoingElectricField k p) fun x =>
          (Complex.I * ↑k) • OQ7Prescribed.outgoingMagneticField k p x) ∧
        (OQ7Prescribed.HasWeakCurl (OQ7Prescribed.outgoingMagneticField k p) fun x =>
            (-Complex.I * ↑k) • (OQ7Prescribed.outgoingElectricField k p x + p.current x)) ∧
          OQ7Prescribed.Outgoing (OQ7Prescribed.outgoingElectricField k p) (OQ7Prescribed.outgoingMagneticField k p)
OQ7Prescribed.outgoingPotential_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.outgoingPotential k (p.add q) =
    OQ7Prescribed.outgoingPotential k p + OQ7Prescribed.outgoingPotential k q
OQ7Prescribed.outgoingPotential_aestronglyMeasurable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.AEStronglyMeasurable (OQ7Prescribed.outgoingPotential k p) MeasureTheory.volume
OQ7Prescribed.outgoingPotential_component_integral : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (x : OQ7Prescribed.Position),
  (OQ7Prescribed.outgoingPotential k p x).ofLp i =
    ∫ (y : OQ7Prescribed.Position), OQ7Prescribed.outgoingGreen k (x - y) * (p.current y).ofLp i
OQ7Prescribed.outgoingPotential_congr_current : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  p.current =ᵐ[MeasureTheory.volume] q.current →
    OQ7Prescribed.outgoingPotential k p = OQ7Prescribed.outgoingPotential k q
OQ7Prescribed.outgoingPotential_contDiff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  ContDiff ℝ (↑⊤) p.current → ContDiff ℝ (↑⊤) (OQ7Prescribed.outgoingPotential k p)
OQ7Prescribed.outgoingPotential_curlCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.distributionCurl (OQ7Prescribed.potentialComponentDistribution k p)) i =
    OQ7Prescribed.outgoingVolumeDistribution k p i + OQ7Prescribed.polarizationCurrentComponentDistribution p i
OQ7Prescribed.outgoingPotential_enorm_le : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x : OQ7Prescribed.Position), ‖x‖ ≤ S → ‖OQ7Prescribed.outgoingPotential k p x‖ₑ ≤ OQ7Prescribed.potentialBound k p S
OQ7Prescribed.outgoingPotential_eq_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    OQ7Prescribed.outgoingPotential k p x =
      MeasureTheory.convolution p.current (OQ7Prescribed.cutoffGreen k (S + p.radius)) OQ7Prescribed.vectorScalarMul
        MeasureTheory.volume x
OQ7Prescribed.outgoingPotential_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  MeasureTheory.Integrable (fun y => OQ7Prescribed.outgoingGreen k (x - y) • p.current y) MeasureTheory.volume
OQ7Prescribed.outgoingPotential_integrand_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x y : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    (OQ7Prescribed.vectorScalarMul (p.current y)) (OQ7Prescribed.outgoingGreen k (x - y)) =
      (OQ7Prescribed.vectorScalarMul (p.current y)) (OQ7Prescribed.cutoffGreen k (S + p.radius) (x - y))
OQ7Prescribed.outgoingPotential_locallyIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.outgoingPotential k p) MeasureTheory.volume
OQ7Prescribed.outgoingPotential_zero_component_integral : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (x : OQ7Prescribed.Position),
  (OQ7Prescribed.outgoingPotential 0 p x).ofLp i =
    ∫ (y : OQ7Prescribed.Position), OQ7Prescribed.outgoingGreen 0 (x - y) * (p.current y).ofLp i
OQ7Prescribed.outgoingRadial_contDiffAt : ∀ (k r : ℝ), r ≠ 0 → ContDiffAt ℝ 1 (OQ7Prescribed.outgoingRadial k) r
OQ7Prescribed.outgoingRadial_hasDerivAt : ∀ (k r : ℝ),
  r ≠ 0 → HasDerivAt (OQ7Prescribed.outgoingRadial k) (OQ7Prescribed.outgoingRadialFirst k r) r
OQ7Prescribed.outgoingRadial_helmholtz : ∀ (k r : ℝ),
  OQ7Prescribed.outgoingRadialSecond k r + (2 / r) • OQ7Prescribed.outgoingRadialFirst k r =
    -↑(k ^ 2) * OQ7Prescribed.outgoingRadial k r
OQ7Prescribed.outgoingRadialFirst_contDiffAt : ∀ (k r : ℝ),
  r ≠ 0 → ContDiffAt ℝ 1 (OQ7Prescribed.outgoingRadialFirst k) r
OQ7Prescribed.outgoingRadialFirst_hasDerivAt : ∀ (k r : ℝ),
  r ≠ 0 → HasDerivAt (OQ7Prescribed.outgoingRadialFirst k) (OQ7Prescribed.outgoingRadialSecond k r) r
OQ7Prescribed.outgoingRadialFirst_sub_static : ∀ (k r : ℝ),
  OQ7Prescribed.outgoingRadialFirst k r - OQ7Prescribed.outgoingRadialFirst 0 r =
    (Complex.exp (Complex.I * ↑k * ↑r) * (Complex.I * ↑k * ↑r - 1) + 1) / (↑(4 * Real.pi) * ↑r ^ 2)
OQ7Prescribed.outgoingRadialFirst_sub_static_norm_le : ∀ (k r : ℝ),
  0 < r →
    ‖OQ7Prescribed.outgoingRadialFirst k r - OQ7Prescribed.outgoingRadialFirst 0 r‖ ≤
      OQ7Prescribed.dynamicGradientBound k r
OQ7Prescribed.outgoingSourceFields_first_weakCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.outgoingElectricField k p) fun x =>
    (Complex.I * ↑k) • OQ7Prescribed.outgoingMagneticField k p x
OQ7Prescribed.outgoingSourceFields_outgoing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.Outgoing (OQ7Prescribed.outgoingElectricField k p) (OQ7Prescribed.outgoingMagneticField k p)
OQ7Prescribed.outgoingSourceFields_second_weakCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.outgoingMagneticField k p) fun x =>
    (-Complex.I * ↑k) • (OQ7Prescribed.outgoingElectricField k p x + p.current x)
OQ7Prescribed.outgoingVolumeDistribution_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.outgoingVolumeDistribution k (p.add q) i =
    OQ7Prescribed.outgoingVolumeDistribution k p i + OQ7Prescribed.outgoingVolumeDistribution k q i
OQ7Prescribed.outgoingVolumeDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingVolumeDistribution k p i) φ =
    k ^ 2 • (∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingPotential k p x).ofLp i +
      ∑ j,
        (∫ (x : OQ7Prescribed.Position),
              ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x •
                OQ7Prescribed.outgoingPotential k p x).ofLp
          j
OQ7Prescribed.outgoingVolumeDistribution_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p) =
    k ^ 2 • OQ7Prescribed.distributionCurl (OQ7Prescribed.potentialComponentDistribution k p)
OQ7Prescribed.outgoingVolumeDistribution_current_dyadic_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.outgoingVolumeDistribution k p i) φ = ∑ j, OQ7Prescribed.currentDyadicTestPairing k p φ i j
OQ7Prescribed.outgoingVolumeDistribution_eq_gradient : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.outgoingVolumeDistribution k p =
    k ^ 2 • OQ7Prescribed.potentialComponentDistribution k p + fun i =>
      (OQ7Prescribed.distributionPartial i)
        (OQ7Prescribed.distributionDivergence (OQ7Prescribed.potentialComponentDistribution k p))
OQ7Prescribed.outgoingVolumeDistribution_eq_staticFourier_add_remainder : ∀ (k : ℝ)
  (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.outgoingVolumeDistribution k p i =
    OQ7Prescribed.vectorL2ComponentDistribution
        (OQ7Prescribed.staticFourierOperator (MeasureTheory.MemLp.toLp p.current ⋯)) i +
      OQ7Prescribed.remainderPotentialComponentDistribution k p i
OQ7Prescribed.outgoingVolumeDistribution_eq_zero_add_remainder : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  OQ7Prescribed.outgoingVolumeDistribution k p i =
    OQ7Prescribed.outgoingVolumeDistribution 0 p i + OQ7Prescribed.remainderPotentialComponentDistribution k p i
OQ7Prescribed.outgoingVolumeDistribution_first_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p) =
    (Complex.I * ↑k) • OQ7Prescribed.outgoingMagneticDistribution k p
OQ7Prescribed.outgoingVolumeDistribution_maxwell_source : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p)) i -
      k ^ 2 • OQ7Prescribed.outgoingVolumeDistribution k p i =
    k ^ 2 • OQ7Prescribed.polarizationCurrentComponentDistribution p i
OQ7Prescribed.outgoingVolumeDistribution_maxwell_source_L2 : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p)) i -
      k ^ 2 • OQ7Prescribed.outgoingVolumeDistribution k p i =
    k ^ 2 • OQ7Prescribed.vectorL2ComponentDistribution (MeasureTheory.MemLp.toLp p.current ⋯) i
OQ7Prescribed.outgoingVolumeDistribution_on_ball_bounded_L2_realization : ∀ (k R : ℝ) (hR : 0 ≤ R)
  (f : ↥(OQ7Prescribed.SupportedVectorL2 R)),
  ∃ u,
    (∀ (i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
        Function.support ⇑φ ⊆ Metric.closedBall 0 R →
          (OQ7Prescribed.vectorL2ComponentDistribution (↑u) i) φ =
            (OQ7Prescribed.outgoingVolumeDistribution k (OQ7Prescribed.supportedPolarization R hR f) i) φ) ∧
      ‖u‖ ≤ (1 + OQ7Prescribed.compactRemainderConstant k R) * ‖f‖
OQ7Prescribed.outgoingVolumeDistribution_zero_bounded_L2_realization : ∀ (p : OQ7Prescribed.CompactPolarization),
  ∃ u,
    (∀ (i : Fin 3), OQ7Prescribed.outgoingVolumeDistribution 0 p i = OQ7Prescribed.vectorL2ComponentDistribution u i) ∧
      ‖u‖ ≤ ‖MeasureTheory.MemLp.toLp p.current ⋯‖
OQ7Prescribed.outgoingVolumeDistribution_zero_eq_staticFourier : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.outgoingVolumeDistribution 0 p i =
    OQ7Prescribed.vectorL2ComponentDistribution
      (OQ7Prescribed.staticFourierOperator (MeasureTheory.MemLp.toLp p.current ⋯)) i
OQ7Prescribed.outgoingVolumeDistribution_zero_hessian_pairing : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingVolumeDistribution 0 p i) φ =
    ∑ j, (OQ7Prescribed.newtonTemperedHessian i j) (OQ7Prescribed.newtonCurrentCorrelationSchwartz p φ j)
OQ7Prescribed.pairing_eq_inner : ∀ (u v : OQ7Prescribed.Vector), OQ7Prescribed.pairing u v = inner ℂ u v
OQ7Prescribed.pairing_real_smul_right : ∀ (E v : OQ7Prescribed.Vector) (r : ℝ),
  OQ7Prescribed.pairing E (r • v) = ↑r * OQ7Prescribed.pairing E v
OQ7Prescribed.pairing_self : ∀ (v : OQ7Prescribed.Vector), OQ7Prescribed.pairing v v = ↑(OQ7Prescribed.squareNorm v)
OQ7Prescribed.permittivity_one_outside : ∀ (B : OQ7Prescribed.TwoLayerBody), ∀ x ∉ B.domain, B.permittivity x = 1
OQ7Prescribed.permittivity_reciprocal : ∀ (B : OQ7Prescribed.TwoLayerBody) (P Q : ℝ),
  B.admissible P Q → ∀ (x : OQ7Prescribed.Position), Matrix.transpose (B.permittivity x) = B.permittivity x
OQ7Prescribed.physicalAbsorption_current_inner : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field)
  (hE : OQ7Prescribed.LocallySquareIntegrable E) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  ↑↑↑f =ᵐ[MeasureTheory.volume] OQ7Prescribed.polarization B E →
    OQ7Prescribed.absorption k B E = k * (inner ℂ (OQ7Prescribed.bodyFieldCurrent B E hE) f).im
OQ7Prescribed.physicalAbsorption_sine_squared_factorization : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.absorption k (OQ7Prescribed.rankOneBody B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β)
      (OQ7Prescribed.volumeTotalElectric k σ
        (OQ7Prescribed.bodyCurrentPolarization B
          ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
            (OQ7Prescribed.activePhysicalSolution k hk B σ (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β hα
              hβ)))) =
    Real.sin θ ^ 2 * OQ7Prescribed.normalizedAbsorption k hk B σ θ α β hα hβ
OQ7Prescribed.physicalExtinction_sine_squared_factorization : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.extinction k (OQ7Prescribed.rankOneBody B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β) σ
      (OQ7Prescribed.volumeTotalElectric k σ
        (OQ7Prescribed.bodyCurrentPolarization B
          ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
            (OQ7Prescribed.activePhysicalSolution k hk B σ (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β hα
              hβ)))) =
    Real.sin θ ^ 2 * OQ7Prescribed.normalizedExtinction k hk B σ θ α β hα hβ
OQ7Prescribed.physicalOutgoingVolume_work_nonneg : ∀ (k : ℝ),
  0 < k →
    ∀ (p : OQ7Prescribed.CompactPolarization),
      0 ≤
        (∫ (x : OQ7Prescribed.Position),
            OQ7Prescribed.pairing (p.current x) (OQ7Prescribed.electricVolumeField k p x)).im
OQ7Prescribed.physicalPolarization_indicator : ∀ (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field),
  OQ7Prescribed.polarization B E =
    B.domain.indicator fun x =>
      if x.ofLp 2 < B.absorberThickness then (OQ7Prescribed.tensorMap (B.absorberPermittivity - 1)) (E x)
      else (OQ7Prescribed.tensorMap (B.platePermittivity - 1)) (E x)
OQ7Prescribed.physicalPolarization_memLp : ∀ (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field),
  OQ7Prescribed.LocallySquareIntegrable E → MeasureTheory.MemLp (OQ7Prescribed.polarization B E) 2 MeasureTheory.volume
OQ7Prescribed.physicalPolarization_vanish : ∀ (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field)
  (x : OQ7Prescribed.Position),
  B.aperture + B.absorberThickness + B.plateThickness < ‖x‖ → OQ7Prescribed.polarization B E x = 0
OQ7Prescribed.physicalScatteringState_exists : ∀ (k : ℝ),
  0 < k →
    ∀ (P Q : ℝ) (B : OQ7Prescribed.TwoLayerBody),
      B.admissible P Q → ∀ (σ : OQ7Prescribed.Direction), Nonempty (OQ7Prescribed.ScatteringState k B σ)
OQ7Prescribed.physicalSourceFields_first_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.electricVolumeField k p)) =
    (Complex.I * ↑k) • OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.magneticVolumeField k p)
OQ7Prescribed.physicalSourceFields_first_weakCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.electricVolumeField k p) fun x =>
    (Complex.I * ↑k) • OQ7Prescribed.magneticVolumeField k p x
OQ7Prescribed.physicalSourceFields_second_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.magneticVolumeField k p)) =
    (-Complex.I * ↑k) •
      (OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.electricVolumeField k p) +
        OQ7Prescribed.polarizationCurrentComponentDistribution p)
OQ7Prescribed.physicalSourceFields_second_weakCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.magneticVolumeField k p) fun x =>
    (-Complex.I * ↑k) • (OQ7Prescribed.electricVolumeField k p x + p.current x)
OQ7Prescribed.physicalVolume_absorption_le_extinction : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction) (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
      OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.bodyCurrentPolarization B f) →
        OQ7Prescribed.absorption k B
            (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) ≤
          OQ7Prescribed.extinction k B σ
            (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f))
OQ7Prescribed.physicalVolume_work_balance : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction)
  (f : ↥(OQ7Prescribed.BodyCurrentL2 B)),
  OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.bodyCurrentPolarization B f) →
    OQ7Prescribed.extinction k B σ (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) =
      OQ7Prescribed.absorption k B (OQ7Prescribed.volumeTotalElectric k σ (OQ7Prescribed.bodyCurrentPolarization B f)) +
        k * (inner ℂ f ((OQ7Prescribed.bodyOutgoingOperator k B) f)).im
OQ7Prescribed.planePhase_contDiff : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction),
  ContDiff ℝ (↑⊤) (OQ7Prescribed.planePhase k σ)
OQ7Prescribed.planePhase_hasFDerivAt : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  HasFDerivAt (OQ7Prescribed.planePhase k σ)
    ((Complex.I * ↑(σ.sign * k) * OQ7Prescribed.planePhase k σ x) • Complex.ofRealCLM ∘SL PiLp.proj 2 (fun x => ℝ) 2) x
OQ7Prescribed.planePhase_norm : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.planePhase k σ x‖ = 1
OQ7Prescribed.polarization_zero_outside : ∀ (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field),
  ∀ x ∉ B.domain, OQ7Prescribed.polarization B E x = 0
OQ7Prescribed.polarizationCurrentComponentDistribution_apply : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.polarizationCurrentComponentDistribution p i) φ =
    ∫ (x : OQ7Prescribed.Position), φ x • (p.current x).ofLp i
OQ7Prescribed.polarizationCurrentComponentDistribution_eq_vectorL2 : ∀ (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  OQ7Prescribed.polarizationCurrentComponentDistribution p i =
    OQ7Prescribed.vectorL2ComponentDistribution (MeasureTheory.MemLp.toLp p.current ⋯) i
OQ7Prescribed.pole_point_complex_test_ibp : ∀ (F D : OQ7Prescribed.Position → ℂ) (i : Fin 3),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 F x) →
    (∀ (x : OQ7Prescribed.Position), x ≠ 0 → HasLineDerivAt ℝ F (D x) x (OQ7Prescribed.basisR i)) →
      MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
        MeasureTheory.LocallyIntegrable D MeasureTheory.volume →
          (∃ R, 0 < R ∧ ∃ M, 0 ≤ M ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ M / ‖x‖) →
            ∀ (φ : OQ7Prescribed.ScalarTest),
              ∫ (x : OQ7Prescribed.Position), ((OQ7Prescribed.testPartial i) φ) x • F x =
                -∫ (x : OQ7Prescribed.Position), φ x • D x
OQ7Prescribed.pole_point_test_ibp : ∀ (F D : OQ7Prescribed.Position → ℝ) (i : Fin 3),
  (∀ (x : OQ7Prescribed.Position), x ≠ 0 → ContDiffAt ℝ 1 F x) →
    (∀ (x : OQ7Prescribed.Position), x ≠ 0 → HasLineDerivAt ℝ F (D x) x (OQ7Prescribed.basisR i)) →
      MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
        MeasureTheory.LocallyIntegrable D MeasureTheory.volume →
          (∃ R, 0 < R ∧ ∃ M, 0 ≤ M ∧ ∀ (x : OQ7Prescribed.Position), ‖x‖ ≤ R → ‖F x‖ ≤ M / ‖x‖) →
            ∀ (φ : OQ7Prescribed.ScalarTest),
              ∫ (x : OQ7Prescribed.Position), F x * ((OQ7Prescribed.testPartial i) φ) x =
                -∫ (x : OQ7Prescribed.Position), D x * φ x
OQ7Prescribed.position_ae_ne_zero : ∀ᵐ (ξ : OQ7Prescribed.Position), ξ ≠ 0
OQ7Prescribed.position_zero_volume : MeasureTheory.volume {0} = 0
OQ7Prescribed.potentialBound_lt_top : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ),
  OQ7Prescribed.potentialBound k p S < ⊤
OQ7Prescribed.potentialComponent_eq_fieldComponent : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.potentialComponentDistribution k p =
    OQ7Prescribed.fieldComponentDistribution (OQ7Prescribed.outgoingPotential k p)
OQ7Prescribed.potentialComponent_first_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (j i : Fin 3),
  (OQ7Prescribed.distributionPartial j) (OQ7Prescribed.potentialComponentDistribution k p i) =
    OQ7Prescribed.gradientPotentialComponentDistribution k p j i
OQ7Prescribed.potentialComponent_helmholtz_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialComponentDistribution k p i) (OQ7Prescribed.testLaplacian φ) +
      k ^ 2 • (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    -∫ (x : OQ7Prescribed.Position), φ x • (p.current x).ofLp i
OQ7Prescribed.potentialComponent_helmholtz_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.distributionLaplacian (OQ7Prescribed.potentialComponentDistribution k p i) +
      k ^ 2 • OQ7Prescribed.potentialComponentDistribution k p i =
    -OQ7Prescribed.polarizationCurrentComponentDistribution p i
OQ7Prescribed.potentialComponent_helmholtz_L2_distribution : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  OQ7Prescribed.distributionLaplacian (OQ7Prescribed.potentialComponentDistribution k p i) +
      k ^ 2 • OQ7Prescribed.potentialComponentDistribution k p i =
    -OQ7Prescribed.vectorL2ComponentDistribution (MeasureTheory.MemLp.toLp p.current ⋯) i
OQ7Prescribed.potentialComponentDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    (∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingPotential k p x).ofLp i
OQ7Prescribed.potentialComponentDistribution_apply_integral : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    ∫ (x : OQ7Prescribed.Position), ↑(φ x) * (OQ7Prescribed.outgoingPotential k p x).ofLp i
OQ7Prescribed.potentialComponentDistribution_correlation_re_im : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.currentCorrelationRealTest Complex.reCLM p φ i) +
      Complex.I *
        (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.currentCorrelationRealTest Complex.imCLM p φ i)
OQ7Prescribed.potentialComponentDistribution_dynamic_hessian_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (l i j : Fin 3),
  (OQ7Prescribed.potentialComponentDistribution k p l)
      ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) =
    (OQ7Prescribed.potentialComponentDistribution 0 p l)
        ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) +
      ∫ (z : OQ7Prescribed.Position),
        OQ7Prescribed.newtonCurrentCorrelation p φ l z * OQ7Prescribed.dynamicHessianRemainder k i j z
OQ7Prescribed.potentialComponentDistribution_newton_pairing : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.potentialComponentDistribution 0 p i) φ =
    ∫ (z : OQ7Prescribed.Position), OQ7Prescribed.outgoingGreen 0 z * OQ7Prescribed.newtonCurrentCorrelation p φ i z
OQ7Prescribed.potentialComponentDistribution_newtonTempered : ∀ (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (j : Fin 3),
  (OQ7Prescribed.potentialComponentDistribution 0 p j) φ =
    OQ7Prescribed.newtonTempered (OQ7Prescribed.newtonCurrentCorrelationSchwartz p φ j)
OQ7Prescribed.potentialComponentDistribution_outgoing_pairing : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest) (i : Fin 3),
  (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    ∫ (z : OQ7Prescribed.Position), OQ7Prescribed.outgoingGreen k z * OQ7Prescribed.newtonCurrentCorrelation p φ i z
OQ7Prescribed.potentialComponentDistribution_zero_apply_integral : ∀ (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialComponentDistribution 0 p i) φ =
    ∫ (x : OQ7Prescribed.Position), ↑(φ x) * (OQ7Prescribed.outgoingPotential 0 p x).ofLp i
OQ7Prescribed.potentialCurlField_locallySquareIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.potentialCurlField k p)
OQ7Prescribed.potentialDistribution_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.potentialDistribution k (p.add q) =
    OQ7Prescribed.potentialDistribution k p + OQ7Prescribed.potentialDistribution k q
OQ7Prescribed.potentialDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialDistribution k p) φ =
    ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingPotential k p x
OQ7Prescribed.poynting_flux_lower_bound : ∀ (E H : OQ7Prescribed.Vector) (n : OQ7Prescribed.Position),
  ‖n‖ = 1 →
    -(‖H‖ * ‖OQ7Prescribed.cross H (OQ7Prescribed.complexify n) - E‖) ≤
      (OQ7Prescribed.pairing E (OQ7Prescribed.cross H (OQ7Prescribed.complexify n))).re
OQ7Prescribed.quadratic_layer : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.quadratic (OQ7Prescribed.layerPermittivity a b ν u) v =
    (1 + Complex.I * ↑ν) * ↑(OQ7Prescribed.squareNorm v) +
      (↑a + Complex.I * ↑b) * ↑(Complex.normSq (OQ7Prescribed.axisCoupling u v))
OQ7Prescribed.quadratic_layer_im : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (OQ7Prescribed.quadratic (OQ7Prescribed.layerPermittivity a b ν u) v).im =
    ν * OQ7Prescribed.squareNorm v + b * Complex.normSq (OQ7Prescribed.axisCoupling u v)
OQ7Prescribed.quadratic_layer_re : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (OQ7Prescribed.quadratic (OQ7Prescribed.layerPermittivity a b ν u) v).re =
    OQ7Prescribed.squareNorm v + a * Complex.normSq (OQ7Prescribed.axisCoupling u v)
OQ7Prescribed.radial_lineDeriv : ∀ (F : ℝ → ℂ) (F₁ : ℂ) (x : OQ7Prescribed.Position),
  x ≠ 0 →
    HasDerivAt F F₁ ‖x‖ → ∀ (j : Fin 3), lineDeriv ℝ (fun y => F ‖y‖) x (OQ7Prescribed.basisR j) = (x.ofLp j / ‖x‖) • F₁
OQ7Prescribed.radial_second_lineDeriv : ∀ (F F₁ F₂ : ℝ → ℂ),
  (∀ (r : ℝ), 0 < r → HasDerivAt F (F₁ r) r) →
    (∀ (r : ℝ), 0 < r → HasDerivAt F₁ (F₂ r) r) →
      ∀ (x : OQ7Prescribed.Position),
        x ≠ 0 →
          ∀ (i j : Fin 3),
            lineDeriv ℝ (fun y => lineDeriv ℝ (fun z => F ‖z‖) y (OQ7Prescribed.basisR j)) x (OQ7Prescribed.basisR i) =
              (x.ofLp i * x.ofLp j / ‖x‖ ^ 2) • F₂ ‖x‖ +
                ((if i = j then 1 else 0) / ‖x‖ - x.ofLp i * x.ofLp j / ‖x‖ ^ 3) • F₁ ‖x‖
OQ7Prescribed.radialDirection_norm : ∀ (x : OQ7Prescribed.Position), x ≠ 0 → ‖OQ7Prescribed.radialDirection x‖ = 1
OQ7Prescribed.radialDirection_sub_norm_le : ∀ (x y : OQ7Prescribed.Position),
  ‖y‖ < ‖x‖ → ‖OQ7Prescribed.radialDirection (x - y) - OQ7Prescribed.radialDirection x‖ ≤ 2 * ‖y‖ / (‖x‖ - ‖y‖)
OQ7Prescribed.radialDirection_sub_norm_le_distance : ∀ (x y : OQ7Prescribed.Position),
  ‖y‖ < ‖x‖ → ‖OQ7Prescribed.radialDirection (x - y) - OQ7Prescribed.radialDirection x‖ ≤ 2 * ‖y‖ / ‖x - y‖
OQ7Prescribed.radialHessian_trace : ∀ (x : OQ7Prescribed.Position),
  x ≠ 0 →
    ∀ (A B : ℂ),
      ∑ i, ((x.ofLp i * x.ofLp i / ‖x‖ ^ 2) • A + (1 / ‖x‖ - x.ofLp i * x.ofLp i / ‖x‖ ^ 3) • B) = A + (2 / ‖x‖) • B
@OQ7Prescribed.radialNorm_hasFDerivAt : ∀ {E : Type u_1} [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E]
  (x : E), x ≠ 0 → HasFDerivAt (fun y => ‖y‖) (‖x‖⁻¹ • (innerSL ℝ) x) x
OQ7Prescribed.rankOne_complexify_continuous : Continuous fun x =>
  ((InnerProductSpace.rankOne ℂ) (OQ7Prescribed.complexify x)) (OQ7Prescribed.complexify x)
OQ7Prescribed.rankOne_transpose : ∀ (u : OQ7Prescribed.Position),
  Matrix.transpose (OQ7Prescribed.rankOne u) = OQ7Prescribed.rankOne u
OQ7Prescribed.rankOneBody_polarization : ∀ (B : OQ7Prescribed.TwoLayerBody) (u v : OQ7Prescribed.Position) (α β : ℂ)
  (E : OQ7Prescribed.Field),
  OQ7Prescribed.polarization (OQ7Prescribed.rankOneBody B u v α β) E =
    B.domain.indicator fun x =>
      if x.ofLp 2 < B.absorberThickness then (α * OQ7Prescribed.axisCoupling u (E x)) • OQ7Prescribed.complexify u
      else (β * OQ7Prescribed.axisCoupling v (E x)) • OQ7Prescribed.complexify v
OQ7Prescribed.rankOnePhysicalScatteringState_exists : ∀ (k : ℝ),
  0 < k →
    ∀ (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction) (u v : OQ7Prescribed.Position) (α β : ℂ),
      0 < α.im → 0 < β.im → Nonempty (OQ7Prescribed.ScatteringState k (OQ7Prescribed.rankOneBody B u v α β) σ)
OQ7Prescribed.real_inner_basis : ∀ (x : OQ7Prescribed.Position) (j : Fin 3),
