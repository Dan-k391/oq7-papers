OQ7Prescribed.scaledOutgoingPhase_plane_error : ∀ (k R : ℝ),
  0 ≤ R →
    ∀ (x y : OQ7Prescribed.Position),
      2 * R + 2 ≤ ‖x‖ →
        ‖y‖ ≤ R →
          ‖OQ7Prescribed.scaledOutgoingPhase k x y -
                Complex.exp (-Complex.I * ↑(k * inner ℝ (OQ7Prescribed.radialDirection x) y))‖ ≤
            (2 * R + |k| * R ^ 2) / ‖x‖
OQ7Prescribed.scaledOutgoingRadial : ∀ (k : ℝ) (x y : OQ7Prescribed.Position),
  ↑‖x‖ * Complex.exp (-Complex.I * ↑(k * ‖x‖)) * (↑(k ^ 2) * OQ7Prescribed.outgoingRadial k ‖x - y‖) =
    ↑(k ^ 2 / (4 * Real.pi)) * OQ7Prescribed.scaledOutgoingPhase k x y
OQ7Prescribed.scaledPower_error_bound : ∀ (x X t e : ℝ), 0 < t → |x - t * X| ≤ e * t → |x / t - X| ≤ e
OQ7Prescribed.scaledSlabApertureDifference_coe : ∀ (k : ℝ) (hk : 0 < k) (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w)
  (hwc : HasCompactSupport w) (A X L : ℝ) (hA0 : 0 ≤ A) (hX : 0 ≤ X) (hL : 0 ≤ L)
  (hA : tsupport w ⊆ Metric.closedBall 0 A) (R : ℝ) (hR : 1 ≤ R) (u v : ℂ) (q : ↥(OQ7Prescribed.HeightSupportedL2 L)),
  ↑↑((OQ7Prescribed.scaledSlabApertureDifference k hk w hw hwc A X L hA0 hX hL hA R hR u v)
          (OQ7Prescribed.heightSupportEnlargement L q)) =ᵐ[MeasureTheory.volume]
    (OQ7Prescribed.slabObservationRegion (X * R) (L + 2)).indicator fun x =>
      OQ7Prescribed.axisCoupling (OQ7Prescribed.slabPosition v 0)
          (OQ7Prescribed.electricVolumeField k
            (OQ7Prescribed.scaledSlabPolarization w hw hwc A X L hA0 hX hL hA R hR u q) x) -
        OQ7Prescribed.planarSlabTransverse k (OQ7Prescribed.scaledApertureWindow w R) (↑↑↑q)
          (OQ7Prescribed.slabHorizontalCoordinate x) (x.ofLp 2) u v
OQ7Prescribed.scaledSlabApertureDifference_smooth_bound : ∀ (k : ℝ) (hk : 0 < k) (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w)
  (hwc : HasCompactSupport w) (A X L : ℝ) (hA0 : 0 ≤ A) (hX : 0 ≤ X) (hL : 0 ≤ L)
  (hA : tsupport w ⊆ Metric.closedBall 0 A),
  ∃ K,
    0 < K ∧
      ∀ (R : ℝ) (hR : 1 ≤ R) (u v : ℂ),
        ‖u‖ ≤ 1 →
          ‖v‖ ≤ 1 →
            ∀ (f : ℝ → ℂ) (hf : ContDiff ℝ (↑⊤) f) (hc : HasCompactSupport f)
              (hs : tsupport f ⊆ Metric.closedBall 0 (L + 2)),
              ‖(OQ7Prescribed.scaledSlabApertureDifference k hk w hw hwc A X L hA0 hX hL hA R hR u v)
                    (OQ7Prescribed.heightSmoothElement (L + 2) f hf hc hs)‖ ≤
                K * ‖OQ7Prescribed.heightSmoothElement (L + 2) f hf hc hs‖
OQ7Prescribed.scaledSlabPolarization_current_ae : ∀ (w : ℂ → ℂ) (hw : ContDiff ℝ (↑⊤) w) (hwc : HasCompactSupport w)
  (A X L : ℝ) (hA0 : 0 ≤ A) (hX : 0 ≤ X) (hL : 0 ≤ L) (hA : tsupport w ⊆ Metric.closedBall 0 A) (R : ℝ) (hR : 1 ≤ R)
  (u : ℂ) (q : ↥(OQ7Prescribed.HeightSupportedL2 L)),
  (OQ7Prescribed.scaledSlabPolarization w hw hwc A X L hA0 hX hL hA R hR u q).current =ᵐ[MeasureTheory.volume] fun x =>
    OQ7Prescribed.slabSeparatedFunction (OQ7Prescribed.scaledApertureWindow w R) (↑↑↑q) x •
      OQ7Prescribed.complexify (OQ7Prescribed.slabPosition u 0)
@OQ7Prescribed.separatedProduct_memLp_two : ∀ {α : Type u_1} {β : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : MeasurableSpace β] {μ : MeasureTheory.Measure α} {ν : MeasureTheory.Measure β} [MeasureTheory.SFinite μ]
  [MeasureTheory.SFinite ν] (f : α → ℂ) (g : β → ℂ),
  MeasureTheory.MemLp f 2 μ → MeasureTheory.MemLp g 2 ν → MeasureTheory.MemLp (fun z => f z.1 * g z.2) 2 (μ.prod ν)
@OQ7Prescribed.separatedProduct_norm : ∀ {α : Type u_1} {β : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : MeasurableSpace β] {μ : MeasureTheory.Measure α} {ν : MeasureTheory.Measure β}
  [inst_2 : MeasureTheory.SFinite μ] [inst_3 : MeasureTheory.SFinite ν] (f : α → ℂ) (g : β → ℂ)
  (hf : MeasureTheory.MemLp f 2 μ) (hg : MeasureTheory.MemLp g 2 ν),
  ‖MeasureTheory.MemLp.toLp (fun z => f z.1 * g z.2) ⋯‖ =
    ‖MeasureTheory.MemLp.toLp f hf‖ * ‖MeasureTheory.MemLp.toLp g hg‖
@OQ7Prescribed.setRestrictionCLM_inner : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [inst_3 : CompleteSpace E]
  (μ : MeasureTheory.Measure α) (s : Set α) (hs : MeasurableSet s) (f : ↥(OQ7Prescribed.SetSupportedL2 μ s))
  (g : ↥(MeasureTheory.Lp E 2 μ)), inner ℂ ↑f ↑((OQ7Prescribed.setRestrictionCLM μ s hs) g) = inner ℂ (↑f) g
@OQ7Prescribed.setRestrictionCLM_norm_le : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [inst_3 : CompleteSpace E]
  (μ : MeasureTheory.Measure α) (s : Set α) (hs : MeasurableSet s), ‖OQ7Prescribed.setRestrictionCLM μ s hs‖ ≤ 1
@OQ7Prescribed.setSupportedL2_isClosed : ∀ {α : Type u_1} {E : Type u_2} [inst : MeasurableSpace α]
  [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [CompleteSpace E] (μ : MeasureTheory.Measure α)
  (s : Set α), MeasurableSet s → IsClosed ↑(OQ7Prescribed.setSupportedL2 μ s)
OQ7Prescribed.shrinking_cutoff_integral_tendsto : ∀ (f : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable f MeasureTheory.volume →
    Filter.Tendsto (fun ε => ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.exteriorCutoff ε ε x * f x)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds (∫ (x : OQ7Prescribed.Position), f x))
