OQ7Prescribed.greenHessian_eq_static_add_dynamic : ∀ (k : ℝ) (i j : Fin 3),
  OQ7Prescribed.greenHessian k i j =
    OQ7Prescribed.greenHessian 0 i j +
      Distribution.ofFun ⊤ (OQ7Prescribed.dynamicHessianRemainder k i j) MeasureTheory.volume ⊤
'OQ7Prescribed.greenHessian_eq_static_add_dynamic' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.dyadicGreenDistribution_eq_static_add_remainder : ∀ (k : ℝ) (i j : Fin 3),
  OQ7Prescribed.dyadicGreenDistribution k i j =
    OQ7Prescribed.greenHessian 0 i j +
      Distribution.ofFun ⊤ (fun x => ((OQ7Prescribed.dyadicRemainder k x) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume ⊤
'OQ7Prescribed.dyadicGreenDistribution_eq_static_add_remainder' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
OQ7Prescribed.outgoing_dyadic_contact_identity : ∀ (k : ℝ) (i j : Fin 3),
  OQ7Prescribed.dyadicGreenDistribution k i j =
    OQ7Prescribed.newtonPVDistribution i j - ((if i = j then 1 else 0) / 3) • OQ7Prescribed.newtonDirac +
      Distribution.ofFun ⊤ (fun x => ((OQ7Prescribed.dyadicRemainder k x) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume ⊤
'OQ7Prescribed.outgoing_dyadic_contact_identity' depends on axioms: [propext, Classical.choice, Quot.sound]
