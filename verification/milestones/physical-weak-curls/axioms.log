def OQ7Prescribed.HasWeakCurl : OQ7Prescribed.Field → OQ7Prescribed.Field → Prop :=
fun F G =>
  ∀ (φ : OQ7Prescribed.Field),
    ContDiff ℝ (↑⊤) φ →
      HasCompactSupport φ →
        ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.bilinear (F x) (OQ7Prescribed.curl φ x) =
          ∫ (x : OQ7Prescribed.Position), OQ7Prescribed.bilinear (G x) (φ x)
OQ7Prescribed.complexTestEval_partial_field : ∀ (F : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    ∀ (i j : Fin 3) (ψ : OQ7Prescribed.Position → ℂ) (hψ : ContDiff ℝ (↑⊤) ψ) (hs : HasCompactSupport ψ),
      OQ7Prescribed.complexTestEval
          ((OQ7Prescribed.distributionPartial j) (OQ7Prescribed.fieldComponentDistribution F i)) ψ hψ hs =
        -∫ (x : OQ7Prescribed.Position), (fderiv ℝ ψ x) (OQ7Prescribed.basisR j) * (F x).ofLp i
'OQ7Prescribed.complexTestEval_partial_field' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.distributionCurl_eq_implies_hasWeakCurl : ∀ (F G : OQ7Prescribed.Field),
  MeasureTheory.LocallyIntegrable F MeasureTheory.volume →
    MeasureTheory.LocallyIntegrable G MeasureTheory.volume →
      OQ7Prescribed.distributionCurl (OQ7Prescribed.fieldComponentDistribution F) =
          OQ7Prescribed.fieldComponentDistribution G →
        OQ7Prescribed.HasWeakCurl F G
'OQ7Prescribed.distributionCurl_eq_implies_hasWeakCurl' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.physicalSourceFields_first_weakCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.electricVolumeField k p) fun x =>
    (Complex.I * ↑k) • OQ7Prescribed.magneticVolumeField k p x
'OQ7Prescribed.physicalSourceFields_first_weakCurl' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.physicalSourceFields_second_weakCurl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.HasWeakCurl (OQ7Prescribed.magneticVolumeField k p) fun x =>
    (-Complex.I * ↑k) • (OQ7Prescribed.electricVolumeField k p x + p.current x)
'OQ7Prescribed.physicalSourceFields_second_weakCurl' depends on axioms: [propext, Classical.choice, Quot.sound]
