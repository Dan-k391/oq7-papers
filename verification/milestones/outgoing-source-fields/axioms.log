OQ7Prescribed.magneticExterior_eq_pointwise_far : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  p.radius + 1 ≤ ‖x‖ → OQ7Prescribed.exteriorMagnetic k p x = OQ7Prescribed.magneticVolumeField k p x
'OQ7Prescribed.magneticExterior_eq_pointwise_far' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.outgoingElectricField_eq_ae : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.outgoingElectricField k p =ᵐ[MeasureTheory.volume] OQ7Prescribed.electricVolumeField k p
'OQ7Prescribed.outgoingElectricField_eq_ae' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.outgoingPhysicalSourceFields : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.outgoingElectricField k p) ∧
    OQ7Prescribed.LocallySquareIntegrable (OQ7Prescribed.outgoingMagneticField k p) ∧
      (OQ7Prescribed.HasWeakCurl (OQ7Prescribed.outgoingElectricField k p) fun x =>
          (Complex.I * ↑k) • OQ7Prescribed.outgoingMagneticField k p x) ∧
        (OQ7Prescribed.HasWeakCurl (OQ7Prescribed.outgoingMagneticField k p) fun x =>
            (-Complex.I * ↑k) • (OQ7Prescribed.outgoingElectricField k p x + p.current x)) ∧
          OQ7Prescribed.Outgoing (OQ7Prescribed.outgoingElectricField k p) (OQ7Prescribed.outgoingMagneticField k p)
'OQ7Prescribed.outgoingPhysicalSourceFields' depends on axioms: [propext, Classical.choice, Quot.sound]
