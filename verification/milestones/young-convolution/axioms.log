OQ7Prescribed.weighted_integral_cauchy_sq : ∀ (w g : OQ7Prescribed.Position → ℝ),
  MeasureTheory.Integrable w MeasureTheory.volume →
    MeasureTheory.Integrable (fun y => w y * g y) MeasureTheory.volume →
      MeasureTheory.Integrable (fun y => w y * g y ^ 2) MeasureTheory.volume →
        (∀ᵐ (y : OQ7Prescribed.Position), 0 ≤ w y) →
          (∫ (y : OQ7Prescribed.Position), w y * g y) ^ 2 ≤
            (∫ (y : OQ7Prescribed.Position), w y) * ∫ (y : OQ7Prescribed.Position), w y * g y ^ 2
'OQ7Prescribed.weighted_integral_cauchy_sq' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.scalarVectorConvolution_ae_integrable : ∀ (K : OQ7Prescribed.Position → ℂ) (f : OQ7Prescribed.Field),
  MeasureTheory.Integrable K MeasureTheory.volume →
    MeasureTheory.Integrable f MeasureTheory.volume →
      ∀ᵐ (x : OQ7Prescribed.Position), MeasureTheory.Integrable (fun y => K y • f (x - y)) MeasureTheory.volume
'OQ7Prescribed.scalarVectorConvolution_ae_integrable' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.scalarVectorConvolution_memLp_two : ∀ (K : OQ7Prescribed.Position → ℂ) (f : OQ7Prescribed.Field),
  MeasureTheory.Integrable K MeasureTheory.volume →
    MeasureTheory.Integrable f MeasureTheory.volume →
      MeasureTheory.MemLp f 2 MeasureTheory.volume →
        MeasureTheory.MemLp (OQ7Prescribed.scalarVectorConvolution K f) 2 MeasureTheory.volume ∧
          ∫ (x : OQ7Prescribed.Position), ‖OQ7Prescribed.scalarVectorConvolution K f x‖ ^ 2 ≤
            (∫ (y : OQ7Prescribed.Position), ‖K y‖) ^ 2 * ∫ (x : OQ7Prescribed.Position), ‖f x‖ ^ 2
'OQ7Prescribed.scalarVectorConvolution_memLp_two' depends on axioms: [propext, Classical.choice, Quot.sound]
