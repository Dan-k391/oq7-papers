                                  (HDiv.hDiv.{0, 0, 0}
                                    (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} k √P) (∫ (z : ℝ) in a j..b j, F.q z)) Q)))
                            √(HDiv.hDiv.{0, 0, 0} (Matrix.det.{0, 0} (F.unitTotalAbsorption D)).re
