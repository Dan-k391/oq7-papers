THEOREM GeneralizedResearch.PhysicalBeamCorollary.corollary65
TYPE ∀ (k P Q X0 ε : ℝ),
  LT.lt.{0} 0 k →
    LT.lt.{0} 1 P →
      LT.lt.{0} 0 Q →
        LT.lt.{0} 0 X0 →
          LT.lt.{0} X0 4 →
            LT.lt.{0} 0 ε →
              ∃ (d : GeneralizedResearch.PhysicalBeamL2.Design),
                Eq.{1} d.k k ∧
                  LT.lt.{0} 0 d.η ∧
                    LE.le.{0} d.η Q ∧
                      LT.lt.{0} 0 d.h ∧
                        LE.le.{0} (OQ7Prescribed.plateDesignPermittivity d.j) P ∧
                          LT.lt.{0} (-1) d.t ∧
                            LT.lt.{0} d.t 1 ∧
                              (GeneralizedResearch.PhysicalBeamCorollary.Realizes d
                                  fun (x : GeneralizedResearch.PhysicalBeamCorollary.Transverse) =>
                                  GeneralizedResearch.BeamFibers.left) ∧
                                GeneralizedResearch.PhysicalBeamCorollary.Realizes d d.reverseInput ∧
                                  Eq.{1}
                                      (Norm.norm.{0}
                                        (GeneralizedResearch.PhysicalBeamL2.beam d.r
                                          (fun (x : GeneralizedResearch.PhysicalBeamL2.Transverse) =>
                                            GeneralizedResearch.BeamFibers.left)
                                          ⋯))
                                      1 ∧
                                    Eq.{1}
                                        (Norm.norm.{0} (GeneralizedResearch.PhysicalBeamL2.beam d.r d.reverseInput ⋯))
                                        1 ∧
                                      Eq.{1}
                                          (GeneralizedResearch.PhysicalBeamL2.extinction d
                                            (fun (x : GeneralizedResearch.PhysicalBeamL2.Transverse) =>
                                              GeneralizedResearch.BeamFibers.left)
                                            ⋯)
                                          X0 ∧
                                        Eq.{1} (GeneralizedResearch.PhysicalBeamL2.extinction d d.reverseInput ⋯) X0 ∧
                                          LE.le.{0}
                                              (HSub.hSub.{0, 0, 0}
                                                (HSub.hSub.{0, 0, 0} X0
                                                  (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} X0 2) 4))
                                                ε)
                                              (abs.{0}
                                                (HSub.hSub.{0, 0, 0}
                                                  (GeneralizedResearch.PhysicalBeamL2.absorption d d.reverseInput ⋯)
                                                  (GeneralizedResearch.PhysicalBeamL2.absorption d
                                                    (fun (x : GeneralizedResearch.PhysicalBeamL2.Transverse) =>
                                                      GeneralizedResearch.BeamFibers.left)
                                                    ⋯))) ∧
                                            LE.le.{0}
                                                (abs.{0}
                                                  (HSub.hSub.{0, 0, 0}
                                                    (GeneralizedResearch.PhysicalBeamL2.absorption d d.reverseInput ⋯)
                                                    (GeneralizedResearch.PhysicalBeamL2.absorption d
                                                      (fun (x : GeneralizedResearch.PhysicalBeamL2.Transverse) =>
                                                        GeneralizedResearch.BeamFibers.left)
                                                      ⋯)))
                                                (HSub.hSub.{0, 0, 0} X0
                                                  (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} X0 2) 4)) ∧
                                              Eq.{1}
                                                  (HMul.hMul.{0, 0, 0} (1 / 2)
                                                    (Inner.inner.{0, 0} ℂ
                                                        (GeneralizedResearch.BoundaryFlux.electricField d
                                                          (fun (x : GeneralizedResearch.BoundaryFlux.Transverse) =>
                                                            GeneralizedResearch.BeamFibers.left)
                                                          ⋯)
                                                        (GeneralizedResearch.BoundaryFlux.magneticField d
                                                          (fun (x : GeneralizedResearch.BoundaryFlux.Transverse) =>
                                                            GeneralizedResearch.BeamFibers.left)
                                                          ⋯)).re)
                                                  (GeneralizedResearch.PhysicalBeamL2.absorption d
                                                    (fun (x : GeneralizedResearch.PhysicalBeamL2.Transverse) =>
                                                      GeneralizedResearch.BeamFibers.left)
                                                    ⋯) ∧
                                                Eq.{1}
                                                  (HMul.hMul.{0, 0, 0} (1 / 2)
                                                    (Inner.inner.{0, 0} ℂ
                                                        (GeneralizedResearch.BoundaryFlux.electricField d d.reverseInput
                                                          ⋯)
                                                        (GeneralizedResearch.BoundaryFlux.magneticField d d.reverseInput
                                                          ⋯)).re)
                                                  (GeneralizedResearch.PhysicalBeamL2.absorption d d.reverseInput ⋯)
AXIOMS [propext, Classical.choice, Quot.sound]
