      LT.lt.{0} 0 P →
        LT.lt.{0} 0 Q →
          (∀ (j : ι), Membership.mem.{u_1, u_1} s j → Set.Ioc.{0} (a j) (b j) ⊆ Set.Ioc.{0} 0 D) →
            (Set.Pairwise.{u_1} ↑s fun (i j : ι) => Disjoint.{0} (Set.Ioc.{0} (a i) (b i)) (Set.Ioc.{0} (a j) (b j))) →
