                      LT.lt.{0} 0 (OQ7.transmissionPower (F.unitTransmission D)) ∧
                        (∀ (j : ι),
                            Membership.mem.{u_1, u_1} s j →
                              Membership.mem.{0, 0} (Set.Icc.{0} 0 Real.pi)
                                  (HDiv.hDiv.{0, 0, 0}
                                    (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} k √P) (∫ (z : ℝ) in a j..b j, F.q z)) Q) ∧
                                LE.le.{0}
