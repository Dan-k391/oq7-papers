THEOREM GeneralizedResearch.PhysicalBeamApproximation.capped_physical_approach
TYPE ∀ (k P Q X0 ε : ℝ),
  LT.lt.{0} 0 k →
    LT.lt.{0} 1 P →
      LT.lt.{0} 0 Q →
        LT.lt.{0} 0 X0 →
          LT.lt.{0} X0 4 →
            LT.lt.{0} 0 ε →
              ∃ (η : ℝ) (h : ℝ) (j : ℕ),
                LT.lt.{0} 0 η ∧
                  LE.le.{0} η Q ∧
                    LT.lt.{0} 0 h ∧
                      LE.le.{0} 1 j ∧
                        LE.le.{0} (OQ7Prescribed.plateDesignPermittivity j) P ∧
                          ∃ (r : ℝ),
                            LT.lt.{0} 0 r ∧
                              LE.le.{0} r (HDiv.hDiv.{0, 0, 0} k 2) ∧
                                ∃ (t : ℝ),
                                  LT.lt.{0} (-1) t ∧
                                    LT.lt.{0} t 1 ∧
                                      Eq.{1}
                                          (GeneralizedResearch.BeamAveraging.diskAverage r
                                            (GeneralizedResearch.BeamFibers.X k η h j t))
                                          X0 ∧
                                        LE.le.{0}
                                          (HSub.hSub.{0, 0, 0}
                                            (HSub.hSub.{0, 0, 0} X0 (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} X0 2) 4))
                                            ε)
                                          (GeneralizedResearch.BeamAveraging.diskAverage r
                                            (GeneralizedResearch.BeamFibers.D k η h j t))
AXIOMS [propext, Classical.choice, Quot.sound]
