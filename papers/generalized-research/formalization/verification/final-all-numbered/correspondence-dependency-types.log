THEOREM OQ7.capped_fourier_moment_Ioo
TYPE ∀ {q : ℝ → ℝ} {a b K Q : ℝ},
  LE.le.{0} a b →
    LT.lt.{0} 0 K →
      LT.lt.{0} 0 Q →
        LE.le.{0} (HSub.hSub.{0, 0, 0} b a) (HDiv.hDiv.{0, 0, 0} Real.pi K) →
          IntervalIntegrable.{0} q MeasureTheory.MeasureSpace.volume.{0} a b →
            (∀ (z : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} a b) z → LE.le.{0} 0 (q z) ∧ LE.le.{0} (q z) Q) →
              LE.le.{0}
                (Norm.norm.{0}
                  (∫ (z : ℝ) in a..b,
                    HMul.hMul.{0, 0, 0} (↑(q z))
                      (Complex.exp
                        (HMul.hMul.{0, 0, 0} (↑(HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 K) z)) Complex.I))))
                (HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} Q K)
                  (Real.sin (HDiv.hDiv.{0, 0, 0} (HMul.hMul.{0, 0, 0} K (∫ (z : ℝ) in a..b, q z)) Q)))
AXIOMS [propext, Classical.choice, Quot.sound]
THEOREM OQ7.sineSquare_triangleIntegral_capped_Ioo
TYPE ∀ {q : ℝ → ℝ} {a b K Q : ℝ},
  LE.le.{0} a b →
    LT.lt.{0} 0 K →
      LT.lt.{0} 0 Q →
        LE.le.{0} (HSub.hSub.{0, 0, 0} b a) (HDiv.hDiv.{0, 0, 0} Real.pi K) →
          IntervalIntegrable.{0} q MeasureTheory.MeasureSpace.volume.{0} a b →
            (∀ (z : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} a b) z → LE.le.{0} 0 (q z) ∧ LE.le.{0} (q z) Q) →
              LE.le.{0}
                (HMul.hMul.{0, 0, 0}
                  (HDiv.hDiv.{0, 0, 0} (HPow.hPow.{0, 0, 0} Q 2) (HMul.hMul.{0, 0, 0} 4 (HPow.hPow.{0, 0, 0} K 2)))
                  (HSub.hSub.{0, 0, 0}
                    (HPow.hPow.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} (HMul.hMul.{0, 0, 0} K (∫ (z : ℝ) in a..b, q z)) Q) 2)
                    (HPow.hPow.{0, 0, 0}
                      (Real.sin (HDiv.hDiv.{0, 0, 0} (HMul.hMul.{0, 0, 0} K (∫ (z : ℝ) in a..b, q z)) Q)) 2)))
                (∫ (p : Prod.{0, 0} ℝ ℝ) in Set.ofPred.{0} fun (p : Prod.{0, 0} ℝ ℝ) => LT.lt.{0} p.1 p.2,
                  HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} (q p.1) (q p.2))
                    (HPow.hPow.{0, 0, 0} (Real.sin (HMul.hMul.{0, 0, 0} K (HSub.hSub.{0, 0, 0} p.2 p.1)))
                      2) ∂MeasureTheory.Measure.prod.{0, 0}
                    (MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} (Set.Ioc.{0} a b))
                    (MeasureTheory.Measure.restrict.{0} MeasureTheory.MeasureSpace.volume.{0} (Set.Ioc.{0} a b)))
AXIOMS [propext, Classical.choice, Quot.sound]
