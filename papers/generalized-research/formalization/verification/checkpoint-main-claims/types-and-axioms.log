THEOREM GeneralizedResearch.HelmholtzProfile.Profile.theorem45_finite
TYPE ∀ {k : ℝ} (F : GeneralizedResearch.HelmholtzProfile.Profile k) {P Q M L D : ℝ},
  LT.lt.{0} 0 k →
    LT.lt.{0} 0 P →
      LT.lt.{0} 0 Q →
        LT.lt.{0} 0 M →
          LT.lt.{0} 0 L →
            F.Selected P Q M L D →
              LE.le.{0} (OQ7.ResourceFloor.beta k P Q M (OQ7.ResourceFloor.halfCellCount k P L)) (F.invariant D) ∧
                LE.le.{0}
                    (HDiv.hDiv.{0, 0, 0}
                      (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 4 (HPow.hPow.{0, 0, 0} k 4)) (HPow.hPow.{0, 0, 0} M 4))
                      (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 3 (HPow.hPow.{0, 0, 0} Q 2))
                        (HPow.hPow.{0, 0, 0}
                          (HAdd.hAdd.{0, 0, 0} Real.pi
                            (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 k) √P) L))
                          2)))
                    (OQ7.ResourceFloor.beta k P Q M (OQ7.ResourceFloor.halfCellCount k P L)) ∧
                  LT.lt.{0} 0
                      (HDiv.hDiv.{0, 0, 0}
                        (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 4 (HPow.hPow.{0, 0, 0} k 4))
                          (HPow.hPow.{0, 0, 0} M 4))
                        (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 3 (HPow.hPow.{0, 0, 0} Q 2))
                          (HPow.hPow.{0, 0, 0}
                            (HAdd.hAdd.{0, 0, 0} Real.pi
                              (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 k) √P) L))
                            2))) ∧
                    (LE.le.{0} (OQ7.ResourceFloor.U k P Q M) (HDiv.hDiv.{0, 0, 0} Real.pi 2) ∨
                        LE.le.{0}
                          (HDiv.hDiv.{0, 0, 0} (OQ7.ResourceFloor.U k P Q M) ↑(OQ7.ResourceFloor.fullCellCount k P L))
                          (1 / 3) →
                      LE.le.{0} (OQ7.ResourceFloor.beta k P Q M (OQ7.ResourceFloor.fullCellCount k P L))
                        (F.invariant D))
AXIOMS [propext, Classical.choice, Quot.sound]
