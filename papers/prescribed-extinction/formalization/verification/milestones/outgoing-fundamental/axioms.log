OQ7Prescribed.outgoing_helmholtz_fundamental_distribution : ∀ (k : ℝ),
  ∑ i, OQ7Prescribed.greenHessian k i i + k ^ 2 • OQ7Prescribed.outgoingGreenDistribution k = -OQ7Prescribed.newtonDirac
'OQ7Prescribed.outgoing_helmholtz_fundamental_distribution' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.outgoing_helmholtz_fundamental_apply : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingGreenDistribution k) (OQ7Prescribed.testLaplacian φ) +
      k ^ 2 • (OQ7Prescribed.outgoingGreenDistribution k) φ =
    -↑(φ 0)
'OQ7Prescribed.outgoing_helmholtz_fundamental_apply' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.outgoingGreen_helmholtz_test_integral : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  ∫ (x : OQ7Prescribed.Position), ((OQ7Prescribed.testLaplacian φ) x + k ^ 2 * φ x) • OQ7Prescribed.outgoingGreen k x =
    -↑(φ 0)
'OQ7Prescribed.outgoingGreen_helmholtz_test_integral' depends on axioms: [propext, Classical.choice, Quot.sound]
