def OQ7Prescribed.Theorem11Statement : Prop :=
∀ (k P Q target : ℝ),
  0 < k →
    1 < P →
      0 < Q →
        0 < target →
          ∀ (ε : ℝ),
            0 < ε →
              ε < 1 →
                ∃ B,
                  B.admissible P Q ∧
                    ∃ sp sm,
                      OQ7Prescribed.extinction k B OQ7Prescribed.Direction.plus sp.electric = target ∧
                        OQ7Prescribed.extinction k B OQ7Prescribed.Direction.minus sm.electric = target ∧
                          1 - ε < OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric ∧
                            OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric < 1
'OQ7Prescribed.Theorem11Statement' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.axisCoupling_bound : ∀ (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  ‖u‖ ^ 2 = 1 → Complex.normSq (OQ7Prescribed.axisCoupling u v) ≤ OQ7Prescribed.squareNorm v
OQ7Prescribed.axisCoupling_eq_inner : ∀ (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.axisCoupling u v = inner ℂ (OQ7Prescribed.complexify u) v
OQ7Prescribed.complexify_continuous : Continuous OQ7Prescribed.complexify
OQ7Prescribed.complexify_norm_sq : ∀ (u : OQ7Prescribed.Position), ‖OQ7Prescribed.complexify u‖ ^ 2 = ‖u‖ ^ 2
OQ7Prescribed.cutoffGreen_memLp : ∀ (k T : ℝ),
  MeasureTheory.MemLp (OQ7Prescribed.cutoffGreen k T) 2 MeasureTheory.volume
OQ7Prescribed.domain_compact_closure : ∀ (B : OQ7Prescribed.TwoLayerBody), IsCompact (closure B.domain)
OQ7Prescribed.domain_subset_closedBall : ∀ (B : OQ7Prescribed.TwoLayerBody),
  B.domain ⊆ Metric.closedBall 0 (B.aperture + B.absorberThickness + B.plateThickness)
OQ7Prescribed.dyadicGreenDistribution_apply : ∀ (k : ℝ) (i j : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.dyadicGreenDistribution k i j) φ =
    (if i = j then k ^ 2 • ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingGreen k x else 0) +
      ∫ (x : OQ7Prescribed.Position),
        ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x • OQ7Prescribed.outgoingGreen k x
OQ7Prescribed.greenHessian_apply : ∀ (k : ℝ) (i j : Fin 3) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.greenHessian k i j) φ =
    (OQ7Prescribed.outgoingGreenDistribution k) ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ))
OQ7Prescribed.incident_absorber_coupling : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.axisCoupling (OQ7Prescribed.basisR 0) (OQ7Prescribed.incidentElectric k σ x) = 0
OQ7Prescribed.incident_plate_coupling : ∀ (θ k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.axisCoupling (OQ7Prescribed.rotatedAxis θ) (OQ7Prescribed.incidentElectric k σ x) =
    ↑(Real.sin θ) * OQ7Prescribed.planePhase k σ x
OQ7Prescribed.incident_plate_rankOne : ∀ (θ k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.tensorApply (OQ7Prescribed.rankOne (OQ7Prescribed.rotatedAxis θ))
      (OQ7Prescribed.incidentElectric k σ x) =
    (↑(Real.sin θ) * OQ7Prescribed.planePhase k σ x) • OQ7Prescribed.complexify (OQ7Prescribed.rotatedAxis θ)
OQ7Prescribed.incident_plate_rankOne_zero_angle : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.tensorApply (OQ7Prescribed.rankOne (OQ7Prescribed.rotatedAxis 0))
      (OQ7Prescribed.incidentElectric k σ x) =
    0
OQ7Prescribed.incidentElectric_minus_conjugate : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  OQ7Prescribed.incidentElectric k OQ7Prescribed.Direction.minus x =
    WithLp.toLp 2 fun i => star ((OQ7Prescribed.incidentElectric k OQ7Prescribed.Direction.plus x).ofLp i)
OQ7Prescribed.incidentElectric_squareNorm : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  OQ7Prescribed.squareNorm (OQ7Prescribed.incidentElectric k σ x) = 1
OQ7Prescribed.layerPermittivity_admissible : ∀ (P Q a b ν : ℝ) (u : OQ7Prescribed.Position),
  ‖u‖ ^ 2 = 1 →
    0 ≤ a →
      1 + a ≤ P →
        0 ≤ b → 0 < ν → b + ν ≤ Q → OQ7Prescribed.MaterialAdmissible P Q (OQ7Prescribed.layerPermittivity a b ν u)
OQ7Prescribed.layerPermittivity_reciprocal : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position),
  Matrix.transpose (OQ7Prescribed.layerPermittivity a b ν u) = OQ7Prescribed.layerPermittivity a b ν u
OQ7Prescribed.outgoingGreen_locallyIntegrable : ∀ (k : ℝ),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.outgoingGreen k) MeasureTheory.volume
OQ7Prescribed.outgoingGreen_measurable : ∀ (k : ℝ), Measurable (OQ7Prescribed.outgoingGreen k)
OQ7Prescribed.outgoingGreen_memLp_on_compact : ∀ (k : ℝ) (K : Set OQ7Prescribed.Position),
  IsCompact K → MeasureTheory.MemLp (OQ7Prescribed.outgoingGreen k) 2 (MeasureTheory.volume.restrict K)
OQ7Prescribed.outgoingGreen_norm : ∀ (k : ℝ) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.outgoingGreen k x‖ = (4 * Real.pi * ‖x‖)⁻¹
OQ7Prescribed.outgoingGreen_sq_norm_locallyIntegrable : ∀ (k : ℝ),
  MeasureTheory.LocallyIntegrable (fun x => ‖OQ7Prescribed.outgoingGreen k x‖ ^ 2) MeasureTheory.volume
OQ7Prescribed.outgoingGreenDistribution_apply : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingGreenDistribution k) φ = ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingGreen k x
OQ7Prescribed.outgoingPotential_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.outgoingPotential k (p.add q) =
    OQ7Prescribed.outgoingPotential k p + OQ7Prescribed.outgoingPotential k q
OQ7Prescribed.outgoingPotential_aestronglyMeasurable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.AEStronglyMeasurable (OQ7Prescribed.outgoingPotential k p) MeasureTheory.volume
OQ7Prescribed.outgoingPotential_congr_current : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  p.current =ᵐ[MeasureTheory.volume] q.current →
    OQ7Prescribed.outgoingPotential k p = OQ7Prescribed.outgoingPotential k q
OQ7Prescribed.outgoingPotential_enorm_le : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x : OQ7Prescribed.Position), ‖x‖ ≤ S → ‖OQ7Prescribed.outgoingPotential k p x‖ₑ ≤ OQ7Prescribed.potentialBound k p S
OQ7Prescribed.outgoingPotential_eq_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    OQ7Prescribed.outgoingPotential k p x =
      MeasureTheory.convolution p.current (OQ7Prescribed.cutoffGreen k (S + p.radius)) OQ7Prescribed.vectorScalarMul
        MeasureTheory.volume x
OQ7Prescribed.outgoingPotential_integrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (x : OQ7Prescribed.Position),
  MeasureTheory.Integrable (fun y => OQ7Prescribed.outgoingGreen k (x - y) • p.current y) MeasureTheory.volume
OQ7Prescribed.outgoingPotential_integrand_cutoff : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ)
  (x y : OQ7Prescribed.Position),
  ‖x‖ ≤ S →
    (OQ7Prescribed.vectorScalarMul (p.current y)) (OQ7Prescribed.outgoingGreen k (x - y)) =
      (OQ7Prescribed.vectorScalarMul (p.current y)) (OQ7Prescribed.cutoffGreen k (S + p.radius) (x - y))
OQ7Prescribed.outgoingPotential_locallyIntegrable : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  MeasureTheory.LocallyIntegrable (OQ7Prescribed.outgoingPotential k p) MeasureTheory.volume
OQ7Prescribed.outgoingVolumeDistribution_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.outgoingVolumeDistribution k (p.add q) i =
    OQ7Prescribed.outgoingVolumeDistribution k p i + OQ7Prescribed.outgoingVolumeDistribution k q i
OQ7Prescribed.outgoingVolumeDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.outgoingVolumeDistribution k p i) φ =
    k ^ 2 • (∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingPotential k p x).ofLp i +
      ∑ j,
        (∫ (x : OQ7Prescribed.Position),
              ((OQ7Prescribed.testPartial j) ((OQ7Prescribed.testPartial i) φ)) x •
                OQ7Prescribed.outgoingPotential k p x).ofLp
          j
OQ7Prescribed.pairing_self : ∀ (v : OQ7Prescribed.Vector), OQ7Prescribed.pairing v v = ↑(OQ7Prescribed.squareNorm v)
OQ7Prescribed.permittivity_one_outside : ∀ (B : OQ7Prescribed.TwoLayerBody), ∀ x ∉ B.domain, B.permittivity x = 1
OQ7Prescribed.permittivity_reciprocal : ∀ (B : OQ7Prescribed.TwoLayerBody) (P Q : ℝ),
  B.admissible P Q → ∀ (x : OQ7Prescribed.Position), Matrix.transpose (B.permittivity x) = B.permittivity x
OQ7Prescribed.planePhase_norm : ∀ (k : ℝ) (σ : OQ7Prescribed.Direction) (x : OQ7Prescribed.Position),
  ‖OQ7Prescribed.planePhase k σ x‖ = 1
OQ7Prescribed.polarization_zero_outside : ∀ (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field),
  ∀ x ∉ B.domain, OQ7Prescribed.polarization B E x = 0
OQ7Prescribed.potentialBound_lt_top : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (S : ℝ),
  OQ7Prescribed.potentialBound k p S < ⊤
OQ7Prescribed.potentialComponentDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialComponentDistribution k p i) φ =
    (∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingPotential k p x).ofLp i
OQ7Prescribed.potentialDistribution_add : ∀ (k : ℝ) (p q : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.potentialDistribution k (p.add q) =
    OQ7Prescribed.potentialDistribution k p + OQ7Prescribed.potentialDistribution k q
OQ7Prescribed.potentialDistribution_apply : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (φ : OQ7Prescribed.ScalarTest),
  (OQ7Prescribed.potentialDistribution k p) φ =
    ∫ (x : OQ7Prescribed.Position), φ x • OQ7Prescribed.outgoingPotential k p x
OQ7Prescribed.quadratic_layer : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.quadratic (OQ7Prescribed.layerPermittivity a b ν u) v =
    (1 + Complex.I * ↑ν) * ↑(OQ7Prescribed.squareNorm v) +
      (↑a + Complex.I * ↑b) * ↑(Complex.normSq (OQ7Prescribed.axisCoupling u v))
OQ7Prescribed.quadratic_layer_im : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (OQ7Prescribed.quadratic (OQ7Prescribed.layerPermittivity a b ν u) v).im =
    ν * OQ7Prescribed.squareNorm v + b * Complex.normSq (OQ7Prescribed.axisCoupling u v)
OQ7Prescribed.quadratic_layer_re : ∀ (a b ν : ℝ) (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (OQ7Prescribed.quadratic (OQ7Prescribed.layerPermittivity a b ν u) v).re =
    OQ7Prescribed.squareNorm v + a * Complex.normSq (OQ7Prescribed.axisCoupling u v)
OQ7Prescribed.rankOne_transpose : ∀ (u : OQ7Prescribed.Position),
  Matrix.transpose (OQ7Prescribed.rankOne u) = OQ7Prescribed.rankOne u
OQ7Prescribed.rotatedAxis_unit : ∀ (θ : ℝ), ‖OQ7Prescribed.rotatedAxis θ‖ ^ 2 = 1
OQ7Prescribed.sphereDirection_unit : ∀ (θ φ : ℝ), ‖OQ7Prescribed.sphereDirection θ φ‖ ^ 2 = 1
OQ7Prescribed.squareNorm_eq_norm_sq : ∀ (v : OQ7Prescribed.Vector), OQ7Prescribed.squareNorm v = ‖v‖ ^ 2
OQ7Prescribed.squareNorm_nonneg : ∀ (v : OQ7Prescribed.Vector), 0 ≤ OQ7Prescribed.squareNorm v
@OQ7Prescribed.squareNorm_pos : ∀ {v : OQ7Prescribed.Vector}, v ≠ 0 → 0 < OQ7Prescribed.squareNorm v
OQ7Prescribed.staticFourierOperator_apply_norm_le : ∀ (f : ↥OQ7Prescribed.VectorL2),
  ‖OQ7Prescribed.staticFourierOperator f‖ ≤ ‖f‖
OQ7Prescribed.staticFourierOperator_norm_le : ‖OQ7Prescribed.staticFourierOperator‖ ≤ 1
OQ7Prescribed.staticFourierOperator_quadratic_im : ∀ (f : ↥OQ7Prescribed.VectorL2),
  (inner ℂ f (OQ7Prescribed.staticFourierOperator f)).im = 0
OQ7Prescribed.staticMultiplierCLM_norm_le : ‖OQ7Prescribed.staticMultiplierCLM‖ ≤ 1
OQ7Prescribed.staticMultiplierLp_add : ∀ (f g : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.staticMultiplierLp (f + g) = OQ7Prescribed.staticMultiplierLp f + OQ7Prescribed.staticMultiplierLp g
OQ7Prescribed.staticMultiplierLp_coe : ∀ (f : ↥OQ7Prescribed.VectorL2),
  ↑↑(OQ7Prescribed.staticMultiplierLp f) =ᵐ[MeasureTheory.volume] fun ξ => (OQ7Prescribed.staticSymbol ξ) (↑↑f ξ)
OQ7Prescribed.staticMultiplierLp_norm_le : ∀ (f : ↥OQ7Prescribed.VectorL2), ‖OQ7Prescribed.staticMultiplierLp f‖ ≤ ‖f‖
OQ7Prescribed.staticMultiplierLp_quadratic_im : ∀ (f : ↥OQ7Prescribed.VectorL2),
  (inner ℂ f (OQ7Prescribed.staticMultiplierLp f)).im = 0
OQ7Prescribed.staticMultiplierLp_smul : ∀ (z : ℂ) (f : ↥OQ7Prescribed.VectorL2),
  OQ7Prescribed.staticMultiplierLp (z • f) = z • OQ7Prescribed.staticMultiplierLp f
OQ7Prescribed.staticSymbol_apply : ∀ (ξ : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (OQ7Prescribed.staticSymbol ξ) v = -↑(‖ξ‖ ^ 2)⁻¹ • OQ7Prescribed.tensorApply (OQ7Prescribed.rankOne ξ) v
OQ7Prescribed.staticSymbol_apply_norm_le : ∀ (ξ : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  ‖(OQ7Prescribed.staticSymbol ξ) v‖ ≤ ‖v‖
OQ7Prescribed.staticSymbol_memLp : ∀ (f : ↥OQ7Prescribed.VectorL2),
  MeasureTheory.MemLp (fun ξ => (OQ7Prescribed.staticSymbol ξ) (↑↑f ξ)) 2 MeasureTheory.volume
OQ7Prescribed.staticSymbol_norm_le : ∀ (ξ : OQ7Prescribed.Position), ‖OQ7Prescribed.staticSymbol ξ‖ ≤ 1
OQ7Prescribed.staticSymbol_quadratic : ∀ (ξ : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  inner ℂ v ((OQ7Prescribed.staticSymbol ξ) v) = -↑(‖ξ‖ ^ 2)⁻¹ * ↑(Complex.normSq (OQ7Prescribed.axisCoupling ξ v))
OQ7Prescribed.staticSymbol_quadratic_im : ∀ (ξ : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  (inner ℂ v ((OQ7Prescribed.staticSymbol ξ) v)).im = 0
OQ7Prescribed.susceptibility_zero_outside : ∀ (B : OQ7Prescribed.TwoLayerBody), ∀ x ∉ B.domain, B.susceptibility x = 0
OQ7Prescribed.tensorApply_one : ∀ (v : OQ7Prescribed.Vector), OQ7Prescribed.tensorApply 1 v = v
OQ7Prescribed.tensorApply_rankOne : ∀ (u : OQ7Prescribed.Position) (v : OQ7Prescribed.Vector),
  OQ7Prescribed.tensorApply (OQ7Prescribed.rankOne u) v = OQ7Prescribed.axisCoupling u v • OQ7Prescribed.complexify u
OQ7Prescribed.vectorScalarMul_apply : ∀ (v : OQ7Prescribed.Vector) (z : ℂ), (OQ7Prescribed.vectorScalarMul v) z = z • v
