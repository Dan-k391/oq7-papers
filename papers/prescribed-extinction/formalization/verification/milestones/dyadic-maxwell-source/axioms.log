OQ7Prescribed.outgoingVolumeDistribution_maxwell_source : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization) (i : Fin 3),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p)) i -
      k ^ 2 • OQ7Prescribed.outgoingVolumeDistribution k p i =
    k ^ 2 • OQ7Prescribed.polarizationCurrentComponentDistribution p i
'OQ7Prescribed.outgoingVolumeDistribution_maxwell_source' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.outgoingVolumeDistribution_maxwell_source_L2 : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization)
  (i : Fin 3),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p)) i -
      k ^ 2 • OQ7Prescribed.outgoingVolumeDistribution k p i =
    k ^ 2 • OQ7Prescribed.vectorL2ComponentDistribution (MeasureTheory.MemLp.toLp p.current ⋯) i
'OQ7Prescribed.outgoingVolumeDistribution_maxwell_source_L2' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.outgoingVolumeDistribution_first_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingVolumeDistribution k p) =
    (Complex.I * ↑k) • OQ7Prescribed.outgoingMagneticDistribution k p
'OQ7Prescribed.outgoingVolumeDistribution_first_curl' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.outgoingMagneticDistribution_second_curl : ∀ (k : ℝ) (p : OQ7Prescribed.CompactPolarization),
  OQ7Prescribed.distributionCurl (OQ7Prescribed.outgoingMagneticDistribution k p) =
    (-Complex.I * ↑k) •
      (OQ7Prescribed.outgoingVolumeDistribution k p + OQ7Prescribed.polarizationCurrentComponentDistribution p)
'OQ7Prescribed.outgoingMagneticDistribution_second_curl' depends on axioms: [propext, Classical.choice, Quot.sound]
