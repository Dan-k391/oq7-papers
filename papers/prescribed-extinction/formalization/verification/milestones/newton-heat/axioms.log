OQ7Prescribed.newtonHeatKernel_factor : ∀ (t : ℝ),
  0 < t →
    ∀ (x : OQ7Prescribed.Position),
      OQ7Prescribed.newtonHeatKernel t x = (4 * Real.pi) ^ (-(3 / 2)) * (t ^ (-(3 / 2)) * Real.exp (-(‖x‖ ^ 2 / 4) / t))
