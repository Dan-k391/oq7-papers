OQ7Prescribed.continuousLinearMap_inner_of_norm_mul.{u_1, u_2} {E : Type u_1} {F : Type u_2} [NormedAddCommGroup E]
  [InnerProductSpace ℂ E] [NormedAddCommGroup F] [InnerProductSpace ℂ F] (J : E →L[ℂ] F) (R : ℝ)
  (hJ : ∀ (q : E), ‖J q‖ = R * ‖q‖) (q r : E) : inner ℂ (J q) (J r) = R ^ 2 • inner ℂ q r
OQ7Prescribed.inner_quadratic_difference_norm_bound.{u_1} {E : Type u_1} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [CompleteSpace E] (M : E →L[ℂ] E) (r s : E) : ‖inner ℂ r (M r) - inner ℂ s (M s)‖ ≤ ‖M‖ * (‖r‖ + ‖s‖) * ‖r - s‖
OQ7Prescribed.bodySharpScalarLift_inner (B : OQ7Prescribed.TwoLayerBody)
  (q r : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))) :
  inner ℂ ((OQ7Prescribed.bodySharpScalarLift B) q) ((OQ7Prescribed.bodySharpScalarLift B) r) =
    B.aperture ^ 2 • inner ℂ q r
OQ7Prescribed.bodySharpScalarLift_inverse_material (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ)
  (q : ↥(OQ7Prescribed.PlanarCurrentL2 (B.absorberThickness + B.plateThickness))) :
  (OQ7Prescribed.activeInverseMaterial B α β) ((OQ7Prescribed.bodySharpScalarLift B) q) =
    (OQ7Prescribed.bodySharpScalarLift B)
      ((OQ7Prescribed.planarInverseMaterial (B.absorberThickness + B.plateThickness) B.absorberThickness α β) q)
OQ7Prescribed.activeInverseMaterial_norm_le (B : OQ7Prescribed.TwoLayerBody) (α β : ℂ) :
  ‖OQ7Prescribed.activeInverseMaterial B α β‖ ≤ OQ7Prescribed.activeMaterialNormBound α β
OQ7Prescribed.normalizedIncidentDrive_norm (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (σ : OQ7Prescribed.Direction) :
  ‖OQ7Prescribed.normalizedIncidentDrive k B σ‖ = B.aperture * √B.plateThickness
OQ7Prescribed.normalizedExtinction_planar_lift_error_bound (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) :
  |OQ7Prescribed.normalizedExtinction k hk B σ θ α β hα hβ -
        B.aperture ^ 2 *
          OQ7Prescribed.planarNormalizedExtinction k hk σ (B.absorberThickness + B.plateThickness) ⋯ B.absorberThickness
            θ α β hα hβ| ≤
    k * B.aperture * √B.plateThickness *
      ‖OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ -
          (OQ7Prescribed.bodySharpScalarLift B)
            (OQ7Prescribed.planarNormalizedResponse k hk σ (B.absorberThickness + B.plateThickness) ⋯
              B.absorberThickness θ α β hα hβ)‖
OQ7Prescribed.normalizedAbsorption_planar_lift_error_bound (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) :
  |OQ7Prescribed.normalizedAbsorption k hk B σ θ α β hα hβ -
        B.aperture ^ 2 *
          OQ7Prescribed.planarNormalizedAbsorption k hk σ (B.absorberThickness + B.plateThickness) ⋯ B.absorberThickness
            θ α β hα hβ| ≤
    2 * k * OQ7Prescribed.activeMaterialNormBound α β / OQ7Prescribed.activeMaterialCoercivity α β * B.aperture *
        √B.plateThickness *
      ‖OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ -
          (OQ7Prescribed.bodySharpScalarLift B)
            (OQ7Prescribed.planarNormalizedResponse k hk σ (B.absorberThickness + B.plateThickness) ⋯
              B.absorberThickness θ α β hα hβ)‖
OQ7Prescribed.physicalBody_normalized_powers_uniform_aperture_localization (k : ℝ) (hk : 0 < k) (h d : ℝ) (hh : 0 < h)
  (hd : 0 < d) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) (ε : ℝ) (hε : 0 < ε) :
  ∃ R0,
    1 ≤ R0 ∧
      ∀ (B : OQ7Prescribed.TwoLayerBody),
        B.absorberThickness = h →
          B.plateThickness = d →
            R0 ≤ B.aperture →
              ∀ (σ : OQ7Prescribed.Direction) (θ : ℝ),
                |OQ7Prescribed.normalizedExtinction k hk B σ θ α β hα hβ -
                        B.aperture ^ 2 *
                          OQ7Prescribed.planarNormalizedExtinction k hk σ (B.absorberThickness + B.plateThickness) ⋯
                            B.absorberThickness θ α β hα hβ| +
                    |OQ7Prescribed.normalizedAbsorption k hk B σ θ α β hα hβ -
                        B.aperture ^ 2 *
                          OQ7Prescribed.planarNormalizedAbsorption k hk σ (B.absorberThickness + B.plateThickness) ⋯
                            B.absorberThickness θ α β hα hβ| ≤
                  ε * B.aperture ^ 2
OQ7Prescribed.physicalRankOne_original_powers_uniform_aperture_localization (k : ℝ) (hk : 0 < k) (h d : ℝ) (hh : 0 < h)
  (hd : 0 < d) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) (ε : ℝ) (hε : 0 < ε) :
  ∃ R0,
    1 ≤ R0 ∧
      ∀ (B : OQ7Prescribed.TwoLayerBody),
        B.absorberThickness = h →
          B.plateThickness = d →
            R0 ≤ B.aperture →
              ∀ (σ : OQ7Prescribed.Direction) (θ : ℝ),
                |OQ7Prescribed.extinction k
                            (OQ7Prescribed.rankOneBody B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β) σ
                            (OQ7Prescribed.rankOnePhysicalElectric k hk B σ θ α β hα hβ) -
                          B.aperture ^ 2 * Real.sin θ ^ 2 *
                            OQ7Prescribed.planarNormalizedExtinction k hk σ (B.absorberThickness + B.plateThickness) ⋯
                              B.absorberThickness θ α β hα hβ| +
                      |OQ7Prescribed.absorption k
                            (OQ7Prescribed.rankOneBody B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β)
                            (OQ7Prescribed.rankOnePhysicalElectric k hk B σ θ α β hα hβ) -
                          B.aperture ^ 2 * Real.sin θ ^ 2 *
                            OQ7Prescribed.planarNormalizedAbsorption k hk σ (B.absorberThickness + B.plateThickness) ⋯
                              B.absorberThickness θ α β hα hβ| +
                    |OQ7Prescribed.scattering k
                          (OQ7Prescribed.rankOneBody B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β)
                          (OQ7Prescribed.rankOnePhysicalElectric k hk B σ θ α β hα hβ) -
                        B.aperture ^ 2 * Real.sin θ ^ 2 *
                          (OQ7Prescribed.planarNormalizedExtinction k hk σ (B.absorberThickness + B.plateThickness) ⋯
                              B.absorberThickness θ α β hα hβ -
                            OQ7Prescribed.planarNormalizedAbsorption k hk σ (B.absorberThickness + B.plateThickness) ⋯
                              B.absorberThickness θ α β hα hβ)| ≤
                  ε * B.aperture ^ 2 * Real.sin θ ^ 2
OQ7Prescribed.physicalBody_normalized_vector_current_uniform_aperture_localization (k : ℝ) (hk : 0 < k) (h d : ℝ)
  (hh : 0 < h) (hd : 0 < d) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im) (ε : ℝ) (hε : 0 < ε) :
  ∃ R0,
    1 ≤ R0 ∧
      ∀ (B : OQ7Prescribed.TwoLayerBody),
        B.absorberThickness = h →
          B.plateThickness = d →
            R0 ≤ B.aperture →
              ∀ (σ : OQ7Prescribed.Direction) (θ : ℝ),
                ‖(OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
                        (OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ) -
                      (OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
                        ((OQ7Prescribed.bodySharpScalarLift B)
                          (OQ7Prescribed.planarNormalizedResponse k hk σ (B.absorberThickness + B.plateThickness) ⋯
                            B.absorberThickness θ α β hα hβ))‖ ≤
                  ε * B.aperture
