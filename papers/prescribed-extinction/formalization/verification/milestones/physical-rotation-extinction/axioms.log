OQ7Prescribed.activeProjectedIncident_sine_factorization : ∀ (k : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ),
  (OQ7Prescribed.activeProjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
      (OQ7Prescribed.bodyIncidentCurrent k B σ) =
    ↑(Real.sin θ) • OQ7Prescribed.normalizedIncidentDrive k B σ
'OQ7Prescribed.activeProjectedIncident_sine_factorization' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.activePhysicalSolution_sine_factorization : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.activePhysicalSolution k hk B σ (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β hα hβ =
    ↑(Real.sin θ) • OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ
'OQ7Prescribed.activePhysicalSolution_sine_factorization' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.normalizedActiveResponse_norm_le : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  ‖OQ7Prescribed.normalizedActiveResponse k hk B σ θ α β hα hβ‖ ≤
    1 / min (α.im / Complex.normSq α) (β.im / Complex.normSq β) * ‖OQ7Prescribed.normalizedIncidentDrive k B σ‖
'OQ7Prescribed.normalizedActiveResponse_norm_le' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.activePhysicalExtinction_work : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (u v : OQ7Prescribed.Position) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.extinction k (OQ7Prescribed.rankOneBody B u v α β) σ
      (OQ7Prescribed.volumeTotalElectric k σ
        (OQ7Prescribed.bodyCurrentPolarization B
          ((OQ7Prescribed.activeInjection B u v) (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ)))) =
    k *
      (inner ℂ ((OQ7Prescribed.activeProjection B u v) (OQ7Prescribed.bodyIncidentCurrent k B σ))
          (OQ7Prescribed.activePhysicalSolution k hk B σ u v α β hα hβ)).im
'OQ7Prescribed.activePhysicalExtinction_work' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.physicalExtinction_sine_squared_factorization : ∀ (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (θ : ℝ) (α β : ℂ) (hα : 0 < α.im) (hβ : 0 < β.im),
  OQ7Prescribed.extinction k (OQ7Prescribed.rankOneBody B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β) σ
      (OQ7Prescribed.volumeTotalElectric k σ
        (OQ7Prescribed.bodyCurrentPolarization B
          ((OQ7Prescribed.activeInjection B (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ))
            (OQ7Prescribed.activePhysicalSolution k hk B σ (OQ7Prescribed.basisR 0) (OQ7Prescribed.rotatedAxis θ) α β hα
              hβ)))) =
    Real.sin θ ^ 2 * OQ7Prescribed.normalizedExtinction k hk B σ θ α β hα hβ
'OQ7Prescribed.physicalExtinction_sine_squared_factorization' depends on axioms: [propext, Classical.choice, Quot.sound]
