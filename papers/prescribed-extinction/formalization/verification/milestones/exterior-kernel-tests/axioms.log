OQ7Prescribed.dyadicGreenDistribution_apply_of_zero : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  φ 0 = 0 →
    ∀ (i j : Fin 3),
      (OQ7Prescribed.dyadicGreenDistribution k i j) φ =
        ∫ (x : OQ7Prescribed.Position), ↑(φ x) * ((OQ7Prescribed.classicalDyadic k x) (OQ7Prescribed.basisC j)).ofLp i
'OQ7Prescribed.dyadicGreenDistribution_apply_of_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
OQ7Prescribed.classicalDyadic_test_integrable_of_zero : ∀ (k : ℝ) (φ : OQ7Prescribed.ScalarTest),
  φ 0 = 0 →
    ∀ (i j : Fin 3),
      MeasureTheory.Integrable (fun x => ↑(φ x) * ((OQ7Prescribed.classicalDyadic k x) (OQ7Prescribed.basisC j)).ofLp i)
        MeasureTheory.volume
