  [inst : MeasurableSpace α] [inst_1 : NormedAddCommGroup E] [inst_2 : InnerProductSpace ℂ E] [inst_3 : CompleteSpace E]
  (μ : MeasureTheory.Measure α) (s t : Set α) (ht : MeasurableSet t) (A B : E →L[ℂ] E) (c : ℝ),
  (∀ (v : E), c * ‖v‖ ^ 2 ≤ -(inner ℂ v (A v)).im) →
