OQ7Prescribed.smoothScalar_distributionPartial : ∀ (f : OQ7Prescribed.Position → ℂ),
  ContDiff ℝ (↑⊤) f →
    ∀ (j : Fin 3),
      (OQ7Prescribed.distributionPartial j) (Distribution.ofFun ⊤ f MeasureTheory.volume ⊤) =
        Distribution.ofFun ⊤ (fun x => (fderiv ℝ f x) (OQ7Prescribed.basisR j)) MeasureTheory.volume ⊤
'OQ7Prescribed.smoothScalar_distributionPartial' depends on axioms: [propext, Classical.choice, Quot.sound]
