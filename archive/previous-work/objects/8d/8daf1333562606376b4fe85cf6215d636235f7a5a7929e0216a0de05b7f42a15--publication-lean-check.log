OQ7Prescribed.theorem11_complete : OQ7Prescribed.PhysicalTheorem11Statement
def OQ7Prescribed.PhysicalTheorem11Statement : Prop :=
OQ7Prescribed.Theorem11Statement ∧
  ∀ (k P Q target : ℝ),
    0 < k →
      1 < P →
        0 < Q →
          0 < target →
            sSup (OQ7Prescribed.prescribedExtinctionAsymmetryValues k P Q target) = 1 ∧
              sSup (OQ7Prescribed.prescribedExtinctionDifferenceValues k P Q target) = target ∧
                (∀ (B : OQ7Prescribed.TwoLayerBody),
                    B.admissible P Q →
                      ∀ (σ : OQ7Prescribed.Direction),
                        (∃ s,
                            ∀ (t : OQ7Prescribed.ScatteringState k B σ),
                              s.electric =ᵐ[MeasureTheory.volume] t.electric ∧
                                s.magnetic =ᵐ[MeasureTheory.volume] t.magnetic) ∧
                          ∀ (s : OQ7Prescribed.ScatteringState k B σ),
                            OQ7Prescribed.FullPhysicalOpticalStatement k B σ s) ∧
                  (∀ (B : OQ7Prescribed.TwoLayerBody),
                      B.admissible P Q →
                        ∀ (sp : OQ7Prescribed.ScatteringState k B OQ7Prescribed.Direction.plus)
                          (sm : OQ7Prescribed.ScatteringState k B OQ7Prescribed.Direction.minus),
                          OQ7Prescribed.extinction k B OQ7Prescribed.Direction.plus sp.electric =
                              OQ7Prescribed.extinction k B OQ7Prescribed.Direction.minus sm.electric ∧
                            0 ≤ OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric ∧
                              OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric ≤ 1 ∧
                                (0 < OQ7Prescribed.extinction k B OQ7Prescribed.Direction.plus sp.electric →
                                    OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric < 1) ∧
                                  OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric =
                                    |OQ7Prescribed.scattering k B sp.electric -
                                          OQ7Prescribed.scattering k B sm.electric| /
                                      OQ7Prescribed.extinction k B OQ7Prescribed.Direction.plus sp.electric) ∧
                    ∀ (s : OQ7Prescribed.PrescribedExtinctionPair k P Q target),
                      s.asymmetry < 1 ∧ s.absorptionDifference < target
def OQ7Prescribed.Theorem11Statement : Prop :=
∀ (k P Q target : ℝ),
  0 < k →
    1 < P →
      0 < Q →
        0 < target →
          ∀ (ε : ℝ),
            0 < ε →
              ε < 1 →
                ∃ B,
                  B.admissible P Q ∧
                    ∃ sp sm,
                      OQ7Prescribed.extinction k B OQ7Prescribed.Direction.plus sp.electric = target ∧
                        OQ7Prescribed.extinction k B OQ7Prescribed.Direction.minus sm.electric = target ∧
                          1 - ε < OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric ∧
                            OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric < 1
def OQ7Prescribed.MaterialAdmissible : ℝ → ℝ → OQ7Prescribed.Tensor → Prop :=
fun P Q ε =>
  Matrix.transpose ε = ε ∧
    (∀ (v : OQ7Prescribed.Vector),
        OQ7Prescribed.squareNorm v ≤ (OQ7Prescribed.quadratic ε v).re ∧
          (OQ7Prescribed.quadratic ε v).re ≤ P * OQ7Prescribed.squareNorm v) ∧
      (∀ (v : OQ7Prescribed.Vector), v ≠ 0 → 0 < (OQ7Prescribed.quadratic ε v).im) ∧
        ∀ (v : OQ7Prescribed.Vector), (OQ7Prescribed.quadratic ε v).im ≤ Q * OQ7Prescribed.squareNorm v
structure OQ7Prescribed.PrescribedExtinctionPair (k P Q target : ℝ) : Type
number of parameters: 4
fields:
  OQ7Prescribed.PrescribedExtinctionPair.body : OQ7Prescribed.TwoLayerBody
  OQ7Prescribed.PrescribedExtinctionPair.admissible : self.body.admissible P Q
  OQ7Prescribed.PrescribedExtinctionPair.plus : OQ7Prescribed.ScatteringState k self.body OQ7Prescribed.Direction.plus
  OQ7Prescribed.PrescribedExtinctionPair.minus : OQ7Prescribed.ScatteringState k self.body OQ7Prescribed.Direction.minus
  OQ7Prescribed.PrescribedExtinctionPair.plus_extinction : OQ7Prescribed.extinction k self.body
        OQ7Prescribed.Direction.plus self.plus.electric =
      target
  OQ7Prescribed.PrescribedExtinctionPair.minus_extinction : OQ7Prescribed.extinction k self.body
        OQ7Prescribed.Direction.minus self.minus.electric =
      target
constructor:
  OQ7Prescribed.PrescribedExtinctionPair.mk {k P Q target : ℝ} (body : OQ7Prescribed.TwoLayerBody)
    (admissible : body.admissible P Q) (plus : OQ7Prescribed.ScatteringState k body OQ7Prescribed.Direction.plus)
    (minus : OQ7Prescribed.ScatteringState k body OQ7Prescribed.Direction.minus)
    (plus_extinction : OQ7Prescribed.extinction k body OQ7Prescribed.Direction.plus plus.electric = target)
    (minus_extinction : OQ7Prescribed.extinction k body OQ7Prescribed.Direction.minus minus.electric = target) :
    OQ7Prescribed.PrescribedExtinctionPair k P Q target
