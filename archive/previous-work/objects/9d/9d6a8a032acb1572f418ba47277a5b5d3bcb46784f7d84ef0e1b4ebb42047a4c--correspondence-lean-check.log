OQ7Prescribed.scattering (k : ℝ) (B : OQ7Prescribed.TwoLayerBody) (E : OQ7Prescribed.Field) : ℝ
OQ7Prescribed.scatteringState_converse_material_volume_equation (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (s : OQ7Prescribed.ScatteringState k B σ) :
  OQ7Prescribed.MaterialVolumeEquation k B σ (OQ7Prescribed.physicalCompactPolarization B s.electric ⋯)
OQ7Prescribed.scatteringState_energy_balance (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (s : OQ7Prescribed.ScatteringState k B σ) :
  OQ7Prescribed.extinction k B σ s.electric =
    OQ7Prescribed.absorption k B s.electric + OQ7Prescribed.scattering k B s.electric
OQ7Prescribed.scatteringState_forward_optical_theorem (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (s : OQ7Prescribed.ScatteringState k B σ) :
  OQ7Prescribed.extinction k B σ s.electric =
    4 * Real.pi / k *
      (OQ7Prescribed.pairing (OQ7Prescribed.basisC 1)
          (OQ7Prescribed.currentFarField k B s.electric (OQ7Prescribed.incidentForwardDirection σ))).im
OQ7Prescribed.scatteringState_full_optical_theorem (k : ℝ) (hk : 0 < k) (B : OQ7Prescribed.TwoLayerBody)
  (σ : OQ7Prescribed.Direction) (s : OQ7Prescribed.ScatteringState k B σ) :
  OQ7Prescribed.FullPhysicalOpticalStatement k B σ s
OQ7Prescribed.slabDesignAsymmetry_joint_continuousAt_zero (k : ℝ) (hk : 0 < k) (A : OQ7.HomogeneousLayer)
  (hpA : 1 ≤ A.p) (hqA : 0 ≤ A.q) (hdA : 0 ≤ A.width) (j : ℕ) (hj : 1 ≤ j) :
  ContinuousAt
    (fun x =>
      OQ7Prescribed.slabFormulaAsymmetry k A
        (OQ7Prescribed.dielectricSlab (OQ7Prescribed.plateDesignPermittivity j) (↑x.1)
          (OQ7Prescribed.plateDesignThickness k j))
        x.2 hpA ⋯)
    (⟨0, ⋯⟩, 0)
OQ7Prescribed.theorem11 : OQ7Prescribed.Theorem11Statement
OQ7Prescribed.theorem11_complete : OQ7Prescribed.PhysicalTheorem11Statement
OQ7Prescribed.universal_physical_asymmetry_eq_scattering_difference (k : ℝ) (hk : 0 < k) (P Q : ℝ)
  (B : OQ7Prescribed.TwoLayerBody) (hB : B.admissible P Q)
  (sp : OQ7Prescribed.ScatteringState k B OQ7Prescribed.Direction.plus)
  (sm : OQ7Prescribed.ScatteringState k B OQ7Prescribed.Direction.minus) :
  OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric =
    |OQ7Prescribed.scattering k B sp.electric - OQ7Prescribed.scattering k B sm.electric| /
      OQ7Prescribed.extinction k B OQ7Prescribed.Direction.plus sp.electric
OQ7Prescribed.universal_physical_asymmetry_lt_one (k : ℝ) (hk : 0 < k) (P Q : ℝ) (B : OQ7Prescribed.TwoLayerBody)
  (hB : B.admissible P Q) (sp : OQ7Prescribed.ScatteringState k B OQ7Prescribed.Direction.plus)
  (sm : OQ7Prescribed.ScatteringState k B OQ7Prescribed.Direction.minus)
  (hX : 0 < OQ7Prescribed.extinction k B OQ7Prescribed.Direction.plus sp.electric) :
  OQ7Prescribed.normalizedAsymmetry k B sp.electric sm.electric < 1
OQ7Prescribed.vacuum_outgoing_weak_unique_zero (k : ℝ) (hk : 0 < k) (E H : OQ7Prescribed.Field)
  (hE : OQ7Prescribed.LocallySquareIntegrable E) (hH : OQ7Prescribed.LocallySquareIntegrable H)
  (he : OQ7Prescribed.HasWeakCurl E fun x => (Complex.I * ↑k) • H x)
  (hh : OQ7Prescribed.HasWeakCurl H fun x => (-Complex.I * ↑k) • E x) (hout : OQ7Prescribed.Outgoing E H) :
  E =ᵐ[MeasureTheory.volume] 0 ∧ H =ᵐ[MeasureTheory.volume] 0
OQ7Prescribed.woodburyElectricOperator_left_inverse.{u_1, u_2} {H : Type u_1} {S : Type u_2} [NormedAddCommGroup H]
  [NormedSpace ℂ H] [CompleteSpace H] [NormedAddCommGroup S] [NormedSpace ℂ S] [CompleteSpace S] (K : H →L[ℂ] H)
  (J : S →L[ℂ] H) (P : H →L[ℂ] S) (C D : S →L[ℂ] S) (hDC : D ∘SL C = ContinuousLinearMap.id ℂ S) (e : S ≃L[ℂ] S)
  (he : ↑e = P ∘SL K ∘SL J - D) (x : H) :
  (OQ7Prescribed.woodburyElectricInverse K J P e) ((OQ7Prescribed.woodburyElectricOperator K J P C) x) = x
OQ7Prescribed.woodburyElectricOperator_right_inverse.{u_1, u_2} {H : Type u_1} {S : Type u_2} [NormedAddCommGroup H]
  [NormedSpace ℂ H] [CompleteSpace H] [NormedAddCommGroup S] [NormedSpace ℂ S] [CompleteSpace S] (K : H →L[ℂ] H)
  (J : S →L[ℂ] H) (P : H →L[ℂ] S) (C D : S →L[ℂ] S) (hCD : C ∘SL D = ContinuousLinearMap.id ℂ S) (e : S ≃L[ℂ] S)
  (he : ↑e = P ∘SL K ∘SL J - D) (x : H) :
  (OQ7Prescribed.woodburyElectricOperator K J P C) ((OQ7Prescribed.woodburyElectricInverse K J P e) x) = x
