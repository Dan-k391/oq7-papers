+<script>
+function indicateEquationOverflow() {
+  document.querySelectorAll('.equation').forEach(function(e) {
+    let hint=e.nextElementSibling;
+    if (!hint || !hint.classList.contains('equation-scroll-hint')) {
+      hint=document.createElement('p');
+      hint.className='equation-scroll-hint';
+      hint.textContent='Scroll horizontally to read the full equation.';
+      e.insertAdjacentElement('afterend',hint);
+    }
+    const overflow=e.scrollWidth>e.clientWidth+1;
+    hint.hidden=!overflow;
+    if (overflow) {
+      e.tabIndex=0;
+      e.setAttribute('aria-label','Equation '+e.dataset.number+', horizontally scrollable');
+    } else {
+      e.removeAttribute('tabindex');
+      e.removeAttribute('aria-label');
+    }
+  });
+}
+window.addEventListener('load',indicateEquationOverflow);
